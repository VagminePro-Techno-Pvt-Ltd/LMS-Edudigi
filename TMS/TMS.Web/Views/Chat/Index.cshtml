@{
    ViewBag.Title = "Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ═══════════════════════════════════════════════════════
       CHAT SYSTEM — WhatsApp-Style Light UI
       ═══════════════════════════════════════════════════════ */

    .chat-container {
        display: flex;
        height: calc(100vh - 70px);
        background: #f0f2f5;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 1px 1px 0 rgba(0,0,0,.06), 0 2px 5px 0 rgba(0,0,0,.1);
    }

    /* ───── LEFT SIDEBAR ───── */
    .chat-sidebar {
        width: 380px;
        min-width: 320px;
        background: #ffffff;
        border-right: 1px solid #e1e1e1;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        padding: 10px 16px;
        background: #f0f2f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .sidebar-header h3 {
        margin: 0;
        color: #54656f;
        font-size: 1rem;
        font-weight: 600;
    }

    .search-box {
        padding: 8px 14px;
        background: #ffffff;
        border-bottom: 1px solid #f0f2f5;
    }

    .search-box input {
        width: 100%;
        padding: 8px 16px;
        background: #f0f2f5;
        border: none;
        border-radius: 8px;
        color: #3b4a54;
        font-size: 0.9rem;
        outline: none;
        box-sizing: border-box;
    }

    .search-box input::placeholder {
        color: #8696a0;
    }

    .search-box input:focus {
        background: #ffffff;
        box-shadow: 0 0 0 1px #00a884;
    }

    .contact-list {
        flex: 1;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ced0d1 transparent;
    }

    .contact-item {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        cursor: pointer;
        transition: background 0.1s;
        border-bottom: 1px solid #f0f2f5;
    }

    .contact-item:hover {
        background: #f5f6f6;
    }

    .contact-item.active {
        background: #ebebeb;
    }

    .contact-avatar {
        width: 49px;
        height: 49px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00a884, #0078d4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .contact-details {
        flex: 1;
        margin-left: 15px;
        overflow: hidden;
    }

    .contact-name {
        font-weight: 500;
        color: #111b21;
        font-size: 1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .contact-role-badge {
        display: inline-block;
        font-size: 10px;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 6px;
        font-weight: 600;
        text-transform: uppercase;
        vertical-align: middle;
    }

    .badge-faculty { background: #e7fce3; color: #1b8700; border: 1px solid #c9ecbd; }
    .badge-student { background: #e3f2fd; color: #1976d2; border: 1px solid #bbdefb; }
    .badge-admin { background: #f3e5f5; color: #7b1fa2; border: 1px solid #e1bee7; }

    .contact-last-msg {
        color: #667781;
        font-size: 0.85rem;
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .contact-meta {
        text-align: right;
        flex-shrink: 0;
        margin-left: 10px;
    }

    .contact-time {
        color: #667781;
        font-size: 0.75rem;
    }

    .unread-badge {
        background: #25d366;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 12px;
        display: inline-block;
        margin-top: 5px;
        min-width: 10px;
        text-align: center;
    }

    .contact-course {
        color: #8696a0;
        font-size: 0.75rem;
        margin-top: 1px;
    }

    /* ───── MAIN CHAT AREA ───── */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #efeae2;
    }

    /* Empty state */
    .chat-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #667781;
        background: #f0f2f5;
        border-bottom: 6px solid #25d366;
    }

    .chat-empty svg {
        width: 100px;
        height: 100px;
        margin-bottom: 30px;
        opacity: 0.6;
    }

    .chat-empty h2 {
        color: #41525d;
        font-weight: 300;
        font-size: 2rem;
        margin-bottom: 12px;
    }

    .chat-empty p {
        font-size: 0.9rem;
        max-width: 450px;
        text-align: center;
        line-height: 1.6;
        color: #667781;
    }

    /* Chat header */
    .chat-header {
        padding: 10px 16px;
        background: #f0f2f5;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .chat-header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00a884, #0078d4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
    }

    .chat-header-info {
        margin-left: 15px;
    }

    .chat-header-name {
        color: #111b21;
        font-weight: 500;
        font-size: 1rem;
    }

    .chat-header-course {
        color: #667781;
        font-size: 0.75rem;
    }

    /* Message area */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 24px 7% 12px;
        scrollbar-width: thin;
        scrollbar-color: #ced0d1 transparent;
        background-color: #efeae2;
        background-image: url("https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png");
    }

    .date-divider {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

    .date-divider span {
        background: #ffffff;
        color: #54656f;
        font-size: 0.78rem;
        padding: 6px 12px;
        border-radius: 7px;
        box-shadow: 0 1px 0.5px rgba(0,0,0,0.13);
        text-transform: uppercase;
        font-weight: 500;
    }

    .message-bubble {
        max-width: 65%;
        padding: 6px 10px 8px;
        margin-bottom: 2px;
        border-radius: 7.5px;
        position: relative;
        line-height: 1.4;
        word-wrap: break-word;
        clear: both;
        box-shadow: 0 1px 0.5px rgba(0,0,0,0.13);
    }

    .message-sent {
        background: #d9fdd3;
        color: #111b21;
        float: right;
    }

    .message-received {
        background: #ffffff;
        color: #111b21;
        float: left;
    }

    .message-text {
        font-size: 0.92rem;
    }

    .message-time {
        font-size: 11px;
        color: #667781;
        text-align: right;
        margin-top: 2px;
        margin-left: 10px;
        display: inline-block;
        float: right;
    }

    .message-sender-name {
        font-size: 12.5px;
        color: #e542a3;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .message-sent .message-sender-name { color: #008069; }

    .messages-clear {
        clear: both;
        height: 6px;
    }

    /* Attachment styles */
    .attachment-preview {
        margin-top: 4px;
        margin-bottom: 4px;
        border-radius: 4px;
        overflow: hidden;
    }

    .attachment-image {
        max-width: 100%;
        max-height: 300px;
        border-radius: 4px;
        display: block;
        cursor: pointer;
    }

    .attachment-file {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(0,0,0,0.05);
        padding: 10px 14px;
        border-radius: 6px;
        text-decoration: none !important;
        color: #111b21 !important;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .attachment-file:hover {
        background: rgba(0,0,0,0.08);
    }

    .attachment-icon {
        font-size: 1.6rem;
    }

    .attachment-name {
        font-size: 0.88rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 180px;
    }

    .attachment-size {
        font-size: 0.72rem;
        color: #667781;
    }

    /* ───── INPUT BAR ───── */
    .chat-input-bar {
        padding: 10px 16px;
        background: #f0f2f5;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 62px;
        box-sizing: border-box;
    }

    .input-actions {
        display: flex;
        gap: 4px;
    }

    .input-actions button {
        background: none;
        border: none;
        color: #54656f;
        font-size: 1.4rem;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .input-actions button:hover {
        background: rgba(0,0,0,0.05);
    }

    .message-input-wrap {
        flex: 1;
        background: #ffffff;
        border-radius: 8px;
        margin: 0 8px;
        padding: 6px 12px;
        display: flex;
        align-items: center;
    }

    .message-input {
        width: 100%;
        border: none;
        background: none;
        color: #3b4a54;
        font-size: 0.95rem;
        outline: none;
        resize: none;
        min-height: 20px;
        max-height: 120px;
        font-family: inherit;
        padding: 5px 0;
    }

    .message-input::placeholder {
        color: #8696a0;
    }

    .send-btn {
        background: none;
        border: none;
        color: #54656f;
        font-size: 1.5rem;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }

    .send-btn:not(:disabled) {
        color: #008069;
    }

    /* File preview bar */
    .file-preview-bar {
        display: none;
        padding: 12px 16px;
        background: #f0f2f5;
        border-top: 1px solid rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .file-preview-bar.active {
        display: flex;
        gap: 12px;
    }

    .file-preview-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        padding: 8px 12px;
        border-radius: 8px;
        color: #3b4a54;
        font-size: 0.85rem;
        box-shadow: 0 1px 1px rgba(0,0,0,0.1);
        border: 1px solid #e1e1e1;
    }

    .file-preview-item .remove-file {
        color: #f15c6d;
        cursor: pointer;
        font-weight: bold;
        padding-left: 5px;
    }

    /* Loading spinner */
    .chat-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        color: #667781;
    }

    .spinner {
        width: 24px;
        height: 24px;
        border: 2px solid rgba(0,0,0,0.05);
        border-top-color: #00a884;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 12px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ─── Responsive ─── */
    @@media (max-width: 768px) {
        .chat-sidebar { width: 100%; border-right: none; }
        .chat-main { display: none; }
        .chat-messages { padding: 16px 12px; }
    }
</style>

<div class="chat-container" id="chatContainer">
    <!-- ═══ LEFT SIDEBAR ═══ -->
    <div class="chat-sidebar" id="chatSidebar">
        <div class="sidebar-header">
            <h3>💬 Messages</h3>
        </div>
        <div class="search-box">
            <input type="text" id="searchContacts" placeholder="Search by name or course..." oninput="filterContacts()" />
        </div>
        <div class="contact-list" id="contactList">
            <div class="chat-loading">
                <div class="spinner"></div>
                Loading contacts...
            </div>
        </div>
    </div>

    <!-- ═══ MAIN CHAT AREA ═══ -->
    <div class="chat-main" id="chatMain">
        <!-- Empty state (default) -->
        <div class="chat-empty" id="chatEmpty">
            <svg viewBox="0 0 303 172" fill="none"><path d="M229.565 160.229c32.449-10.214 62.832-45.279 59.218-82.572C284.39 33.969 248.007 4.677 199.607.561c-56.998-4.835-87.668 16.939-107.645 41.697C70.483 70.13 30.858 67.838 11.849 95.223c-18.63 26.847 8.888 50.98 35.138 60.838 24.14 9.067 58.163 12.763 84.022 8.009 25.858-4.754 66.778-4.404 98.556-3.841z" fill="#e9edef"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M152 130c34.242 0 62-22.09 62-49.333S186.242 31.333 152 31.333 90 53.424 90 80.667c0 10.834 4.358 20.833 11.738 28.75L95 131.333l25.397-9.888C129.01 127.077 140.09 130 152 130z" fill="#d1d7db"></path></svg>
            <h2>LMS Chat System</h2>
            <p>Select a contact from the left to start a conversation. You can chat with Faculty, Students, and Admins from your courses.</p>
        </div>

        <!-- Active chat (hidden by default) -->
        <div id="activeChat" style="display:none; flex:1; flex-direction:column;">
            <div class="chat-header" id="chatHeader">
                <div class="chat-header-avatar" id="headerAvatar">A</div>
                <div class="chat-header-info">
                    <div class="chat-header-name" id="headerName">User</div>
                    <div class="chat-header-course" id="headerCourse">Course</div>
                </div>
            </div>

            <div class="chat-messages" id="chatMessages">
                <div class="chat-loading">
                    <div class="spinner"></div>
                    Loading messages...
                </div>
            </div>

            <div class="file-preview-bar" id="filePreviewBar"></div>

            <div class="chat-input-bar">
                <div class="input-actions">
                    <button type="button" title="Attach file" onclick="document.getElementById('fileInput').click()">📎</button>
                    <button type="button" title="Send image" onclick="document.getElementById('imageInput').click()">📷</button>
                </div>
                <input type="file" id="fileInput" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip" multiple style="display:none" onchange="onFilesSelected(this)" />
                <input type="file" id="imageInput" accept="image/*" multiple style="display:none" onchange="onFilesSelected(this)" />
                <div class="message-input-wrap">
                    <textarea id="messageInput" class="message-input" placeholder="Type a message..." rows="1" onkeydown="handleKeyDown(event)"></textarea>
                </div>
                <button class="send-btn" id="sendBtn" onclick="sendMessage()" title="Send">
                    ➤
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden fields to track current conversation -->
<input type="hidden" id="currentPartnerId" value="0" />
<input type="hidden" id="currentCourseId" value="0" />
<input type="hidden" id="currentUserId" value="0" />

<script>
    // ═══════════════════════════════════════════════
    // STATE
    // ═══════════════════════════════════════════════
    let allPartners = [];
    let selectedFiles = [];
    let pollingInterval = null;
    let lastMessageId = 0;

    // ═══════════════════════════════════════════════
    // INIT
    // ═══════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function () {
        loadPartners();
    });

    // ═══════════════════════════════════════════════
    // LOAD CHAT PARTNERS
    // ═══════════════════════════════════════════════
    async function loadPartners() {
        try {
            const res = await fetch('/Chat/GetPartners');
            allPartners = await res.json();
            renderPartners(allPartners);
        } catch (e) {
            document.getElementById('contactList').innerHTML =
                '<div style="padding:20px;color:#8696a0;text-align:center;">Failed to load contacts.</div>';
        }
    }

    function renderPartners(partners) {
        const list = document.getElementById('contactList');
        if (!partners || partners.length === 0) {
            list.innerHTML = '<div style="padding:30px;color:#8696a0;text-align:center;">No contacts found.<br>Enroll in a course to start chatting.</div>';
            return;
        }

        let html = '';
        partners.forEach(p => {
            const initials = getInitials(p.name);
            const roleBadge = getRoleBadge(p.role);
            const time = p.lastMessageTime ? formatTime(p.lastMessageTime) : '';
            const unread = p.unreadCount > 0 ? `<span class="unread-badge">${p.unreadCount}</span>` : '';
            const lastMsg = p.lastMessage || 'No messages yet';

            html += `
                <div class="contact-item" data-userid="${p.userId}" data-courseid="${p.courseId}"
                     data-name="${escapeHtml(p.name)}" data-role="${p.role}" data-course="${escapeHtml(p.courseName)}"
                     onclick="openChat(${p.userId}, ${p.courseId}, '${escapeHtml(p.name)}', '${p.role}', '${escapeHtml(p.courseName)}')">
                    <div class="contact-avatar">${initials}</div>
                    <div class="contact-details">
                        <div class="contact-name">${escapeHtml(p.name)} ${roleBadge}</div>
                        <div class="contact-course">${escapeHtml(p.courseName)}</div>
                        <div class="contact-last-msg">${escapeHtml(lastMsg)}</div>
                    </div>
                    <div class="contact-meta">
                        <div class="contact-time">${time}</div>
                        ${unread}
                    </div>
                </div>`;
        });
        list.innerHTML = html;
    }

    function filterContacts() {
        const q = document.getElementById('searchContacts').value.toLowerCase();
        const filtered = allPartners.filter(p =>
            (p.name && p.name.toLowerCase().includes(q)) ||
            (p.courseName && p.courseName.toLowerCase().includes(q)) ||
            (p.role && p.role.toLowerCase().includes(q))
        );
        renderPartners(filtered);
    }

    // ═══════════════════════════════════════════════
    // OPEN CHAT CONVERSATION
    // ═══════════════════════════════════════════════
    async function openChat(partnerId, courseId, name, role, courseName) {
        // Set active state in sidebar
        document.querySelectorAll('.contact-item').forEach(el => el.classList.remove('active'));
        const activeEl = document.querySelector(`.contact-item[data-userid="${partnerId}"][data-courseid="${courseId}"]`);
        if (activeEl) activeEl.classList.add('active');

        // Store current conversation
        document.getElementById('currentPartnerId').value = partnerId;
        document.getElementById('currentCourseId').value = courseId;

        // Update header
        const initials = getInitials(name);
        document.getElementById('headerAvatar').textContent = initials;
        document.getElementById('headerName').textContent = name + ' (' + role + ')';
        document.getElementById('headerCourse').textContent = courseName;

        // Show active chat, hide empty state
        document.getElementById('chatEmpty').style.display = 'none';
        const activeChat = document.getElementById('activeChat');
        activeChat.style.display = 'flex';

        // Clear selected files
        selectedFiles = [];
        updateFilePreview();

        // Load messages
        await loadMessages(partnerId, courseId);

        // Start polling for new messages
        if (pollingInterval) clearInterval(pollingInterval);
        pollingInterval = setInterval(() => pollNewMessages(), 4000);

        // Focus the input
        document.getElementById('messageInput').focus();
    }

    async function loadMessages(partnerId, courseId) {
        const container = document.getElementById('chatMessages');
        container.innerHTML = '<div class="chat-loading"><div class="spinner"></div>Loading messages...</div>';

        try {
            const res = await fetch(`/Chat/GetMessages?partnerId=${partnerId}&courseId=${courseId}`);
            const messages = await res.json();
            renderMessages(messages);
            if (messages.length > 0) {
                lastMessageId = messages[messages.length - 1].id;
            }
        } catch (e) {
            container.innerHTML = '<div style="padding:30px;color:#8696a0;text-align:center;">Failed to load messages.</div>';
        }
    }

    function renderMessages(messages) {
        const container = document.getElementById('chatMessages');
        const partnerId = parseInt(document.getElementById('currentPartnerId').value);

        if (!messages || messages.length === 0) {
            container.innerHTML = '<div style="padding:40px;color:#667781;text-align:center;font-size:0.9rem;">No messages yet. Say hello! 👋</div>';
            return;
        }

        let html = '';
        let lastDate = '';

        messages.forEach(m => {
            const msgDate = new Date(m.sentOn).toLocaleDateString();
            if (msgDate !== lastDate) {
                html += `<div class="messages-clear"></div><div class="date-divider"><span>${formatDate(m.sentOn)}</span></div>`;
                lastDate = msgDate;
            }

            const isSent = m.senderId !== partnerId;
            const bubbleClass = isSent ? 'message-sent' : 'message-received';
            const time = formatTimeShort(m.sentOn);

            html += `<div class="message-bubble ${bubbleClass}">`;

            if (!isSent) {
                html += `<div class="message-sender-name">${escapeHtml(m.senderName || '')}</div>`;
            }

            // Attachments
            if (m.attachments && m.attachments.length > 0) {
                m.attachments.forEach(att => {
                    html += renderAttachment(att);
                });
            }

            // Text
            if (m.messageText) {
                html += `<div class="message-text">${escapeHtml(m.messageText)}</div>`;
            }

            html += `<div class="message-time">${time}${isSent && m.isRead ? ' ✓✓' : ''}</div>`;
            html += `</div><div class="messages-clear"></div>`;
        });

        container.innerHTML = html;
        container.scrollTop = container.scrollHeight;
    }

    function renderAttachment(att) {
        const isImage = att.fileType === 'Image';
        if (isImage) {
            return `<div class="attachment-preview">
                        <a href="${att.filePath}" target="_blank">
                            <img class="attachment-image" src="${att.filePath}" alt="${escapeHtml(att.fileName)}" loading="lazy" />
                        </a>
                    </div>`;
        } else {
            const icon = getFileIcon(att.fileType);
            const size = formatFileSize(att.fileSize);
            return `<div class="attachment-preview">
                        <a class="attachment-file" href="${att.filePath}" target="_blank" download>
                            <span class="attachment-icon">${icon}</span>
                            <div>
                                <div class="attachment-name">${escapeHtml(att.fileName)}</div>
                                <div class="attachment-size">${att.fileType} • ${size}</div>
                            </div>
                        </a>
                    </div>`;
        }
    }

    // ═══════════════════════════════════════════════
    // SEND MESSAGE
    // ═══════════════════════════════════════════════
    async function sendMessage() {
        const partnerId = parseInt(document.getElementById('currentPartnerId').value);
        const courseId = parseInt(document.getElementById('currentCourseId').value);
        const input = document.getElementById('messageInput');
        const text = input.value.trim();

        if (!text && selectedFiles.length === 0) return;
        if (!partnerId || !courseId) return;

        // Disable send while processing
        const sendBtn = document.getElementById('sendBtn');
        sendBtn.disabled = true;

        const formData = new FormData();
        formData.append('courseId', courseId);
        formData.append('receiverId', partnerId);
        formData.append('messageText', text);

        selectedFiles.forEach(f => formData.append('files', f));

        try {
            const res = await fetch('/Chat/SendMessage', { method: 'POST', body: formData });
            const result = await res.json();

            if (result.success) {
                input.value = '';
                input.style.height = 'auto';
                selectedFiles = [];
                updateFilePreview();

                // Append the new message to the chat
                appendMessage(result.data, false);
            } else {
                alert(result.message || 'Failed to send.');
            }
        } catch (e) {
            alert('Network error. Please try again.');
        } finally {
            sendBtn.disabled = false;
            input.focus();
        }
    }

    function appendMessage(m, isFromPartner) {
        const container = document.getElementById('chatMessages');
        // Remove empty placeholder if it exists
        const emptyMsg = container.querySelector('[style*="No messages yet"]');
        if (emptyMsg) container.innerHTML = '';

        const bubbleClass = isFromPartner ? 'message-received' : 'message-sent';
        const time = formatTimeShort(m.sentOn);

        let html = `<div class="message-bubble ${bubbleClass}">`;

        if (isFromPartner) {
            html += `<div class="message-sender-name">${escapeHtml(m.senderName || '')}</div>`;
        }

        if (m.attachments && m.attachments.length > 0) {
            m.attachments.forEach(att => { html += renderAttachment(att); });
        }

        if (m.messageText) {
            html += `<div class="message-text">${escapeHtml(m.messageText)}</div>`;
        }

        html += `<div class="message-time">${time}</div></div><div class="messages-clear"></div>`;
        container.innerHTML += html;
        container.scrollTop = container.scrollHeight;

        if (m.id) lastMessageId = m.id;
    }

    // ═══════════════════════════════════════════════
    // FILE HANDLING
    // ═══════════════════════════════════════════════
    function onFilesSelected(input) {
        const files = Array.from(input.files);
        files.forEach(f => {
            if (f.size <= 10 * 1024 * 1024) { // 10MB limit
                selectedFiles.push(f);
            }
        });
        input.value = '';
        updateFilePreview();
    }

    function updateFilePreview() {
        const bar = document.getElementById('filePreviewBar');
        if (selectedFiles.length === 0) {
            bar.classList.remove('active');
            bar.innerHTML = '';
            return;
        }

        bar.classList.add('active');
        let html = '';
        selectedFiles.forEach((f, i) => {
            const icon = isImageFile(f.name) ? '🖼' : '📄';
            html += `<div class="file-preview-item">
                        ${icon} ${escapeHtml(f.name.substring(0, 25))}
                        <span class="remove-file" onclick="removeFile(${i})">✕</span>
                     </div>`;
        });
        bar.innerHTML = html;
    }

    function removeFile(index) {
        selectedFiles.splice(index, 1);
        updateFilePreview();
    }

    // ═══════════════════════════════════════════════
    // POLLING FOR NEW MESSAGES
    // ═══════════════════════════════════════════════
    async function pollNewMessages() {
        const partnerId = parseInt(document.getElementById('currentPartnerId').value);
        const courseId = parseInt(document.getElementById('currentCourseId').value);
        if (!partnerId || !courseId) return;

        try {
            const res = await fetch(`/Chat/GetMessages?partnerId=${partnerId}&courseId=${courseId}`);
            const messages = await res.json();
            if (messages.length > 0) {
                const newMsgs = messages.filter(m => m.id > lastMessageId);
                newMsgs.forEach(m => {
                    const isFromPartner = m.senderId === partnerId;
                    appendMessage(m, isFromPartner);
                });
            }
        } catch (e) { /* silent fail on polling */ }
    }

    // ═══════════════════════════════════════════════
    // INPUT HANDLING
    // ═══════════════════════════════════════════════
    function handleKeyDown(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    }

    // Auto-resize textarea
    document.addEventListener('DOMContentLoaded', () => {
        const textarea = document.getElementById('messageInput');
        if (textarea) {
            textarea.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }
    });

    // ═══════════════════════════════════════════════
    // UTILITY FUNCTIONS
    // ═══════════════════════════════════════════════
    function getInitials(name) {
        if (!name) return '?';
        return name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
    }

    function getRoleBadge(role) {
        if (!role) return '';
        const cls = role.toLowerCase() === 'faculty' ? 'badge-faculty'
            : role.toLowerCase() === 'admin' ? 'badge-admin'
                : 'badge-student';
        return `<span class="contact-role-badge ${cls}">${role}</span>`;
    }

    function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function formatTime(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - d) / 1000);

        if (diff < 60) return 'now';
        if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
        if (diff < 604800) return Math.floor(diff / 86400) + 'd ago';
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
    }

    function formatTimeShort(dateStr) {
        const d = new Date(dateStr);
        return d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
    }

    function formatDate(dateStr) {
        const d = new Date(dateStr);
        const now = new Date();
        if (d.toDateString() === now.toDateString()) return 'Today';
        const yesterday = new Date(now);
        yesterday.setDate(now.getDate() - 1);
        if (d.toDateString() === yesterday.toDateString()) return 'Yesterday';
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function getFileIcon(type) {
        switch (type) {
            case 'PDF': return '📕';
            case 'Document': return '📘';
            case 'Spreadsheet': return '📗';
            case 'Presentation': return '📙';
            case 'Video': return '🎬';
            case 'Archive': return '📦';
            default: return '📄';
        }
    }

    function isImageFile(name) {
        return /\.(jpg|jpeg|png|gif)$/i.test(name);
    }
</script>
