@model TMS.ViewModels.Academics.UnitHubViewModel
@{
    ViewData["Title"] = Model.UnitName;
}

<style>
    .uh-page { padding: 8px 4px 32px; font-family: 'Jost','Segoe UI',sans-serif; }
    .uh-bc { font-size: 13px; color: #94a3b8; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .uh-bc a { color: #64748b; text-decoration: none; }
    .uh-bc a:hover { color: #6366f1; }
    .uh-bc .sep { color: #cbd5e1; }
    .uh-bc strong { color: #1e293b; }

    .uh-hero {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        border-radius: 18px; padding: 28px 32px; color: #fff; margin-bottom: 28px;
        display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
        box-shadow: 0 8px 32px rgba(79, 70, 229, 0.25); position: relative; overflow: hidden;
    }
    .uh-hero::before {
        content: ''; position: absolute; right: -30px; top: -30px;
        width: 180px; height: 180px; border-radius: 50%; background: rgba(255, 255, 255, 0.06);
    }
    .uh-hero-left h2 { font-size: 22px; font-weight: 900; margin: 0 0 6px; }
    .uh-hero-left p { font-size: 14px; opacity: 0.85; margin: 0; line-height: 1.5; }
    
    .uh-hero-badges { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
    .uh-badge {
        background: rgba(255, 255, 255, 0.18); border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 20px; padding: 4px 14px; font-size: 12px; font-weight: 600;
        display: inline-flex; align-items: center; gap: 6px;
    }

    .uh-hero-stats { display: flex; gap: 24px; }
    .uh-stat { text-align: center; min-width: 70px; }
    .uh-stat .sn { font-size: 28px; font-weight: 900; line-height: 1; }
    .uh-stat .sl { font-size: 11px; opacity: 0.75; text-transform: uppercase; letter-spacing: .6px; margin-top: 4px; }

    .quadrant-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 28px; }
    
    .quadrant-card {
        display: block; border-radius: 16px; border: 1.5px solid #eef2f6; padding: 24px 22px;
        text-decoration: none; transition: transform .22s, box-shadow .22s, border-color .22s;
        box-shadow: 0 2px 12px rgba(0,0,0,.04); background: #fff; position: relative;
    }
    .quadrant-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 32px rgba(99,102,241,.14);
        border-color: var(--q-color);
    }
    
    .quadrant-icon {
        width: 48px; height: 48px; border-radius: 12px;
        background: #fff; display: flex; align-items: center; justify-content: center;
        margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,.08); font-size: 22px;
    }
    
    .quadrant-qnum { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; margin-bottom: 4px; }
    .quadrant-title { font-size: 16px; font-weight: 800; color: #1e293b; margin-bottom: 6px; }
    .quadrant-desc { font-size: 12.5px; color: #64748b; line-height: 1.5; margin-bottom: 14px; min-height: 38px; }
    
    .quadrant-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 14px; padding-top: 12px; border-top: 1px solid #f1f5f9;
    }
    
    .quadrant-stats { font-size: 12px; font-weight: 700; color: #64748b; }
    .quadrant-arrow { font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }
    
    .quiz-badge {
        background: #f0fdf4; color: #16a34a; padding: 2px 10px;
        border-radius: 12px; font-size: 11px; font-weight: 700;
        display: inline-flex; align-items: center; gap: 4px;
    }

    @@media(max-width:768px) {
        .uh-hero { padding: 20px; flex-direction: column; align-items: flex-start; }
        .quadrant-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="uh-page">
    <div class="uh-bc">
        <a asp-controller="Home" asp-action="StudentDashboard"><i class="fa-solid fa-house"></i> Dashboard</a><span class="sep">/</span>
        <a asp-controller="StudentCourse" asp-action="Index">My Courses</a><span class="sep">/</span>
        <a asp-controller="StudentCourse" asp-action="Details" asp-route-courseId="@Model.CourseId">@Model.CourseName</a><span class="sep">/</span>
        <strong>@Model.UnitName</strong>
    </div>

    <div class="uh-hero">
        <div class="uh-hero-left">
            <h2>@Model.UnitName</h2>
            <p>@(string.IsNullOrEmpty(Model.UnitDescription) ? "Access materials and activities across four specialized quadrants." : Model.UnitDescription)</p>
            <div class="uh-hero-badges">
                <span class="uh-badge"><i class="fa-solid fa-graduation-cap"></i> @Model.CourseName</span>
                <span class="uh-badge"><i class="fa-solid fa-calendar-days"></i> @Model.SemesterName</span>
            </div>
        </div>
        <div class="uh-hero-stats">
            <div class="uh-stat"><div class="sn">@Model.TotalMaterials</div><div class="sl">Materials</div></div>
            <div class="uh-stat"><div class="sn">@Model.ProgressPercent%</div><div class="sl">Progress</div></div>
        </div>
    </div>

    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
        <i class="fa-solid fa-cubes" style="color:#6366f1;font-size:16px;"></i>
        <span style="font-size:16px;font-weight:800;color:#1e293b;">4 Learning Quadrants</span>
        <span style="font-size:12px;color:#94a3b8;margin-left:4px;">— Select a quadrant to explore content</span>
    </div>

    <div class="quadrant-grid">
        @foreach (var q in Model.Quadrants)
        {
            <a href="@Url.Action("Content", "StudentQuadrant", new { courseId = Model.CourseId, unitId = Model.UnitId, quadrantId = q.QuadrantId })"
               class="quadrant-card" style="background: @q.BgColor; --q-color: @q.Color;">
                <div class="quadrant-icon" style="color: @q.Color;">
                    <i class="fa-solid @q.Icon"></i>
                </div>
                <div class="quadrant-qnum" style="color: @q.Color;">Quadrant @q.QuadrantNumber</div>
                <div class="quadrant-title">@q.QuadrantName</div>
                <div class="quadrant-desc">@q.Description</div>
                
                <div class="quadrant-footer">
                    <span class="quadrant-stats" style="color: @q.Color;">
                        @if (q.QuadrantNumber == 3 && q.HasQuizAttempt)
                        {
                            <span class="quiz-badge"><i class="fa-solid fa-circle-check"></i> Completed</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-file-lines"></i> <span>@(q.MaterialCount) Items</span>
                        }
                    </span>
                    <span class="quadrant-arrow" style="color: @q.Color;">
                        Explore <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
            </a>
        }
    </div>
</div>
