@model TMS.ViewModels.Academics.ClassroomCalendarViewModel

@{
    ViewData["Title"] = "Academic Classroom Calendar";
    Layout = "_Layout";
    bool isStudent = Model.UserRole.Equals("Student", StringComparison.OrdinalIgnoreCase);
    var facultyList = (ViewBag.FacultyList as List<TMS.ViewModels.UserViewModel>) ?? new List<TMS.ViewModels.UserViewModel>();
}

<style>
    :root {
        --cal-bg: #f8fafc;
        --cal-card: #ffffff;
        --cal-border: #e2e8f0;
        --cal-accent: #4f46e5;
        --cal-accent-hover: #4338ca;
        --cal-accent-light: #eef2ff;
        --cal-accent-glow: rgba(79, 70, 229, 0.2);
        --cal-live: #ef4444;
        --cal-live-glow: rgba(239, 68, 68, 0.25);
        --cal-success: #10b981;
        --cal-amber: #f59e0b;
        --cal-text: #0f172a;
        --cal-text-secondary: #475569;
        --cal-muted: #64748b;
        --cal-radius: 14px;
        --cal-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
        --cal-shadow-hover: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    }

    .cal-container {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        padding: 1.25rem;
        background-color: var(--cal-bg);
        min-height: calc(100vh - 80px);
    }

    /* Top Hero Header */
    .cal-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
        border-radius: var(--cal-radius);
        padding: 1.75rem 2rem;
        color: #ffffff;
        margin-bottom: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(49, 46, 129, 0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.25rem;
        position: relative;
        overflow: hidden;
    }

    .cal-hero::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .cal-hero-title h2 {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cal-hero-title p {
        font-size: 0.9rem;
        color: #c7d2fe;
        margin: 0;
        font-weight: 400;
    }

    .cal-role-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 9999px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    /* Stats Ribbon */
    .cal-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .cal-stat-card {
        background: var(--cal-card);
        border: 1px solid var(--cal-border);
        border-radius: var(--cal-radius);
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--cal-shadow);
        transition: all 0.25s ease;
    }

    .cal-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--cal-shadow-hover);
        border-color: #cbd5e1;
    }

    .cal-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .cal-stat-icon.live { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .cal-stat-icon.upcoming { background: rgba(79, 70, 229, 0.12); color: #4f46e5; }
    .cal-stat-icon.completed { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .cal-stat-icon.cancelled { background: rgba(100, 116, 139, 0.12); color: #64748b; }

    .cal-stat-info .num {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--cal-text);
        line-height: 1.1;
    }

    .cal-stat-info .lbl {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--cal-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 2px;
    }

    /* Main Grid Layout */
    .cal-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 1080px) {
        .cal-layout {
            grid-template-columns: 1fr;
        }
    }

    /* Cards */
    .panel-card {
        background: var(--cal-card);
        border: 1px solid var(--cal-border);
        border-radius: var(--cal-radius);
        padding: 1.5rem;
        box-shadow: var(--cal-shadow);
        margin-bottom: 1.5rem;
        position: relative;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .panel-header h5 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--cal-text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-header h5 i {
        color: var(--cal-accent);
    }

    /* Session List Items */
    .session-stream {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        max-height: 480px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .session-stream::-webkit-scrollbar { width: 5px; }
    .session-stream::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

    .session-row {
        background: #ffffff;
        border: 1px solid var(--cal-border);
        border-radius: 10px;
        padding: 0.9rem;
        display: flex;
        gap: 0.85rem;
        align-items: center;
        transition: all 0.2s ease;
        position: relative;
    }

    .session-row:hover {
        border-color: var(--cal-accent);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.08);
        transform: translateY(-1px);
    }

    .session-row.is-live {
        border-color: #fca5a5;
        background: #fff5f5;
        box-shadow: 0 0 15px var(--cal-live-glow);
    }

    .session-date-badge {
        flex: 0 0 65px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 6px 4px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .session-row.is-live .session-date-badge {
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .s-day { font-size: 0.85rem; font-weight: 800; color: var(--cal-text); line-height: 1; }
    .s-time { font-size: 0.68rem; color: var(--cal-muted); font-weight: 600; margin-top: 3px; }

    .session-details {
        flex: 1;
        min-width: 0;
    }

    .session-details .s-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--cal-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }

    .session-details .s-sub {
        font-size: 0.75rem;
        color: var(--cal-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-launch-pill {
        padding: 6px 14px;
        font-size: 0.75rem;
        font-weight: 700;
        border-radius: 9999px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-launch-pill.primary {
        background: var(--cal-accent);
        color: #ffffff;
    }
    .btn-launch-pill.primary:hover {
        background: var(--cal-accent-hover);
        box-shadow: 0 4px 10px var(--cal-accent-glow);
        color: #ffffff;
    }

    .btn-launch-pill.live-pulse {
        background: var(--cal-live);
        color: #ffffff;
        animation: pulse-glow 1.8s infinite;
    }
    .btn-launch-pill.live-pulse:hover {
        background: #dc2626;
        color: #ffffff;
    }

    @@keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6); }
        70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    /* Schedule Form Styling */
    .form-row-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .form-group-cal {
        margin-bottom: 1rem;
    }

    .form-group-cal label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--cal-text-secondary);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .form-control-cal, .form-select-cal {
        width: 100%;
        padding: 9px 12px;
        background: #ffffff;
        border: 1px solid var(--cal-border);
        border-radius: 8px;
        font-size: 0.86rem;
        color: var(--cal-text);
        transition: all 0.2s;
    }

    .form-control-cal:focus, .form-select-cal:focus {
        outline: none;
        border-color: var(--cal-accent);
        box-shadow: 0 0 0 3px var(--cal-accent-glow);
    }

    /* Day Selector Buttons */
    .day-selector-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .day-btn {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--cal-border);
        background: #f8fafc;
        color: var(--cal-text-secondary);
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .day-btn:hover {
        background: #e2e8f0;
    }

    .day-btn.active {
        background: var(--cal-accent);
        color: #ffffff;
        border-color: var(--cal-accent);
        box-shadow: 0 4px 10px var(--cal-accent-glow);
    }

    .btn-create-submit {
        width: 100%;
        padding: 12px 20px;
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-create-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
    }

    /* FullCalendar Container Styling */
    #calendarBox {
        min-height: 580px;
    }

    .fc {
        font-family: inherit;
    }

    .fc .fc-toolbar-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--cal-text);
        letter-spacing: -0.01em;
    }

    .fc .fc-button {
        background: #ffffff !important;
        color: var(--cal-text-secondary) !important;
        border: 1px solid var(--cal-border) !important;
        border-radius: 8px !important;
        font-size: 0.8rem !important;
        font-weight: 700 !important;
        text-transform: capitalize !important;
        padding: 7px 14px !important;
        transition: all 0.2s !important;
        box-shadow: none !important;
    }

    .fc .fc-button:hover {
        background: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
    }

    .fc .fc-button-active {
        background: var(--cal-accent) !important;
        color: #ffffff !important;
        border-color: var(--cal-accent) !important;
    }

    .fc-theme-standard th {
        background: #f8fafc;
        padding: 10px 0;
        border-color: var(--cal-border) !important;
    }

    .fc-theme-standard td {
        border-color: var(--cal-border) !important;
    }

    .fc-col-header-cell-cushion {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--cal-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .fc-day-today {
        background: var(--cal-accent-light) !important;
    }

    .fc-event {
        border: none !important;
        border-radius: 6px !important;
        padding: 3px 6px !important;
        font-size: 0.76rem !important;
        font-weight: 600 !important;
        cursor: pointer;
        transition: transform 0.15s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .fc-event:hover {
        transform: scale(1.02);
    }

    /* Legend */
    .cal-legend {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--cal-border);
        font-size: 0.75rem;
        color: var(--cal-muted);
        font-weight: 600;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* Modal Styling */
    .modal-content-cal {
        border-radius: 16px;
        border: none;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }

    .modal-header-cal {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        color: #ffffff;
        padding: 1.25rem 1.5rem;
        border-bottom: none;
    }

    .modal-header-cal .modal-title {
        font-weight: 800;
        font-size: 1.15rem;
    }

    .modal-body-cal {
        padding: 1.5rem;
        background: #ffffff;
    }

    .modal-footer-cal {
        padding: 1rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid var(--cal-border);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }
</style>

@Html.AntiForgeryToken()

<div class="cal-container">
    <!-- ═══ HERO BANNER ═══ -->
    <div class="cal-hero">
        <div class="cal-hero-title">
            <h2>
                <i class="fa-solid fa-calendar-days"></i> Classroom Schedule & Live Sessions
            </h2>
            <p>Real-time lecture schedules, interactive virtual meetings, and attendance management.</p>
        </div>
        <div>
            <span class="cal-role-pill">
                <i class="fa-solid fa-user-shield"></i> @Model.UserRole Mode
            </span>
        </div>
    </div>

    <!-- ═══ STATS RIBBON ═══ -->
    <div class="cal-stats-grid">
        <div class="cal-stat-card">
            <div class="cal-stat-icon live">
                <i class="fa-solid fa-tower-broadcast"></i>
            </div>
            <div class="cal-stat-info">
                <div class="num" id="statLiveCount">@Model.LiveSessions.Count</div>
                <div class="lbl">Live Now</div>
            </div>
        </div>
        <div class="cal-stat-card">
            <div class="cal-stat-icon upcoming">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div class="cal-stat-info">
                <div class="num">@Model.TotalUpcoming</div>
                <div class="lbl">Upcoming Sessions</div>
            </div>
        </div>
        <div class="cal-stat-card">
            <div class="cal-stat-icon completed">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="cal-stat-info">
                <div class="num">@Model.TotalCompleted</div>
                <div class="lbl">Completed Sessions</div>
            </div>
        </div>
        <div class="cal-stat-card">
            <div class="cal-stat-icon cancelled">
                <i class="fa-solid fa-ban"></i>
            </div>
            <div class="cal-stat-info">
                <div class="num">@Model.TotalCancelled</div>
                <div class="lbl">Cancelled</div>
            </div>
        </div>
    </div>

    <!-- ═══ MAIN LAYOUT ═══ -->
    <div class="cal-layout">

        <!-- LEFT SIDEBAR: LIVE & UPCOMING -->
        <div class="cal-sidebar">

            <!-- 🔴 Live Classes Box -->
            @if (Model.LiveSessions.Any())
            {
                <div class="panel-card" style="border-color: #fca5a5; background: #fffdfd;">
                    <div class="panel-header">
                        <h5 style="color: #dc2626;">
                            <i class="fa-solid fa-tower-broadcast" style="color: #dc2626;"></i> 🔴 Live Classes Now
                        </h5>
                    </div>
                    <div class="session-stream">
                        @foreach (var s in Model.LiveSessions)
                        {
                            <div class="session-row is-live">
                                <div class="session-date-badge">
                                    <span class="s-day" style="color: #dc2626;">LIVE</span>
                                    <span class="s-time">NOW</span>
                                </div>
                                <div class="session-details">
                                    <div class="s-title">@s.Title</div>
                                    <div class="s-sub">@s.CourseName · @s.FacultyName</div>
                                    <div class="mt-2">
                                        @{
                                            var liveUrl = (Model.IsFaculty && !string.IsNullOrEmpty(s.HostUrl)) ? s.HostUrl : s.JoinUrl;
                                        }
                                        @if (!string.IsNullOrEmpty(liveUrl))
                                        {
                                            <a href="@liveUrl" target="_blank" class="btn-launch-pill live-pulse" title="@(Model.IsFaculty ? "Start Zoom as Host (Direct Host Link)" : "Join Live Class")">
                                                <i class="fa-solid fa-video"></i> @(Model.IsFaculty ? "Start as Host" : "Join Live Class")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-danger" style="font-size:0.75rem; font-weight:700;">
                                                <i class="fa-solid fa-hourglass-half"></i> Link Pending
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 📅 Upcoming Schedule Stream -->
            <div class="panel-card">
                <div class="panel-header">
                    <h5>
                        <i class="fa-solid fa-calendar-check"></i> Upcoming Classes
                    </h5>
                </div>
                <div class="session-stream">
                    @if (!Model.UpcomingSessions.Any())
                    {
                        <div class="text-center py-4 text-muted" style="font-size: 0.85rem;">
                            <i class="fa-regular fa-calendar-xmark fa-2x mb-2 d-block text-secondary"></i>
                            No upcoming sessions scheduled.
                        </div>
                    }
                    else
                    {
                        @foreach (var s in Model.UpcomingSessions.Take(8))
                        {
                            <div class="session-row">
                                <div class="session-date-badge">
                                    <span class="s-day">@s.ScheduledStart.ToString("dd MMM")</span>
                                    <span class="s-time">@s.ScheduledStart.ToString("hh:mm tt")</span>
                                </div>
                                <div class="session-details">
                                    <div class="s-title">@s.Title</div>
                                    <div class="s-sub">@s.CourseName · @s.SubjectName</div>
                                    @if (s.CanJoin)
                                    {
                                        <div class="mt-1">
                                            @{
                                                var upUrl = (Model.IsFaculty && !string.IsNullOrEmpty(s.HostUrl)) ? s.HostUrl : s.JoinUrl;
                                            }
                                            @if (!string.IsNullOrEmpty(upUrl))
                                            {
                                                <a href="@upUrl" target="_blank" class="btn-launch-pill primary" style="padding: 4px 10px; font-size: 0.7rem;" title="@(Model.IsFaculty ? "Start as Host" : "Join Class")">
                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> @(Model.IsFaculty ? "Start Host" : "Join")
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Quick Info / Help Box -->
            <div class="panel-card" style="background: #f1f5f9; border-style: dashed;">
                <div style="font-size: 0.8rem; color: #475569;">
                    <strong class="d-block mb-1 text-dark"><i class="fa-solid fa-circle-info text-primary"></i> Calendar Tips:</strong>
                    Click on any event on the calendar to view full session details, join links, or manage schedules.
                </div>
            </div>

        </div>

        <!-- RIGHT AREA: SCHEDULE FORM & FULLCALENDAR -->
        <div class="cal-main-content">

            <!-- Schedule a Class Form (Faculty / Admin / Staff Only) -->
            @if (!isStudent)
            {
                <div class="panel-card">
                    <div class="panel-header">
                        <h5>
                            <i class="fa-solid fa-calendar-plus"></i> Schedule a New Class Session
                        </h5>
                    </div>

                    <form id="createClassForm">
                        <div class="form-row-grid">
                            <div class="form-group-cal" style="grid-column: 1 / -1;">
                                <label>Class Session Title <span class="text-danger">*</span></label>
                                <input type="text" id="classTitle" class="form-control-cal" placeholder="e.g. Advanced Data Structures - Binary Trees" required />
                            </div>

                            <div class="form-group-cal">
                                <label>Course <span class="text-danger">*</span></label>
                                <select id="classCourse" class="form-select-cal" required>
                                    <option value="">-- Select Course --</option>
                                    @foreach (var c in Model.Courses)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group-cal">
                                <label>Subject</label>
                                <select id="classSubject" class="form-select-cal">
                                    <option value="">-- Select Subject (or All) --</option>
                                </select>
                            </div>

                            <div class="form-group-cal">
                                <label>Assign Faculty / Teacher</label>
                                <select id="classFaculty" class="form-select-cal">
                                    <option value="">-- Select Instructor --</option>
                                    @foreach (var f in facultyList)
                                    {
                                        if (f.Id == Model.UserId)
                                        {
                                            <option value="@f.Id" selected="selected">@f.Name (Current User)</option>
                                        }
                                        else
                                        {
                                            <option value="@f.Id">@f.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group-cal">
                                <label>Start Date <span class="text-danger">*</span></label>
                                <input type="date" id="classStartDate" class="form-control-cal" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="form-group-cal">
                                <label>Start Time <span class="text-danger">*</span></label>
                                <input type="time" id="classStartTime" class="form-control-cal" required value="10:00" />
                            </div>

                            <div class="form-group-cal">
                                <label>Duration (Minutes)</label>
                                <input type="number" id="classDuration" class="form-control-cal" value="60" min="15" max="300" />
                            </div>

                            <div class="form-group-cal">
                                <label>Max Capacity</label>
                                <input type="number" id="classCapacity" class="form-control-cal" value="100" min="1" max="1000" />
                            </div>

                            <div class="form-group-cal">
                                <label>Meeting Platform</label>
                                <select id="meetingProvider" class="form-select-cal" onchange="toggleMeetingLinkBox()">
                                    <option value="Zoom">Zoom (Automated Room Generation)</option>
                                    <option value="External">External Link (Google Meet / Microsoft Teams / Custom)</option>
                                </select>
                            </div>
                        </div>

                        <!-- External URL Box -->
                        <div class="form-group-cal" id="externalLinkBox" style="display:none;">
                            <label>External Meeting URL <span class="text-danger">*</span></label>
                            <input type="url" id="externalMeetingLink" class="form-control-cal" placeholder="https://meet.google.com/xyz-abc or https://teams.microsoft.com/..." />
                        </div>

                        <!-- Recurring Options -->
                        <div class="form-group-cal mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isRecurring" style="cursor:pointer;" />
                                <label class="form-check-label fw-bold text-dark" for="isRecurring" style="cursor:pointer; text-transform:none; font-size:0.88rem;">
                                    Recurring Schedule (Weekly Class Series)
                                </label>
                            </div>
                        </div>

                        <div id="recurringOptions" style="display:none; background:#f8fafc; border: 1px solid #e2e8f0; border-radius:10px; padding:1.25rem; margin-bottom:1.25rem;">
                            <div class="form-row-grid">
                                <div class="form-group-cal">
                                    <label>Series End Date <span class="text-danger">*</span></label>
                                    <input type="date" id="classEndDate" class="form-control-cal" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="form-group-cal" style="grid-column: 1 / -1;">
                                    <label>Repeat on Days of Week</label>
                                    <div class="day-selector-pills">
                                        <button type="button" class="day-btn" data-day="MO">Mon</button>
                                        <button type="button" class="day-btn" data-day="TU">Tue</button>
                                        <button type="button" class="day-btn" data-day="WE">Wed</button>
                                        <button type="button" class="day-btn" data-day="TH">Thu</button>
                                        <button type="button" class="day-btn" data-day="FR">Fri</button>
                                        <button type="button" class="day-btn" data-day="SA">Sat</button>
                                    </div>
                                    <small class="text-muted mt-1 d-block">Click to select active lecture days.</small>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-create-submit" id="btnCreateClass">
                            <i class="fa-solid fa-plus-circle"></i> Create & Publish Class
                        </button>
                    </form>

                    <div id="createResult" class="mt-3"></div>
                </div>
            }

            <!-- ═══ FULLCALENDAR VIEW ═══ -->
            <div class="panel-card">
                <div class="panel-header">
                    <h5>
                        <i class="fa-solid fa-calendar"></i> Interactive Calendar
                    </h5>
                    <div>
                        <select id="calendarCourseFilter" class="form-select-cal" style="width: auto; display: inline-block; padding: 5px 10px; font-size: 0.8rem;">
                            <option value="">All Courses</option>
                            @foreach (var c in Model.Courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div id="calendarBox"></div>

                <!-- Color-Coded Status Legend -->
                <div class="cal-legend">
                    <div class="legend-item">
                        <span class="legend-dot" style="background:#3b82f6;"></span> Scheduled
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot" style="background:#ef4444;"></span> Live Now
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot" style="background:#10b981;"></span> Completed
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot" style="background:#f59e0b;"></span> Rescheduled
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot" style="background:#64748b;"></span> Cancelled
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

