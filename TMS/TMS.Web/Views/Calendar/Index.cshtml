                <div class="form-group-cal mb-3">
                    <label>New Start Time <span class="text-danger">*</span></label>
                    <input type="time" id="rescheduleTime" class="form-control-cal" required />
                </div>
                <div class="form-group-cal mb-3">
                    <label>Duration (Minutes)</label>
                    <input type="number" id="rescheduleDuration" class="form-control-cal" value="60" min="15" max="300" />
                </div>
                <div id="rescheduleResult" class="mt-2"></div>
            </div>
            <div class="modal-footer modal-footer-cal">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-warning fw-bold text-dark" id="btnSubmitReschedule">
                    <i class="fa-solid fa-check me-1"></i> Confirm Reschedule
                </button>
