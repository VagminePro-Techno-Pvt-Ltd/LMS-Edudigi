    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-cal">
            <div class="modal-header modal-header-cal" style="background: linear-gradient(135deg, #b45309 0%, #d97706 100%);">
                <h5 class="modal-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Reschedule Class</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
