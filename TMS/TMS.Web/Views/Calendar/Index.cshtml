<div class="modal fade" id="attendanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-cal">
            <div class="modal-header modal-header-cal" style="background: linear-gradient(135deg, #065f46 0%, #059669 100%);">
                <h5 class="modal-title"><i class="fa-solid fa-user-check me-2"></i>Class Attendance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-cal">
                <input type="hidden" id="attendanceInstanceId" />
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark" id="attSessionTitle">Session</h6>
                        <small class="text-muted" id="attSessionDate">Date</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="selectAllAttendance(true)">Select All</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllAttendance(false)">Clear All</button>
                    </div>
                </div>

                <div id="attendanceStudentList" style="max-height: 360px; overflow-y: auto;">
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-spinner fa-spin fa-2x mb-2"></i>
                        <p>Loading enrolled students...</p>
                    </div>
                </div>

                <div id="attendanceResult" class="mt-3"></div>
            </div>
            <div class="modal-footer modal-footer-cal">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success fw-bold" id="btnSubmitAttendance">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Attendance
                </button>
            </div>
        </div>
    </div>
</div>

<!-- FullCalendar v6 JS -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const userRole = '@Model.UserRole';
        const currentUserId = parseInt('@Model.UserId') || 0;
        const calendarEl = document.getElementById('calendarBox');
        let currentCourseFilter = '';

        // ── Check & Populate Faculty Dropdown via AJAX if empty ──
        const facultySelect = document.getElementById('classFaculty');
        if (facultySelect && facultySelect.options.length <= 1) {
            fetch('/Calendar/GetFaculties')
                .then(r => r.json())
                .then(data => {
                    if (data && data.length > 0) {
                        facultySelect.innerHTML = '<option value="">-- Select Instructor --</option>';
                        data.forEach(f => {
                            const isSelected = f.id === currentUserId ? 'selected="selected"' : '';
                            facultySelect.innerHTML += `<option value="${f.id}" ${isSelected}>${f.name}</option>`;
                        });
                    }
                })
                .catch(() => {});
        }

        // ── 1. FullCalendar Initialization ──
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            height: 600,
            nowIndicator: true,
            navLinks: true,
            dayMaxEvents: 3,
            events: function (fetchInfo, successCallback, failureCallback) {
                let url = `/Calendar/GetEvents?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`;
                if (currentCourseFilter) {
                    url += `&courseId=${currentCourseFilter}`;
                }
                fetch(url)
                    .then(r => r.json())
                    .then(data => successCallback(data))
                    .catch(err => failureCallback(err));
            },
            eventClick: function (info) {
                info.jsEvent.preventDefault();
                const p = info.event.extendedProps;

                document.getElementById('eventModalTitle').innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <span>${escapeHtml(info.event.title)}</span>
                    </div>
                `;

                document.getElementById('eventModalBody').innerHTML = `
                    <div class="mb-3">
                        <span class="badge" style="background-color:${info.event.backgroundColor || '#4f46e5'}; font-size:0.75rem; text-transform:uppercase; padding:5px 10px;">
                            ${p.status || 'Scheduled'}
                        </span>
                    </div>
                    <table class="table table-borderless table-sm" style="font-size:0.88rem;">
                        <tr><td class="text-muted" style="width:120px;"><strong>Course:</strong></td><td>${escapeHtml(p.course)}</td></tr>
                        <tr><td class="text-muted"><strong>Subject:</strong></td><td>${escapeHtml(p.subject)}</td></tr>
                        <tr><td class="text-muted"><strong>Faculty:</strong></td><td>${escapeHtml(p.faculty)}</td></tr>
                        <tr><td class="text-muted"><strong>Duration:</strong></td><td>${p.duration} Minutes</td></tr>
                        ${p.recordingUrl ? `<tr><td class="text-muted"><strong>Recording:</strong></td><td><a href="${p.recordingUrl}" target="_blank" class="text-primary fw-bold"><i class="fa-solid fa-play me-1"></i>Watch Lecture</a></td></tr>` : ''}
                    </table>
                `;

                let footerHtml = '';
                if (p.canJoin) {
                    if (p.joinUrl) {
                        footerHtml += `<a href="${p.joinUrl}" target="_blank" class="btn btn-primary fw-bold"><i class="fa-solid fa-video me-1"></i> Join Session</a>`;
                    } else {
                        footerHtml += `<span class="text-danger small me-auto fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i> Meeting Link Pending</span>`;
                    }
                }

                if (userRole !== 'Student') {
                    if (p.statusCode === 0 || p.statusCode === 4) {
                        footerHtml += `<button type="button" class="btn btn-outline-warning" onclick="openRescheduleModal(${p.instanceId}, '${escapeHtml(info.event.title)}', '${info.event.startStr}', ${p.duration})"><i class="fa-solid fa-clock-rotate-left me-1"></i> Reschedule</button>`;
                        footerHtml += `<button type="button" class="btn btn-outline-danger" onclick="cancelSession(${p.instanceId})"><i class="fa-solid fa-ban me-1"></i> Cancel</button>`;
                    }
                    footerHtml += `<button type="button" class="btn btn-outline-success" onclick="openAttendanceModal(${p.instanceId})"><i class="fa-solid fa-user-check me-1"></i> Attendance</button>`;
                }

                document.getElementById('eventModalFooter').innerHTML = footerHtml || `<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>`;
                new bootstrap.Modal(document.getElementById('eventModal')).show();
            },
            eventTimeFormat: { hour: '2-digit', minute: '2-digit', meridiem: 'short' }
        });
        calendar.render();

        // ── Course Filter Dropdown ──
        const courseFilter = document.getElementById('calendarCourseFilter');
        if (courseFilter) {
            courseFilter.addEventListener('change', function () {
                currentCourseFilter = this.value;
                calendar.refetchEvents();
            });
        }

        // ── 2. Recurring Schedule Toggle ──
        const recurCheck = document.getElementById('isRecurring');
        if (recurCheck) {
            recurCheck.addEventListener('change', function () {
                document.getElementById('recurringOptions').style.display = this.checked ? 'block' : 'none';
                const endDateInput = document.getElementById('classEndDate');
                if (endDateInput) {
                    endDateInput.required = this.checked;
                }
            });
        }

        // ── Day Selector Pills ──
        document.querySelectorAll('.day-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                this.classList.toggle('active');
            });
        });

        // ── 3. Cascade Subject Dropdown based on Course ──
        const courseSelect = document.getElementById('classCourse');
        if (courseSelect) {
            courseSelect.addEventListener('change', function () {
                const courseId = this.value;
                const subjectSelect = document.getElementById('classSubject');
                subjectSelect.innerHTML = '<option value="">Loading subjects...</option>';

                fetch('/Calendar/GetSubjects?courseId=' + (courseId || '0'))
                    .then(r => r.json())
                    .then(data => {
                        let html = '<option value="">-- Select Subject (or All) --</option>';
                        if (data && data.length > 0) {
                            data.forEach(s => {
                                html += `<option value="${s.id}">${s.name}</option>`;
                            });
                        }
                        subjectSelect.innerHTML = html;
                    })
                    .catch(() => {
                        subjectSelect.innerHTML = '<option value="">-- Select Subject --</option>';
                    });
            });

            // Initial load of subjects
            if (courseSelect.value) {
                courseSelect.dispatchEvent(new Event('change'));
            }
        }

        // ── 4. Create Class Form Submit ──
        const form = document.getElementById('createClassForm');
        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const selectedDays = [];
                document.querySelectorAll('.day-btn.active').forEach(b => selectedDays.push(b.dataset.day));

                const titleVal = document.getElementById('classTitle').value.trim();
                const courseVal = parseInt(document.getElementById('classCourse').value) || 0;
                const startDateVal = document.getElementById('classStartDate').value;
                const startTimeVal = document.getElementById('classStartTime').value;

                if (!titleVal || !courseVal || !startDateVal || !startTimeVal) {
                    alert('Please fill all required fields.');
                    return;
                }

                const payload = {
                    Title: titleVal,
                    CourseId: courseVal,
                    SubjectId: parseInt(document.getElementById('classSubject').value) || null,
                    FacultyId: parseInt(document.getElementById('classFaculty')?.value) || currentUserId,
                    StartDate: startDateVal,
                    StartTime: startTimeVal.length === 5 ? startTimeVal + ':00' : startTimeVal,
                    DurationMinutes: parseInt(document.getElementById('classDuration').value) || 60,
                    MaxCapacity: parseInt(document.getElementById('classCapacity').value) || 100,
                    IsRecurring: document.getElementById('isRecurring').checked,
                    EndDate: document.getElementById('classEndDate')?.value || null,
                    SelectedDays: selectedDays,
                    MeetingProvider: document.getElementById('meetingProvider').value,
                    ExternalMeetingLink: document.getElementById('externalMeetingLink')?.value || ''
                };

                const resultEl = document.getElementById('createResult');
                const submitBtn = document.getElementById('btnCreateClass');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Scheduling...';

                fetch('/Calendar/CreateClass', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        resultEl.innerHTML = `<div class="alert alert-success py-2"><i class="fa-solid fa-circle-check me-2"></i>${res.message}</div>`;
                        calendar.refetchEvents();
                        form.reset();
                        document.querySelectorAll('.day-btn.active').forEach(b => b.classList.remove('active'));
                        document.getElementById('recurringOptions').style.display = 'none';
                        document.getElementById('externalLinkBox').style.display = 'none';
                        setTimeout(() => location.reload(), 1200);
                    } else {
                        resultEl.innerHTML = `<div class="alert alert-danger py-2"><i class="fa-solid fa-triangle-exclamation me-2"></i>${res.message || 'Failed to create session.'}</div>`;
                    }
                })
                .catch(() => {
                    resultEl.innerHTML = `<div class="alert alert-danger py-2">Connection error. Please try again.</div>`;
                })
                .finally(() => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-plus-circle"></i> Create & Publish Class';
                });
            });
        }

        // ── 5. Cancel Session ──
        window.cancelSession = function (instanceId) {
            if (!confirm('Are you sure you want to cancel this class session?')) return;
            fetch('/Calendar/CancelInstance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ instanceId: instanceId, reason: 'Cancelled by instructor/admin' })
            })
            .then(r => r.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('eventModal'))?.hide();
                    calendar.refetchEvents();
                    setTimeout(() => location.reload(), 800);
                }
            });
        };

        // ── 6. Reschedule Modal Handlers ──
        window.openRescheduleModal = function (instanceId, title, startStr, duration) {
            bootstrap.Modal.getInstance(document.getElementById('eventModal'))?.hide();
            document.getElementById('rescheduleInstanceId').value = instanceId;
            document.getElementById('rescheduleTitle').value = title;
            document.getElementById('rescheduleDuration').value = duration || 60;
            document.getElementById('rescheduleResult').innerHTML = '';

            if (startStr) {
                const parts = startStr.split('T');
                if (parts[0]) document.getElementById('rescheduleDate').value = parts[0];
                if (parts[1]) document.getElementById('rescheduleTime').value = parts[1].substring(0, 5);
            }

            new bootstrap.Modal(document.getElementById('rescheduleModal')).show();
        };

        document.getElementById('btnSubmitReschedule')?.addEventListener('click', function () {
            const instanceId = parseInt(document.getElementById('rescheduleInstanceId').value);
            const newDate = document.getElementById('rescheduleDate').value;
            const newTime = document.getElementById('rescheduleTime').value;
            const duration = parseInt(document.getElementById('rescheduleDuration').value) || 60;

            if (!newDate || !newTime) {
                alert('Please select both date and time.');
                return;
            }

            const newStart = `${newDate}T${newTime}:00`;
            const resultEl = document.getElementById('rescheduleResult');
            this.disabled = true;

            fetch('/Calendar/RescheduleInstance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ instanceId: instanceId, newStart: newStart, newDuration: duration })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    resultEl.innerHTML = `<div class="alert alert-success py-2">${data.message}</div>`;
                    calendar.refetchEvents();
                    setTimeout(() => {
                        bootstrap.Modal.getInstance(document.getElementById('rescheduleModal'))?.hide();
                        location.reload();
                    }, 1000);
                } else {
                    resultEl.innerHTML = `<div class="alert alert-danger py-2">${data.message}</div>`;
                }
            })
            .catch(() => {
                resultEl.innerHTML = `<div class="alert alert-danger py-2">Error rescheduling session.</div>`;
            })
            .finally(() => {
                this.disabled = false;
            });
        });

        // ── 7. Attendance Modal Handlers ──
        window.openAttendanceModal = function (instanceId) {
            bootstrap.Modal.getInstance(document.getElementById('eventModal'))?.hide();
            document.getElementById('attendanceInstanceId').value = instanceId;
            document.getElementById('attendanceResult').innerHTML = '';
            const listEl = document.getElementById('attendanceStudentList');
            listEl.innerHTML = '<div class="text-center py-4 text-muted"><i class="fa-solid fa-spinner fa-spin fa-2x mb-2"></i><p>Loading students...</p></div>';

            new bootstrap.Modal(document.getElementById('attendanceModal')).show();

            fetch('/Calendar/GetStudentsForAttendance?instanceId=' + instanceId)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('attSessionTitle').textContent = data.sessionTitle + ' (' + data.courseName + ')';
                        document.getElementById('attSessionDate').textContent = data.scheduledDate;

                        if (!data.students || data.students.length === 0) {
                            listEl.innerHTML = '<div class="text-center py-4 text-muted">No students currently enrolled in this course.</div>';
                            return;
                        }

                        let html = '<div class="list-group">';
                        data.students.forEach(s => {
                            html += `
                                <label class="list-group-item d-flex justify-content-between align-items-center py-2" style="cursor:pointer;">
                                    <div>
                                        <input class="form-check-input me-2 att-check" type="checkbox" value="${s.studentId}" ${s.isPresent ? 'checked' : ''} />
                                        <strong>${escapeHtml(s.studentName)}</strong>
                                        <small class="text-muted d-block ms-4">${escapeHtml(s.studentEmail)}</small>
                                    </div>
                                    <span class="badge ${s.isPresent ? 'bg-success' : 'bg-secondary'} att-badge-${s.studentId}">${s.isPresent ? 'Present' : 'Absent'}</span>
                                </label>
                            `;
                        });
                        html += '</div>';
                        listEl.innerHTML = html;

                        // Checkbox toggle status listener
                        document.querySelectorAll('.att-check').forEach(cb => {
                            cb.addEventListener('change', function () {
                                const badge = document.querySelector('.att-badge-' + this.value);
                                if (badge) {
                                    badge.className = `badge ${this.checked ? 'bg-success' : 'bg-secondary'} att-badge-${this.value}`;
                                    badge.textContent = this.checked ? 'Present' : 'Absent';
                                }
                            });
                        });
                    } else {
                        listEl.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    }
                })
                .catch(() => {
                    listEl.innerHTML = `<div class="alert alert-danger">Failed to fetch enrolled students.</div>`;
                });
        };

        window.selectAllAttendance = function (check) {
            document.querySelectorAll('.att-check').forEach(cb => {
                cb.checked = check;
                const badge = document.querySelector('.att-badge-' + cb.value);
                if (badge) {
                    badge.className = `badge ${check ? 'bg-success' : 'bg-secondary'} att-badge-${cb.value}`;
                    badge.textContent = check ? 'Present' : 'Absent';
                }
            });
        };

        document.getElementById('btnSubmitAttendance')?.addEventListener('click', function () {
            const instanceId = parseInt(document.getElementById('attendanceInstanceId').value);
            const presentIds = [];
            document.querySelectorAll('.att-check:checked').forEach(cb => presentIds.push(parseInt(cb.value)));

            const resultEl = document.getElementById('attendanceResult');
            this.disabled = true;

            fetch('/Calendar/MarkAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ instanceId: instanceId, presentStudentIds: presentIds })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    resultEl.innerHTML = `<div class="alert alert-success py-2"><i class="fa-solid fa-check me-1"></i>${data.message}</div>`;
                    setTimeout(() => {
                        bootstrap.Modal.getInstance(document.getElementById('attendanceModal'))?.hide();
                    }, 1000);
                } else {
                    resultEl.innerHTML = `<div class="alert alert-danger py-2">${data.message}</div>`;
                }
            })
            .catch(() => {
                resultEl.innerHTML = `<div class="alert alert-danger py-2">Error saving attendance.</div>`;
            })
            .finally(() => {
                this.disabled = false;
            });
        });
    });

    function toggleMeetingLinkBox() {
        const provider = document.getElementById('meetingProvider').value;
        const box = document.getElementById('externalLinkBox');
        if (box) {
            box.style.display = (provider === 'External') ? 'block' : 'none';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
</script>
