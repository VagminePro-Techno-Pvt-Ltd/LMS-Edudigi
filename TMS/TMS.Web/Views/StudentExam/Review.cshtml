@model TMS.Models.Assessments.StudentExamAttempt

@{
    ViewData["Title"] = "Assessment Review";
}

<div class="exam-page">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- Page Header -->
            <div class="exam-page-header" style="margin-bottom:24px;">
                <div>
                    <h1>
                        <span class="header-icon" style="background:#eff6ff; color:#3b82f6;">
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                        </span>
                        Review Answers
                    </h1>
                    <p>Assessment: <strong style="color:#7c3aed;">@Model.Exam?.Title</strong> · Course: @Model.Exam?.Course?.Name</p>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <!-- Questions Review Stream -->
            <div style="display:flex; flex-direction:column; gap:20px;">
                @for (int i = 0; i < Model.Exam?.QuestionMaps.Count; i++)
                {
                    var map = Model.Exam.QuestionMaps.ElementAt(i);
                    var q = map.Question!;
                    var ans = Model.Answers.FirstOrDefault(a => a.QuestionId == q.Id);
                    var isSubjective = q.QuestionType == "Subjective";
                    var isUnattempted = !isSubjective && (ans == null || ans.SelectedOptionId == null);
                    var isCorrect = !isSubjective && !isUnattempted && ans?.IsCorrect == true;
                    var isIncorrect = !isSubjective && !isUnattempted && ans?.IsCorrect != true;

                    // Border color based on state
                    var borderColor = isSubjective ? "#93c5fd" : isCorrect ? "#a7f3d0" : isIncorrect ? "#fecaca" : "#e2e8f0";

                    <div class="exam-section-box" style="border-left:4px solid @borderColor; padding:24px;">
                        <!-- Question Header -->
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
                            <div>
                                <span style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.5px;">
                                    Question @(i + 1) of @Model.Exam.QuestionMaps.Count
                                </span>
                                <h4 style="font-size:16px; font-weight:700; color:#1e293b; margin:8px 0 0; line-height:1.5;">@q.QuestionText</h4>
                            </div>
                            <div style="text-align:right; flex-shrink:0; margin-left:16px;">
                                <span style="background:#fef9c3; color:#92400e; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:700; display:block; margin-bottom:6px;">
                                    @q.Marks Marks
                                </span>
                                @if (isSubjective)
                                {
                                    <span class="exam-badge pending">Descriptive</span>
                                    <div style="font-size:11px; color:#d97706; margin-top:4px;">Awarded: @(ans?.ObtainedMarks ?? 0)</div>
                                }
                                else if (isUnattempted)
                                {
                                    <span class="exam-badge draft">Unattempted</span>
                                }
                                else if (isCorrect)
                                {
                                    <span class="exam-badge passed"><i class="fa-solid fa-check"></i> Correct (+@q.Marks)</span>
                                }
                                else
                                {
                                    <span class="exam-badge failed"><i class="fa-solid fa-xmark"></i> Wrong (-@q.NegativeMarks)</span>
                                }
                            </div>
                        </div>

                        <!-- Options Review -->
                        @if (q.QuestionType == "MCQ")
                        {
                            <div style="display:flex; flex-direction:column; gap:8px;">
                                @foreach (var opt in q.Options)
                                {
                                    var isSelected = ans?.SelectedOptionId == opt.Id;
                                    var isCorrectOpt = opt.IsCorrect;
                                    var bg = isCorrectOpt ? "#ecfdf5" : (isSelected && !isCorrectOpt) ? "#fef2f2" : "#f8fafc";
                                    var border = isCorrectOpt ? "#a7f3d0" : (isSelected && !isCorrectOpt) ? "#fecaca" : "#f1f5f9";

                                    <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:@bg; border:1px solid @border; border-radius:10px;">
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            @if (isCorrectOpt)
                                            {
                                                <i class="fa-solid fa-circle-check" style="color:#059669;"></i>
                                            }
                                            else if (isSelected)
                                            {
                                                <i class="fa-solid fa-circle-xmark" style="color:#ef4444;"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-circle" style="color:#cbd5e1;"></i>
                                            }
                                            <span style="font-size:13.5px; color:#1e293b; font-weight:@(isCorrectOpt || isSelected ? "600" : "400");">@opt.OptionText</span>
                                        </div>
                                        @if (isSelected)
                                        {
                                            <span style="font-size:10px; color:#64748b; background:#f1f5f9; padding:2px 8px; border-radius:4px;">Your choice</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (q.QuestionType == "Subjective")
                        {
                            <div style="padding:14px; background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px;">
                                <div style="font-size:11px; font-weight:600; color:#3b82f6; text-transform:uppercase; margin-bottom:6px;">
                                    <i class="fa-regular fa-file-lines"></i> Your Answer:
                                </div>
                                <p style="font-size:13.5px; color:#1e293b; line-height:1.6; margin:0; white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(ans?.SubjectiveAnswer) ? "No answer submitted." : ans.SubjectiveAnswer)</p>
                            </div>
                        }

                        <!-- Explanation -->
                        @if (!string.IsNullOrWhiteSpace(q.Explanation))
                        {
                            <div style="margin-top:14px; padding:14px; background:#fffbeb; border:1px solid #fde68a; border-radius:10px;">
                                <div style="font-size:11px; font-weight:600; color:#92400e; text-transform:uppercase; margin-bottom:6px;">
                                    <i class="fa-solid fa-lightbulb"></i> Explanation
                                </div>
                                <p style="font-size:13px; color:#78350f; line-height:1.5; margin:0;">@q.Explanation</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Back Button -->
            <div style="margin-top:24px; text-align:center;">
                <a asp-action="Index" class="exam-btn exam-btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Back to Assessments
                </a>
            </div>
        </div>
    </div>
</div>
