@using System.Security.Claims
@{
    string? currentRole = User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value
                       ?? User?.Claims?.FirstOrDefault(c => c.Type == "role")?.Value
                       ?? "";
    string userRoleLower = currentRole.ToLowerInvariant().Trim();
    bool isAdmin = userRoleLower.Contains("admin")
                   || userRoleLower.Contains("super")
                   || userRoleLower.Contains("management")
                   || userRoleLower.Contains("coordinator")
                   || string.IsNullOrEmpty(userRoleLower);

    bool isFaculty = !isAdmin && (userRoleLower.Contains("faculty")
                                  || userRoleLower.Contains("teacher")
                                  || userRoleLower.Contains("instructor")
                                  || userRoleLower.Contains("evaluator"));
}

