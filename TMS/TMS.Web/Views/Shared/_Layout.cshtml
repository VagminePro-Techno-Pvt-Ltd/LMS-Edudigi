    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const links = document.querySelectorAll('.enhanced-sidebar a');
            const currentPath = window.location.pathname.toLowerCase().replace(/\/$/, "");

            links.forEach(link => {
                try {
                    const linkPath = new URL(link.href).pathname.toLowerCase().replace(/\/$/, "");
                    if (currentPath === linkPath || (linkPath !== "/" && currentPath.startsWith(linkPath + "/"))) {
                        link.classList.add('active');

                        // Open parent menu if it's in a submenu
                        let parentList = link.closest('.sidebar-list');
                        if (parentList) {
                            parentList.classList.add('open');
                        }
                    }
                } catch (e) {}
            });

            // Toggle submenus
            document.querySelectorAll('.enhanced-sidebar .has-submenu').forEach(parentLink => {
                parentLink.addEventListener('click', function(e) {
                    // Prevent navigation if it has subitems
                    const parentLi = this.closest('.sidebar-list');
                    if(parentLi.querySelector('.sidebar-submenu')) {
                        e.preventDefault();
                        parentLi.classList.toggle('open');
                    }
                });
            });
            // Dismiss loader reliably
            function dismissLoaders() {
                var loaders = document.querySelectorAll('.loader-wrapper');
                loaders.forEach(function (l) {
                    l.style.transition = 'opacity 0.3s ease';
                    l.style.opacity = '0';
                    setTimeout(function () {
                        if (l.parentNode) l.parentNode.removeChild(l);
                    }, 300);
                });
            }
            dismissLoaders();
            window.addEventListener('load', dismissLoaders);
            setTimeout(dismissLoaders, 1200);
        });
    </script>

    <script>
        // Keep the original toggle node: existing sidebar-menu.js click handler stays attached.
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.querySelector('.sidebar-wrapper');
            const dock = document.getElementById('sidebarToggleDock');
            const headerLeft = document.querySelector('.page-header .header-left-wrapper');
            const toggle = document.querySelector('.page-header .toggle-sidebar, #sidebarToggleDock .toggle-sidebar');
            if (!sidebar || !dock || !headerLeft || !toggle) return;

            // Accessible hover names for existing role-based menu links.
            document.querySelectorAll('.enhanced-sidebar a[data-title]').forEach(function (link) {
                if (!link.hasAttribute('title')) link.setAttribute('title', link.getAttribute('data-title'));
            });

            function syncTogglePosition() {
                const collapsed = sidebar.classList.contains('close_icon');
                const destination = collapsed ? headerLeft : dock;
                if (toggle.parentElement !== destination) destination.prepend(toggle);
                toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
                toggle.setAttribute('role', 'button');
                toggle.setAttribute('tabindex', '0');
                toggle.setAttribute('aria-expanded', String(!collapsed));
                toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
            }

            // Handle both mouse and keyboard without adding a duplicate mouse click listener.
            toggle.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    toggle.click();
                }
            });
            new MutationObserver(syncTogglePosition).observe(sidebar, { attributes: true, attributeFilter: ['class'] });
            syncTogglePosition();
        });
    </script>
<script src="~/js/lms-sidebar-fix.js" asp-append-version="true"></script>
