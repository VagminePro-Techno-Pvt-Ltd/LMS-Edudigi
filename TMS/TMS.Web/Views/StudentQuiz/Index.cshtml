@model IEnumerable<TMS.ViewModels.Masters.QuizMasterViewModel>
@{
    ViewData["Title"] = "My Quizzes & Practice Tests";
    var attempts = ViewBag.Attempts as List<TMS.ViewModels.Academics.StudentQuizAttemptViewModel> ?? new List<TMS.ViewModels.Academics.StudentQuizAttemptViewModel>();
    var attemptedQuizIds = attempts.Select(a => a.QuizId).ToHashSet();
    var availableQuizzes = Model.Where(q => !attemptedQuizIds.Contains(q.Id)).ToList();
    var completedCount = attempts.Count;
    var availableCount = availableQuizzes.Count;
    var totalCount = Model.Count();
}

<style>
    .sq-shell {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 28px 40px;
        box-sizing: border-box;
    }

    .sq-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4338ca 100%);
        border-radius: 20px;
        padding: 2rem 2.4rem;
        color: #ffffff;
        margin-bottom: 24px;
        box-shadow: 0 12px 30px -8px rgba(49, 46, 129, 0.35);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .sq-hero::after {
        content: '';
        position: absolute;
        bottom: -40px;
        right: -40px;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        pointer-events: none;
    }

    .sq-stat-pill {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 14px;
        padding: 12px 20px;
        min-width: 120px;
        text-align: center;
        transition: transform 0.2s;
    }
    .sq-stat-pill:hover { transform: translateY(-2px); }

    .sq-nav-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 14px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .sq-nav-tab.active {
        background: #4338ca;
        color: #ffffff;
        border-color: #4338ca;
        box-shadow: 0 4px 14px rgba(67, 56, 202, 0.25);
    }

    .sq-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .sq-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.2s ease;
        position: relative;
    }
    .sq-card:hover {
        transform: translateY(-3px);
        border-color: #c7d2fe;
        box-shadow: 0 12px 30px rgba(67, 56, 202, 0.08);
    }

    .sq-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .sq-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }
    .sq-card-icon.pending { background: #eff6ff; color: #2563eb; }
    .sq-card-icon.completed { background: #ecfdf5; color: #059669; }

    .sq-quiz-title {
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
        line-height: 1.3;
    }

    .sq-course-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        margin-bottom: 14px;
    }

    .sq-meta-row {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 18px;
        padding-top: 10px;
        border-top: 1px dashed #edf2f7;
    }

    .btn-start-quiz {
        width: 100%;
        background: linear-gradient(135deg, #4338ca 0%, #3b82f6 100%);
        color: #ffffff !important;
        border: none;
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 700;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(67, 56, 202, 0.22);
        transition: all 0.2s ease;
    }
    .btn-start-quiz:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(67, 56, 202, 0.35);
        color: #ffffff;
    }

    .btn-view-result {
        width: 100%;
        background: #f0fdf4;
        color: #166534 !important;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 700;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-view-result:hover {
        background: #dcfce7;
        border-color: #86efac;
    }

    .score-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 8px 12px;
        margin-bottom: 14px;
    }
</style>

<div class="sq-shell">
    <!-- Hero Header -->
    <div class="sq-hero">
        <div>
            <div style="display:inline-flex; align-items:center; gap:6px; background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3); color: #ffffff !important; padding: 5px 14px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px;">
                <i class="fa-solid fa-clipboard-question text-warning"></i> KNOWLEDGE PRACTICE
            </div>
            <h2 style="font-size: 26px; font-weight: 800; color: #ffffff !important; margin: 0 0 6px 0; letter-spacing: -0.3px;">
                My Quizzes &amp; Assessments
            </h2>
            <p style="font-size: 14px; color: rgba(255,255,255,0.85) !important; margin: 0; line-height: 1.4;">
                Practice unit quizzes, test your knowledge, and review instant performance analytics.
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="sq-stat-pill">
                <span style="display:block; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.9); text-transform: uppercase;">Available</span>
                <strong style="font-size: 24px; font-weight: 800; color: #facc15;">@availableCount</strong>
            </div>
            <div class="sq-stat-pill">
                <span style="display:block; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.9); text-transform: uppercase;">Completed</span>
                <strong style="font-size: 24px; font-weight: 800; color: #4ade80;">@completedCount</strong>
            </div>
            <div class="sq-stat-pill">
                <span style="display:block; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.9); text-transform: uppercase;">Total</span>
                <strong style="font-size: 24px; font-weight: 800; color: #ffffff;">@totalCount</strong>
            </div>
        </div>
    </div>

    <!-- Navigation Bar & Search -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex gap-2">
            <button type="button" class="sq-nav-tab active" id="tabAvailable" onclick="switchQuizTab('available')">
                <i class="fa-solid fa-list-check"></i> Available Quizzes (@availableCount)
            </button>
            <button type="button" class="sq-nav-tab" id="tabCompleted" onclick="switchQuizTab('completed')">
                <i class="fa-solid fa-circle-check"></i> Completed / History (@completedCount)
            </button>
        </div>

        <div class="input-group" style="max-width: 300px;">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa fa-search"></i></span>
            <input type="text" id="quizSearchInput" class="form-control border-start-0 bg-white" placeholder="Search quiz or course..." />
        </div>
    </div>

    <!-- ── SECTION 1: AVAILABLE QUIZZES ──────────────────────── -->
    <div id="sectionAvailable">
        @if (availableQuizzes.Any())
        {
            <div class="sq-grid">
                @foreach (var quiz in availableQuizzes)
                {
                    <div class="sq-card quiz-item" data-title="@quiz.Title" data-course="@(quiz.Course?.Name ?? "")">
                        <div>
                            <div class="sq-card-header">
                                <div class="sq-card-icon pending">
                                    <i class="fa-solid fa-clipboard-question"></i>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1" style="font-size:11px;">
                                    @(quiz.CourseQuadrant?.Name ?? "Quadrant IV")
                                </span>
                            </div>

                            <h3 class="sq-quiz-title">@quiz.Title</h3>
                            
                            <span class="sq-course-badge" title="Course">
                                <i class="fa-solid fa-book-open text-primary"></i>
                                @(quiz.Course?.Name ?? "General Academic Course")
                            </span>

                            <div class="sq-meta-row">
                                <div>
                                    <i class="fa-solid fa-circle-question text-muted me-1"></i>
                                    <strong>@(quiz.Questions?.Count ?? 0)</strong> Questions
                                </div>
                                <div>
                                    <i class="fa-solid fa-bullseye text-muted me-1"></i>
                                    Passing: <strong>@(quiz.PassingMarks ?? 50)%</strong>
                                </div>
                            </div>
                        </div>

                        <div>
                            <a href="@Url.Action("Attempt", "StudentQuiz", new { quizId = quiz.Id })" class="btn-start-quiz">
                                <i class="fa-solid fa-play"></i> Start Practice Quiz
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border p-4">
                <div style="width: 64px; height: 64px; border-radius: 18px; background: #f0fdf4; color: #16a34a; font-size: 28px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">All Caught Up!</h4>
                <p class="text-muted small mb-0">You have completed all currently assigned quizzes. Review completed results in the History tab.</p>
            </div>
        }
    </div>

    <!-- ── SECTION 2: COMPLETED QUIZZES ──────────────────────── -->
    <div id="sectionCompleted" style="display: none;">
        @if (attempts.Any())
        {
            <div class="sq-grid">
                @foreach (var att in attempts)
                {
                    <div class="sq-card quiz-item" data-title="@att.QuizTitle" data-course="@(att.CourseName ?? "")">
                        <div>
                            <div class="sq-card-header">
                                <div class="sq-card-icon completed">
                                    <i class="fa-solid fa-award"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size:11px;">
                                    COMPLETED
                                </span>
                            </div>

                            <h3 class="sq-quiz-title">@att.QuizTitle</h3>
                            
                            <span class="sq-course-badge" title="Course">
                                <i class="fa-solid fa-book-open text-primary"></i>
                                @(att.CourseName ?? "General Academic Course")
                            </span>

                            <div class="score-banner">
                                <span class="small text-muted fw-semibold">Attempt Score</span>
                                <strong class="text-success fs-6">@att.Score Marks</strong>
                            </div>

                            <div class="sq-meta-row mb-3">
                                <div>
                                    <i class="fa-regular fa-calendar-check text-muted me-1"></i>
                                    @att.AttemptDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <div>
                            <a href="@Url.Action("Result", "StudentQuiz", new { attemptId = att.Id })" class="btn-view-result">
                                <i class="fa-solid fa-chart-pie"></i> View Score &amp; Solutions
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border p-4">
                <div style="width: 64px; height: 64px; border-radius: 18px; background: #eff6ff; color: #2563eb; font-size: 28px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;">
                    <i class="fa-solid fa-hourglass-start"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">No Completed Quizzes</h4>
                <p class="text-muted small mb-0">You haven't attempted any quizzes yet. Switch to Available Quizzes to start your first test.</p>
            </div>
        }
    </div>
</div>

<script>
    function switchQuizTab(tab) {
        if (tab === 'available') {
            $('#tabAvailable').addClass('active');
            $('#tabCompleted').removeClass('active');
            $('#sectionAvailable').show();
            $('#sectionCompleted').hide();
        } else {
            $('#tabCompleted').addClass('active');
            $('#tabAvailable').removeClass('active');
            $('#sectionCompleted').show();
            $('#sectionAvailable').hide();
        }
    }

    $(function () {
        $('#quizSearchInput').on('keyup', function () {
            var val = $(this).val().toLowerCase();
            $('.quiz-item').each(function () {
                var title = ($(this).data('title') || '').toLowerCase();
                var course = ($(this).data('course') || '').toLowerCase();
                $(this).toggle(title.indexOf(val) > -1 || course.indexOf(val) > -1);
            });
        });
    });
</script>
