@model TMS.Web.Models.ViewModels.DashboardViewModel
@{
    string facultyName = !string.IsNullOrEmpty(Model?.FacultyName) ? Model.FacultyName : "Administrator";
    string lastLogin = !string.IsNullOrEmpty(Model?.LastLoginString) ? Model.LastLoginString : DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
    int studentCount = Model?.TotalStudents ?? 0;
    int facultyCount = Model?.TotalFaculty ?? 0;
    int courseCount = Model?.TotalCourses ?? 0;
    int assetCount = Model?.TotalMaterials ?? 0;
}

<style>
    :root {
        --dash-bg: #f5f7fc;
        --card-bg: #ffffff;
        --border-color: #e2e8f0;
        --text-heading: #0f172a;
        --text-sub: #64748b;
        --radius-lg: 20px;
        --radius-md: 14px;
        --radius-sm: 10px;
    }

    .edudigi-exact-dashboard {
        padding: 24px 28px 40px 28px;
        background-color: var(--dash-bg);
        min-height: calc(100vh - 80px);
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* ══════════════════════════════════════════════════════════
       1. HERO WELCOME BANNER (Soft Light-Blue / Sapphire Gradient)
       ══════════════════════════════════════════════════════════ */
    .hero-welcome-card {
        background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 35%, #e8f0fe 70%, #eff6ff 100%);
        border: 1px solid #bfdbfe;
        border-radius: var(--radius-lg);
        padding: 30px 36px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(37, 99, 235, 0.05);
    }

    /* Floating light-blue ambient orbs */
    .hero-welcome-card::before {
        content: '';
        position: absolute;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, rgba(255,255,255,0) 70%);
        right: 180px;
        top: -100px;
        pointer-events: none;
    }

    .hero-welcome-card::after {
        content: '';
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(147, 197, 253, 0.25) 0%, rgba(255,255,255,0) 70%);
        right: 20px;
        bottom: -60px;
        pointer-events: none;
    }

    .hero-text-side {
        max-width: 600px;
        position: relative;
        z-index: 2;
    }

    .hero-greeting {
        font-size: 26px;
        font-weight: 800;
        color: var(--text-heading);
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hero-tagline {
        font-size: 14.5px;
        color: var(--text-sub);
        margin: 0 0 18px 0;
        font-weight: 400;
    }

    .hero-login-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 16px;
        background: #ffffff;
        border: 1px solid #bfdbfe;
        border-radius: 30px;
        font-size: 12.5px;
        font-weight: 600;
        color: #2563eb;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);
    }

    .hero-illustration-side {
        position: relative;
        z-index: 2;
        width: 260px;
        height: 125px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    /* ══════════════════════════════════════════════════════════
       2. STATUS & MAINTENANCE ROW (2 Clean Cards)
       ══════════════════════════════════════════════════════════ */
    .top-status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 22px;
    }

    .status-box-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .status-box-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.07);
        border-color: #93c5fd;
    }

    .status-box-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .status-avatar-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .status-avatar-icon.blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .status-avatar-icon.green {
        background: #dcfce7;
        color: #16a34a;
    }

    .status-box-details h4 {
        font-size: 15.5px;
        font-weight: 700;
        color: var(--text-heading);
        margin: 0 0 3px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .system-status-pill {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 20px;
        background: #dcfce7;
        color: #15803d;
    }

    .status-date-text {
        font-size: 12px;
        color: #94a3b8;
        font-weight: 500;
    }

    .status-box-details p {
        font-size: 13px;
        color: var(--text-sub);
        margin: 0;
        line-height: 1.4;
    }

    .status-chevron-arrow {
        color: #94a3b8;
        font-size: 14px;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .status-box-card:hover .status-chevron-arrow {
        transform: translateX(4px);
        color: #2563eb;
    }

    /* ══════════════════════════════════════════════════════════
       3. METRICS STATS GRID (4 Light-Tinted Cards)
       ══════════════════════════════════════════════════════════ */
    .metrics-row-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 22px;
    }

    .metric-stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 20px 20px 16px 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 140px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .metric-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08);
        border-color: #bfdbfe;
    }

    .metric-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .metric-rounded-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .metric-rounded-icon.blue { background: #dbeafe; color: #2563eb; }
    .metric-rounded-icon.green { background: #dcfce7; color: #16a34a; }
    .metric-rounded-icon.light-blue { background: #eff6ff; color: #3b82f6; }
    .metric-rounded-icon.orange { background: #ffedd5; color: #ea580c; }

    .trend-indicator-pill {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 20px;
    }

    .trend-indicator-pill.blue { background: #eff6ff; color: #2563eb; }
    .trend-indicator-pill.green { background: #f0fdf4; color: #16a34a; }
    .trend-indicator-pill.light-blue { background: #eff6ff; color: #3b82f6; }
    .trend-indicator-pill.orange { background: #fff7ed; color: #ea580c; }

    .metric-card-middle {
        margin-top: 10px;
    }

    .metric-small-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.7px;
        margin-bottom: 2px;
    }

    .metric-large-val {
        font-size: 32px;
        font-weight: 800;
        color: var(--text-heading);
        line-height: 1.1;
        margin: 0;
    }

    .metric-card-sub {
        font-size: 12px;
        color: #94a3b8;
        font-weight: 500;
        margin-top: 6px;
    }

    .wave-vector-bg {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 105px;
        height: 48px;
        pointer-events: none;
        opacity: 0.75;
    }

    /* ══════════════════════════════════════════════════════════
       4. BOTTOM SPLIT (User Management & Quick Actions)
       ══════════════════════════════════════════════════════════ */
    .bottom-layout-grid {
        display: grid;
        grid-template-columns: 1.42fr 1fr;
        gap: 20px;
    }

    .white-panel-box {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .panel-box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .panel-box-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .panel-box-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .panel-box-icon.bolt {
        background: #e0f2fe;
        color: #0284c7;
    }

    .panel-box-texts h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-heading);
        margin: 0 0 2px 0;
    }

    .panel-box-texts p {
        font-size: 13px;
        color: var(--text-sub);
        margin: 0;
    }

    .panel-view-btn {
        font-size: 13px;
        font-weight: 600;
        color: #2563eb;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        background: #eff6ff;
        transition: background 0.15s ease;
    }

    .panel-view-btn:hover {
        background: #dbeafe;
    }

    /* Table Styles */
    .exact-user-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .exact-user-table th {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.5px;
        padding: 10px 12px;
        border-bottom: 1px solid #f1f5f9;
        text-align: left;
    }

    .exact-user-table td {
        padding: 12px;
        font-size: 13.5px;
        color: var(--text-heading);
        border-bottom: 1px solid #f8fafc;
        vertical-align: middle;
    }

    .exact-user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        color: #ffffff;
        margin-right: 10px;
    }

    .exact-user-avatar.j-blue { background: #3b82f6; }
    .exact-user-avatar.s-sky { background: #0ea5e9; }
    .exact-user-avatar.m-indigo { background: #4f46e5; }
    .exact-user-avatar.e-blue { background: #2563eb; }

    .user-flex-name {
        font-weight: 600;
        color: var(--text-heading);
        display: flex;
        align-items: center;
    }

    .exact-role-pill {
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        display: inline-block;
    }

    .exact-role-pill.student { background: #eff6ff; color: #2563eb; }
    .exact-role-pill.faculty { background: #dcfce7; color: #16a34a; }
    .exact-role-pill.admin { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }

    .exact-status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .exact-status-indicator.active { color: #16a34a; }
    .exact-status-indicator.active::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #16a34a;
    }

    .exact-status-indicator.pending { color: #d97706; }
    .exact-status-indicator.pending::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #f59e0b;
    }

    /* Quick Actions 6-Grid (Light Bluish Palette) */
    .exact-quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .exact-qa-tile {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 14px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }

    .exact-qa-tile:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.08);
        background: #ffffff;
        border-color: #bfdbfe;
    }

    .exact-qa-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .exact-qa-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .exact-qa-icon.c-blue { background: #e0f2fe; color: #2563eb; }
    .exact-qa-icon.c-green { background: #dcfce7; color: #16a34a; }
    .exact-qa-icon.c-light-blue { background: #eff6ff; color: #3b82f6; }
    .exact-qa-icon.c-orange { background: #ffedd5; color: #ea580c; }
    .exact-qa-icon.c-sky { background: #e0f2fe; color: #0284c7; }
    .exact-qa-icon.c-indigo { background: #eff6ff; color: #4f46e5; }

    .exact-qa-title {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--text-heading);
    }

    .exact-qa-arrow {
        font-size: 11px;
        color: #94a3b8;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .exact-qa-tile:hover .exact-qa-arrow {
        transform: translateX(3px);
        color: #2563eb;
    }

    @@media (max-width: 1100px) {
        .metrics-row-grid { grid-template-columns: 1fr 1fr; }
        .bottom-layout-grid { grid-template-columns: 1fr; }
        .top-status-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="edudigi-exact-dashboard">

    <!-- ════════ 1. Hero Welcome Banner (Light Bluish Gradient) ════════ -->
    <div class="hero-welcome-card">
        <div class="hero-text-side">
            <h1 class="hero-greeting">
                <span>👋</span> Welcome back, @facultyName!
            </h1>
            <p class="hero-tagline">
                @(Model?.IsFaculty == true
                    ? "Here's an overview of your assigned courses, enrolled learners, and active assessments."
                    : "Here's an overview of your administrative platform management.")
            </p>
            <div class="hero-login-badge">
                <i class="fa-regular fa-calendar text-primary"></i>
                <span>Last Login: @lastLogin</span>
            </div>
        </div>

        <div class="hero-illustration-side d-none d-md-flex">
            <!-- 3D Books + Cap + Charts Vector Graphic in Soft Sapphire & Blue Tones -->
            <svg width="240" height="120" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Bottom Book (Sapphire Blue) -->
                <path d="M40 85 L145 70 L175 80 L70 95 Z" fill="#2563eb" />
                <path d="M40 85 L70 95 L70 102 L40 92 Z" fill="#1d4ed8" />
                <path d="M70 95 L175 80 L175 87 L70 102 Z" fill="#60a5fa" />

                <!-- Middle Book (Cyan/Sky) -->
                <path d="M35 72 L140 57 L170 67 L65 82 Z" fill="#0284c7" />
                <path d="M35 72 L65 82 L65 89 L35 79 Z" fill="#0369a1" />
                <path d="M65 82 L170 67 L170 74 L65 89 Z" fill="#38bdf8" />

                <!-- Top Book (Indigo/Blue) -->
                <path d="M30 58 L135 43 L165 53 L60 68 Z" fill="#4f46e5" />
                <path d="M30 58 L60 68 L60 75 L30 65 Z" fill="#4338ca" />
                <path d="M60 68 L165 53 L165 60 L60 75 Z" fill="#818cf8" />

                <!-- 3D Graduation Cap on Top of Books -->
                <polygon points="98,15 48,32 98,48 148,32" fill="#1e293b" />
                <polygon points="98,48 68,56 68,64 98,72 128,64 128,56" fill="#0f172a" />
                <circle cx="98" cy="32" r="4" fill="#fbbf24" />
                <path d="M148 32 L158 48 L155 65" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" fill="none" />
                <circle cx="155" cy="67" r="3" fill="#f59e0b" />

                <!-- Floating 3D Mini Analytics Card in Back -->
                <g filter="drop-shadow(0px 8px 16px rgba(37,99,235,0.15))">
                    <rect x="140" y="14" width="85" height="62" rx="10" fill="#ffffff" stroke="#bfdbfe" stroke-width="1.5" />
                    <rect x="150" y="24" width="38" height="4" rx="2" fill="#93c5fd" />
                    <rect x="150" y="32" width="24" height="3" rx="1.5" fill="#cbd5e1" />
                    <!-- Bar Chart in Blues & Accents -->
                    <rect x="154" y="56" width="7" height="12" rx="2" fill="#93c5fd" />
                    <rect x="165" y="48" width="7" height="20" rx="2" fill="#3b82f6" />
                    <rect x="176" y="42" width="7" height="26" rx="2" fill="#10b981" />
                    <rect x="187" y="50" width="7" height="18" rx="2" fill="#0284c7" />
                    <rect x="198" y="38" width="7" height="30" rx="2" fill="#2563eb" />
                </g>

                <!-- Floating glowing light-blue orb -->
                <circle cx="218" cy="18" r="8" fill="#93c5fd" opacity="0.8" />
            </svg>
        </div>
    </div>

    <!-- ════════ 2. Platform Maintenance / Quick Info Overview ════════ -->
    <div class="top-status-grid">
        @if (Model?.IsFaculty == true)
        {
            <a asp-area="Admin" asp-controller="LectureMaterial" asp-action="Index" class="status-box-card">
                <div class="status-box-left">
                    <div class="status-avatar-icon blue">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div class="status-box-details">
                        <h4>Assigned Curriculum <span class="system-status-pill">Content Hub</span></h4>
                        <p>Access and upload lecture materials, PDFs, and assignments for your courses.</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right status-chevron-arrow"></i>
            </a>

            <a asp-area="" asp-controller="FacultyQuizAssessment" asp-action="Index" class="status-box-card">
                <div class="status-box-left">
                    <div class="status-avatar-icon green">
                        <i class="fa-solid fa-spell-check"></i>
                    </div>
                    <div class="status-box-details">
                        <h4>Assessment Evaluations <span class="status-date-text ms-2">@(Model?.PendingAssessments ?? 0) Pending</span></h4>
                        <p>Grade subjective answers and review student checkpoint test attempts.</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right status-chevron-arrow"></i>
            </a>
        }
        else
        {
            <a asp-area="Admin" asp-controller="Home" asp-action="GetAllMasters" class="status-box-card">
                <div class="status-box-left">
                    <div class="status-avatar-icon blue">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="status-box-details">
                        <h4>Platform Maintenance <span class="system-status-pill">System Status</span></h4>
                        <p>No active threats or outages. Background operations are proceeding within bounds.</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right status-chevron-arrow"></i>
            </a>

            <a asp-area="Admin" asp-controller="CourseStructure" asp-action="Index" class="status-box-card">
                <div class="status-box-left">
                    <div class="status-avatar-icon green">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div class="status-box-details">
                        <h4>Institution Overview <span class="status-date-text ms-2">@DateTime.Now.ToString("dd MMM yyyy")</span></h4>
                        <p>Manage users, program definitions, and academic catalogs via shortcuts.</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right status-chevron-arrow"></i>
            </a>
        }
    </div>

    <!-- ════════ 3. Metrics Stats Grid (4 Cards) ════════ -->
    <div class="metrics-row-grid">

        @if (Model?.IsFaculty == true)
        {
            <!-- Faculty: My Courses -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon blue">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <span class="trend-indicator-pill blue">
                        <i class="fa-solid fa-check"></i> Assigned
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">MY COURSES</div>
                    <h2 class="metric-large-val">@(Model?.MyCourses ?? 0)</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Active Modules</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 30 40, 50 15, 70 25 C 85 32, 95 10, 100 15 L 100 45 L 0 45 Z" fill="#dbeafe" opacity="0.6" />
                    <path d="M0 35 C 30 40, 50 15, 70 25 C 85 32, 95 10, 100 15" stroke="#3b82f6" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Faculty: My Students -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon green">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                    <span class="trend-indicator-pill green">
                        <i class="fa-solid fa-users"></i> Enrolled
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">MY STUDENTS</div>
                    <h2 class="metric-large-val">@(Model?.MyStudents ?? 0)</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Active Learners</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 25 25, 45 40, 70 20 C 85 10, 95 25, 100 20 L 100 45 L 0 45 Z" fill="#dcfce7" opacity="0.6" />
                    <path d="M0 35 C 25 25, 45 40, 70 20 C 85 10, 95 25, 100 20" stroke="#16a34a" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Faculty: Pending Assessments -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon light-blue">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <span class="trend-indicator-pill light-blue">
                        <i class="fa-solid fa-hourglass-half"></i> Pending
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">PENDING ASSESSMENTS</div>
                    <h2 class="metric-large-val">@(Model?.PendingAssessments ?? 0)</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Submissions to Grade</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 30 C 20 40, 45 15, 65 30 C 80 40, 90 20, 100 25 L 100 45 L 0 45 Z" fill="#eff6ff" opacity="0.7" />
                    <path d="M0 30 C 20 40, 45 15, 65 30 C 80 40, 90 20, 100 25" stroke="#3b82f6" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Faculty: Content Assets -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon orange">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <span class="trend-indicator-pill orange">
                        <i class="fa-solid fa-file"></i> Resources
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">COURSE MATERIALS</div>
                    <h2 class="metric-large-val">@(Model?.TotalMaterials ?? 0)</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Content Resources</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 30 20, 55 45, 75 25 C 88 15, 95 30, 100 25 L 100 45 L 0 45 Z" fill="#ffedd5" opacity="0.6" />
                    <path d="M0 35 C 30 20, 55 45, 75 25 C 88 15, 95 30, 100 25" stroke="#ea580c" stroke-width="2.5" fill="none" />
                </svg>
            </div>
        }
        else
        {
            <!-- Admin: Total Students -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon blue">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <span class="trend-indicator-pill blue">
                        <i class="fa-solid fa-arrow-up"></i> 12%
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">TOTAL STUDENTS</div>
                    <h2 class="metric-large-val">@studentCount</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Registered Learners</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 30 40, 50 15, 70 25 C 85 32, 95 10, 100 15 L 100 45 L 0 45 Z" fill="#dbeafe" opacity="0.6" />
                    <path d="M0 35 C 30 40, 50 15, 70 25 C 85 32, 95 10, 100 15" stroke="#3b82f6" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Admin: Total Faculty -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon green">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <span class="trend-indicator-pill green">
                        <i class="fa-solid fa-arrow-up"></i> 8%
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">TOTAL FACULTY</div>
                    <h2 class="metric-large-val">@facultyCount</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Active Educators</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 25 25, 45 40, 70 20 C 85 10, 95 25, 100 20 L 100 45 L 0 45 Z" fill="#dcfce7" opacity="0.6" />
                    <path d="M0 35 C 25 25, 45 40, 70 20 C 85 10, 95 25, 100 20" stroke="#16a34a" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Admin: Total Courses -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon light-blue">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <span class="trend-indicator-pill light-blue">
                        <i class="fa-solid fa-arrow-up"></i> 5%
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">TOTAL COURSES</div>
                    <h2 class="metric-large-val">@courseCount</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Instituted Degrees</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 30 C 20 40, 45 15, 65 30 C 80 40, 90 20, 100 25 L 100 45 L 0 45 Z" fill="#eff6ff" opacity="0.7" />
                    <path d="M0 30 C 20 40, 45 15, 65 30 C 80 40, 90 20, 100 25" stroke="#3b82f6" stroke-width="2.5" fill="none" />
                </svg>
            </div>

            <!-- Admin: Library Assets -->
            <div class="metric-stat-card">
                <div class="metric-card-top">
                    <div class="metric-rounded-icon orange">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <span class="trend-indicator-pill orange">
                        <i class="fa-solid fa-arrow-up"></i> 18%
                    </span>
                </div>
                <div class="metric-card-middle">
                    <div class="metric-small-label">LIBRARY ASSETS</div>
                    <h2 class="metric-large-val">@assetCount</h2>
                </div>
                <div class="metric-card-sub">
                    <span>Resource Mappings</span>
                </div>
                <svg class="wave-vector-bg" viewBox="0 0 100 45" fill="none">
                    <path d="M0 35 C 30 20, 55 45, 75 25 C 88 15, 95 30, 100 25 L 100 45 L 0 45 Z" fill="#ffedd5" opacity="0.6" />
                    <path d="M0 35 C 30 20, 55 45, 75 25 C 88 15, 95 30, 100 25" stroke="#ea580c" stroke-width="2.5" fill="none" />
                </svg>
            </div>
        }

    </div>

    <!-- ════════ 4. User/Course Management (Left) & Quick Actions (Right) ════════ -->
    <div class="bottom-layout-grid">

        @if (Model?.IsFaculty == true)
        {
            <!-- Left: Faculty Assigned Courses -->
            <div class="white-panel-box">
                <div class="panel-box-header">
                    <div class="panel-box-title-wrap">
                        <div class="panel-box-icon">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div class="panel-box-texts">
                            <h3>My Assigned Courses</h3>
                            <p>Courses and syllabus modules assigned to your teaching workload.</p>
                        </div>
                    </div>
                    <a asp-area="Admin" asp-controller="LectureMaterial" asp-action="Index" class="panel-view-btn">
                        Content Library <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="exact-user-table">
                        <thead>
                            <tr>
                                <th style="width: 30px;">#</th>
                                <th>Course Title</th>
                                <th>Program</th>
                                <th>Semester</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.FacultyCourses != null && Model.FacultyCourses.Any())
                            {
                                int idx = 1;
                                foreach (var c in Model.FacultyCourses)
                                {
                                    var avatarLetter = !string.IsNullOrEmpty(c.CourseCode) ? c.CourseCode.Substring(0, 1).ToUpper() : "C";
                                    var avatarClass = (idx % 4) switch
                                    {
                                        1 => "j-blue",
                                        2 => "s-sky",
                                        3 => "m-indigo",
                                        _ => "e-blue"
                                    };
                                    <tr>
                                        <td>@idx</td>
                                        <td>
                                            <div class="user-flex-name">
                                                <span class="exact-user-avatar @avatarClass">@avatarLetter</span>
                                                <div>
                                                    <strong class="text-dark d-block">@(c.Name ?? "Course")</strong>
                                                    <small class="text-muted font-monospace">@(c.CourseCode ?? "")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="exact-role-pill faculty">
                                                @(c.CourseCategory?.Name ?? "General Program")
                                            </span>
                                        </td>
                                        <td class="text-muted" style="font-size:13px;">
                                            @(c.Semester?.Name ?? "Semester 1")
                                        </td>
                                        <td style="text-align: right;">
                                            <a asp-area="Admin" asp-controller="LectureMaterial" asp-action="Index" asp-route-courseId="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1" style="font-size:12px; font-weight:600;">
                                                <i class="fa-solid fa-folder-open me-1"></i> Content
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No assigned courses found yet. Please contact admin to map courses to your account.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right: Faculty Quick Actions -->
            <div class="white-panel-box">
                <div class="panel-box-header">
                    <div class="panel-box-title-wrap">
                        <div class="panel-box-icon bolt">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div class="panel-box-texts">
                            <h3>Faculty Quick Actions</h3>
                            <p>Shortcuts to frequently used instructor workflows.</p>
                        </div>
                    </div>
                </div>

                <div class="exact-quick-actions-grid">
                    <!-- Create Quiz -->
                    <a asp-area="Admin" asp-controller="Quiz" asp-action="Item" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-blue">
                                <i class="fa-solid fa-circle-plus"></i>
                            </div>
                            <span class="exact-qa-title">Create New Quiz</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Evaluate Submissions -->
                    <a asp-area="" asp-controller="FacultyQuizAssessment" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-green">
                                <i class="fa-solid fa-spell-check"></i>
                            </div>
                            <span class="exact-qa-title">Evaluate Assessments</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Content Library -->
                    <a asp-area="Admin" asp-controller="LectureMaterial" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-light-blue">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>
                            <span class="exact-qa-title">Content Library</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Interactive PPT -->
                    <a asp-area="" asp-controller="FacultyPPT" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-orange">
                                <i class="fa-solid fa-file-powerpoint"></i>
                            </div>
                            <span class="exact-qa-title">Interactive PPT</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Student Progress Hub -->
                    <a asp-area="" asp-controller="ProgressReport" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-sky">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <span class="exact-qa-title">Student Progress Hub</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Discussion Forum -->
                    <a asp-area="" asp-controller="Discussion" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-indigo">
                                <i class="fa-solid fa-comments"></i>
                            </div>
                            <span class="exact-qa-title">Discussion Forum</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Left: Admin User Management -->
            <div class="white-panel-box">
                <div class="panel-box-header">
                    <div class="panel-box-title-wrap">
                        <div class="panel-box-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div class="panel-box-texts">
                            <h3>User Management</h3>
                            <p>Manage and monitor all users across the platform.</p>
                        </div>
                    </div>
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="panel-view-btn">
                        View All <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="exact-user-table">
                        <thead>
                            <tr>
                                <th style="width: 30px;">#</th>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.RecentUsers != null && Model.RecentUsers.Any())
                            {
                                int idx = 1;
                                foreach (var u in Model.RecentUsers)
                                {
                                    var roleName = u.Role?.Name ?? "User";
                                    var rolePillClass = roleName.ToLower() switch
                                    {
                                        "student" => "student",
                                        "faculty" or "teacher" or "co faculty" => "faculty",
                                        "admin" or "super admin" or "management" => "admin",
                                        _ => "student"
                                    };
                                    var avatarLetter = !string.IsNullOrEmpty(u.Name) ? u.Name.Substring(0, 1).ToUpper() : "U";
                                    var avatarClass = (idx % 4) switch
                                    {
                                        1 => "j-blue",
                                        2 => "s-sky",
                                        3 => "m-indigo",
                                        _ => "e-blue"
                                    };
                                    <tr>
                                        <td>@idx</td>
                                        <td>
                                            <div class="user-flex-name">
                                                <span class="exact-user-avatar @avatarClass">@avatarLetter</span>
                                                <span>@(u.Name ?? "User")</span>
                                            </div>
                                        </td>
                                        <td><span class="exact-role-pill @rolePillClass">@roleName</span></td>
                                        <td class="text-muted" style="font-size:13px;">@(u.Email ?? "-")</td>
                                        <td>
                                            @if (u.IsActive)
                                            {
                                                <span class="exact-status-indicator active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="exact-status-indicator pending">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            <a asp-area="Admin" asp-controller="User" asp-action="Item" asp-route-id="@u.IdEnc" class="text-muted" title="Edit User">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No users registered yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right: Admin Quick Actions -->
            <div class="white-panel-box">
                <div class="panel-box-header">
                    <div class="panel-box-title-wrap">
                        <div class="panel-box-icon bolt">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div class="panel-box-texts">
                            <h3>Quick Actions</h3>
                            <p>Frequently used administrative actions.</p>
                        </div>
                    </div>
                </div>

                <div class="exact-quick-actions-grid">
                    <!-- Add User -->
                    <a asp-area="Admin" asp-controller="User" asp-action="Item" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-blue">
                                <i class="fa-solid fa-user-plus"></i>
                            </div>
                            <span class="exact-qa-title">Add User</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Bulk Upload -->
                    <a asp-area="Admin" asp-controller="User" asp-action="BulkUpload" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-green">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                            </div>
                            <span class="exact-qa-title">Bulk Upload</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Create Course -->
                    <a asp-area="Admin" asp-controller="CourseStructure" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-light-blue">
                                <i class="fa-solid fa-book-open"></i>
                            </div>
                            <span class="exact-qa-title">Create Course</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Manage Batches -->
                    <a asp-area="Admin" asp-controller="CourseEnrollment" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-orange">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <span class="exact-qa-title">Manage Batches</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- Quiz Management & Evaluation -->
                    <a asp-area="Admin" asp-controller="Quiz" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-sky">
                                <i class="fa-solid fa-clipboard-question"></i>
                            </div>
                            <span class="exact-qa-title">Quizzes & Assessments</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- View Reports / Evaluation -->
                    <a asp-area="" asp-controller="FacultyQuizAssessment" asp-action="Index" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-green">
                                <i class="fa-solid fa-spell-check"></i>
                            </div>
                            <span class="exact-qa-title">Evaluate Submissions</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>

                    <!-- System Settings -->
                    <a asp-area="" asp-controller="Home" asp-action="GetAllMasters" class="exact-qa-tile">
                        <div class="exact-qa-left">
                            <div class="exact-qa-icon c-indigo">
                                <i class="fa-solid fa-gear"></i>
                            </div>
                            <span class="exact-qa-title">System Settings</span>
                        </div>
                        <i class="fa-solid fa-chevron-right exact-qa-arrow"></i>
                    </a>
                </div>
            </div>
        }

    </div>

</div>
