@{
    ViewData["Title"] = "Login";
    Layout = "_layoutempty";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700&display=swap');

    body {
        background-color: #f0f4ff;
        margin: 0;
        padding: 0;
    }

    .lms-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .lms-hero {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-radius: 0 0 2rem 2rem;
        position: relative;
        overflow: hidden;
        padding-top: 40px; /* Added padding to move content down */
        padding-bottom: 120px;
        box-shadow: 0 10px 30px rgba(30, 58, 138, 0.2);
    }

    /* Floating bubbles */
    .lms-bubble {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        z-index: 1;
    }
    .b1 { width: 220px; height: 220px; right: -40px; top: -60px; animation: floatA 6s ease-in-out infinite; }
    .b2 { width: 130px; height: 130px; right: 160px; top: 40px; animation: floatB 8s ease-in-out infinite; }
    .b3 { width: 70px; height: 70px; right: 80px; bottom: 30px; animation: floatC 5s ease-in-out infinite; }
    .b4 { width: 50px; height: 50px; left: 42%; top: 12px; animation: floatA 7s ease-in-out infinite reverse; }

    @@keyframes floatA { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-18px)} }
    @@keyframes floatB { 0%,100%{transform:translateY(0) translateX(0)} 50%{transform:translateY(-12px) translateX(8px)} }
    @@keyframes floatC { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-22px)} }

    .lms-navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 40px;
        position: relative;
        z-index: 2;
    }

    .lms-brand {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
    }

    .lms-brand img {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 2.5px solid rgba(255,255,255,0.8);
        background: #fff;
        object-fit: contain;
        padding: 4px;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .lms-brand-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .lms-brand-name {
        font-family: 'Jost', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        line-height: 1.1;
        letter-spacing: 0.5px;
    }

    .lms-brand-tagline {
        font-family: 'Jost', sans-serif;
        font-size: 12px;
        font-weight: 400;
        color: rgba(255,255,255,0.85);
        line-height: 1.4;
    }

    .lms-nav-btns {
        display: flex;
        gap: 12px;
    }

    .lms-nav-btn {
        border: 1.5px solid rgba(255,255,255,0.6);
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(5px);
        color: #fff;
        border-radius: 20px;
        padding: 8px 20px;
        font-size: 13.5px;
        font-family: 'Jost', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        text-decoration: none;
    }
    .lms-nav-btn:hover { 
        background: rgba(255,255,255,0.25); 
        color: #fff; 
        border-color: #fff;
        transform: translateY(-2px);
    }

    .hero-text-container {
        position: relative;
        z-index: 2;
        padding: 40px 40px 0; /* Added top padding */
    }

    .hero-title {
        font-family: 'Jost', sans-serif;
        font-size: 42px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
    }

    .hero-desc {
        font-family: 'Jost', sans-serif;
        font-size: 16px;
        color: rgba(255,255,255,0.9);
        max-width: 600px;
        line-height: 1.6;
    }

    /* Cards */
    .lms-cards-row {
        display: flex;
        gap: 2rem;
        justify-content: center;
        flex-wrap: wrap;
        padding: 0 20px 40px;
        margin-top: -60px;
        position: relative;
        z-index: 3;
    }

    .lms-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 1.5rem;
        box-shadow: 0 15px 35px rgba(30, 58, 138, 0.1);
        padding: 35px 25px;
        flex: 1 1 280px;
        max-width: 340px;
        text-align: center;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .lms-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 50px rgba(30, 58, 138, 0.18);
        background: #ffffff;
        border-color: rgba(59, 130, 246, 0.3);
    }

    .lms-icon-wrap {
        width: 80px; 
        height: 80px;
        border-radius: 50%;
        margin-bottom: 20px;
        display: flex; 
        align-items: center; 
        justify-content: center;
        transition: all 0.3s ease;
    }
    
    .lms-card:nth-child(1) .lms-icon-wrap { background: #eff6ff; color: #3b82f6; }
    .lms-card:nth-child(2) .lms-icon-wrap { background: #f5f3ff; color: #8b5cf6; }
    .lms-card:nth-child(3) .lms-icon-wrap { background: #ecfdf5; color: #10b981; }

    .lms-card:hover .lms-icon-wrap {
        transform: scale(1.1);
    }

    .card-title {
        font-family: 'Jost', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #1e3a8a;
        margin-bottom: 12px;
    }

    .card-desc {
        font-family: 'Jost', sans-serif;
        font-size: 14.5px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 25px;
    }

    .lms-card-arrow {
        width: 36px; 
        height: 36px; 
        border-radius: 50%;
        background: #eff6ff;
        display: flex; 
        align-items: center; 
        justify-content: center;
        color: #3b82f6;
        transition: all 0.3s ease;
        margin-top: auto;
    }
    
    .lms-card:hover .lms-card-arrow { 
        background: #3b82f6; 
        color: #fff;
        transform: translateX(4px);
    }
</style>

<div class="lms-wrapper">
    <div class="lms-hero">
        <!-- Floating Bubbles -->
        <div class="lms-bubble b1"></div>
        <div class="lms-bubble b2"></div>
        <div class="lms-bubble b3"></div>
        <div class="lms-bubble b4"></div>

        <!-- Navbar -->
        <div class="lms-navbar">
            <a href="#" class="lms-brand">
                <img src="@Url.Content("~/images/logo.jpg")" alt="EduDigiClass Logo" />
                <div class="lms-brand-text">
                    <span class="lms-brand-name">EduDigiClass</span>
                    <span class="lms-brand-tagline">Learn, Grow, Succeed</span>
                </div>
            </a>
            <div class="lms-nav-btns">
                <a href="#" class="lms-nav-btn">🌐 Language</a>
                <a href="#" class="lms-nav-btn">📱 Get App</a>
            </div>
        </div>

        <!-- Hero Text -->
        <div class="hero-text-container">
            <h1 class="hero-title">Online Learning Platform</h1>
            <p class="hero-desc">
                Welcome to EduDigiClass Digital Learning Environment –
                your gateway to courses, virtual classes, and educational resources, accessible anytime, anywhere.
            </p>
        </div>
    </div>

    <!-- Login Cards -->
    <div class="lms-cards-row">
        <a asp-controller="Auth" asp-action="Login" class="lms-card">
            <div class="lms-icon-wrap">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            </div>
            <div class="card-title">Student Login</div>
            <p class="card-desc">Log in to access your courses and academic resources</p>
            <div class="lms-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </a>

        <a asp-controller="Auth" asp-action="Login" class="lms-card">
            <div class="lms-icon-wrap">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div class="card-title">Faculty Login</div>
            <p class="card-desc">Log in to manage classes, evaluate students, and track progress</p>
            <div class="lms-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </a>

        <a asp-controller="Auth" asp-action="Login" class="lms-card">
            <div class="lms-icon-wrap">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
            </div>
            <div class="card-title">Administrative Login</div>
            <p class="card-desc">Enter the university's admin panel for system and process management</p>
            <div class="lms-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </a>
    </div>
</div>
