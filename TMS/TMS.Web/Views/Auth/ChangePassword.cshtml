@model TMS.Web.Models.ChangePasswordViewModel
@{
    Layout = "_LayoutEmpty";
    ViewData["Title"] = "Change Password";
}

<style>
    /* Hide the default logo from layout to avoid duplication */
    .empty-layout-logo-container { display: none !important; }

    body {
        margin: 0;
        min-height: 100vh;
        background-color: #f5f7fb;
        background-image: 
            radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.05) 0px, transparent 50%),
            radial-gradient(at 100% 0%, rgba(99, 102, 241, 0.05) 0px, transparent 50%);
        font-family: 'Jost', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cp-container {
        width: 100%;
        max-width: 450px;
        padding: 20px;
    }

    .cp-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        border: 1px solid #eef2f6;
        padding: 40px;
        position: relative;
    }

    .cp-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .cp-logo {
        height: 60px;
        margin-bottom: 20px;
        object-fit: contain;
    }

    .cp-title {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .cp-subtitle {
        font-size: 14px;
        color: #64748b;
        margin-top: 8px;
    }

    .cp-forced-banner {
        background: #fffbeb;
        border: 1px solid #fef3c7;
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 25px;
        display: flex;
        gap: 12px;
        align-items: center;
        color: #92400e;
        font-size: 13px;
        line-height: 1.4;
    }

    .cp-forced-banner i {
        color: #d97706;
        font-size: 18px;
    }

    .cp-form-group {
        margin-bottom: 22px;
    }

    .cp-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .cp-input-wrap {
        position: relative;
    }

    .cp-input {
        width: 100%;
        padding: 12px 45px 12px 15px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        color: #1e293b;
        font-size: 15px;
        transition: all 0.2s;
    }

    .cp-input:focus {
        outline: none;
        border-color: #3b82f6;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .cp-toggle-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 5px;
        transition: color 0.2s;
    }

    .cp-toggle-eye:hover {
        color: #64748b;
    }

    .cp-error {
        color: #ef4444;
        font-size: 12px;
        font-weight: 500;
        margin-top: 5px;
        display: block;
    }

    .cp-error-summary {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .cp-strength {
        height: 4px;
        background: #e2e8f0;
        border-radius: 2px;
        margin-top: 10px;
        display: flex;
        gap: 4px;
    }

    .cp-strength-bar {
        flex: 1;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .strength-0 .bar-0 { background: #ef4444; }
    .strength-1 .bar-0, .strength-1 .bar-1 { background: #f97316; }
    .strength-2 .bar-0, .strength-2 .bar-1, .strength-2 .bar-2 { background: #eab308; }
    .strength-3 .bar-0, .strength-3 .bar-1, .strength-3 .bar-2, .strength-3 .bar-3 { background: #22c55e; }

    .cp-requirements {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 10px;
    }

    .cp-req {
        font-size: 11px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
    }

    .cp-req.met {
        color: #10b981;
    }

    .cp-submit {
        width: 100%;
        padding: 14px;
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .cp-submit:hover {
        background: #2563eb;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
    }

    .cp-footer {
        text-align: center;
        margin-top: 25px;
    }

    .cp-footer a {
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: color 0.2s;
    }

    .cp-footer a:hover {
        color: #3b82f6;
    }
</style>

<div class="cp-container">
    <div class="cp-card">
        <div class="cp-header">
            <img src="~/images/logo.jpg" class="cp-logo" alt="LMS Logo" />
            <h2 class="cp-title">Update Password</h2>
            <p class="cp-subtitle">Secure your account with a new password</p>
        </div>

        @if (Model.IsForced)
        {
            <div class="cp-forced-banner">
                <i class="fas fa-exclamation-circle"></i>
                <div>
                    <strong>Security Requirement</strong><br />
                    Please update your temporary password to continue.
                </div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            var generalErrors = ViewData.ModelState[""]?.Errors;
            if (generalErrors != null && generalErrors.Count > 0)
            {
                <div class="cp-error-summary">
                    @foreach (var err in generalErrors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }
        }

        <form method="post" asp-action="ChangePassword" asp-controller="Auth" asp-area="">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsForced" />

            <div class="cp-form-group">
                <label class="cp-label">Current Password</label>
                <div class="cp-input-wrap">
                    <input asp-for="CurrentPassword" type="password" class="cp-input" placeholder="••••••••" id="passCurrent" />
                    <button type="button" class="cp-toggle-eye" onclick="togglePass('passCurrent', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="cp-error"></span>
            </div>

            <div class="cp-form-group">
                <label class="cp-label">New Password</label>
                <div class="cp-input-wrap">
                    <input asp-for="NewPassword" type="password" class="cp-input" placeholder="Min 8 chars, A-z, 0-9" id="passNew" />
                    <button type="button" class="cp-toggle-eye" onclick="togglePass('passNew', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="cp-error"></span>
                
                <div class="cp-strength" id="strengthBarContainer">
                    <div class="cp-strength-bar bar-0"></div>
                    <div class="cp-strength-bar bar-1"></div>
                    <div class="cp-strength-bar bar-2"></div>
                    <div class="cp-strength-bar bar-3"></div>
                </div>

                <div class="cp-requirements">
                    <span class="cp-req" id="req_len"><i class="fas fa-check-circle"></i> 8+ Characters</span>
                    <span class="cp-req" id="req_alphanumeric"><i class="fas fa-check-circle"></i> Alphanumeric</span>
                </div>
            </div>

            <div class="cp-form-group">
                <label class="cp-label">Confirm Password</label>
                <div class="cp-input-wrap">
                    <input asp-for="ConfirmPassword" type="password" class="cp-input" placeholder="••••••••" id="passConfirm" />
                    <button type="button" class="cp-toggle-eye" onclick="togglePass('passConfirm', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="cp-error"></span>
            </div>

            <button type="submit" class="cp-submit">
                <i class="fas fa-shield-alt"></i> Update Password
            </button>
        </form>

        @if (!Model.IsForced)
        {
            <div class="cp-footer">
                <a href="@Url.Action("Index", "Home")">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        document.getElementById('passNew').addEventListener('input', function() {
            const val = this.value;
            const hasLen = val.length >= 8;
            const hasNum = /\d/.test(val);
            const hasLetter = /[a-zA-Z]/.test(val);
            const hasSpecial = /[^A-Za-z0-9]/.test(val);

            // Requirements
            document.getElementById('req_len').classList.toggle('met', hasLen);
            document.getElementById('req_alphanumeric').classList.toggle('met', hasNum && hasLetter);

            // Strength
            let score = -1;
            if (val.length > 0) score = 0;
            if (hasLen) score++;
            if (hasNum && hasLetter) score++;
            if (hasSpecial || val.length >= 12) score++;

            const container = document.getElementById('strengthBarContainer');
            container.className = 'cp-strength strength-' + score;
        });
    </script>
}
