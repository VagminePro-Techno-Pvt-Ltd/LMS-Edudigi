@{
    Layout = "_LayoutEmpty"; 
    int step = ViewBag.Step ?? 1;
    string email = ViewBag.Email as string;
}

<div class="container mt-4">
    <div class="card shadow-lg p-4 position-relative" style="max-width: 450px; margin:auto;">
        <a href="/Auth/Login" class="text-decoration-none text-muted position-absolute" style="top: 15px; left: 15px; font-size: 14px;">
            &larr; Back
        </a>
        <h3 class="text-center mb-3 mt-2">
            @if (step == 1)
            {
                <text>Forgot Password</text>
            }
            @if (step == 2)
            {
                <text>Verify OTP</text>
            }
            @if (step == 3)
            {
                <text>Reset Password</text>
            }
        </h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <!-- STEP 1: ENTER EMAIL -->
        @if (step == 1)
        {
            <form method="post" action="/Auth/ForgotPassword">
                <div class="form-group">
                    <label>Email</label>
                    <input required class="form-control" name="email" />
                </div>

                <div class="text-center">
                    <button class="btn btn-primary btn-sm mt-3 px-4" style="border-radius:20px; font-weight:600;">Send OTP</button>
                </div>
            </form>
        }

        <!-- STEP 2: ENTER OTP -->
        @if (step == 2)
        {
            <form method="post" action="/Auth/VerifyOtp">
                <input type="hidden" name="email" value="@email" />

                <div class="form-group">
                    <label>Enter OTP</label>
                    <input required class="form-control" name="otp" />
                </div>

                <div class="text-center d-flex flex-column align-items-center gap-2">
                    <button class="btn btn-success btn-sm mt-3 px-4" style="border-radius:20px; font-weight:600;">Verify OTP</button>
                    <a href="/Auth/ForgotPasswordFlow?step=1" class="btn btn-link btn-sm text-decoration-none">Resend OTP</a>
                </div>
            </form>
        }

        <!-- STEP 3: RESET PASSWORD -->
        @if (step == 3)
        {
            <form method="post" action="/Auth/ResetPassword">
                <input type="hidden" name="email" value="@email" />

                <div class="form-group">
                    <label>New Password</label>
                    <input required type="password" class="form-control" name="newPassword" />
                </div>

              

                <div class="text-center">
                    <button class="btn btn-primary btn-sm mt-3 px-4" style="border-radius:20px; font-weight:600;">Reset Password</button>
                </div>
            </form>
        }
    </div>
</div>
