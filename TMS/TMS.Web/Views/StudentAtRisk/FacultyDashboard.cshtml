@model TMS.ViewModels.Academics.FacultyStudentRiskRosterViewModel
@{
    ViewData["Title"] = "Student At-Risk Management";
    var assignedCourses = ViewBag.AssignedCourses as List<TMS.Models.Masters.CourseMaster> ?? new List<TMS.Models.Masters.CourseMaster>();
    int selectedCourseId = ViewBag.SelectedCourseId != null ? (int)ViewBag.SelectedCourseId : Model.CourseId;
    string selectedType = ViewBag.SelectedActivityType as string ?? "All";
}

<style>
    .risk-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 60%, #3b82f6 100%);
        border-radius: 16px;
        padding: 24px 30px;
        color: #ffffff;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(37,99,235,0.15);
    }
    .risk-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .risk-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }
    .risk-badge-critical {
        background-color: #fee2e2;
        color: #dc2626;
        border: 1px solid #fca5a5;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .risk-badge-high {
        background-color: #ffedd5;
        color: #ea580c;
        border: 1px solid #fdba74;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .risk-badge-medium {
        background-color: #fef9c3;
        color: #ca8a04;
        border: 1px solid #fde047;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .risk-badge-low {
        background-color: #dcfce7;
        color: #16a34a;
        border: 1px solid #86efac;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .tab-btn {
        padding: 10px 20px;
        border: none;
        background: transparent;
        font-weight: 600;
        color: #64748b;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .tab-btn.active {
        color: #2563eb;
        border-bottom: 3px solid #2563eb;
        background: #f8fafc;
    }
    .custom-table th {
        background: #f8fafc;
        color: #475569;
        font-size: 12.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #e2e8f0;
    }
    .custom-table td {
        vertical-align: middle;
        font-size: 14px;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="risk-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-light text-primary mb-2 px-3 py-1 fw-bold" style="font-size:12px;">FACULTY MONITORING</span>
                <h2 class="h3 fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Student At-Risk & Activity Deadlines</h2>
                <p class="mb-0 text-white-50">Set activity deadlines, configure reminders, and monitor students approaching or missing deadlines.</p>
            </div>
            <!-- Course Selector Form -->
            <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 p-2 rounded-3 border border-white border-opacity-25">
                <label class="text-white fw-bold mb-0 small text-nowrap"><i class="fa-solid fa-book-open me-1"></i>Assigned Course:</label>
                <form method="get" asp-action="FacultyDashboard" id="courseSelectForm" class="m-0">
                    <select name="courseId" class="form-select form-select-sm border-0 fw-bold text-dark" style="min-width: 240px;" onchange="this.form.submit()">
                        @foreach (var c in assignedCourses)
                        {
                            <option value="@c.Id" selected="@(c.Id == selectedCourseId ? "selected" : null)">
                                @c.Name @(!string.IsNullOrEmpty(c.CourseCode) ? $"({c.CourseCode})" : "")
                            </option>
                        }
                    </select>
                    <input type="hidden" name="riskFilter" value="@Model.RiskFilter" />
                    <input type="hidden" name="search" value="@Model.SearchTerm" />
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.NoCourses == true)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 p-4">
            <h5 class="fw-bold"><i class="fa-solid fa-circle-info me-2"></i>No Mapped Courses Found</h5>
            <p class="mb-0">You currently have no courses assigned to your faculty profile. Please contact the administrator.</p>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="risk-card border-start border-danger border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Critical Risk</span>
                            <h3 class="fw-bold text-danger mb-0 mt-1">@Model.CriticalCount</h3>
                            <span class="text-muted" style="font-size:11px;">&ge; 2 missed deadlines</span>
                        </div>
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="width:52px; height:52px; background:#fee2e2 !important; border:1px solid #fca5a5;">
                            <i class="fa-solid fa-radiation fa-lg" style="color:#dc2626 !important;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="risk-card border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">High Risk</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1" style="color:#ea580c !important;">@Model.HighCount</h3>
                            <span class="text-muted" style="font-size:11px;">1 missed deadline</span>
                        </div>
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="width:52px; height:52px; background:#ffedd5 !important; border:1px solid #fed7aa;">
                            <i class="fa-solid fa-triangle-exclamation fa-lg" style="color:#ea580c !important;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="risk-card border-start border-info border-4" style="border-left-color: #f59e0b !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Medium Risk</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1" style="color:#ca8a04 !important;">@Model.MediumCount</h3>
                            <span class="text-muted" style="font-size:11px;">Deadline approaching</span>
                        </div>
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="width:52px; height:52px; background:#fef9c3 !important; border:1px solid #fde047;">
                            <i class="fa-solid fa-clock fa-lg" style="color:#ca8a04 !important;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="risk-card border-start border-success border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Low Risk / On Track</span>
                            <h3 class="fw-bold text-success mb-0 mt-1">@Model.LowCount</h3>
                            <span class="text-muted" style="font-size:11px;">All activities up to date</span>
                        </div>
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="width:52px; height:52px; background:#dcfce7 !important; border:1px solid #86efac;">
                            <i class="fa-solid fa-circle-check fa-lg" style="color:#16a34a !important;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Workspace Tabs -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-header bg-white border-bottom p-0 d-flex justify-content-between align-items-center">
                <div class="d-flex" role="tablist">
                    <button class="tab-btn active" id="tabActivitiesBtn" onclick="switchFacultyTab('activities')">
                        <i class="fa-solid fa-calendar-check me-2"></i>Course Activities &amp; Deadlines (@Model.Activities.Count)
                    </button>
                    <button class="tab-btn" id="tabRosterBtn" onclick="switchFacultyTab('roster')">
                        <i class="fa-solid fa-users-viewfinder me-2"></i>Student Risk Roster (@Model.Students.Count)
                    </button>
                </div>
                <div class="pe-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fw-semibold">
                        <i class="fa-solid fa-graduation-cap me-1"></i>@Model.CourseName
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- TAB 1: ACTIVITIES & DEADLINES -->
                <div id="tabActivitiesSection">
                    <!-- Filters -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small fw-bold">Filter Type:</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type active" onclick="filterActivityTable('All')">All</a>
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type" onclick="filterActivityTable('Video')">Videos</a>
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type" onclick="filterActivityTable('Pdf')">PDFs</a>
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type" onclick="filterActivityTable('Assignment')">Assignments</a>
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type" onclick="filterActivityTable('Quiz')">Quizzes</a>
                                <a href="javascript:void(0)" class="btn btn-outline-secondary btn-filter-type" onclick="filterActivityTable('Discussion')">Discussions</a>
                            </div>
                        </div>
                        <div>
                            <span class="text-muted small"><i class="fa-solid fa-circle-info text-primary me-1"></i>Deadlines set here generate student notifications and calculate academic risk.</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table custom-table" id="activitiesTable">
                            <thead>
                                <tr>
                                    <th>Activity Details</th>
                                    <th>Type</th>
                                    <th>Deadline</th>
                                    <th>Remaining Time</th>
                                    <th>Reminder Period</th>
                                    <th>Student Progress</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Activities.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No activities found for this course.</td>
                                    </tr>
                                }
                                @foreach (var act in Model.Activities)
                                {
                                    <tr data-type="@act.ActivityType">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (act.ActivityType == "Video")
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger p-2"><i class="fa-solid fa-play"></i></span>
                                                }
                                                else if (act.ActivityType == "Pdf")
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary p-2"><i class="fa-solid fa-file-pdf"></i></span>
                                                }
                                                else if (act.ActivityType == "Assignment")
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning p-2" style="color:#d97706 !important;"><i class="fa-solid fa-pen-to-square"></i></span>
                                                }
                                                else if (act.ActivityType == "Quiz")
                                                {
                                                    <span class="badge bg-info bg-opacity-10 text-info p-2"><i class="fa-solid fa-circle-question"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-purple bg-opacity-10 text-purple p-2" style="background:#f3e8ff; color:#7e22ce;"><i class="fa-solid fa-comments"></i></span>
                                                }
                                                <div>
                                                    <strong class="text-dark">@act.Title</strong>
                                                    <div class="text-muted small">@act.UnitOrQuadrant</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">@act.ActivityType</span>
                                        </td>
                                        <td>
                                            @if (act.DeadlineDate.HasValue)
                                            {
                                                <div class="fw-semibold text-dark">@act.DeadlineDate.Value.ToString("dd MMM yyyy")</div>
                                                <div class="text-muted small">@act.DeadlineDate.Value.ToString("hh:mm tt")</div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted">Not Set</span>
                                            }
                                        </td>
                                        <td>
                                            @if (act.DeadlineDate.HasValue)
                                            {
                                                if (act.IsOverdue)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-bold"><i class="fa-solid fa-circle-exclamation me-1"></i>@act.RemainingText</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info bg-opacity-10 text-primary fw-semibold"><i class="fa-regular fa-clock me-1"></i>@act.RemainingText</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@act.ReminderDaysBefore days</span>
                                            <span class="text-muted small">before deadline</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                    @{
                                                        int pct = act.TotalEnrolled > 0 ? (int)Math.Round((double)act.CompletedCount / act.TotalEnrolled * 100) : 0;
                                                    }
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%"></div>
                                                </div>
                                                <span class="small fw-semibold">@act.CompletedCount/@act.TotalEnrolled</span>
                                            </div>
                                            @if (act.OverdueCount > 0)
                                            {
                                                <div class="text-danger small mt-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>@act.OverdueCount Overdue</div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm"
                                                    onclick="openSetDeadlineModal('@act.ActivityType', @act.ActivityId, '@Html.Raw(act.Title.Replace("'", "\\'"))', '@(act.DeadlineDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @act.ReminderDaysBefore)">
                                                <i class="fa-solid fa-calendar-plus me-1"></i>Set / Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB 2: STUDENT RISK ROSTER -->
                <div id="tabRosterSection" style="display:none;">
                    <!-- Filter Toolbar -->
                    <form method="get" asp-action="FacultyDashboard" class="row g-2 mb-3">
                        <input type="hidden" name="courseId" value="@selectedCourseId" />
                        <div class="col-md-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" name="search" class="form-control" placeholder="Search student name or email..." value="@Model.SearchTerm" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="riskFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="All" selected="@(Model.RiskFilter == "All" ? "selected" : null)">All Risk Levels</option>
                                <option value="CRITICAL" selected="@(Model.RiskFilter == "CRITICAL" ? "selected" : null)">Critical (&ge; 2 missed)</option>
                                <option value="HIGH" selected="@(Model.RiskFilter == "HIGH" ? "selected" : null)">High (1 missed)</option>
                                <option value="MEDIUM" selected="@(Model.RiskFilter == "MEDIUM" ? "selected" : null)">Medium (Approaching)</option>
                                <option value="LOW" selected="@(Model.RiskFilter == "LOW" ? "selected" : null)">Low (On Track)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="fa-solid fa-filter me-1"></i>Apply</button>
                        </div>
                        <div class="col-md-3 text-end">
                            <a asp-action="FacultyDashboard" asp-route-courseId="@selectedCourseId" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-rotate-left me-1"></i>Reset
                            </a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table custom-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Risk Level</th>
                                    <th>Pending Activities</th>
                                    <th>Overdue (Missed)</th>
                                    <th>Completed</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Students.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No students matching the criteria.</td>
                                    </tr>
                                }
                                @foreach (var s in Model.Students)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar bg-light text-primary rounded-circle p-2 fw-bold" style="width:36px; height:36px; display:flex; align-items:center; justify-content:center;">
                                                    @(s.StudentName.Length > 0 ? s.StudentName.Substring(0, 1).ToUpper() : "S")
                                                </div>
                                                <div>
                                                    <strong class="text-dark">@s.StudentName</strong>
                                                    <div class="text-muted small">@s.StudentEmail</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (s.RiskLevel == "CRITICAL")
                                            {
                                                <span class="risk-badge-critical"><i class="fa-solid fa-radiation"></i> CRITICAL</span>
                                            }
                                            else if (s.RiskLevel == "HIGH")
                                            {
                                                <span class="risk-badge-high"><i class="fa-solid fa-triangle-exclamation"></i> HIGH</span>
                                            }
                                            else if (s.RiskLevel == "MEDIUM")
                                            {
                                                <span class="risk-badge-medium"><i class="fa-solid fa-clock"></i> MEDIUM</span>
                                            }
                                            else
                                            {
                                                <span class="risk-badge-low"><i class="fa-solid fa-circle-check"></i> LOW</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@s.PendingCount</span>
                                            <span class="text-muted small">/ @s.TotalActivities</span>
                                        </td>
                                        <td>
                                            @if (s.OverdueCount > 0)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-1">@s.OverdueCount missed</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">0</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">@s.CompletedCount completed</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                                    onclick="openStudentDetailsModal(@selectedCourseId, @s.StudentId)">
                                                <i class="fa-solid fa-chart-pie me-1"></i>View Details
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Set/Edit Deadline -->
<div class="modal fade" id="deadlineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold" id="deadlineModalTitle"><i class="fa-solid fa-calendar-check me-2"></i>Set Activity Deadline</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="deadlineForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalCourseId" value="@selectedCourseId" />
                    <input type="hidden" id="modalActivityType" value="" />
                    <input type="hidden" id="modalActivityId" value="" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Activity Title</label>
                        <input type="text" id="modalActivityTitle" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold">Deadline Date &amp; Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="modalDeadlineDate" class="form-control" required />
                        <div class="form-text text-muted">Students will receive upcoming and overdue alerts based on this date.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold">Reminder Window (Days Before)</label>
                        <select id="modalReminderDays" class="form-select">
                            <option value="1">1 Day Before</option>
                            <option value="2" selected>2 Days Before</option>
                            <option value="3">3 Days Before</option>
                            <option value="5">5 Days Before</option>
                            <option value="7">7 Days Before</option>
                        </select>
                        <div class="form-text text-muted">Approaching alerts trigger when deadline is within this window.</div>
                    </div>

                    <div id="deadlineAlertBox" class="alert alert-danger d-none py-2 px-3 small"></div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0 rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="saveDeadlineBtn" onclick="submitDeadlineForm()">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save Deadline
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Student Risk Detail -->
<div class="modal fade" id="studentDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-graduate me-2"></i>Student Activity &amp; Risk Breakdown</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="detailStudentName">Loading...</h5>
                        <div class="text-muted small" id="detailStudentEmail">...</div>
                    </div>
                    <div id="detailRiskBadge"></div>
                </div>

                <div class="table-responsive">
                    <table class="table custom-table" id="detailActivitiesTable">
                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Type</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th>Remaining / Overdue</th>
                            </tr>
                        </thead>
                        <tbody id="detailActivitiesBody">
                            <tr><td colspan="5" class="text-center py-3 text-muted">Loading activities...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function switchFacultyTab(tab) {
        if (tab === 'activities') {
            $('#tabActivitiesSection').show();
            $('#tabRosterSection').hide();
            $('#tabActivitiesBtn').addClass('active');
            $('#tabRosterBtn').removeClass('active');
        } else {
            $('#tabActivitiesSection').hide();
            $('#tabRosterSection').show();
            $('#tabActivitiesBtn').removeClass('active');
            $('#tabRosterBtn').addClass('active');
        }
    }

    function filterActivityTable(type) {
        $('.btn-filter-type').removeClass('active');
        $(`a[onclick="filterActivityTable('${type}')"]`).addClass('active');
        if (type === 'All') {
            $('#activitiesTable tbody tr').show();
        } else {
            $('#activitiesTable tbody tr').each(function() {
                var rowType = $(this).attr('data-type');
                if (rowType === type) $(this).show();
                else $(this).hide();
            });
        }
    }

    function openSetDeadlineModal(type, id, title, existingDate, reminderDays) {
        $('#modalActivityType').val(type);
        $('#modalActivityId').val(id);
        $('#modalActivityTitle').val(title);
        $('#modalReminderDays').val(reminderDays || 2);
        $('#deadlineAlertBox').addClass('d-none').text('');

        if (existingDate && existingDate.length >= 16) {
            $('#modalDeadlineDate').val(existingDate.substring(0, 16));
        } else {
            // Default 7 days from now
            var d = new Date();
            d.setDate(d.getDate() + 7);
            var iso = d.toISOString();
            $('#modalDeadlineDate').val(iso.substring(0, 16));
        }

        var modal = new bootstrap.Modal(document.getElementById('deadlineModal'));
        modal.show();
    }

    function submitDeadlineForm() {
        var courseId = parseInt($('#modalCourseId').val());
        var actType = $('#modalActivityType').val();
        var actId = parseInt($('#modalActivityId').val());
        var title = $('#modalActivityTitle').val();
        var dlDate = $('#modalDeadlineDate').val();
        var reminder = parseInt($('#modalReminderDays').val());

        if (!dlDate) {
            $('#deadlineAlertBox').removeClass('d-none').text('Please select a valid deadline date and time.');
            return;
        }

        var token = $('input[name="__RequestVerificationToken"]').val();

        var payload = {
            CourseId: courseId,
            ActivityType: actType,
            ActivityId: actId,
            ActivityTitle: title,
            DeadlineDate: dlDate,
            ReminderDaysBefore: reminder
        };

        $('#saveDeadlineBtn').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...');

        $.ajax({
            url: '/StudentAtRisk/SaveDeadline',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': token },
            data: JSON.stringify(payload),
            success: function(resp) {
                $('#saveDeadlineBtn').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i>Save Deadline');
                if (resp && resp.success) {
                    bootstrap.Modal.getInstance(document.getElementById('deadlineModal')).hide();
                    location.reload();
                } else {
                    $('#deadlineAlertBox').removeClass('d-none').text(resp.message || 'Error saving deadline.');
                }
            },
            error: function(err) {
                $('#saveDeadlineBtn').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i>Save Deadline');
                $('#deadlineAlertBox').removeClass('d-none').text('Server communication error. Please try again.');
            }
        });
    }

    function openStudentDetailsModal(courseId, studentId) {
        var modal = new bootstrap.Modal(document.getElementById('studentDetailModal'));
        modal.show();

        $('#detailStudentName').text('Loading...');
        $('#detailStudentEmail').text('');
        $('#detailRiskBadge').html('');
        $('#detailActivitiesBody').html('<tr><td colspan="5" class="text-center py-3 text-muted">Loading activities...</td></tr>');

        $.ajax({
            url: `/StudentAtRisk/GetStudentDetails?courseId=${courseId}&studentId=${studentId}`,
            type: 'GET',
            success: function(resp) {
                if (resp && resp.success && resp.data) {
                    var d = resp.data;
                    $('#detailStudentName').text(d.studentName);
                    $('#detailStudentEmail').text(d.studentEmail);

                    var badgeHtml = '';
                    if (d.riskLevel === 'CRITICAL') badgeHtml = '<span class="risk-badge-critical"><i class="fa-solid fa-radiation"></i> CRITICAL</span>';
                    else if (d.riskLevel === 'HIGH') badgeHtml = '<span class="risk-badge-high"><i class="fa-solid fa-triangle-exclamation"></i> HIGH</span>';
                    else if (d.riskLevel === 'MEDIUM') badgeHtml = '<span class="risk-badge-medium"><i class="fa-solid fa-clock"></i> MEDIUM</span>';
                    else badgeHtml = '<span class="risk-badge-low"><i class="fa-solid fa-circle-check"></i> LOW</span>';
                    $('#detailRiskBadge').html(badgeHtml);

                    var rows = '';
                    if (!d.activities || d.activities.length === 0) {
                        rows = '<tr><td colspan="5" class="text-center py-3 text-muted">No activities found for this course.</td></tr>';
                    } else {
                        d.activities.forEach(function(act) {
                            var statusBadge = '';
                            if (act.status === 'Completed') statusBadge = '<span class="badge bg-success bg-opacity-10 text-success fw-bold">Completed</span>';
                            else if (act.status === 'Overdue') statusBadge = '<span class="badge bg-danger bg-opacity-10 text-danger fw-bold">Overdue</span>';
                            else if (act.status === 'Approaching') statusBadge = '<span class="badge bg-warning bg-opacity-10 text-warning fw-bold" style="color:#ca8a04 !important;">Approaching</span>';
                            else statusBadge = '<span class="badge bg-light text-muted">On Track</span>';

                            var dlStr = act.deadlineDate ? new Date(act.deadlineDate).toLocaleString() : 'Not Set';

                            rows += `<tr>
                                <td><strong>${act.title}</strong></td>
                                <td><span class="badge bg-light text-secondary border">${act.activityType}</span></td>
                                <td><small class="text-muted">${dlStr}</small></td>
                                <td>${statusBadge}</td>
                                <td><small class="fw-semibold">${act.remainingText || '—'}</small></td>
                            </tr>`;
                        });
                    }
                    $('#detailActivitiesBody').html(rows);
                } else {
                    $('#detailActivitiesBody').html('<tr><td colspan="5" class="text-center py-3 text-danger">Failed to load student details.</td></tr>');
                }
            },
            error: function() {
                $('#detailActivitiesBody').html('<tr><td colspan="5" class="text-center py-3 text-danger">Server communication error.</td></tr>');
            }
        });
    }
</script>
}
