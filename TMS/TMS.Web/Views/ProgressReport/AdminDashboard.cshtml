@model TMS.ViewModels.AdminProgressDashboardViewModel
@{
    ViewData["Title"] = "Student Progress & Learning Analytics";
    var programs = ViewBag.Programs as List<TMS.Models.Masters.CourseCategoryMaster> ?? new List<TMS.Models.Masters.CourseCategoryMaster>();
    var courses = ViewBag.Courses as List<TMS.Models.Masters.CourseMaster> ?? new List<TMS.Models.Masters.CourseMaster>();
    int? selProg = ViewBag.SelectedProgramId as int?;
    int? selCourse = ViewBag.SelectedCourseId as int?;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .progress-hub {
        padding: 24px;
        background-color: #f8fafc;
        min-height: 100vh;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .stat-card-gradient-1 {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
    }
    .stat-card-gradient-2 {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
        color: white;
    }
    .stat-card-gradient-3 {
        background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        color: white;
    }
    .stat-card-gradient-4 {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
    }

    .analytics-card {
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .analytics-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .table-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .progress-bar-thin {
        height: 6px;
        border-radius: 999px;
        background-color: #e2e8f0;
        overflow: hidden;
    }

    .badge-excellent {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }
    .badge-ontrack {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }
    .badge-attention {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }
    .badge-notstarted {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #cbd5e1;
    }
</style>

<div class="progress-hub">
    <!-- Header & Filter Row -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase;">
                <i class="fa-solid fa-chart-pie"></i> Analytics &amp; Performance Hub
            </div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 24px; letter-spacing: -0.3px;">
                Student Progress &amp; Analytics
            </h2>
            <p class="text-muted small mb-0" style="font-size: 13.5px;">
                Track real-time learning engagement, video lecture consumption, quizzes, and cohort benchmarks.
            </p>
        </div>
        
        <!-- Filters Form -->
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center bg-white p-2 px-3 rounded-4 shadow-sm border">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-filter text-primary small"></i>
                <select name="programId" class="form-select form-select-sm border bg-light rounded-3 fw-semibold text-dark" style="min-width: 190px; font-size: 13px;" onchange="this.form.submit()">
                    <option value="">All Programs</option>
                    @foreach (var prog in programs)
                    {
                        <!option value="@prog.Id" @(selProg == prog.Id ? "selected" : "")>@prog.Name</!option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <select name="courseId" class="form-select form-select-sm border bg-light rounded-3 fw-semibold text-dark" style="min-width: 190px; font-size: 13px;" onchange="this.form.submit()">
                    <option value="">All Courses</option>
                    @foreach (var crs in courses)
                    {
                        <!option value="@crs.Id" @(selCourse == crs.Id ? "selected" : "")>@crs.Name</!option>
                    }
                </select>
            </div>

            <a href="@Url.Action("Index", "ProgressReport")" class="btn btn-light btn-sm rounded-3 text-secondary border" title="Reset Filters">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </form>
    </div>

    <!-- 4 High Impact Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="analytics-card stat-card-gradient-1 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-white-50 small fw-semibold text-uppercase">Total Students</span>
                        <h2 class="fw-bold mb-0 mt-1">@Model.TotalStudents</h2>
                        <small class="text-white-50">@Model.ActiveStudentsCount Active Learners</small>
                    </div>
                    <div style="background: rgba(255,255,255,0.2); width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px;">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="analytics-card stat-card-gradient-2 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-white-50 small fw-semibold text-uppercase">Average Progress</span>
                        <h2 class="fw-bold mb-0 mt-1">@Model.AverageProgress%</h2>
                        <small class="text-white-50">Classroom Performance</small>
                    </div>
                    <div style="background: rgba(255,255,255,0.2); width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px;">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="analytics-card stat-card-gradient-3 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-white-50 small fw-semibold text-uppercase">Video Watch Rate</span>
                        <h2 class="fw-bold mb-0 mt-1">@Model.VideoWatchRate%</h2>
                        <small class="text-white-50">E-Content Consumption</small>
                    </div>
                    <div style="background: rgba(255,255,255,0.2); width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px;">
                        <i class="fa-solid fa-circle-play"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="analytics-card stat-card-gradient-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-white-50 small fw-semibold text-uppercase">Reading Materials</span>
                        <h2 class="fw-bold mb-0 mt-1">@Model.StudyMaterialReadRate%</h2>
                        <small class="text-white-50">PDF &amp; Notes Read Rate</small>
                    </div>
                    <div style="background: rgba(255,255,255,0.2); width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px;">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Progress Roster Table -->
    <div class="table-card">
        <div class="p-3 px-4 border-bottom bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <div>
                <h5 class="fw-bold text-dark mb-0">Enrolled Students Progress Roster</h5>
                <small class="text-muted">Showing individual learning progress across study materials, video lectures, quizzes, and tasks.</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 260px;">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="rosterSearch" class="form-control border-0 bg-light" placeholder="Search student name / ID..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="progressTable">
                <thead style="background:#f8fafc; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; color:#64748b;">
                    <tr>
                        <th class="ps-4 py-3">Student</th>
                        <th class="py-3">Program / Course</th>
                        <th class="py-3" style="min-width: 130px;">PDF / Study Docs</th>
                        <th class="py-3" style="min-width: 130px;">Video Watched</th>
                        <th class="py-3" style="min-width: 130px;">Quizzes</th>
                        <th class="py-3" style="min-width: 130px;">Assignments</th>
                        <th class="py-3" style="min-width: 130px;">Overall Score</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody style="font-size: 13.5px;">
                    @if (!Model.StudentSummaries.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-chart-pie fa-3x mb-3 text-muted opacity-50 d-block"></i>
                                <strong>No student enrollments found.</strong>
                                <p class="small text-muted mb-0">Try changing the program or course filters above.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var student in Model.StudentSummaries)
                    {
                        <tr class="student-row">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                        @(student.StudentName.Length > 0 ? student.StudentName.Substring(0, 1).ToUpper() : "S")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark student-name">@student.StudentName</div>
                                        <div class="text-muted small">@student.EnrollmentNo</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@student.ProgramName</div>
                                <div class="text-muted small">@student.CourseName</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Docs/PDF</span>
                                    <span class="fw-bold text-dark">@student.StudyProgressPct%</span>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-primary" style="width: @student.StudyProgressPct%;"></div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Videos</span>
                                    <span class="fw-bold text-dark">@student.VideoProgressPct%</span>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-info" style="width: @student.VideoProgressPct%;"></div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Quizzes</span>
                                    <span class="fw-bold text-dark">@student.QuizProgressPct%</span>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-warning" style="width: @student.QuizProgressPct%;"></div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Assignments</span>
                                    <span class="fw-bold text-dark">@student.AssignmentProgressPct%</span>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-success" style="width: @student.AssignmentProgressPct%;"></div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Overall</span>
                                    <span class="fw-bold text-primary">@student.OverallProgressPct%</span>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-primary" style="width: @student.OverallProgressPct%;"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (student.StatusBadge == "Excellent")
                                {
                                    <span class="badge badge-excellent rounded-pill px-3 py-2 fw-semibold">
                                        <i class="fa-solid fa-star me-1"></i> Excellent
                                    </span>
                                }
                                else if (student.StatusBadge == "Needs Attention")
                                {
                                    <span class="badge badge-attention rounded-pill px-3 py-2 fw-semibold">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> At Risk
                                    </span>
                                }
                                else if (student.StatusBadge == "Not Started")
                                {
                                    <span class="badge badge-notstarted rounded-pill px-3 py-2 fw-semibold">
                                        Not Started
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-ontrack rounded-pill px-3 py-2 fw-semibold">
                                        <i class="fa-solid fa-circle-check me-1"></i> On Track
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Index", "ProgressReport", new { studentId = student.StudentId })" class="btn btn-outline-primary btn-sm rounded-3 px-3 fw-semibold">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('rosterSearch')?.addEventListener('input', function() {
            var filter = this.value.toLowerCase().trim();
            var rows = document.querySelectorAll('.student-row');
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
