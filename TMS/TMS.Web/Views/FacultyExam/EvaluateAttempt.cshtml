@model TMS.Models.Assessments.StudentExamAttempt

@{
    ViewData["Title"] = "Grading Console";
}

<div class="exam-page">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Page Header -->
            <div class="exam-page-header" style="margin-bottom:24px;">
                <div>
                    <h1>
                        <span class="header-icon" style="background:#f5f3ff; color:#7c3aed;">
                            <i class="fa-solid fa-pen-ruler"></i>
                        </span>
                        Grading Console
                    </h1>
                    <p>
                        Student: <strong style="color:#1e293b;">@Model.Student?.Name</strong> ·
                        Assessment: <strong style="color:#7c3aed;">@Model.Exam?.Title</strong>
                    </p>
                </div>
                <div class="header-actions">
                    <a asp-action="EvaluateList" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back to Desk
                    </a>
                </div>
            </div>

            <form asp-action="SaveEvaluation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="attemptId" value="@Model.Id" />

                <!-- Questions Stream -->
                <div style="display:flex; flex-direction:column; gap:20px; margin-bottom:28px;">
                    @for (int i = 0; i < Model.Exam?.QuestionMaps.Count; i++)
                    {
                        var map = Model.Exam.QuestionMaps.ElementAt(i);
                        var q = map.Question!;
                        var ans = Model.Answers.FirstOrDefault(a => a.QuestionId == q.Id);

                        <div class="exam-section-box" style="border-left:4px solid @(q.QuestionType == "Subjective" ? "#7c3aed" : "#3b82f6");">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px;">
                                <div>
                                    <span style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase;">
                                        Question @(i + 1) · <strong style="color:@(q.QuestionType == "Subjective" ? "#7c3aed" : "#3b82f6");">@q.QuestionType</strong>
                                    </span>
                                    <h4 style="font-size:15px; font-weight:700; color:#1e293b; margin:6px 0 0; line-height:1.5;">@q.QuestionText</h4>
                                </div>
                                <span style="background:#fef9c3; color:#92400e; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:700; white-space:nowrap;">
                                    Max: @q.Marks
                                </span>
                            </div>

                            @if (q.QuestionType == "MCQ")
                            {
                                <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:12px;">
                                    @foreach (var opt in q.Options)
                                    {
                                        var isSelected = ans?.SelectedOptionId == opt.Id;
                                        var isCorrectOpt = opt.IsCorrect;
                                        var bg = isCorrectOpt ? "#ecfdf5" : (isSelected && !isCorrectOpt) ? "#fef2f2" : "#f8fafc";
                                        var border = isCorrectOpt ? "#a7f3d0" : (isSelected && !isCorrectOpt) ? "#fecaca" : "#f1f5f9";

                                        <div style="display:flex; align-items:center; gap:10px; padding:10px 14px; background:@bg; border:1px solid @border; border-radius:8px;">
                                            @if (isCorrectOpt)
                                            {
                                                <i class="fa-solid fa-circle-check" style="color:#059669;"></i>
                                            }
                                            else if (isSelected)
                                            {
                                                <i class="fa-solid fa-circle-xmark" style="color:#ef4444;"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-circle" style="color:#cbd5e1;"></i>
                                            }
                                            <span style="font-size:13px; color:#1e293b;">@opt.OptionText</span>
                                            @if (isSelected)
                                            {
                                                <span style="font-size:10px; color:#64748b; margin-left:auto;">(Student)</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div style="font-size:13px; color:#64748b;">
                                    Auto-Graded: <strong style="color:@(ans?.IsCorrect == true ? "#059669" : "#ef4444");">@(ans?.ObtainedMarks ?? 0) Marks</strong>
                                </div>
                            }
                            else if (q.QuestionType == "Subjective")
                            {
                                <div style="padding:14px; background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; margin-bottom:14px;">
                                    <div style="font-size:11px; font-weight:600; color:#3b82f6; text-transform:uppercase; margin-bottom:6px;">Student Response:</div>
                                    <p style="font-size:13.5px; color:#1e293b; line-height:1.6; margin:0; white-space:pre-wrap; font-style:italic;">
                                        "@(string.IsNullOrWhiteSpace(ans?.SubjectiveAnswer) ? "[No answer submitted]" : ans.SubjectiveAnswer)"
                                    </p>
                                </div>

                                <!-- AI Evaluation Trigger & Assist Card -->
                                <div class="mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-ai-evaluate" data-qid="@q.Id" data-attempt="@Model.Id" style="border-radius:8px; font-weight:600; font-size:12px;">
                                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI Assist Evaluation
                                        </button>
                                        <span class="small text-muted" style="font-size:11px;">(Evaluates conceptual understanding against rubric using Gemini)</span>
                                    </div>

                                    <!-- Loading spinner -->
                                    <div id="aiLoading_@q.Id" class="d-none alert alert-info py-2 px-3 mb-2 text-center" style="font-size:12px; border-radius:8px;">
                                        <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>
                                        Evaluating conceptual understanding against rubric using Gemini...
                                    </div>

                                    <!-- Evaluation Results Card -->
                                    <div id="aiResultCard_@q.Id" class="d-none card border-primary border-opacity-25 mb-2" style="background:#f8fafc; border-radius:10px;">
                                        <div class="card-header bg-primary bg-opacity-10 py-2 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <strong class="text-primary small"><i class="fa-solid fa-shield-halved me-1"></i>Conceptual Evaluation</strong>
                                                <span id="aiThresholdBadge_@q.Id" class="badge bg-success" style="font-size:10px;">Threshold Met</span>
                                                <span id="aiConfidenceBadge_@q.Id" class="badge bg-secondary" style="font-size:10px;">Medium Confidence</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-success btn-apply-ai" data-qid="@q.Id" style="font-size:11px; font-weight:600; border-radius:6px; padding:3px 10px;">
                                                <i class="fa-solid fa-check me-1"></i>Apply Suggested Marks
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between small fw-semibold text-muted mb-1">
                                                    <span>Conceptual Match:</span>
                                                    <span id="aiMatchPct_@q.Id" class="fw-bold text-success">0%</span>
                                                </div>
                                                <div class="progress" style="height:6px;">
                                                    <div id="aiProgressBar_@q.Id" class="progress-bar bg-success" role="progressbar" style="width:0%"></div>
                                                </div>
                                            </div>
                                            <div class="row g-2 mb-2" style="font-size:12px;">
                                                <div class="col-md-6">
                                                    <div class="p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25 h-100">
                                                        <strong class="text-success d-block mb-1"><i class="fa-solid fa-thumbs-up me-1"></i>Demonstrated Strengths</strong>
                                                        <div id="aiStrengths_@q.Id" class="text-dark"></div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="p-2 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25 h-100">
                                                        <strong class="text-warning-emphasis d-block mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Missing Concepts</strong>
                                                        <div id="aiMissing_@q.Id" class="text-dark"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="p-2 rounded bg-white border" style="font-size:12px;">
                                                <strong class="text-primary d-block mb-1"><i class="fa-solid fa-comment-dots me-1"></i>Evaluation Feedback</strong>
                                                <div id="aiFeedback_@q.Id" class="text-dark"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div style="display:flex; align-items:center; gap:12px;">
                                    <label class="exam-label" style="margin:0; white-space:nowrap;">Allocate Score:</label>
                                    <input type="number" step="0.25" name="questionMarks[@q.Id]" id="inputMarks_@q.Id" class="exam-input marks-input" min="0" max="@q.Marks" value="@(ans?.ObtainedMarks ?? 0)" onchange="calculateGradedTotal()" required style="width:100px; text-align:center;" />
                                    <span style="font-size:13px; color:#64748b;">/ @q.Marks</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Evaluation Summary Panel -->
                <div class="exam-section-box" style="border:2px solid #e2e8f0;">
                    <div class="exam-section-title">
                        <span class="title-icon" style="background:#fef9c3; color:#ca8a04;">
                            <i class="fa-solid fa-clipboard-list"></i>
                        </span>
                        Evaluation Summary
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="exam-label">Subjective Marks Awarded</label>
                            <input type="number" step="0.5" name="totalMarksAwarded" id="totalMarksAwarded" class="exam-input" readonly value="0"
                                   style="font-size:22px; font-weight:800; color:#7c3aed; text-align:center;" />
                        </div>
                        <div class="col-md-8">
                            <label class="exam-label">Feedback Remarks</label>
                            <textarea name="feedback" class="exam-textarea" rows="2" placeholder="Overall guidance, improvement pointers..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div style="display:flex; justify-content:space-between; margin-top:24px; padding-top:20px; border-top:1px solid #e2e8f0;">
                    <a asp-action="EvaluateList" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </a>
                    <button type="submit" class="exam-btn exam-btn-success" style="padding:12px 32px;">
                        <i class="fa-solid fa-check-double"></i> Publish Evaluation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () { calculateGradedTotal(); });

    function calculateGradedTotal() {
        let total = 0;
        $(".marks-input").each(function () {
            total += parseFloat($(this).val()) || 0;
        });
        $("#totalMarksAwarded").val(total.toFixed(2));
    }

    let inFlightAiRequests = {};
    $(document).on('click', '.btn-ai-evaluate', function() {
        const qid = $(this).data('qid');
        const attemptId = $(this).data('attempt');
        const btn = $(this);

        if (inFlightAiRequests[qid]) return;
        inFlightAiRequests[qid] = true;

        btn.prop('disabled', true);
        $('#aiLoading_' + qid).removeClass('d-none');
        $('#aiResultCard_' + qid).addClass('d-none');

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("EvaluateSubjectiveAnswerAi", "FacultyExam")',
            type: 'POST',
            data: {
                attemptId: attemptId,
                questionId: qid,
                __RequestVerificationToken: token
            },
            success: function(res) {
                $('#aiLoading_' + qid).addClass('d-none');
                btn.prop('disabled', false);
                delete inFlightAiRequests[qid];

                if (res.success && res.evaluation) {
                    const ev = res.evaluation;
                    $('#aiMatchPct_' + qid).text(ev.conceptualMatchPercentage + '%');
                    $('#aiProgressBar_' + qid).css('width', ev.conceptualMatchPercentage + '%')
                        .removeClass('bg-success bg-danger')
                        .addClass(ev.thresholdMet ? 'bg-success' : 'bg-danger');

                    $('#aiThresholdBadge_' + qid)
                        .text(ev.thresholdMet ? 'Threshold Met (≥50%)' : 'Review Needed (<50%)')
                        .removeClass('bg-success bg-danger')
                        .addClass(ev.thresholdMet ? 'bg-success' : 'bg-danger');

                    $('#aiConfidenceBadge_' + qid).text((ev.confidence || 'Medium') + ' Confidence');
                    $('#aiStrengths_' + qid).text(ev.strengths || 'None noted');
                    $('#aiMissing_' + qid).text(ev.missingConcepts || 'None');
                    $('#aiFeedback_' + qid).text(ev.feedback || 'Evaluated conceptually against rubric.');

                    $('#aiResultCard_' + qid).removeClass('d-none');

                    // Store suggested marks for apply button
                    btn.data('suggestedMarks', ev.suggestedMarks);
                    btn.data('suggestedFeedback', ev.feedback);
                } else {
                    alert(res.errorMessage || 'AI evaluation was unable to process this response.');
                }
            },
            error: function() {
                $('#aiLoading_' + qid).addClass('d-none');
                btn.prop('disabled', false);
                delete inFlightAiRequests[qid];
                alert('Server error executing AI evaluation.');
            }
        });
    });

    $(document).on('click', '.btn-apply-ai', function() {
        const qid = $(this).data('qid');
        const btn = $('.btn-ai-evaluate[data-qid="' + qid + '"]');
        const suggested = btn.data('suggestedMarks');
        const feedback = btn.data('suggestedFeedback');

        if (suggested !== undefined) {
            $('#inputMarks_' + qid).val(suggested);
            calculateGradedTotal();
        }
        if (feedback) {
            const currentFb = $('textarea[name="feedback"]').val();
            if (!currentFb) {
                $('textarea[name="feedback"]').val(`Q${qid}: ${feedback}`);
            } else if (!currentFb.includes(`Q${qid}:`)) {
                $('textarea[name="feedback"]').val(currentFb + `\nQ${qid}: ${feedback}`);
            }
        }
    });
</script>
}
