@model TMS.Models.Assessments.ExamMaster

@{
    ViewData["Title"] = "Create New Assessment";
}

<div class="exam-page">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- Page Header -->
            <div class="exam-page-header" style="margin-bottom:24px;">
                <div>
                    <h1>
                        <span class="header-icon" style="background:#ecfdf5; color:#059669;">
                            <i class="fa-solid fa-plus-circle"></i>
                        </span>
                        Create Assessment
                    </h1>
                    <p>Define the core settings, timers, and active windows for the examination.</p>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                </div>
            </div>

            <!-- Form -->
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>

                <div class="row g-4">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="exam-section-box">
                            <div class="exam-section-title">
                                <span class="title-icon" style="background:#eff6ff; color:#3b82f6;">
                                    <i class="fa-solid fa-file-lines"></i>
                                </span>
                                Assessment Details
                            </div>

                            <div style="margin-bottom:16px;">
                                <label asp-for="Title" class="exam-label">Assessment Title</label>
                                <input asp-for="Title" class="exam-input" placeholder="e.g. Mid-Term Examination 2026" required />
                                <span asp-validation-for="Title" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div style="margin-bottom:16px;">
                                <label asp-for="CourseId" class="exam-label">Map to Course</label>
                                <select asp-for="CourseId" class="exam-select" asp-items="ViewBag.Courses" required>
                                    <option value="">-- Select Course --</option>
                                </select>
                                <span asp-validation-for="CourseId" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Description" class="exam-label">Guidelines / Description</label>
                                <textarea asp-for="Description" class="exam-textarea" rows="4" placeholder="Instructions shown to candidates..."></textarea>
                                <span asp-validation-for="Description" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="exam-section-box">
                            <div class="exam-section-title">
                                <span class="title-icon" style="background:#fff7ed; color:#ea580c;">
                                    <i class="fa-solid fa-sliders"></i>
                                </span>
                                Configuration
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label asp-for="DurationMinutes" class="exam-label">Duration (Min)</label>
                                    <input asp-for="DurationMinutes" type="number" class="exam-input" min="1" max="600" required />
                                </div>
                                <div class="col-6">
                                    <label asp-for="AllowedAttempts" class="exam-label">Allowed Attempts</label>
                                    <input asp-for="AllowedAttempts" type="number" class="exam-input" min="1" max="10" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label asp-for="TotalMarks" class="exam-label">Total Marks</label>
                                    <input asp-for="TotalMarks" type="number" step="0.5" class="exam-input" required />
                                </div>
                                <div class="col-6">
                                    <label asp-for="PassingMarks" class="exam-label">Passing Score (%)</label>
                                    <input asp-for="PassingMarks" type="number" class="exam-input" min="1" max="100" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label asp-for="StartDate" class="exam-label">Start Window</label>
                                    <input asp-for="StartDate" type="datetime-local" class="exam-input" required />
                                </div>
                                <div class="col-6">
                                    <label asp-for="EndDate" class="exam-label">End Window</label>
                                    <input asp-for="EndDate" type="datetime-local" class="exam-input" required />
                                </div>
                            </div>

                            <!-- Toggles -->
                            <div style="margin-top:16px; display:flex; flex-direction:column; gap:12px;">
                                <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                                    <label asp-for="ShuffleQuestions" style="margin:0; font-size:13px; font-weight:600; color:#1e293b;">Shuffle Questions</label>
                                    <label class="exam-toggle">
                                        <input asp-for="ShuffleQuestions" type="checkbox" />
                                        <span class="exam-toggle-slider"></span>
                                    </label>
                                </div>
                                <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                                    <label asp-for="ShowResultImmediately" style="margin:0; font-size:13px; font-weight:600; color:#1e293b;">Publish Results Instantly</label>
                                    <label class="exam-toggle">
                                        <input asp-for="ShowResultImmediately" type="checkbox" />
                                        <span class="exam-toggle-slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px; padding-top:24px; border-top:1px solid #e2e8f0;">
                    <a asp-action="Index" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="exam-btn exam-btn-primary" style="padding:12px 32px;">
                        Save & Proceed <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
