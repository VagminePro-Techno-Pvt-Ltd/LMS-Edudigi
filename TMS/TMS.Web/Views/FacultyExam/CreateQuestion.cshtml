@model TMS.Models.Assessments.QuestionBank

@{
    ViewData["Title"] = "Create Question";
}

<div class="exam-page">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- Page Header -->
            <div class="exam-page-header" style="margin-bottom:24px;">
                <div>
                    <h1>
                        <span class="header-icon" style="background:#ecfdf5; color:#059669;">
                            <i class="fa-solid fa-circle-plus"></i>
                        </span>
                        Question Creator
                    </h1>
                    <p>Construct reusable MCQ or descriptive subjective questions for your assessments.</p>
                </div>
                <div class="header-actions">
                    <a asp-action="QuestionBank" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Question Bank
                    </a>
                </div>
            </div>

            <form asp-action="CreateQuestion" method="post" id="question-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>

                <div class="row g-4">
                    <!-- Left: Core Fields -->
                    <div class="col-md-6">
                        <div class="exam-section-box">
                            <div class="exam-section-title">
                                <span class="title-icon" style="background:#eff6ff; color:#3b82f6;">
                                    <i class="fa-solid fa-sliders"></i>
                                </span>
                                Question Settings
                            </div>

                            <div style="margin-bottom:16px;">
                                <label asp-for="CourseId" class="exam-label">Map to Course</label>
                                <select asp-for="CourseId" class="exam-select" asp-items="ViewBag.Courses" required>
                                    <option value="">-- Select Course --</option>
                                </select>
                                <span asp-validation-for="CourseId" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div style="margin-bottom:16px;">
                                <label asp-for="QuestionType" class="exam-label">Question Format</label>
                                <select asp-for="QuestionType" class="exam-select" id="q-type-select" required>
                                    <option value="MCQ">Multiple Choice (MCQ)</option>
                                    <option value="Subjective">Descriptive / Subjective</option>
                                </select>
                            </div>

                            <div class="row g-3" style="margin-bottom:16px;">
                                <div class="col-6">
                                    <label asp-for="Marks" class="exam-label">Base Marks</label>
                                    <input asp-for="Marks" type="number" step="0.5" class="exam-input" min="0.5" max="100" required />
                                </div>
                                <div class="col-6" id="negative-marks-container">
                                    <label asp-for="NegativeMarks" class="exam-label">Negative Penalty</label>
                                    <input asp-for="NegativeMarks" type="number" step="0.25" class="exam-input" min="0" max="50" required />
                                </div>
                            </div>

                            <div>
                                <label asp-for="DifficultyLevel" class="exam-label">Difficulty</label>
                                <select asp-for="DifficultyLevel" class="exam-select" required>
                                    <option value="Easy">Easy</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="Hard">Hard</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Question Text -->
                    <div class="col-md-6">
                        <div class="exam-section-box">
                            <div class="exam-section-title">
                                <span class="title-icon" style="background:#f5f3ff; color:#7c3aed;">
                                    <i class="fa-solid fa-pen-nib"></i>
                                </span>
                                Question Content
                            </div>

                            <div style="margin-bottom:16px;">
                                <label asp-for="QuestionText" class="exam-label">Question Stem</label>
                                <textarea asp-for="QuestionText" class="exam-textarea" rows="5" placeholder="Type the question..." required></textarea>
                                <span asp-validation-for="QuestionText" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Explanation" class="exam-label">Explanation (shown in review)</label>
                                <textarea asp-for="Explanation" class="exam-textarea" rows="4" placeholder="Explain the rationale behind the correct answer..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MCQ Options Block -->
                <div class="exam-section-box mt-4" id="options-block">
                    <div class="exam-section-title">
                        <span class="title-icon" style="background:#fef9c3; color:#ca8a04;">
                            <i class="fa-solid fa-list-ol"></i>
                        </span>
                        Option Generator
                        <span style="font-size:12px; font-weight:400; color:#64748b; margin-left:auto;">Check the correct answer</span>
                    </div>

                    <div id="options-container" style="display:flex; flex-direction:column; gap:12px;">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="option-row" style="display:flex; align-items:center; gap:12px; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                                <label style="margin:0; display:flex; align-items:center; cursor:pointer;">
                                    <input type="checkbox" name="correctIndices" value="@i" style="width:18px; height:18px; accent-color:#059669; cursor:pointer;" />
                                </label>
                                <span style="font-size:13px; font-weight:700; color:#3b82f6; min-width:24px;">@((char)('A' + i))</span>
                                <input type="text" name="optionText" class="exam-input" placeholder="Option @(i + 1) text..." style="flex:1;" />
                            </div>
                        }
                    </div>
                    <button type="button" class="exam-btn exam-btn-secondary exam-btn-sm" style="margin-top:14px;" onclick="addOptionRow()">
                        <i class="fa-solid fa-plus"></i> Add Option
                    </button>
                </div>

                <!-- Actions -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:24px; padding-top:24px; border-top:1px solid #e2e8f0; gap:16px;">
                    <a asp-action="QuestionBank" class="exam-btn exam-btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <div style="display:flex; gap:12px;">
                        <button type="submit" name="submitAction" value="saveAndAddAnother" class="exam-btn" style="background:#eafaf1; color:#0f5132; border:1px solid #d1e7dd; padding:12px 24px; font-weight:600; border-radius:8px; display:flex; align-items:center; gap:8px;">
                            <i class="fa-solid fa-circle-plus"></i> Save &amp; Add Another
                        </button>
                        <button type="submit" name="submitAction" value="saveAndClose" class="exam-btn exam-btn-primary" style="padding:12px 32px;">
                            <i class="fa-solid fa-floppy-disk"></i> Save &amp; Close
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $("#q-type-select").change(function () {
            if ($(this).val() === "Subjective") {
                $("#options-block").slideUp(300);
                $("#negative-marks-container").slideUp(300);
            } else {
                $("#options-block").slideDown(300);
                $("#negative-marks-container").slideDown(300);
            }
        });

        // Trigger change on load to set initial state correctly
        $("#q-type-select").trigger('change');
    });

    let optionCount = 4;
    function addOptionRow() {
        let letter = String.fromCharCode(65 + optionCount);
        let html = `<div class="option-row" style="display:flex; align-items:center; gap:12px; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
            <label style="margin:0; display:flex; align-items:center; cursor:pointer;">
                <input type="checkbox" name="correctIndices" value="${optionCount}" style="width:18px; height:18px; accent-color:#059669; cursor:pointer;" />
            </label>
            <span style="font-size:13px; font-weight:700; color:#3b82f6; min-width:24px;">${letter}</span>
            <input type="text" name="optionText" class="exam-input" placeholder="Option ${optionCount + 1} text..." style="flex:1;" />
        </div>`;
        $("#options-container").append(html);
        optionCount++;
    }
</script>
}
