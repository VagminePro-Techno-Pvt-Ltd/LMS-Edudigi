@model TMS.Models.Assessments.ExamMaster

@{
    ViewData["Title"] = "Configure Exam";
}

<div class="exam-page">
    <div class="exam-page-header" style="margin-bottom:24px;">
        <div>
            <h1>
                <span class="header-icon" style="background:#f5f3ff; color:#7c3aed;">
                    <i class="fa-solid fa-gear"></i>
                </span>
                Configure Assessment
            </h1>
            <p>Update settings, schedules, and manage exam sections.</p>
        </div>
        <div class="header-actions">
            <a asp-action="Index" class="exam-btn exam-btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Core Config -->
        <div class="col-lg-7">
            <div class="exam-section-box">
                <div class="exam-section-title">
                    <span class="title-icon" style="background:#eff6ff; color:#3b82f6;">
                        <i class="fa-solid fa-sliders"></i>
                    </span>
                    Core Exam Configuration
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" id="examId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Title" class="exam-label">Exam Title</label>
                            <input asp-for="Title" class="exam-input" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CourseId" class="exam-label">Course</label>
                            <select asp-for="CourseId" class="exam-select" asp-items="ViewBag.Courses" required></select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="DurationMinutes" class="exam-label">Duration (Min)</label>
                            <input asp-for="DurationMinutes" type="number" class="exam-input" required />
                        </div>
                        <div class="col-6">
                            <label asp-for="AllowedAttempts" class="exam-label">Attempts</label>
                            <input asp-for="AllowedAttempts" type="number" class="exam-input" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="TotalMarks" class="exam-label">Total Marks</label>
                            <input asp-for="TotalMarks" type="number" step="0.5" class="exam-input" required />
                        </div>
                        <div class="col-6">
                            <label asp-for="PassingMarks" class="exam-label">Passing (%)</label>
                            <input asp-for="PassingMarks" type="number" class="exam-input" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="StartDate" class="exam-label">Start</label>
                            <input asp-for="StartDate" type="datetime-local" class="exam-input" required />
                        </div>
                        <div class="col-6">
                            <label asp-for="EndDate" class="exam-label">End</label>
                            <input asp-for="EndDate" type="datetime-local" class="exam-input" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="exam-label">Status</label>
                            <select asp-for="Status" class="exam-select" required>
                                <option value="Draft">Draft</option>
                                <option value="Active">Active</option>
                                <option value="Archived">Archived</option>
                            </select>
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                            <label asp-for="ShuffleQuestions" style="margin:0; font-size:13px; font-weight:600; color:#1e293b;">Shuffle Questions</label>
                            <label class="exam-toggle">
                                <input asp-for="ShuffleQuestions" type="checkbox" />
                                <span class="exam-toggle-slider"></span>
                            </label>
                        </div>
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                            <label asp-for="ShowResultImmediately" style="margin:0; font-size:13px; font-weight:600; color:#1e293b;">Publish Instantly</label>
                            <label class="exam-toggle">
                                <input asp-for="ShowResultImmediately" type="checkbox" />
                                <span class="exam-toggle-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div style="display:flex; justify-content:space-between; padding-top:16px; border-top:1px solid #e2e8f0;">
                        <a asp-action="Index" class="exam-btn exam-btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
                        <button type="submit" class="exam-btn exam-btn-primary"><i class="fa-solid fa-floppy-disk"></i> Update Config</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: Section Manager -->
        <div class="col-lg-5">
            <div class="exam-section-box">
                <div class="exam-section-title">
                    <span class="title-icon" style="background:#fff7ed; color:#ea580c;">
                        <i class="fa-solid fa-folder-open"></i>
                    </span>
                    Exam Sections
                </div>

                <div id="sections-container" style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
                    @if (Model.Sections == null || !Model.Sections.Any())
                    {
                        <div style="text-align:center; padding:30px; color:#94a3b8; font-size:13px;">
                            <i class="fa-regular fa-folder-open" style="font-size:32px; display:block; margin-bottom:10px; opacity:0.3;"></i>
                            No sections defined yet.
                        </div>
                    }
                    else
                    {
                        @foreach (var s in Model.Sections.OrderBy(sec => sec.DisplayOrder))
                        {
                            <div class="section-item" id="section-row-@s.Id" style="display:flex; justify-content:space-between; align-items:center; padding:14px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                                <div>
                                    <strong style="color:#1e293b;">@s.SectionName</strong>
                                    <div style="font-size:11px; color:#64748b; margin-top:2px;">Q: @s.TotalQuestions · Marks: @s.TotalMarks</div>
                                    <span style="background:#f5f3ff; color:#7c3aed; padding:2px 8px; border-radius:4px; font-size:10px; font-weight:700; margin-top:4px; display:inline-block;">@s.QuestionMaps.Count Mapped</span>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <a asp-action="MapQuestions" asp-route-examId="@Model.Id" asp-route-sectionId="@s.Id" class="exam-btn exam-btn-sm" style="background:#eff6ff; color:#3b82f6 !important; border:1px solid #bfdbfe;">
                                        <i class="fa-solid fa-link"></i>
                                    </a>
                                    <button class="exam-btn exam-btn-sm exam-btn-danger" onclick="deleteSection(@s.Id)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Section Adder -->
                <div style="padding:16px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0;">
                    <h5 style="font-size:14px; font-weight:700; color:#1e293b; margin:0 0 12px;">Add Section</h5>
                    <div style="margin-bottom:10px;">
                        <input type="text" id="new-section-name" class="exam-input" placeholder="Section Name (e.g. Section A: MCQ)" />
                    </div>
                    <div class="row g-2" style="margin-bottom:10px;">
                        <div class="col-6">
                            <input type="number" id="new-section-questions" class="exam-input" placeholder="Questions" />
                        </div>
                        <div class="col-6">
                            <input type="number" id="new-section-marks" class="exam-input" placeholder="Marks" />
                        </div>
                    </div>
                    <button class="exam-btn exam-btn-primary exam-btn-block" onclick="addSection()">
                        <i class="fa-solid fa-plus"></i> Create Section
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function addSection() {
        let examId = $("#examId").val();
        let name = $("#new-section-name").val();
        let questions = $("#new-section-questions").val();
        let marks = $("#new-section-marks").val();
        if (!name || !questions || !marks) { alert("Please fill all section fields!"); return; }
        $.post("/FacultyExam/AddSection", {
            examId: examId, sectionName: name, totalQuestions: questions, totalMarks: marks, displayOrder: 1
        }, function (res) {
            if (res.success) { location.reload(); } else { alert("Failed to add section."); }
        });
    }

    function deleteSection(id) {
        if (confirm("Delete this section? Mapped questions will be detached.")) {
            $.post("/FacultyExam/DeleteSection", { sectionId: id }, function (res) {
                if (res.success) { $(`#section-row-${id}`).fadeOut(300, function () { $(this).remove(); }); }
                else { alert("Failed to delete section."); }
            });
        }
    }
</script>
}
