@model IEnumerable<TMS.Models.Academics.InternalAssessment>
@using TMS.Models.Academics
@using TMS.Web.Services
@{
    ViewData["Title"] = "Internal Assessments";
    var submissions = ViewBag.Submissions as List<InternalAssessmentSubmission> ?? new();
    var courses = ViewBag.Courses as Dictionary<int,string> ?? new();
    var questionCounts = ViewBag.QuestionCounts as Dictionary<int,int> ?? new();
    var activeCourseIds = ViewBag.ActiveCourseIds as HashSet<int> ?? new();
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Internal Assessments</h2><p class="text-muted">Submit work and view published results.</p></div><a class="btn btn-outline-secondary" href="/StudentExam/Index">Back to Assessments &amp; Exams</a></div>
    @if(TempData["IA_Message"] != null){<div class="alert alert-success">@TempData["IA_Message"]</div>}
    @if(!Model.Any()){<div class="alert alert-info">No internal assessments assigned to your enrolled courses yet.</div>}
    <div class="row g-3">
    @foreach(var a in Model){
        var sub=submissions.FirstOrDefault(s=>s.AssessmentId==a.Id);
        var evaluated = sub?.Marks.HasValue == true && sub.EvaluatedBy.HasValue && sub.EvaluatedOn.HasValue;
        var submissionStatus = a.ResultsPublished
            ? InternalAssessmentResultPolicy.SubmissionStatus(sub != null, evaluated)
            : sub == null ? "NOT SUBMITTED" : evaluated ? "SUBMITTED" : "PENDING";
        var outcome = InternalAssessmentResultPolicy.AssessmentOutcome(a.ResultsPublished, sub != null, evaluated, sub?.Marks, a.MaxMarks);
        var canSubmit = activeCourseIds.Contains(a.CourseId) && !a.ResultsPublished;
        <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2"><span class="badge bg-primary">@a.Type</span><span><span class="badge @(submissionStatus == "ABSENT" ? "bg-danger" : submissionStatus == "SUBMITTED" ? "bg-success" : "bg-warning text-dark")">Submission: @submissionStatus</span> <span class="badge @(outcome == "PASS" ? "bg-success" : outcome == "FAIL" ? "bg-danger" : "bg-warning text-dark")">Outcome: @outcome</span></span></div>
            <h4 class="mt-3">@a.Title</h4><p class="text-muted">@(courses.GetValueOrDefault(a.CourseId,"Course"))</p>
            <p style="white-space:pre-wrap">@a.Instructions</p><p><strong>Due:</strong> @a.DueDate.ToString("dd MMM yyyy hh:mm tt") &nbsp; <strong>Max marks:</strong> @a.MaxMarks</p>
            @if(sub!=null){
                <p class="text-success">Submitted @sub.SubmittedOn.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") @(sub.IsLate?"(Late)":"")</p>
                @if(a.ResultsPublished && evaluated){<div class="alert alert-primary"><strong>Marks:</strong> @sub.Marks / @a.MaxMarks<br/><strong>Result:</strong> @outcome<br/><strong>Feedback:</strong> @sub.Feedback</div>}
                else {<div class="alert alert-secondary">@(sub.Marks.HasValue?"Result not published yet.":"Awaiting faculty evaluation.")</div>}
            } else if(a.ResultsPublished){
                <div class="alert alert-danger"><strong>ABSENT</strong><br/>Marks: 0 / @a.MaxMarks<br/>Result: FAIL</div>
            } else if(!canSubmit){
                <div class="alert alert-secondary">Historical assessment. New submissions require an active enrollment.</div>
            } else if(questionCounts.GetValueOrDefault(a.Id)>0){
                <a class="btn btn-primary" asp-action="Attempt" asp-route-id="@a.Id">Answer Questions</a>
            } else if(a.DueDate >= DateTime.Now || a.AllowLateSubmission){
                <form method="post" asp-controller="InternalAssessment" asp-action="Submit" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id" />
                    <label class="form-label">Your answer / notes</label><textarea name="answerText" maxlength="10000" rows="3" class="form-control mb-2"></textarea>
                    <label class="form-label">Attachment (optional, max 8 MB)</label><input type="file" name="attachment" accept=".pdf,.docx,.pptx,.jpg,.jpeg,.png" class="form-control mb-3" />
                    <button class="btn btn-primary" type="submit">Submit Internal Assessment</button>
                </form>
            }else{<div class="alert alert-danger">Deadline passed.</div>}
        </div></div></div>
    }
    </div>
</div>
