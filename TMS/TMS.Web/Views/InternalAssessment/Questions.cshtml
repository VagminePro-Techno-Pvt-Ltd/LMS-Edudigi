@model IEnumerable<TMS.Models.Academics.InternalAssessmentQuestion>
@using TMS.Models.Academics
@{ var a=(InternalAssessment)ViewBag.Assessment; var selected=a.Type.Split(','); var total=Model.Sum(q=>q.Marks); ViewData["Title"]="Manage Questions"; }
<div class="container-fluid py-4"><a asp-action="FacultyDashboard" class="btn btn-outline-secondary mb-3">Back</a><h2>@a.Title — Manage Questions</h2>
<div class="alert @(total==a.MaxMarks?"alert-success":"alert-warning")">Question marks: <strong>@total / @a.MaxMarks</strong>. Total must equal maximum marks before publishing.</div>
@if(a.IsPublished){<div class="alert alert-info">Unpublish assessment to edit questions.</div>}
@foreach(var q in Model){<div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between"><strong>@q.Type — @q.Marks marks</strong><span>Question #@q.Id</span></div><p style="white-space:pre-wrap">@q.Text</p>
@if(q.Type=="MCQ"){<p>A. @q.OptionA | B. @q.OptionB | C. @q.OptionC | D. @q.OptionD<br/>Correct: @q.CorrectOption</p>}
@if(!a.IsPublished){<details><summary>Edit question</summary><form asp-action="SaveQuestion" method="post" class="row g-2 mt-2">@Html.AntiForgeryToken()<input type="hidden" name="assessmentId" value="@a.Id"/><input type="hidden" name="questionId" value="@q.Id"/><div class="col-md-3"><select name="type" class="form-select">@foreach(var t in selected){if(t==q.Type){<option selected>@t</option>}else{<option>@t</option>}}</select></div><div class="col-md-9"><textarea name="text" class="form-control" required maxlength="4000">@q.Text</textarea></div><div class="col-md-3"><input type="number" name="marks" class="form-control" step="0.01" min="0.01" value="@q.Marks" required/></div><div class="col-md-9"><input name="optionA" value="@q.OptionA" placeholder="MCQ Option A" class="form-control"/><input name="optionB" value="@q.OptionB" placeholder="MCQ Option B" class="form-control"/><input name="optionC" value="@q.OptionC" placeholder="MCQ Option C" class="form-control"/><input name="optionD" value="@q.OptionD" placeholder="MCQ Option D" class="form-control"/><select name="correctOption" class="form-select"><option value="">MCQ correct option</option>@foreach(var c in new[]{"A","B","C","D"}){if(q.CorrectOption==c){<option selected>@c</option>}else{<option>@c</option>}}</select></div><div class="col-12"><button class="btn btn-primary">Save Changes</button></div></form></details><form asp-action="DeleteQuestion" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@q.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete question?')">Delete</button></form>}
</div></div>}
@if(!a.IsPublished){<div class="card"><div class="card-body"><h4>Add Question</h4><form asp-action="SaveQuestion" method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" name="assessmentId" value="@a.Id"/><div class="col-md-4"><label>Section / Type</label><select name="type" class="form-select" required>@foreach(var t in selected){<option>@t</option>}</select></div><div class="col-md-4"><label>Marks for this question</label><input type="number" name="marks" step="0.01" min="0.01" max="@a.MaxMarks" class="form-control" required/></div><div class="col-12"><label>Question / Task</label><textarea name="text" maxlength="4000" class="form-control" required rows="3"></textarea></div><div class="col-md-6"><label>MCQ options (only for MCQ)</label><input name="optionA" placeholder="Option A" class="form-control mb-1"/><input name="optionB" placeholder="Option B" class="form-control mb-1"/><input name="optionC" placeholder="Option C" class="form-control mb-1"/><input name="optionD" placeholder="Option D" class="form-control mb-1"/></div><div class="col-md-4"><label>Correct MCQ option</label><select name="correctOption" class="form-select"><option value="">Not applicable</option><option>A</option><option>B</option><option>C</option><option>D</option></select></div><div class="col-12"><button class="btn btn-primary">Add Question</button></div></form></div></div>}
</div>