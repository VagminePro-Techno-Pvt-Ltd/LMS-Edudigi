@model IEnumerable<TMS.Models.Academics.InternalAssessmentQuestionAnswer>
@using TMS.Models.Academics
@{var a=(InternalAssessment)ViewBag.Assessment;var s=(InternalAssessmentSubmission)ViewBag.Submission;var questions=(List<InternalAssessmentQuestion>)ViewBag.Questions;ViewData["Title"]="Question-wise Evaluation";}
<div class="container-fluid py-4"><a asp-action="Submissions" asp-route-id="@a.Id" class="btn btn-outline-secondary mb-3">Back</a><h2>@a.Title — Question-wise Evaluation</h2><p>Student ID: @s.StudentId | Max marks: @a.MaxMarks</p><form asp-action="SaveGrades" method="post">@Html.AntiForgeryToken()<input type="hidden" name="submissionId" value="@s.Id"/>
@foreach(var q in questions){var r=Model.FirstOrDefault(x=>x.QuestionId==q.Id);<div class="card mb-3"><div class="card-body"><h5>@q.Type — @q.Marks marks</h5><p style="white-space:pre-wrap">@q.Text</p><div class="border rounded p-2 mb-2" style="white-space:pre-wrap">Answer: @r?.AnswerText</div>@if(q.Type=="MCQ"){<p>Correct option: @q.CorrectOption | Auto marks: @r?.Marks</p>}else{<div class="row g-2"><div class="col-md-3"><label>Marks / @q.Marks</label><input type="number" name="marks[@q.Id]" min="0" max="@q.Marks" step="0.01" value="@r?.Marks" required class="form-control"/></div><div class="col-md-9"><label>Feedback</label><input name="feedback[@q.Id]" maxlength="1000" value="@r?.Feedback" class="form-control"/></div></div>}</div></div>}
<button class="btn btn-primary">Save Question-wise Grades</button></form></div>