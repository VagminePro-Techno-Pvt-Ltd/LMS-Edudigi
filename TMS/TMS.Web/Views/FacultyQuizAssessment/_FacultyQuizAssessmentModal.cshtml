@model TMS.ViewModels.Academics.FacultyQuizAssessmentViewModel
@{
    bool isAssessed = Model.IsAssessed;
}

<div class="modal-header text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);">
    <div>
        <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 px-2 py-1 mb-1 font-monospace" style="font-size:0.75rem;">
            EVALUATION REVIEW
        </span>
        <h5 class="modal-title fw-bold mb-0 text-white">
            <i class="fa-solid fa-clipboard-check me-2"></i>@Model.QuizName
        </h5>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <!-- Student / Course Info Card -->
    <div class="p-3 bg-light rounded-3 border mb-3">
        <div class="row g-2">
            <div class="col-md-6">
                <span class="text-muted small d-block">Student Name:</span>
                <strong class="text-dark"><i class="fa-solid fa-user-graduate text-primary me-1"></i>@Model.StudentName</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Course & Quadrant:</span>
                <strong class="text-dark">@Model.CourseName • @Model.QuadrantName</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Submitted Date:</span>
                <span class="text-secondary small fw-semibold">@Model.AttemptedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Evaluation Status:</span>
                @if (isAssessed)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                        <i class="fa-solid fa-circle-check me-1"></i> Assessed (Score: @Model.TotalScore)
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                        <i class="fa-solid fa-hourglass-half me-1"></i> Pending Faculty Grading
                    </span>
                }
            </div>
        </div>
    </div>

    <form id="quizAssessmentForm">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AttemptId)
        @Html.HiddenFor(m => m.QuizId)
        @Html.HiddenFor(m => m.StudentId)
        @Html.HiddenFor(m => m.CourseId)
        @Html.HiddenFor(m => m.QuadrantId)
        @Html.HiddenFor(m => m.StudentName)
        @Html.HiddenFor(m => m.CourseName)
        @Html.HiddenFor(m => m.QuadrantName)
        @Html.HiddenFor(m => m.QuizName)

        <h6 class="fw-bold text-dark mb-3">Questions & Answers Evaluation:</h6>

        <div class="d-flex flex-column gap-3">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var isObjective = q.QuestionType == TMS.Models.Masters.QuestionType.Objective;

                <div class="p-3 bg-white rounded-3 border shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark border fw-bold">Question @(i + 1)</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                @(isObjective ? "Objective (MCQ)" : "Subjective")
                            </span>
                        </div>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-semibold">
                            Max: @q.MaxScore Marks
                        </span>
                    </div>

                    <h6 class="fw-bold text-dark mb-2" style="font-size: 0.95rem;">@q.QuestionText</h6>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem; letter-spacing:0.5px;">Student Answer:</small>
                        @if (isObjective)
                        {
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="fw-bold text-dark">
                                    <i class="fa-solid fa-circle-dot text-primary me-1"></i>
                                    @(string.IsNullOrEmpty(q.SelectedOptionText) ? "No option selected" : q.SelectedOptionText)
                                </span>
                                @if (q.IsOptionCorrect.HasValue)
                                {
                                    if (q.IsOptionCorrect.Value)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="fa-solid fa-check me-1"></i> Correct Answer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                            <i class="fa-solid fa-xmark me-1"></i> Incorrect Answer
                                        </span>
                                    }
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(q.CorrectOptionText) && q.IsOptionCorrect == false)
                            {
                                <div class="mt-2 small text-muted">
                                    <i class="fa-solid fa-info-circle text-success me-1"></i> Correct Option: <strong class="text-success">@q.CorrectOptionText</strong>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="mb-0 text-dark small" style="white-space: pre-wrap; font-size: 0.9rem; line-height: 1.5;">
                                @(string.IsNullOrEmpty(q.WrittenAnswer) ? "No written answer submitted." : q.WrittenAnswer)
                            </p>
                        }
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <label class="small fw-bold text-muted mb-0">Award Marks:</label>
                        <div style="max-width: 110px;">
                            <input type="number"
                                   name="Questions[@i].StudentScore"
                                   class="form-control form-control-sm text-center fw-bold faculty-score-input"
                                   value="@q.StudentScore"
                                   min="0"
                                   max="@q.MaxScore"
                                   step="0.5" />
                        </div>
                        <span class="text-muted small">/ @q.MaxScore</span>
                    </div>

                    <input type="hidden" name="Questions[@i].QuestionId" value="@q.QuestionId" />
                    <input type="hidden" name="Questions[@i].QuestionText" value="@q.QuestionText" />
                    <input type="hidden" name="Questions[@i].MaxScore" value="@q.MaxScore" />
                    <input type="hidden" name="Questions[@i].QuestionType" value="@q.QuestionType" />
                    <input type="hidden" name="Questions[@i].SelectedOptionText" value="@q.SelectedOptionText" />
                    <input type="hidden" name="Questions[@i].WrittenAnswer" value="@q.WrittenAnswer" />
                </div>
            }
        </div>

        <div id="assessmentSaveAlert" class="mt-3"></div>
    </form>
</div>

<div class="modal-footer bg-light border-top d-flex justify-content-between">
    <div>
        <span class="text-muted small">Total Awarded Score:</span>
        <strong class="fs-5 text-primary ms-1" id="liveTotalScoreDisplay">@Model.TotalScore</strong>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" form="quizAssessmentForm" class="btn btn-primary fw-bold px-4" id="saveAssessmentBtn" style="background: linear-gradient(135deg, #16a34a, #15803d); border:none;">
            <i class="fa-solid fa-floppy-disk me-1"></i> Save Evaluation
        </button>
    </div>
</div>

<script>
    function calculateModalTotal() {
        var total = 0;
        $(".faculty-score-input").each(function () {
            var val = parseFloat($(this).val()) || 0;
            total += val;
        });
        $("#liveTotalScoreDisplay").text(total);
    }

    $(".faculty-score-input").on("input change", function () {
        calculateModalTotal();
    });

    calculateModalTotal();
</script>
