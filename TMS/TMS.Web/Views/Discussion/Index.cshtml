@model IEnumerable<TMS.Models.Masters.DiscussionThread>
@{
    ViewBag.Title = "Discussion Forum";
}

<link rel="stylesheet" href="~/css/forum-premium.css" asp-append-version="true" />

<div class="forum-page-bg py-3">
    <div class="container-fluid px-0">
        <!-- Top Action Bar / Hero Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 p-4 rounded-4 shadow-sm border bg-white">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase;">
                    <i class="fa-solid fa-comments"></i> Collaborative Learning Forum
                </div>
                <h2 class="fw-bold text-dark mb-1" style="font-size: 24px; letter-spacing: -0.3px;">
                    Community Discussions
                </h2>
                <p class="text-muted small mb-0" style="font-size: 13.5px;">
                    Connect, share knowledge, ask academic questions, and engage with peers and faculty.
                </p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#askQuestionModal" style="display:inline-flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-plus"></i> Start a Discussion
            </button>
        </div>

        <div class="row">
            <!-- Main Feed -->
            <div class="col-lg-8">
                <!-- Filters Tab -->
                <div class="card premium-sidebar-card mb-4 border-0 shadow-sm rounded-4">
                    <div class="card-body p-2">
                        <ul class="nav nav-pills nav-fill">
                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.Filter == "latest" ? "active" : "")" href="@Url.Action("Index", new { programId = ViewBag.ProgramId, filter = "latest" })">Latest Feed</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.Filter == "popular" ? "active" : "")" href="@Url.Action("Index", new { programId = ViewBag.ProgramId, filter = "popular" })">Trending</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.Filter == "unanswered" ? "active" : "")" href="@Url.Action("Index", new { programId = ViewBag.ProgramId, filter = "unanswered" })">Unanswered</a>
                            </li>
                        </ul>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="card premium-post-card text-center py-5 rounded-4 shadow-sm border-0">
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px; font-size: 28px;">
                                    <i class="fa-solid fa-comments"></i>
                                </div>
                            </div>
                            <h4 class="text-dark font-weight-bold">No discussions yet</h4>
                            <p class="text-muted small">Be the first one to start a conversation in this program!</p>
                            <button class="btn btn-primary rounded-pill px-4 py-2 mt-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#askQuestionModal">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Ask Now
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var thread in Model)
                    {
                        <div class="card premium-post-card">
                            <div class="post-header">
                                <div class="post-user-info">
                                    <img src="/img/user-default.png" class="user-avatar" />
                                    <div class="user-details">
                                        <p class="name">@thread.CreatedByUser?.Name <span class="post-badge">Author</span></p>
                                        <p class="meta">@thread.CreatedOn.ToString("MMM dd, yyyy") • <i class="fas fa-eye mr-1"></i> @thread.ViewCount views</p>
                                    </div>
                                </div>
                                <div class="post-options">
                                    <button class="btn btn-link text-muted"><i class="fas fa-ellipsis-h"></i></button>
                                </div>
                            </div>
                            <div class="post-content">
                                <a href="@Url.Action("Details", new { id = thread.Id })" class="post-title">@thread.Title</a>
                                <p class="post-excerpt">
                                    @(thread.Replies?.FirstOrDefault(r => r.ParentReplyId == null)?.CommentText ?? "No content provided.")
                                </p>
                                @if (thread.Attachments != null && thread.Attachments.Any(a => a.FileType.Contains("image")))
                                {
                                    <img src="@thread.Attachments.First(a => a.FileType.Contains("image")).FilePath" class="post-image-preview" />
                                }
                            </div>
                            <div class="post-footer">
                                <a href="@Url.Action("Details", new { id = thread.Id })" class="post-action">
                                    <i class="far fa-comment-dots"></i> @(thread.Replies?.Count ?? 0) Comments
                                </a>
                                <a href="javascript:void(0)" class="post-action">
                                    <i class="far fa-thumbs-up"></i> 0 Likes
                                </a>
                                @if (thread.IsLocked)
                                {
                                    <span class="ml-auto text-muted small"><i class="fas fa-lock mr-1"></i> Locked</span>
                                }
                                @if (thread.IsPinned)
                                {
                                    <span class="ml-2 text-warning small"><i class="fas fa-thumbtack mr-1"></i> Pinned</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Program Categories -->
                <div class="card premium-sidebar-card">
                    <div class="sidebar-header">
                        <h6>Program Groups</h6>
                    </div>
                    <div class="sidebar-body">
                        <div class="groups-list">
                            <a href="#" class="group-item active">
                                <span>Main Forum</span>
                                <i class="fas fa-chevron-right small"></i>
                            </a>
                            <a href="#" class="group-item">
                                <span>Study Materials</span>
                                <i class="fas fa-chevron-right small"></i>
                            </a>
                            <a href="#" class="group-item">
                                <span>Exam Queries</span>
                                <i class="fas fa-chevron-right small"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Trending Topics -->
                <div class="card premium-sidebar-card">
                    <div class="sidebar-header">
                        <h6>Trending Topics</h6>
                    </div>
                    <div class="sidebar-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach(var trending in Model.OrderByDescending(t => t.ViewCount).Take(3))
                            {
                                <a href="@Url.Action("Details", new { id = trending.Id })" class="list-group-item list-group-item-action border-0 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded p-2 mr-3 text-primary">
                                            <i class="fas fa-chart-line"></i>
                                        </div>
                                        <div>
                                            <p class="m-0 font-weight-bold small text-dark">@trending.Title</p>
                                            <small class="text-muted">@trending.ViewCount views • @(trending.Replies?.Count ?? 0) replies</small>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Guidelines -->
                <div class="card premium-sidebar-card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="font-weight-bold mb-3"><i class="fas fa-info-circle mr-2"></i>Community Guidelines</h6>
                        <ul class="small pl-3 mb-0" style="opacity: 0.9;">
                            <li class="mb-2">Be respectful and helpful to others.</li>
                            <li class="mb-2">Check for existing questions before posting.</li>
                            <li>Use clear and descriptive titles.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ask Question Modal -->
<div class="modal fade" id="askQuestionModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <form action="@Url.Action("CreateThread")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProgramId" value="@ViewBag.ProgramId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title font-weight-bold text-dark">Create New Discussion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-muted small text-uppercase mb-2">Discussion Title</label>
                        <input type="text" name="Title" class="form-control form-control-lg border-0 bg-light" style="border-radius: 10px;" placeholder="What's on your mind?" required />
                    </div>
                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-muted small text-uppercase mb-2">Details & Context</label>
                        <textarea name="CommentText" class="form-control border-0 bg-light" style="border-radius: 10px;" rows="6" placeholder="Provide more details about your question..." required></textarea>
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-muted small text-uppercase mb-2">Attachments</label>
                        <div class="p-3 border-2 border-dashed rounded text-center bg-light" style="border: 2px dashed #cbd5e0 !important;">
                            <input type="file" name="attachments" id="attachments" multiple class="d-none" />
                            <label for="attachments" class="m-0 cursor-pointer text-primary font-weight-bold">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2 d-block"></i>
                                Click to upload images or documents
                            </label>
                            <p class="small text-muted mb-0 mt-2">Max 5MB per file</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-4 font-weight-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-premium-ask px-5">Publish Post</button>
                </div>
            </form>
        </div>
    </div>
</div>
