@model TMS.Models.Masters.DiscussionReply

<div class="card reply-item mb-3 @(Model.IsAccepted ? "accepted-indicator" : "")">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="d-flex align-items-center">
                <img src="/img/user-default.png" class="rounded-circle mr-3 border shadow-sm" style="width: 40px; height: 40px;" />
                <div>
                    <span class="d-block font-weight-bold text-dark">@Model.User?.Name</span>
                    <small class="text-muted">@Model.CommentedOn.ToString("MMM dd, yyyy HH:mm")</small>
                </div>
            </div>
            <div class="reply-meta-actions">
                @if (Model.IsAccepted)
                {
                    <span class="badge bg-success text-white rounded-pill px-3 py-2">
                        <i class="fas fa-check-circle mr-1"></i> Best Answer
                    </span>
                }
                else if (User.IsInRole("Admin") || User.IsInRole("Faculty"))
                {
                    <button class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="markAccepted(@Model.Id)">
                        <i class="fas fa-check mr-1"></i> Mark as Solution
                    </button>
                }
            </div>
        </div>

        <div class="reply-body py-2 text-dark" style="line-height: 1.6;">
            @Model.CommentText
        </div>

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="reply-attachments mt-3 pt-3 border-top d-flex flex-wrap gap-2">
                @foreach (var file in Model.Attachments)
                {
                    <a href="@file.FilePath" class="badge bg-light border text-primary rounded-pill p-2 px-3" target="_blank">
                        <i class="fas fa-paperclip mr-1"></i> @file.FileName
                    </a>
                }
            </div>
        }

        <div class="reply-footer mt-3 pt-3 border-top d-flex align-items-center">
            <button class="btn btn-link btn-sm text-primary font-weight-bold p-0 text-decoration-none" onclick="showReplyForm(@Model.Id)">
                <i class="fas fa-reply mr-1"></i> Reply
            </button>
            <span class="mx-3 text-light">|</span>
            <button class="btn btn-link btn-sm text-muted p-0 text-decoration-none">
                <i class="far fa-thumbs-up mr-1"></i> Like
            </button>
        </div>
    </div>
</div>

@if (Model.ChildReplies != null && Model.ChildReplies.Any())
{
    <div class="nested-container">
        @foreach (var child in Model.ChildReplies)
        {
            @Html.Partial("_ThreadReply", child)
        }
    </div>
}
