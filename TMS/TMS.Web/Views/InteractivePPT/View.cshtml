@{
    Layout = null; // Render fully isolated for seamless embedding in Modals / Fullscreen
    int pptId       = (int)ViewBag.PPTId;
    int slideCount  = (int)ViewBag.SlideCount;
    string pptTitle = ViewBag.PPTTitle ?? "Presentation";
    string courseName = ViewBag.CourseName ?? "";
    string? convError = ViewBag.ConversionError as string;

    var interactions = ViewBag.Interactions as List<TMS.Models.Academics.PPTSlideInteraction>
                       ?? new List<TMS.Models.Academics.PPTSlideInteraction>();

    // Build a JS-safe dictionary: slideNumber → list of interactions
    var slideMap = interactions
        .GroupBy(i => i.SlideNumber)
        .ToDictionary(
            g => g.Key,
            g => g.Select(i => new {
                id = i.Id,
                itemType = i.ItemType,
                itemId = i.ItemId,
                buttonText = i.ButtonText
            }).ToList()
        );
    var slideMapJson = System.Text.Json.JsonSerializer.Serialize(slideMap);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interactive PPT — @pptTitle</title>
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            margin: 0;
            padding: 0;
            background: #0f172a;
            overflow: hidden;
        }

        .ippt-page {
            font-family: 'Jost', 'Segoe UI', sans-serif;
            background: #0f172a;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Top bar ── */
        .ippt-topbar {
            background: linear-gradient(135deg,#6366f1,#4f46e5,#7c3aed);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            box-shadow: 0 4px 20px rgba(99,102,241,.4);
            position: relative;
            z-index: 50;
            flex-shrink: 0;
        }
        .ippt-tb-left { display:flex;align-items:center;gap:12px;flex:1;min-width:0; }
        .ippt-back {
            display:inline-flex;align-items:center;justify-content:center;
            width:36px;height:36px;background:rgba(255,255,255,.15);
            border:1px solid rgba(255,255,255,.25);border-radius:8px;
            color:#fff;text-decoration:none;font-size:14px;transition:background .2s;
        }
        .ippt-back:hover { background:rgba(255,255,255,.28);color:#fff; }
        .ippt-title-block { min-width:0; }
        .ippt-title-block h1 { font-size:15px;font-weight:800;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .ippt-title-block p  { font-size:11px;color:rgba(255,255,255,.7);margin-top:1px; }
        .ippt-tb-right { display:flex;align-items:center;gap:8px;flex-shrink:0; }
        .ippt-counter {
            background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
            border-radius:8px;padding:5px 14px;font-size:13px;font-weight:700;color:#fff;
        }
        .ippt-fs-btn {
            display:inline-flex;align-items:center;gap:6px;padding:7px 14px;
            background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
            border-radius:8px;color:#fff;cursor:pointer;font-size:12px;font-weight:700;
            transition:background .2s;
        }
        .ippt-fs-btn:hover { background:rgba(255,255,255,.28); }

        /* Hide back button when displayed inside an LMS iframe modal */
        body.is-framed .ippt-back {
            display: none !important;
        }

        /* ── Main area ── */
        .ippt-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 16px;
            gap: 12px;
            position: relative;
            overflow: hidden;
        }

        /* ── Slide wrapper ── */
        .ippt-slide-wrap {
            position:relative;
            width: 100%;
            max-width: min(100%, 960px);
            background:#1e293b;border-radius:16px;overflow:hidden;
            box-shadow:0 24px 64px rgba(0,0,0,.6);
            aspect-ratio:16/9;
            flex-shrink: 1;
        }
        .ippt-slide-img {
            width:100%;height:100%;object-fit:contain;
            display:block;
            transition:opacity .25s;
        }
        .ippt-slide-loading {
            position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
            background:#1e293b;
            transition:opacity .3s;
        }
        .ippt-spinner {
            width:44px;height:44px;border:4px solid rgba(255,255,255,.1);
            border-top-color:#6366f1;border-radius:50%;
            animation:ipptSpin 1s linear infinite;
        }
        @@keyframes ipptSpin { to { transform:rotate(360deg); } }

        /* ── Navigation arrows ── */
        .ippt-nav {
            position:absolute;top:50%;transform:translateY(-50%);
            width:44px;height:44px;border-radius:50%;
            background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);
            color:#fff;cursor:pointer;font-size:16px;
            display:flex;align-items:center;justify-content:center;
            transition:background .2s,transform .15s;
            z-index:10;
        }
        .ippt-nav:hover { background:rgba(255,255,255,.3);transform:translateY(-50%) scale(1.08); }
        .ippt-nav:disabled { opacity:.3;cursor:default; }
        .ippt-nav.prev { left:12px; }
        .ippt-nav.next { right:12px; }

        /* ── Interaction overlay ── */
        .ippt-interactions {
            position:absolute;bottom:16px;right:16px;left:16px;
            display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;
            pointer-events:none;
            z-index:20;
        }
        .ippt-int-btn {
            display:inline-flex;align-items:center;gap:7px;
            padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;
            text-decoration:none;border:none;cursor:pointer;
            transition:all .2s;pointer-events:all;
            box-shadow:0 4px 16px rgba(0,0,0,.3);
            animation:ipptBtnIn .3s ease;
        }
        @@keyframes ipptBtnIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
        .ippt-int-btn.quiz     { background:#6366f1;color:#fff; }
        .ippt-int-btn.quiz:hover { background:#4f46e5; }
        .ippt-int-btn.video    { background:#3b82f6;color:#fff; }
        .ippt-int-btn.video:hover { background:#2563eb; }
        .ippt-int-btn.document { background:#ef4444;color:#fff; }
        .ippt-int-btn.document:hover { background:#dc2626; }
        .ippt-int-btn.assignment { background:#16a34a;color:#fff; }
        .ippt-int-btn.assignment:hover { background:#15803d; }

        /* ── Slide strip ── */
        .ippt-strip {
            display:flex;gap:8px;overflow-x:auto;padding:6px 0;
            width:100%;max-width:960px;
            scrollbar-width:thin;scrollbar-color:#334155 transparent;
            flex-shrink: 0;
        }
        .ippt-thumb {
            flex-shrink:0;width:92px;height:52px;
            background:#1e293b;border-radius:6px;overflow:hidden;
            cursor:pointer;border:2px solid transparent;transition:border-color .2s;
            position:relative;
        }
        .ippt-thumb.active { border-color:#6366f1; }
        .ippt-thumb img { width:100%;height:100%;object-fit:cover; }
        .ippt-thumb-num {
            position:absolute;bottom:2px;right:4px;
            font-size:9px;font-weight:700;color:#fff;
            background:rgba(0,0,0,.5);border-radius:3px;padding:1px 4px;
        }
        .ippt-thumb .has-int {
            position:absolute;top:3px;right:3px;width:7px;height:7px;
            border-radius:50%;background:#f59e0b;
        }

        /* ── Error card ── */
        .ippt-error {
            background:#1e293b;border-radius:16px;padding:36px;text-align:center;
            max-width:500px;margin:auto;
        }
        .ippt-error i { font-size:48px;color:#ef4444;margin-bottom:16px;display:block; }
        .ippt-error h2 { font-size:18px;font-weight:700;color:#fff;margin-bottom:8px; }
        .ippt-error p  { font-size:12.5px;color:#94a3b8;line-height:1.65; }

        /* ── Converting overlay ── */
        .ippt-converting {
            text-align:center;padding:40px 20px;
        }
        .ippt-converting .ippt-spinner { margin:0 auto 20px; }
        .ippt-converting p { color:#94a3b8;font-size:13.5px; }
        .ippt-converting strong { color:#fff; }

        @@media(max-width:640px) {
            .ippt-topbar { padding:8px 12px; }
            .ippt-title-block h1 { font-size:12.5px; }
            .ippt-nav { width:36px;height:36px;font-size:13px; }
        }
        @@media(max-width:480px) {
            .ippt-strip { max-width:100%; }
            .ippt-thumb { width:64px;height:36px; }
        }
    </style>
    <script>
        // Apply framed logic if running inside a browser modal iframe
        document.addEventListener('DOMContentLoaded', function() {
            if (window.self !== window.top) {
                document.body.classList.add('is-framed');
            }
        });
    </script>
</head>
<body>

<div class="ippt-page" id="ipptPage">

    <!-- ── Top bar ── -->
    <div class="ippt-topbar">
        <div class="ippt-tb-left">
            <a href="javascript:history.back()" class="ippt-back" title="Go back">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="ippt-title-block">
                <h1>@pptTitle</h1>
                <p><i class="fa-solid fa-book" style="margin-right:4px;"></i>@courseName</p>
            </div>
        </div>
        <div class="ippt-tb-right">
            <div class="ippt-counter" id="ipptCounter">
                @if (slideCount > 0) { <text>Slide <span id="slideNumDisp">1</span> / @slideCount</text> }
            </div>
            <button class="ippt-fs-btn" onclick="toggleFullscreen()">
                <i class="fa-solid fa-expand" id="ipptFsIcon"></i>
                <span class="d-none d-sm-inline">Fullscreen</span>
            </button>
        </div>
    </div>

    <!-- ── Main ── -->
    <div class="ippt-main" id="ipptMain">

        @if (!string.IsNullOrEmpty(convError) && slideCount == 0)
        {
            <!-- Conversion failed -->
            <div class="ippt-error">
                <i class="fa-solid fa-circle-xmark"></i>
                <h2>Preview Failed</h2>
                <p>@convError</p>
                <p style="margin-top:12px;font-size:11.5px;">
                    Make sure LibreOffice is installed and the path is set correctly.
                </p>
            </div>
        }
        else if (slideCount == 0)
        {
            <!-- Slides still converting -->
            <div class="ippt-converting" id="ipptConverting">
                <div class="ippt-spinner"></div>
                <p><strong>Converting presentation to slides…</strong><br>This may take a few seconds. Please wait.</p>
            </div>
        }
        else
        {
            <!-- ── Slide viewer ── -->
            <div class="ippt-slide-wrap" id="ipptSlideWrap">
                <!-- Loading indicator -->
                <div class="ippt-slide-loading" id="ipptSlideLoading">
                    <div class="ippt-spinner"></div>
                </div>

                <!-- Current slide image -->
                <img id="ipptSlideImg" class="ippt-slide-img" alt="Slide"
                     onload="onSlideLoaded()"
                     onerror="onSlideError()" />

                <!-- Prev / Next arrows -->
                <button class="ippt-nav prev" id="btnPrev" onclick="gotoSlide(currentSlide - 1)" title="Previous (←)">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="ippt-nav next" id="btnNext" onclick="gotoSlide(currentSlide + 1)" title="Next (→)">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                <!-- Interaction buttons overlay -->
                <div class="ippt-interactions" id="ipptInteractions"></div>
            </div>

            <!-- ── Thumbnail strip ── -->
            <div class="ippt-strip" id="ipptStrip">
                @for (int s = 1; s <= slideCount; s++)
                {
                    bool hasInteraction = interactions.Any(i => i.SlideNumber == s);
                    <div class="ippt-thumb @(s == 1 ? "active" : "")" id="thumb_@s" onclick="gotoSlide(@s)" title="Slide @s">
                        <img src="/InteractivePPT/Slide/@pptId/@s"
                             alt="Slide @s"
                             loading="lazy"
                             onerror="this.parentElement.style.background='#334155'" />
                        <span class="ippt-thumb-num">@s</span>
                        @if (hasInteraction) { <span class="has-int" title="Has interactions"></span> }
                    </div>
                }
            </div>
        }

    </div><!-- /ippt-main -->
</div>

<script>
    // ── State ────────────────────────────────────────────────────────
    var totalSlides = @slideCount;
    var pptId       = @pptId;
    var currentSlide = 1;
    var _inFs = false;

    // Slide interaction map: { "slideNum": [{itemType, itemId, buttonText}, ...] }
    var slideMap = @Html.Raw(slideMapJson);

    // ── Boot ─────────────────────────────────────────────────────────
    window.addEventListener('DOMContentLoaded', function() {
        if (totalSlides === 0) {
            // Trigger server-side conversion then poll
            triggerConversion();
        } else {
            gotoSlide(1);
        }

        // Keyboard nav
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
                e.preventDefault(); gotoSlide(currentSlide + 1);
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                e.preventDefault(); gotoSlide(currentSlide - 1);
            } else if (e.key === 'f' || e.key === 'F') {
                toggleFullscreen();
            }
        });
    });

    // ── Navigate to slide ────────────────────────────────────────────
    function gotoSlide(n) {
        if (n < 1 || n > totalSlides) return;
        currentSlide = n;

        // Update image
        var img = document.getElementById('ipptSlideImg');
        var loader = document.getElementById('ipptSlideLoading');
        if (img) {
            if (loader) loader.style.opacity = '1';
            img.src = '/InteractivePPT/Slide/' + pptId + '/' + n + '?t=' + Date.now();
        }

        // Update counter
        var disp = document.getElementById('slideNumDisp');
        if (disp) disp.textContent = n;

        // Update arrow states
        var prev = document.getElementById('btnPrev');
        var next = document.getElementById('btnNext');
        if (prev) prev.disabled = n <= 1;
        if (next) next.disabled = n >= totalSlides;

        // Update active thumbnail
        document.querySelectorAll('.ippt-thumb').forEach(function(t) { t.classList.remove('active'); });
        var th = document.getElementById('thumb_' + n);
        if (th) {
            th.classList.add('active');
            th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        // Render interaction buttons
        renderInteractions(n);
    }

    function onSlideLoaded() {
        var l = document.getElementById('ipptSlideLoading');
        if (l) l.style.opacity = '0';
    }
    function onSlideError() {
        var l = document.getElementById('ipptSlideLoading');
        if (l) { l.innerHTML = '<p style="color:#94a3b8;font-size:13px;">Slide could not load.</p>'; }
    }

    // ── Interactions overlay ─────────────────────────────────────────
    var iconMap = { 'Quiz':'fa-circle-question', 'Video':'fa-play', 'Document':'fa-file-pdf', 'Assignment':'fa-clipboard-list' };
    var classMap = { 'Quiz':'quiz', 'Video':'video', 'Document':'document', 'Assignment':'assignment' };
    var linkMap = {
        'Quiz':       function(id){ return '/StudentQuiz/Attempt?quizId=' + id; },
        'Video':      function(id){ return '/VideoLearning/Watch/' + id; },
        'Document':   function(id){ return '/DocumentViewer/View/' + id; },
        'Assignment': function(id){ return '/Assignment/Details/' + id; }
    };

    function renderInteractions(slideNum) {
        var wrap = document.getElementById('ipptInteractions');
        if (!wrap) return;
        wrap.innerHTML = '';
        var items = slideMap[slideNum] || slideMap[slideNum.toString()] || [];
        items.forEach(function(item) {
            var icon = iconMap[item.itemType] || 'fa-link';
            var cls  = classMap[item.itemType] || 'quiz';
            var href = (linkMap[item.itemType] || function(){ return '#'; })(item.itemId);
            var btn  = document.createElement('a');
            btn.className = 'ippt-int-btn ' + cls;
            btn.href = href;
            btn.target = '_blank';
            btn.rel = 'noopener';
            btn.innerHTML = '<i class="fa-solid ' + icon + '"></i>' + escHtml(item.buttonText);
            wrap.appendChild(btn);
        });
    }

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Conversion polling ───────────────────────────────────────────
    function triggerConversion() {
        fetch('/InteractivePPT/ConvertSlides/' + pptId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success && data.slideCount > 0) {
                location.reload();
            } else {
                var c = document.getElementById('ipptConverting');
                if (c) c.innerHTML = '<i class="fa-solid fa-circle-xmark" style="font-size:40px;color:#ef4444;margin-bottom:16px;display:block;"></i>'
                    + '<p style="color:#94a3b8;">' + (data.message || 'Conversion failed.') + '</p>';
            }
        })
        .catch(function() {
            var c = document.getElementById('ipptConverting');
            if (c) c.innerHTML = '<p style="color:#ef4444;">An error occurred during conversion.</p>';
        });
    }

    // ── Fullscreen ───────────────────────────────────────────────────
    function toggleFullscreen() {
        var el = document.getElementById('ipptPage');
        if (!_inFs) {
            (el.requestFullscreen||el.webkitRequestFullscreen||el.mozRequestFullScreen||el.msRequestFullscreen||function(){}).call(el);
        } else {
            (document.exitFullscreen||document.webkitExitFullscreen||document.mozCancelFullScreen||document.msExitFullscreen||function(){}).call(document);
        }
    }
    ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange','MSFullscreenChange'].forEach(function(ev){
        document.addEventListener(ev, function(){
            _inFs = !!(document.fullscreenElement||document.webkitFullscreenElement||document.mozFullScreenElement||document.msFullscreenElement);
            var icon = document.getElementById('ipptFsIcon');
            if (icon) icon.className = _inFs ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
        });
    });
</script>
</body>
</html>
