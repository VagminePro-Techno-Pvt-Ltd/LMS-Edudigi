@model TMS.ViewModels.Academics.FacultyCertificationDashboardViewModel
@using TMS.Models.Masters
@using TMS.Models.Academics

@{
    ViewData["Title"] = "Certification Exams — Faculty";
}

<style>
    .cert-faculty {
        --cert-navy: #142a4c;
        --cert-blue: #2563eb;
        --cert-gold: #d97706;
        --cert-bg: #f8fafc;
        --cert-border: #e2e8f0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .cert-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--cert-border);
    }
    .cert-title-group h2 {
        font-size: 26px;
        font-weight: 800;
        color: var(--cert-navy);
        margin: 0 0 6px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .cert-title-group p {
        color: #64748b;
        margin: 0;
        font-size: 14px;
    }
    .cert-nav-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 22px;
    }
    .cert-nav-tab {
        padding: 9px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 13.5px;
        color: #475569;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .cert-nav-tab:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .cert-nav-tab.active {
        background: var(--cert-navy);
        color: #ffffff;
        border-color: var(--cert-navy);
        box-shadow: 0 4px 12px rgba(20, 42, 76, 0.2);
    }
    .cert-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .cert-stat-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 18px 20px;
        border: 1px solid var(--cert-border);
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .cert-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
    .cert-stat-info .num {
        font-size: 24px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
    }
    .cert-stat-info .lbl {
        font-size: 12.5px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cert-exam-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--cert-border);
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        transition: all 0.2s ease;
    }
    .cert-exam-card:hover {
        box-shadow: 0 6px 18px rgba(0,0,0,0.07);
        border-color: #cbd5e1;
    }
    .badge-published {
        background: #dcfce7;
        color: #15803d;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge-draft {
        background: #fef3c7;
        color: #b45309;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
</style>

<div class="container-fluid py-3 cert-faculty">
    <!-- Header -->
    <div class="cert-header">
        <div class="cert-title-group">
            <h2>
                <i class="fa-solid fa-certificate" style="color: #d97706;"></i>
                Certification Examinations
            </h2>
            <p>Design topic-based certification exams with real-time evaluation and automatic digital certificate generation.</p>
        </div>
        <div>
            <button class="btn btn-primary px-4 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#createExamSection">
                <i class="fa-solid fa-plus me-1"></i> Create Certification Exam
            </button>
        </div>
    </div>

    <!-- Navigation Tabs between IA and Certification Exams -->
    <div class="cert-nav-tabs">
        <a class="cert-nav-tab" asp-controller="InternalAssessment" asp-action="FacultyDashboard">
            <i class="fa-solid fa-list-check"></i> Internal Assessments
        </a>
        <a class="cert-nav-tab active" asp-controller="CertificationExam" asp-action="FacultyDashboard">
            <i class="fa-solid fa-award"></i> Certification Exams
        </a>
    </div>

    <!-- Stats Row -->
    <div class="cert-stats-grid">
        <div class="cert-stat-card">
            <div class="cert-stat-icon" style="background:#eff6ff; color:#2563eb;">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="cert-stat-info">
                <div class="num">@Model.TotalExams</div>
                <div class="lbl">Total Exams</div>
            </div>
        </div>
        <div class="cert-stat-card">
            <div class="cert-stat-icon" style="background:#f0fdf4; color:#16a34a;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="cert-stat-info">
                <div class="num">@Model.PublishedExams</div>
                <div class="lbl">Published Exams</div>
            </div>
        </div>
        <div class="cert-stat-card">
            <div class="cert-stat-icon" style="background:#fef3c7; color:#d97706;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="cert-stat-info">
                <div class="num">@Model.TotalAttempts</div>
                <div class="lbl">Student Attempts</div>
            </div>
        </div>
        <div class="cert-stat-card">
            <div class="cert-stat-icon" style="background:#faf5ff; color:#9333ea;">
                <i class="fa-solid fa-stamp"></i>
            </div>
            <div class="cert-stat-info">
                <div class="num">@Model.TotalCertificates</div>
                <div class="lbl">Certificates Generated</div>
            </div>
        </div>
    </div>

    <!-- Create Exam Collapsible Form -->
    <div class="collapse mb-4" id="createExamSection">
        <div class="card border-0 shadow-sm" style="border-radius:14px; border:1px solid #cbd5e1 !important;">
            <div class="card-header bg-white py-3" style="border-bottom:1px solid #e2e8f0; border-radius:14px 14px 0 0;">
                <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Create New Certification Exam</h5>
                <small class="text-muted">Faculty can directly create, add questions and publish certification exams without requiring admin approval.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Exam Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Advanced Cloud Computing Professional Certification" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Certification Topic <span class="text-danger">*</span></label>
                            <input type="text" name="CertificationTopic" class="form-control" placeholder="e.g. Distributed Enterprise Architecture" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
                            <select name="CourseId" class="form-select" required>
                                <option value="">-- Select Assigned Course --</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.Name (@c.CourseCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Subject (Optional)</label>
                            <select name="SubjectId" class="form-select">
                                <option value="">-- Select Subject (Optional) --</option>
                                @foreach (var s in Model.Subjects)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Overview of the certification exam syllabus, objectives and guidelines..."></textarea>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-semibold">Duration (Minutes)</label>
                            <input type="number" name="DurationMinutes" class="form-control" value="60" min="5" max="360" required />
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-semibold">Total Marks</label>
                            <input type="number" step="0.5" name="TotalMarks" class="form-control" value="100" min="1" max="1000" required />
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-semibold">Passing Percentage (%)</label>
                            <input type="number" step="0.5" name="PassingPercentage" class="form-control" value="50" min="1" max="100" required />
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-semibold">Max Attempts (Default 1)</label>
                            <input type="number" name="MaxAttempts" class="form-control" value="1" min="1" max="10" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start Date &amp; Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="StartDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End Date &amp; Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="EndDate" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-12 text-end pt-3">
                            <button type="button" class="btn btn-light me-2" data-bs-toggle="collapse" data-bs-target="#createExamSection">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-arrow-right me-1"></i> Save &amp; Add Questions</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Exam Listing -->
    <div class="mb-4">
        <h4 class="fw-bold mb-3" style="color:var(--cert-navy);">Your Certification Examinations</h4>

        @if (!Model.Exams.Any())
        {
            <div class="text-center py-5 bg-white rounded-3 border" style="border-color:#e2e8f0 !important;">
                <div class="mb-3 text-muted"><i class="fa-solid fa-stamp" style="font-size:42px;"></i></div>
                <h5 class="fw-bold text-dark">No Certification Exams Created Yet</h5>
                <p class="text-muted mb-3">Create your first certification exam to issue digitally verified certificates to qualifying students.</p>
                <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createExamSection">
                    <i class="fa-solid fa-plus me-1"></i> Create Certification Exam
                </button>
            </div>
        }
        else
        {
            @foreach (var exam in Model.Exams)
            {
                int qCount = Model.QuestionCounts.GetValueOrDefault(exam.Id, 0);
                int attCount = Model.AttemptCounts.GetValueOrDefault(exam.Id, 0);
                int certCount = Model.CertificateCounts.GetValueOrDefault(exam.Id, 0);

                <div class="cert-exam-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <span class="badge bg-light text-primary border me-2">@(exam.Course?.Name ?? "General Course")</span>
                            @if (exam.Subject != null)
                            {
                                <span class="badge bg-light text-secondary border me-2">@exam.Subject.Name</span>
                            }
                            @if (exam.Status == "Published")
                            {
                                <span class="badge-published"><i class="fa-solid fa-circle-check"></i> Published</span>
                            }
                            else
                            {
                                <span class="badge-draft"><i class="fa-solid fa-clock"></i> Draft</span>
                            }
                        </div>
                        <div class="text-muted small">
                            <i class="fa-regular fa-calendar me-1"></i> Schedule: @exam.StartDate.ToString("dd MMM yyyy, hh:mm tt") &ndash; @exam.EndDate.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                    <h4 class="fw-bold mb-1" style="color:var(--cert-navy);">@exam.Title</h4>
                    <p class="text-muted mb-3" style="font-size:13.5px;"><strong class="text-dark">Certification Topic:</strong> @exam.CertificationTopic</p>

                    @if (!string.IsNullOrWhiteSpace(exam.Description))
                    {
                        <p class="text-secondary small mb-3">@exam.Description</p>
                    }

                    <div class="d-flex flex-wrap gap-4 py-2 border-top border-bottom my-3 small text-muted">
                        <div><i class="fa-regular fa-clock text-primary me-1"></i> Duration: <strong class="text-dark">@exam.DurationMinutes min</strong></div>
                        <div><i class="fa-solid fa-award text-warning me-1"></i> Total Marks: <strong class="text-dark">@exam.TotalMarks</strong></div>
                        <div><i class="fa-solid fa-percent text-success me-1"></i> Passing: <strong class="text-dark">@exam.PassingPercentage%</strong></div>
                        <div><i class="fa-solid fa-rotate text-info me-1"></i> Max Attempts: <strong class="text-dark">@exam.MaxAttempts</strong></div>
                        <div><i class="fa-solid fa-list-ol text-primary me-1"></i> Questions: <strong class="text-dark">@qCount</strong></div>
                        <div><i class="fa-solid fa-user-graduate text-secondary me-1"></i> Attempts: <strong class="text-dark">@attCount</strong></div>
                        <div><i class="fa-solid fa-certificate text-warning me-1"></i> Certificates: <strong class="text-dark">@certCount</strong></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                        <div class="btn-group">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Questions" asp-route-id="@exam.Id">
                                <i class="fa-solid fa-list-check me-1"></i> Manage Questions (@qCount)
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@exam.Id">
                                <i class="fa-solid fa-eye me-1"></i> Preview
                            </a>
                            <a class="btn btn-sm btn-outline-info" asp-action="FacultyAttempts" asp-route-id="@exam.Id">
                                <i class="fa-solid fa-award me-1"></i> View Results &amp; Certificates (@attCount)
                            </a>
                        </div>
                        <div class="d-flex gap-2">
                            @if (exam.Status == "Draft")
                            {
                                <a class="btn btn-sm btn-light border" asp-action="Edit" asp-route-id="@exam.Id">
                                    <i class="fa-solid fa-pen me-1"></i> Edit Draft
                                </a>
                                <form asp-action="Publish" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Publish this certification exam? Students in enrolled courses will immediately be able to take it.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success px-3">
                                        <i class="fa-solid fa-upload me-1"></i> Publish Exam
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this draft exam?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success p-2 px-3 fw-bold border border-success-subtle">
                                    <i class="fa-solid fa-check-double me-1"></i> Active &amp; Live
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
