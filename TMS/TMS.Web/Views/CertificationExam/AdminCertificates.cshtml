@model List<TMS.Models.Academics.IssuedCertificate>
@{
    ViewData["Title"] = "Digital Certificates Management — Admin";
    string searchTerm = ViewBag.SearchTerm as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "All";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="color:#142a4c;">
                <i class="fa-solid fa-stamp text-warning me-2"></i>
                Digital Certificate Repository &amp; Governance
            </h2>
            <p class="text-muted mb-0">Oversee all issued certification exam credentials, manage audit logs, and revoke invalidated certificates.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="FacultyDashboard" class="btn btn-outline-primary">
                <i class="fa-solid fa-file-pen me-1"></i> Faculty Exams View
            </a>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius:12px; border:1px solid #e2e8f0 !important;">
        <div class="card-body p-3">
            <form method="get" asp-action="AdminCertificates" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Search by student name, certificate ID, or topic..." value="@searchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="All" selected="@(statusFilter == "All")">-- All Statuses --</option>
                        <option value="Valid" selected="@(statusFilter == "Valid")">Valid Credentials</option>
                        <option value="Revoked" selected="@(statusFilter == "Revoked")">Revoked Credentials</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="AdminCertificates" class="btn btn-outline-secondary w-100">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Certificates Table -->
    <div class="card shadow-sm border-0" style="border-radius:12px; border:1px solid #e2e8f0 !important;">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Issued Certificates (@Model.Count)</h5>
            <div class="small text-muted">No manual approval required &bull; Auto-generated on exam completion</div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-certificate text-muted" style="font-size:42px;"></i>
                    <h5 class="fw-bold text-dark mt-3">No Certificates Matching Criteria</h5>
                    <p class="text-muted small">No certification exam certificates match your active filter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Certificate Number</th>
                                <th>Student</th>
                                <th>Certification Exam &amp; Topic</th>
                                <th>Grade</th>
                                <th>Issue Date</th>
                                <th>Status</th>
                                <th>Generation</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-primary font-monospace">@c.CertificateNumber</div>
                                        <a href="/CertificationExam/Verify?token=@c.VerificationToken" target="_blank" class="small text-muted text-decoration-none">
                                            <i class="fa-solid fa-qrcode me-1"></i> QR Link
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@c.StudentFullName</div>
                                        <small class="text-muted">Student ID: @c.StudentId</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@c.CertificationExam?.Title</div>
                                        <small class="text-muted">Topic: @c.CertificationTopic</small>
                                    </td>
                                    <td>
                                        <span class="badge @(c.IsPassed ? "bg-success" : "bg-primary") px-2 fs-6">@c.FinalGrade</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@c.IssueDate.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>
                                        @if (c.Status == "Valid")
                                        {
                                            <span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check"></i> Valid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border" title="@c.RevocationReason">
                                                <i class="fa-solid fa-ban"></i> Revoked
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.GeneratedSuccessfully)
                                        {
                                            <span class="badge bg-light text-success border"><i class="fa-solid fa-file-pdf me-1"></i> Generated</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white" title="@c.GenerationError">
                                                <i class="fa-solid fa-triangle-exclamation"></i> Error
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            @if (c.GeneratedSuccessfully)
                                            {
                                                <a asp-action="DownloadCertificate" asp-route-certificateId="@c.Id" class="btn btn-sm btn-outline-primary" title="Download Certificate PDF">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <form asp-action="RetryCertificate" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="certificateId" value="@c.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Retry Generation">
                                                        <i class="fa-solid fa-rotate-right"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (c.Status == "Valid")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRevokeModal(@c.Id, '@c.CertificateNumber', '@c.StudentFullName')" title="Revoke Certificate">
                                                    <i class="fa-solid fa-ban"></i> Revoke
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Revoke Confirmation Modal -->
<div class="modal fade" id="revokeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="RevokeCertificate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Revoke Digital Certificate</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="certificateId" id="revokeCertId" />
                    <p class="text-dark">You are about to revoke the following certificate. This action is permanently logged on the audit ledger:</p>

                    <div class="p-3 bg-light rounded border mb-3">
                        <div><strong>Certificate Number:</strong> <span id="revokeCertNumber"></span></div>
                        <div><strong>Student:</strong> <span id="revokeStudentName"></span></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Revocation Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="State official reason for revocation (e.g. academic integrity finding, clerical correction)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fa-solid fa-ban me-1"></i> Confirm Revocation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let revokeModalObj;
    document.addEventListener("DOMContentLoaded", function () {
        revokeModalObj = new bootstrap.Modal(document.getElementById('revokeModal'));
    });

    function openRevokeModal(certId, certNumber, studentName) {
        document.getElementById('revokeCertId').value = certId;
        document.getElementById('revokeCertNumber').innerText = certNumber;
        document.getElementById('revokeStudentName').innerText = studentName;
        revokeModalObj.show();
    }
</script>
}
