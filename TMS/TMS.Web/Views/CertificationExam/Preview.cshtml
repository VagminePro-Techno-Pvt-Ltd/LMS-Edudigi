@model List<TMS.Models.Academics.CertificationExamQuestion>
@{
    ViewData["Title"] = "Exam Preview — Certification Exam";
    var exam = ViewBag.Exam as TMS.Models.Academics.CertificationExam;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Questions" asp-route-id="@exam?.Id" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Questions
        </a>
        <div class="d-flex gap-2">
            @if (exam?.Status == "Draft")
            {
                <form asp-action="Publish" asp-route-id="@exam?.Id" method="post" onsubmit="return confirm('Publish this exam?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-upload me-1"></i> Publish Exam Now
                    </button>
                </form>
            }
            <button onclick="window.print()" class="btn btn-outline-dark">
                <i class="fa-solid fa-print me-1"></i> Print / Save PDF
            </button>
        </div>
    </div>

    <!-- Exam Header Banner -->
    <div class="card shadow-sm border-0 mb-4" style="border-top: 4px solid #142a4c !important;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                    <span class="badge bg-primary me-2">@(exam?.Course?.Name ?? "Course")</span>
                    <span class="badge bg-secondary me-2">@(exam?.Subject?.Name ?? "General Subject")</span>
                    <span class="badge @(exam?.Status == "Published" ? "bg-success" : "bg-warning text-dark")">@exam?.Status</span>
                </div>
                <div class="text-muted small">
                    <i class="fa-regular fa-clock me-1"></i> Duration: @exam?.DurationMinutes Minutes | Total Marks: @exam?.TotalMarks
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-1">@exam?.Title</h2>
            <p class="text-muted mb-2"><strong class="text-dark">Certification Topic:</strong> @exam?.CertificationTopic</p>
            @if (!string.IsNullOrWhiteSpace(exam?.Description))
            {
                <p class="text-secondary small mb-0">@exam?.Description</p>
            }
        </div>
    </div>

    <!-- Questions List -->
    <div class="mb-4">
        <h5 class="fw-bold text-dark mb-3">Examination Questions (@Model?.Count)</h5>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No questions have been added to this exam yet.</div>
        }
        else
        {
            int idx = 1;
            foreach (var q in Model)
            {
                <div class="card shadow-sm border-0 mb-3" style="border-left: 3px solid #2563eb !important;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-primary">Question @(idx++) <span class="badge bg-light text-dark border ms-2">@q.Marks Marks</span></span>
                            <span class="badge bg-light text-secondary border">
                                @(q.QuestionType switch
                                {
                                    "SingleChoice" => "Single-choice MCQ",
                                    "MultipleChoice" => "Multiple-choice MCQ",
                                    "TrueFalse" => "True / False",
                                    _ => q.QuestionType
                                })
                            </span>
                        </div>

                        <div class="fs-6 fw-semibold text-dark mb-3">@q.QuestionText</div>

                        <div class="row g-2 mb-2">
                            @foreach (var opt in q.Options.OrderBy(o => o.SortOrder))
                            {
                                <div class="col-md-6">
                                    <div class="p-2 px-3 rounded border @(opt.IsCorrect ? "bg-success-subtle border-success text-success fw-bold" : "bg-light text-dark")">
                                        @if (opt.IsCorrect)
                                        {
                                            <i class="fa-solid fa-circle-check text-success me-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-circle text-muted me-2"></i>
                                        }
                                        @opt.OptionText
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(q.Explanation))
                        {
                            <div class="small text-muted mt-2 p-2 bg-light rounded">
                                <i class="fa-solid fa-lightbulb text-warning me-1"></i> <strong>Explanation:</strong> @q.Explanation
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
