@model TMS.ViewModels.Academics.CertificationExamFormModel
@using TMS.Models.Masters
@using TMS.Models.Academics

@{
    ViewData["Title"] = "Edit Certification Exam Draft";
    var courses = ViewBag.Courses as List<CourseMaster> ?? new();
    var subjects = ViewBag.Subjects as List<SubjectMaster> ?? new();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit Certification Exam</h3>
            <p class="text-muted small mb-0">Update metadata and scheduling for this certification examination.</p>
        </div>
        <a asp-action="FacultyDashboard" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius:14px; border:1px solid #cbd5e1 !important;">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Exam Title <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Certification Topic <span class="text-danger">*</span></label>
                        <input type="text" asp-for="CertificationTopic" class="form-control" required />
                        <span asp-validation-for="CertificationTopic" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
                        <select asp-for="CourseId" class="form-select" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name (@c.CourseCode)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Subject (Optional)</label>
                        <select asp-for="SubjectId" class="form-select">
                            <option value="">-- Select Subject (Optional) --</option>
                            @foreach (var s in subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-semibold">Duration (Minutes)</label>
                        <input type="number" asp-for="DurationMinutes" class="form-control" min="5" max="360" required />
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-semibold">Total Marks</label>
                        <input type="number" step="0.5" asp-for="TotalMarks" class="form-control" min="1" max="1000" required />
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-semibold">Passing Percentage (%)</label>
                        <input type="number" step="0.5" asp-for="PassingPercentage" class="form-control" min="1" max="100" required />
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-semibold">Max Attempts</label>
                        <input type="number" asp-for="MaxAttempts" class="form-control" min="1" max="10" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Start Date &amp; Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" asp-for="StartDate" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">End Date &amp; Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" asp-for="EndDate" class="form-control" required />
                    </div>

                    <div class="col-12 text-end pt-3">
                        <a asp-action="FacultyDashboard" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Update Exam</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
