@model List<TMS.ViewModels.Academics.AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcement Board";
}

@section extracss {
<style>
    /* ════════════════════════════════════════════════════════
       ANNOUNCEMENT BOARD — Student View (Futuristic Light)
       ════════════════════════════════════════════════════════ */
    :root {
        --board-bg: #f8fafc;
        --board-card: #ffffff;
        --board-border: #e8ecf0;
        --board-radius: 4px;
        --board-blue: #3b82f6;
        --board-indigo: #6366f1;
        --board-green: #10b981;
        --board-amber: #f59e0b;
        --board-red: #ef4444;
        --board-text: #1e293b;
        --board-muted: #64748b;
        --board-transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
    }

    .board-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .board-header h1 {
        font-family: 'Jost', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--board-text);
        margin: 0;
    }

    .board-header h1 i {
        color: var(--board-indigo);
        margin-right: 10px;
    }

    .board-header p {
        font-size: 13px;
        color: var(--board-muted);
        margin: 4px 0 0;
    }

    /* ── Type Filter ── */
    .board-filters {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .board-filter-btn {
        padding: 8px 18px;
        border-radius: var(--board-radius);
        border: 1px solid var(--board-border);
        background: var(--board-card);
        color: var(--board-muted);
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--board-transition);
    }

    .board-filter-btn:hover,
    .board-filter-btn.active {
        background: var(--board-indigo);
        color: #fff;
        border-color: var(--board-indigo);
    }

    /* ── Card Stream ── */
    .board-stream {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .board-card {
        background: var(--board-card);
        border: 1px solid var(--board-border);
        border-radius: var(--board-radius);
        overflow: hidden;
        transition: var(--board-transition);
        position: relative;
    }

    .board-card:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.07);
        transform: translateY(-2px);
    }

    /* Type Indicators */
    .board-card.type-urgent {
        border-left: 4px solid var(--board-red);
    }

    .board-card.type-event {
        border-left: 4px solid var(--board-indigo);
    }

    .board-card.type-general {
        border-left: 4px solid var(--board-blue);
    }

    /* Pin Ribbon */
    .board-pin-ribbon {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: var(--board-radius);
        font-size: 10px;
        font-weight: 700;
        color: #d97706;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .board-pin-ribbon i { font-size: 9px; }

    /* Card Top (accent bar for urgent) */
    .board-card.type-urgent::before {
        content: '';
        display: block;
        height: 3px;
        background: linear-gradient(90deg, var(--board-red), #f97316);
        animation: urgentSweep 3s ease-in-out infinite;
    }

    @@keyframes urgentSweep {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }

    .board-card-inner {
        padding: 24px 28px;
    }

    .board-card-top {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 14px;
    }

    .board-type-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--board-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .board-type-icon i { font-size: 20px; }

    .board-card-title-block {
        flex: 1;
    }

    .board-card-title-block h2 {
        font-family: 'Jost', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: var(--board-text);
        margin: 0 0 4px;
        line-height: 1.3;
    }

    .board-card-title-block .board-meta-line {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .board-meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--board-muted);
        padding: 3px 10px;
        background: #f1f5f9;
        border-radius: var(--board-radius);
    }

    .board-meta-chip i { font-size: 10px; }

    .board-meta-chip.chip-urgent { background: #fef2f2; color: #ef4444; font-weight: 700; }
    .board-meta-chip.chip-event  { background: #f5f3ff; color: #7c3aed; }
    .board-meta-chip.chip-general { background: #eff6ff; color: #3b82f6; }

    .board-card-body {
        font-size: 14px;
        color: #475569;
        line-height: 1.65;
    }

    .board-card-body p { margin: 0; }

    .board-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 28px;
        background: #fafbfc;
        border-top: 1px solid #f1f5f9;
    }

    .board-footer-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .board-footer-info span {
        font-size: 11.5px;
        color: var(--board-muted);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .board-footer-info span i { font-size: 11px; }

    .board-attachment-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: var(--board-radius);
        color: #3b82f6;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: var(--board-transition);
    }

    .board-attachment-link:hover {
        background: #dbeafe;
        transform: translateY(-1px);
    }

    /* ── Empty State ── */
    .board-empty {
        text-align: center;
        padding: 60px 20px;
        background: var(--board-card);
        border: 1px solid var(--board-border);
        border-radius: var(--board-radius);
    }

    .board-empty i { font-size: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .board-empty h3 { font-size: 18px; color: var(--board-text); font-weight: 700; margin: 0 0 6px; }
    .board-empty p { font-size: 13px; color: var(--board-muted); }

    @@media (max-width: 768px) {
        .board-card-inner { padding: 16px; }
        .board-card-footer { padding: 12px 16px; flex-direction: column; gap: 10px; }
    }
</style>
}

<div class="board-header">
    <div>
        <h1><i class="fa-solid fa-bullhorn"></i>Announcement Board</h1>
        <p>Stay updated with the latest announcements from your institution</p>
    </div>
    <div class="board-filters">
        <div class="board-filter-btn active" data-filter="all">All</div>
        <div class="board-filter-btn" data-filter="general">General</div>
        <div class="board-filter-btn" data-filter="event">Events</div>
        <div class="board-filter-btn" data-filter="urgent">Urgent</div>
        <div style="position: relative; margin-left: auto;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 13px;"></i>
            <input type="text" id="annSearch" placeholder="Search announcements..." style="padding: 8px 12px 8px 34px; border: 1px solid var(--board-border); border-radius: var(--board-radius); font-size: 12.5px; width: 220px; outline: none; transition: all 0.2s;" onfocus="this.style.borderColor='var(--board-indigo)'; this.style.boxShadow='0 0 0 3px rgba(99,102,241,0.1)';" onblur="this.style.borderColor='var(--board-border)'; this.style.boxShadow='none';">
        </div>
    </div>
</div>

<div class="board-stream" id="boardStream">
    @if (!Model.Any())
    {
        <div class="board-empty">
            <i class="fa-solid fa-bullhorn"></i>
            <h3>No Announcements</h3>
            <p>There are no announcements to display at this time. Check back later!</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var typeClass = item.AnnouncementType switch { 1 => "type-event", 2 => "type-urgent", _ => "type-general" };
            var iconBg = item.AnnouncementType switch { 1 => "#f5f3ff", 2 => "#fef2f2", _ => "#eff6ff" };
            var iconClr = item.AnnouncementType switch { 1 => "#7c3aed", 2 => "#ef4444", _ => "#3b82f6" };
            var iconClass = item.AnnouncementType switch { 1 => "fa-solid fa-calendar-days", 2 => "fa-solid fa-triangle-exclamation", _ => "fa-solid fa-circle-info" };
            var chipClass = item.AnnouncementType switch { 1 => "chip-event", 2 => "chip-urgent", _ => "chip-general" };

            <div class="board-card @typeClass" data-type="@item.AnnouncementTypeText.ToLower()">
                @if (item.IsPinned)
                {
                    <div class="board-pin-ribbon">
                        <i class="fa-solid fa-thumbtack"></i> Pinned
                    </div>
                }

                <div class="board-card-inner">
                    <div class="board-card-top">
                        <div class="board-type-icon" style="background:@iconBg;">
                            <i class="@iconClass" style="color:@iconClr;"></i>
                        </div>
                        <div class="board-card-title-block">
                            <h2>@item.Title</h2>
                            <div class="board-meta-line">
                                <span class="board-meta-chip @chipClass">
                                    <i class="@iconClass"></i> @item.AnnouncementTypeText
                                </span>
                                <span class="board-meta-chip">
                                    <i class="fa-regular fa-clock"></i> @item.TimeAgo
                                </span>
                                <span class="board-meta-chip">
                                    <i class="fa-solid fa-bullseye"></i> @item.TargetTypeText
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="board-card-body">
                        @Html.Raw(item.Description)
                    </div>
                </div>

                <div class="board-card-footer">
                    <div class="board-footer-info">
                        <span><i class="fa-regular fa-user"></i> @item.AuthorName</span>
                        <span><i class="fa-regular fa-calendar"></i> @item.PublishDateStr</span>
                        @if (item.ExpiryDate.HasValue)
                        {
                            <span><i class="fa-solid fa-hourglass-end"></i> Expires @item.ExpiryDateStr</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(item.AttachmentUrl))
                    {
                        <a href="@item.AttachmentUrl" class="board-attachment-link" target="_blank">
                            <i class="fa-solid fa-paperclip"></i> View Attachment
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
    const searchInput = document.getElementById('annSearch');
    const filterBtns = document.querySelectorAll('.board-filter-btn');
    const cards = document.querySelectorAll('.board-card');

    function filterAnnouncements() {
        const query = searchInput.value.toLowerCase();
        const activeFilter = document.querySelector('.board-filter-btn.active').dataset.filter;

        cards.forEach(card => {
            const title = card.querySelector('h2').textContent.toLowerCase();
            const body = card.querySelector('.board-card-body').textContent.toLowerCase();
            const type = card.dataset.type;

            const matchesSearch = title.includes(query) || body.includes(query);
            const matchesFilter = activeFilter === 'all' || type === activeFilter;

            card.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
        });
    }

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            filterAnnouncements();
        });
    });

    searchInput.addEventListener('input', filterAnnouncements);
</script>
}
