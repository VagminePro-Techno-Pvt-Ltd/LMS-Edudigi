@model TMS.ViewModels.Academics.SubjectListPageViewModel

@{
    ViewData["Title"] = "Subjects — " + Model.SemesterName;
}

<style>
    .sq-page { padding: 8px 4px 32px; font-family: 'Jost','Segoe UI',sans-serif; }

    .sq-bc { font-size:13px; color:#94a3b8; margin-bottom:14px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .sq-bc a { color:#64748b; text-decoration:none; transition:color .15s; }
    .sq-bc a:hover { color:#6366f1; }
    .sq-bc .sep { color:#cbd5e1; }
    .sq-bc strong { color:#1e293b; }

    .sq-title { font-size:22px; font-weight:800; color:#1e293b; display:flex; align-items:center; gap:10px; margin-bottom:20px; }
    .sq-title i { color:#6366f1; }

    /* Hero */
    .sq-hero {
        background: linear-gradient(135deg,#6366f1 0%,#4f46e5 60%,#7c3aed 100%);
        border-radius:16px; padding:28px 32px; color:#fff; margin-bottom:28px;
        display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
        box-shadow:0 8px 32px rgba(99,102,241,.28); position:relative; overflow:hidden;
    }
    .sq-hero::before {
        content:''; position:absolute; right:-40px; top:-40px;
        width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.07);
    }
    .sq-hero-left h2 { font-size:20px; font-weight:800; margin:0 0 6px; }
    .sq-hero-left p  { font-size:14px; opacity:.82; margin:0; }
    .sq-hero-stat { text-align:center; min-width:80px; }
    .sq-hero-stat .stat-num { font-size:28px; font-weight:800; line-height:1; }
    .sq-hero-stat .stat-lbl { font-size:11px; opacity:.75; text-transform:uppercase; letter-spacing:.6px; margin-top:4px; }

    /* Section heading */
    .sq-sec-head { font-size:15px; font-weight:800; color:#1e293b; display:flex; align-items:center; gap:8px; margin-bottom:16px; }
    .sq-sec-head i { color:#6366f1; }

    /* Subject grid */
    .subj-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:18px; margin-bottom:28px; }

    .subj-card {
        background:#fff; border-radius:16px; border:1px solid #eef2f6;
        box-shadow:0 2px 12px rgba(0,0,0,.05); overflow:hidden;
        transition:transform .2s,box-shadow .2s,border-color .2s; cursor:pointer;
        text-decoration:none; display:block;
    }
    .subj-card:hover { transform:translateY(-4px); box-shadow:0 10px 30px rgba(99,102,241,.14); border-color:#c7d2fe; }

    .subj-card-top { padding:22px 22px 16px; display:flex; align-items:flex-start; gap:16px; }
    .subj-icon {
        width:52px; height:52px; border-radius:14px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center; font-size:20px;
    }
    .subj-info h4 { font-size:15px; font-weight:800; color:#1e293b; margin:0 0 4px; line-height:1.3; }
    .subj-code { font-size:11.5px; color:#6366f1; font-weight:700; background:#eff6ff; padding:2px 8px; border-radius:6px; display:inline-block; margin-bottom:6px; }
    .subj-info p  { font-size:12px; color:#64748b; margin:0; }

    .subj-card-footer {
        padding:12px 22px; border-top:1px solid #f1f5f9;
        display:flex; align-items:center; justify-content:space-between;
    }
    .subj-meta { display:flex; gap:14px; }
    .subj-meta-item { font-size:12px; color:#64748b; display:flex; align-items:center; gap:5px; }
    .subj-meta-item i { color:#6366f1; font-size:11px; }
    .btn-open-subject {
        background:#6366f1; color:#fff; border:none; border-radius:8px;
        padding:6px 16px; font-size:12px; font-weight:700;
        transition:background .18s; display:inline-flex; align-items:center; gap:5px;
    }
    .btn-open-subject:hover { background:#4f46e5; color:#fff; }

    /* Empty state */
    .sq-empty { text-align:center; padding:60px 24px; background:#fff; border-radius:16px; border:1px solid #eef2f6; }
    .sq-empty i { font-size:48px; color:#cbd5e1; margin-bottom:12px; display:block; }
    .sq-empty h4 { font-size:16px; font-weight:700; color:#94a3b8; margin:0 0 6px; }
    .sq-empty p { font-size:13px; color:#94a3b8; margin:0; }

    @@media(max-width:768px){
        .sq-hero { padding:20px; }
        .sq-hero-left h2 { font-size:17px; }
        .subj-grid { grid-template-columns:1fr; }
    }
</style>

<div class="sq-page">
    @* Breadcrumb *@
    <div class="sq-bc">
        <a asp-controller="Home" asp-action="StudentDashboard"><i class="fa-solid fa-house"></i> Dashboard</a>
        <span class="sep">/</span>
        <a asp-controller="StudentCourseContent" asp-action="Index">My Courses</a>
        <span class="sep">/</span>
        <strong>@Model.CourseName — Subjects</strong>
    </div>

    @* Title *@
    <div class="sq-title">
        <i class="fa-solid fa-book-open-reader"></i>
        <span>@Model.SemesterName — Select a Subject</span>
    </div>

    @* Hero *@
    <div class="sq-hero">
        <div class="sq-hero-left">
            <h2><i class="fa-solid fa-graduation-cap" style="font-size:17px;opacity:.8;margin-right:8px;"></i>@Model.CourseName</h2>
            <p>Choose a subject to explore its units and learning materials.</p>
        </div>
        <div class="sq-hero-stat">
            <div class="stat-num">@Model.Subjects.Count</div>
            <div class="stat-lbl">Subjects</div>
        </div>
    </div>

    @* Section heading *@
    <div class="sq-sec-head">
        <i class="fa-solid fa-book"></i>
        Subjects in @Model.SemesterName
    </div>

    @if (Model.Subjects == null || !Model.Subjects.Any())
    {
        <div class="sq-empty">
            <i class="fa-solid fa-book"></i>
            <h4>No Subjects Found</h4>
            <p>No subjects have been added to this semester yet. Please contact your administrator.</p>
        </div>
    }
    else
    {
        string[] iconBgs  = { "#eff6ff","#fef9c3","#f0fdf4","#fff7ed","#fdf4ff","#fef2f2" };
        string[] iconClrs = { "#3b82f6","#ca8a04","#16a34a","#ea580c","#a855f7","#ef4444" };
        string[] icons    = { "fa-book-open","fa-atom","fa-flask","fa-calculator","fa-globe","fa-palette" };
        int si = 0;

        <div class="subj-grid">
            @foreach (var subj in Model.Subjects)
            {
                int ci = si % 6;
                <a href="@Url.Action("SubjectUnits","Quadrant", new { semesterId=Model.SemesterId, courseId=Model.CourseId, subjectId=subj.SubjectId })"
                   class="subj-card" id="subj-card-@subj.SubjectId">
                    <div class="subj-card-top">
                        <div class="subj-icon" style="background:@iconBgs[ci];color:@iconClrs[ci];">
                            <i class="fa-solid @icons[ci]"></i>
                        </div>
                        <div class="subj-info">
                            @if (!string.IsNullOrEmpty(subj.SubjectCode))
                            {
                                <span class="subj-code">@subj.SubjectCode</span>
                            }
                            <h4>@subj.SubjectName</h4>
                            <p>Click to view units for this subject.</p>
                        </div>
                    </div>
                    <div class="subj-card-footer">
                        <div class="subj-meta">
                            <span class="subj-meta-item">
                                <i class="fa-solid fa-layer-group"></i>
                                @subj.TotalUnits Unit(s)
                            </span>
                            <span class="subj-meta-item">
                                <i class="fa-solid fa-file-lines"></i>
                                @subj.TotalContent Content
                            </span>
                        </div>
                        <span class="btn-open-subject">
                            <i class="fa-solid fa-arrow-right"></i> Open
                        </span>
                    </div>
                </a>
                si++;
            }
        </div>
    }
</div>
