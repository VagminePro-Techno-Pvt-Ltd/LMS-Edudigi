@model List<TMS.ViewModels.Academics.InteractivePPTListViewModel>
@{
    ViewData["Title"] = "Manage Interactive PPTs";
}

@section extracss {
<style>
    /* ════════════════════════════════════════════════════════
       FACULTY PPT MANAGEMENT — Modern Light Theme
       ════════════════════════════════════════════════════════ */
    :root {
        --ppt-bg: #f8fafc;
        --ppt-card: #ffffff;
        --ppt-border: #e8ecf0;
        --ppt-radius: 4px;
        --ppt-shadow: 0 1px 6px rgba(0,0,0,0.04);
        --ppt-shadow-hover: 0 6px 24px rgba(0,0,0,0.08);
        --ppt-blue: #3b82f6;
        --ppt-indigo: #6366f1;
        --ppt-green: #10b981;
        --ppt-amber: #f59e0b;
        --ppt-red: #ef4444;
        --ppt-text: #1e293b;
        --ppt-muted: #64748b;
        --ppt-transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
    }

    .ppt-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .ppt-page-header .ppt-title-block h1 {
        font-family: 'Jost', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--ppt-text);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .ppt-page-header .ppt-title-block p {
        font-size: 13px;
        color: var(--ppt-muted);
        margin: 4px 0 0;
    }

    .ppt-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        background: linear-gradient(135deg, var(--ppt-blue), var(--ppt-indigo));
        color: #fff;
        border: none;
        border-radius: var(--ppt-radius);
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: var(--ppt-transition);
        box-shadow: 0 2px 8px rgba(99,102,241,0.25);
    }

    .ppt-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(99,102,241,0.35);
        color: #fff;
    }

    /* ── Stats Bar ── */
    .ppt-stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .ppt-stat-card {
        background: var(--ppt-card);
        border: 1px solid var(--ppt-border);
        border-radius: var(--ppt-radius);
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: var(--ppt-transition);
    }

    .ppt-stat-card:hover {
        box-shadow: var(--ppt-shadow-hover);
        transform: translateY(-2px);
    }

    .ppt-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--ppt-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ppt-stat-icon i { font-size: 18px; }

    .ppt-stat-info .stat-value {
        font-size: 22px;
        font-weight: 800;
        color: var(--ppt-text);
        line-height: 1;
    }

    .ppt-stat-info .stat-label {
        font-size: 11.5px;
        color: var(--ppt-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 2px;
    }

    /* ── Filter Bar ── */
    .ppt-filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .ppt-filter-select {
        padding: 8px 12px;
        border: 1px solid var(--ppt-border);
        border-radius: var(--ppt-radius);
        font-size: 12.5px;
        outline: none;
        transition: var(--ppt-transition);
        background: var(--ppt-card);
        color: var(--ppt-text);
        min-width: 150px;
    }

    .ppt-filter-select:focus {
        border-color: var(--ppt-blue);
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    }

    .ppt-search-box {
        position: relative;
        margin-left: auto;
    }

    .ppt-search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
    }

    .ppt-search-box input {
        padding: 8px 12px 8px 34px;
        border: 1px solid var(--ppt-border);
        border-radius: var(--ppt-radius);
        font-size: 12.5px;
        width: 220px;
        outline: none;
        transition: var(--ppt-transition);
    }

    .ppt-search-box input:focus {
        border-color: var(--ppt-blue);
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    }

    /* ── PPT Table ── */
    .ppt-table-container {
        background: var(--ppt-card);
        border: 1px solid var(--ppt-border);
        border-radius: var(--ppt-radius);
        overflow: hidden;
    }

    .ppt-table {
        width: 100%;
        border-collapse: collapse;
    }

    .ppt-table thead {
        background: #f8fafc;
        border-bottom: 2px solid var(--ppt-border);
    }

    .ppt-table th {
        padding: 14px 16px;
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--ppt-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .ppt-table tbody tr {
        border-bottom: 1px solid var(--ppt-border);
        transition: var(--ppt-transition);
    }

    .ppt-table tbody tr:hover {
        background: #f8fafc;
    }

    .ppt-table tbody tr:last-child {
        border-bottom: none;
    }

    .ppt-table td {
        padding: 16px;
        font-size: 13px;
        color: var(--ppt-text);
        vertical-align: middle;
    }

    .ppt-title-cell {
        font-weight: 600;
        color: var(--ppt-text);
        max-width: 250px;
    }

    .ppt-title-cell .ppt-title {
        display: block;
        margin-bottom: 4px;
    }

    .ppt-title-cell .ppt-desc {
        font-size: 11.5px;
        color: var(--ppt-muted);
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ppt-meta-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--ppt-muted);
        padding: 3px 10px;
        background: #f1f5f9;
        border-radius: var(--ppt-radius);
        margin: 2px;
    }

    .ppt-meta-tag i { font-size: 10px; }

    /* Status Badges */
    .ppt-status-active {
        background: #ecfdf5;
        color: #059669;
        padding: 4px 10px;
        border-radius: var(--ppt-radius);
        font-size: 11px;
        font-weight: 600;
    }

    .ppt-status-inactive {
        background: #f1f5f9;
        color: #94a3b8;
        padding: 4px 10px;
        border-radius: var(--ppt-radius);
        font-size: 11px;
        font-weight: 600;
    }

    /* Action Buttons */
    .ppt-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ppt-action-btn {
        width: 32px;
        height: 32px;
        border-radius: var(--ppt-radius);
        border: 1px solid var(--ppt-border);
        background: var(--ppt-card);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--ppt-transition);
        color: var(--ppt-muted);
        text-decoration: none;
    }

    .ppt-action-btn:hover {
        background: #eff6ff;
        color: var(--ppt-blue);
        border-color: #bfdbfe;
        transform: scale(1.08);
    }

    .ppt-action-btn.view:hover {
        background: #f0fdf4;
        color: var(--ppt-green);
        border-color: #bbf7d0;
    }

    .ppt-action-btn.danger:hover {
        background: #fef2f2;
        color: var(--ppt-red);
        border-color: #fecaca;
    }

    .ppt-action-btn i { font-size: 12px; }

    /* ── Empty State ── */
    .ppt-empty-state {
        text-align: center;
        padding: 60px 20px;
        background: var(--ppt-card);
        border: 1px solid var(--ppt-border);
        border-radius: var(--ppt-radius);
    }

    .ppt-empty-state i {
        font-size: 48px;
        color: #cbd5e1;
        margin-bottom: 16px;
    }

    .ppt-empty-state h3 {
        font-size: 18px;
        color: var(--ppt-text);
        font-weight: 700;
        margin: 0 0 6px;
    }

    .ppt-empty-state p {
        font-size: 13px;
        color: var(--ppt-muted);
        margin-bottom: 20px;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .ppt-table-container {
            overflow-x: auto;
        }
        .ppt-table {
            min-width: 800px;
        }
    }
</style>
}

<div class="ppt-page-header">
    <div class="ppt-title-block">
        <h1><i class="fa-solid fa-file-powerpoint" style="color: var(--ppt-indigo); margin-right: 10px;"></i>Manage Interactive PPTs</h1>
        <p>View and manage your uploaded PowerPoint presentations</p>
    </div>
    <a asp-action="Upload" class="ppt-btn-primary">
        <i class="fa-solid fa-plus"></i>
        Upload New PPT
    </a>
</div>

@{
    int total = Model.Count;
    int active = Model.Count(p => p.IsActive);
    int inactive = Model.Count(p => !p.IsActive);
    long totalSize = Model.Where(p => p.FileSizeBytes.HasValue).Sum(p => p.FileSizeBytes.Value);
    string totalSizeFormatted = totalSize < 1024 * 1024 * 1024 
        ? $"{totalSize / (1024.0 * 1024.0):F2} MB" 
        : $"{totalSize / (1024.0 * 1024.0 * 1024.0):F2} GB";
}

<div class="ppt-stats-bar">
    <div class="ppt-stat-card">
        <div class="ppt-stat-icon" style="background:#eff6ff;">
            <i class="fa-solid fa-file-powerpoint" style="color:#3b82f6;"></i>
        </div>
        <div class="ppt-stat-info">
            <div class="stat-value">@total</div>
            <div class="stat-label">Total PPTs</div>
        </div>
    </div>
    <div class="ppt-stat-card">
        <div class="ppt-stat-icon" style="background:#ecfdf5;">
            <i class="fa-solid fa-circle-check" style="color:#10b981;"></i>
        </div>
        <div class="ppt-stat-info">
            <div class="stat-value">@active</div>
            <div class="stat-label">Active</div>
        </div>
    </div>
    <div class="ppt-stat-card">
        <div class="ppt-stat-icon" style="background:#f1f5f9;">
            <i class="fa-solid fa-circle-xmark" style="color:#94a3b8;"></i>
        </div>
        <div class="ppt-stat-info">
            <div class="stat-value">@inactive</div>
            <div class="stat-label">Inactive</div>
        </div>
    </div>
    <div class="ppt-stat-card">
        <div class="ppt-stat-icon" style="background:#fef3c7;">
            <i class="fa-solid fa-database" style="color:#f59e0b;"></i>
        </div>
        <div class="ppt-stat-info">
            <div class="stat-value">@totalSizeFormatted</div>
            <div class="stat-label">Total Size</div>
        </div>
    </div>
</div>

<div class="ppt-filter-bar">
    <select class="ppt-filter-select" id="courseFilter">
        <option value="">All Courses</option>
        @foreach (var course in Model.Select(p => new { p.CourseId, p.CourseName }).Distinct().OrderBy(c => c.CourseName))
        {
            <option value="@course.CourseId">@course.CourseName</option>
        }
    </select>

    <select class="ppt-filter-select" id="statusFilter">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
    </select>

    <div class="ppt-search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="pptSearch" placeholder="Search PPT title...">
    </div>
</div>

@if (!Model.Any())
{
    <div class="ppt-empty-state">
        <i class="fa-solid fa-file-powerpoint"></i>
        <h3>No PPTs Uploaded Yet</h3>
        <p>Upload your first Interactive PowerPoint presentation to get started.</p>
        <a asp-action="Upload" class="ppt-btn-primary">
            <i class="fa-solid fa-plus"></i>
            Upload PPT
        </a>
    </div>
}
else
{
    <div class="ppt-table-container">
        <table class="ppt-table">
            <thead>
                <tr>
                    <th>PPT Title</th>
                    <th>Course Details</th>
                    <th>Unit & Topic</th>
                    <th>File Info</th>
                    <th>Uploaded</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="pptTableBody">
                @foreach (var item in Model)
                {
                    <tr data-course-id="@item.CourseId" data-status="@(item.IsActive ? "active" : "inactive")">
                        <td class="ppt-title-cell">
                            <span class="ppt-title">@item.Title</span>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <span class="ppt-desc">@item.Description</span>
                            }
                        </td>
                        <td>
                            <div class="ppt-meta-tag">
                                <i class="fa-solid fa-graduation-cap"></i> @item.ProgramName
                            </div>
                            <div class="ppt-meta-tag">
                                <i class="fa-solid fa-book"></i> @item.CourseName
                            </div>
                        </td>
                        <td>
                            <div class="ppt-meta-tag">
                                <i class="fa-solid fa-layer-group"></i> @item.UnitName
                            </div>
                            <div class="ppt-meta-tag">
                                <i class="fa-solid fa-bookmark"></i> @item.TopicName
                            </div>
                        </td>
                        <td>
                            <div class="ppt-meta-tag">
                                <i class="fa-solid fa-file"></i> @item.FileSizeFormatted
                            </div>
                            @if (!string.IsNullOrEmpty(item.OriginalFileName))
                            {
                                <div class="ppt-meta-tag" title="@item.OriginalFileName">
                                    <i class="fa-solid fa-paperclip"></i> @(item.OriginalFileName.Length > 20 ? item.OriginalFileName.Substring(0, 20) + "..." : item.OriginalFileName)
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-size: 12px; color: var(--ppt-muted);">
                                <i class="fa-regular fa-calendar"></i> @item.UploadedDateStr
                            </div>
                        </td>
                        <td>
                            <span class="@item.StatusBadgeClass">@item.StatusText</span>
                        </td>
                        <td>
                            <div class="ppt-actions">
                                <a href="@Url.Action("View", "InteractivePPT", new { pptId = item.Id })"
                                   class="ppt-action-btn view" title="View Slides (Student Preview)">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="@Url.Action("ManageInteractions", "InteractivePPT", new { pptId = item.Id })"
                                   class="ppt-action-btn" title="Manage Slide Interactions"
                                   style="color:#6366f1;border-color:#c7d2fe;">
                                    <i class="fa-solid fa-puzzle-piece"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="ppt-action-btn" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button class="ppt-action-btn danger" title="Delete" onclick="deletePPT(@item.Id)">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    // ── Filter & Search ──
    const searchInput = document.getElementById('pptSearch');
    const courseFilter = document.getElementById('courseFilter');
    const statusFilter = document.getElementById('statusFilter');
    const tableRows = document.querySelectorAll('#pptTableBody tr');

    function filterPPTs() {
        const query = searchInput.value.toLowerCase();
        const selectedCourse = courseFilter.value;
        const selectedStatus = statusFilter.value;

        tableRows.forEach(row => {
            const title = row.querySelector('.ppt-title').textContent.toLowerCase();
            const courseId = row.dataset.courseId;
            const status = row.dataset.status;

            const matchesSearch = title.includes(query);
            const matchesCourse = !selectedCourse || courseId === selectedCourse;
            const matchesStatus = !selectedStatus || status === selectedStatus;

            row.style.display = (matchesSearch && matchesCourse && matchesStatus) ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', filterPPTs);
    courseFilter.addEventListener('change', filterPPTs);
    statusFilter.addEventListener('change', filterPPTs);

    // ── Delete PPT ──
    function deletePPT(id) {
        if (!confirm('Are you sure you want to delete this PPT? This action will deactivate the PPT.')) return;

        fetch('@Url.Action("Delete")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: 'id=' + id
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Error deleting PPT');
            }
        })
        .catch(err => {
            alert('Error deleting PPT: ' + err.message);
        });
    }
</script>
@Html.AntiForgeryToken()
}
