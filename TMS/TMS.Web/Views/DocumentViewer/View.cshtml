@model TMS.ViewModels.Masters.LectureMaterialViewModel

@{
    ViewData["Title"] = "Document Viewer — " + Model.Title;

    string viewerType          = ViewBag.ViewerType          ?? "Unsupported";
    string iframeSrc           = ViewBag.IframeSrc           ?? "";
    string fileExt             = ViewBag.FileExtension       ?? "";
    bool   isLocal             = ViewBag.IsLocalhost         ?? false;
    bool   showConvWarn        = ViewBag.ShowConversionWarning ?? false;
    string downloadUrl         = ViewBag.DownloadUrl         ?? "#";
    string backUrl             = ViewBag.BackUrl             ?? "/StudentCourseContent/Index";
    string courseName          = ViewBag.CourseName          ?? "Course";

    string extLabel = fileExt.TrimStart('.').ToUpperInvariant();
    string iconClass = extLabel switch {
        "PDF"  => "fa-file-pdf",
        "DOC"  => "fa-file-word",
        "DOCX" => "fa-file-word",
        "PPT"  => "fa-file-powerpoint",
        "PPTX" => "fa-file-powerpoint",
        "XLS"  => "fa-file-excel",
        "XLSX" => "fa-file-excel",
        _      => "fa-file-lines"
    };
    string iconColor = extLabel switch {
        "PDF"            => "#ef4444",
        "DOC" or "DOCX" => "#3b82f6",
        "PPT" or "PPTX" => "#f97316",
        "XLS" or "XLSX" => "#16a34a",
        _               => "#6366f1"
    };
}

<meta name="description" content="View document @Model.Title inline in the LMS.">

<style>
    /* ── Reset / Base ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .dv-page {
        font-family: 'Jost', 'Segoe UI', system-ui, sans-serif;
        background: #f1f5f9;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ── Top bar ─────────────────────────────────────────────── */
    .dv-topbar {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 60%, #7c3aed 100%);
        padding: 14px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        box-shadow: 0 4px 20px rgba(99,102,241,.35);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .dv-tb-left {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: 1;
        min-width: 0;
    }

    .dv-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 10px;
        color: #fff;
        text-decoration: none;
        font-size: 15px;
        transition: background .18s;
        flex-shrink: 0;
    }
    .dv-back-btn:hover { background: rgba(255,255,255,.28); color: #fff; }

    .dv-file-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
        flex-shrink: 0;
    }

    .dv-meta {
        min-width: 0;
        flex: 1;
    }
    .dv-meta-title {
        font-size: 15px;
        font-weight: 800;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.25;
    }
    .dv-meta-sub {
        font-size: 11.5px;
        color: rgba(255,255,255,.72);
        margin-top: 2px;
    }

    .dv-tb-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .dv-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 9px;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all .18s;
        white-space: nowrap;
    }
    .dv-btn-fs {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
    }
    .dv-btn-fs:hover { background: rgba(255,255,255,.28); color: #fff; }

    .dv-btn-dl {
        background: #fff;
        color: #4f46e5;
    }
    .dv-btn-dl:hover { background: #f0f0ff; color: #4338ca; box-shadow: 0 4px 14px rgba(0,0,0,.12); }

    /* ── Notice strip ──────────────────────────────────────────── */
    .dv-notice-strip {
        background: #fff7ed;
        border-bottom: 2px solid #fed7aa;
        padding: 10px 24px;
        font-size: 13px;
        color: #92400e;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dv-notice-strip i { color: #f97316; font-size: 16px; flex-shrink: 0; }

    /* ── Viewer area ───────────────────────────────────────────── */
    .dv-viewer-wrap {
        flex: 1;
        position: relative;
        overflow: hidden;
        background: #e2e8f0;
        /* Fixed height so the iframe fills viewport minus the top bar */
        min-height: calc(100vh - 70px);
        display: flex;
        flex-direction: column;
    }

    /* Loading overlay */
    .dv-loader {
        position: absolute;
        inset: 0;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 20;
        transition: opacity .4s;
    }
    .dv-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e2e8f0;
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: dvSpin 1s linear infinite;
    }
    @@keyframes dvSpin { to { transform: rotate(360deg); } }
    .dv-loader-text { font-size: 14px; font-weight: 600; color: #64748b; }

    /* The iframe itself */
    .dv-iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
        background: #fff;
    }

    /* Image viewer */
    .dv-img-wrap {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        padding: 24px;
    }
    .dv-img-wrap img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 12px 40px rgba(0,0,0,.5);
    }

    /* Error / unsupported card */
    .dv-error-card {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }
    .dv-error-inner {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 12px 40px rgba(0,0,0,.1);
        border: 1px solid #e2e8f0;
        padding: 48px 40px;
        text-align: center;
        max-width: 480px;
        width: 100%;
    }
    .dv-error-icon { font-size: 52px; margin-bottom: 18px; }
    .dv-error-title { font-size: 20px; font-weight: 800; color: #1e293b; margin-bottom: 8px; }
    .dv-error-desc  { font-size: 13.5px; color: #64748b; line-height: 1.65; margin-bottom: 24px; }
    .dv-error-dl {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 24px;
        background: #6366f1;
        color: #fff;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: background .18s;
    }
    .dv-error-dl:hover { background: #4f46e5; color: #fff; }

    /* Fullscreen */
    .dv-viewer-wrap:fullscreen { width: 100%; height: 100%; }
    .dv-viewer-wrap:-webkit-full-screen { width: 100%; height: 100%; }
    .dv-viewer-wrap:fullscreen .dv-iframe  { position: absolute; inset: 0; }

    @@media(max-width:640px) {
        .dv-topbar { padding: 12px 14px; gap: 10px; }
        .dv-meta-title { font-size: 13px; }
        .dv-btn { padding: 7px 12px; font-size: 12px; }
    }
</style>

<div class="dv-page" id="dvPage">

    <!-- ── Top bar ─────────────────────────────────────────────── -->
    <div class="dv-topbar">
        <div class="dv-tb-left">
            <!-- Back button -->
            <a href="@backUrl" class="dv-back-btn" id="dvBackBtn" title="Go back">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <!-- File icon -->
            <div class="dv-file-icon">
                <i class="fa-solid @iconClass"></i>
            </div>

            <!-- Title + subtitle -->
            <div class="dv-meta">
                <div class="dv-meta-title" title="@Model.Title">@Model.Title</div>
                <div class="dv-meta-sub">
                    @if (!string.IsNullOrEmpty(courseName) && courseName != "Course")
                    {
                        <span>@courseName</span><span style="margin:0 6px;opacity:.55;">&middot;</span>
                    }
                    <span style="text-transform:uppercase;letter-spacing:.5px;font-weight:700;">@extLabel</span>
                    @if (isLocal && viewerType == "ConvertedPDF")
                    {
                        <span style="margin-left:8px;background:rgba(255,255,255,.18);border-radius:20px;padding:1px 9px;font-size:10.5px;">
                            <i class="fa-solid fa-rotate"></i> Converted PDF
                        </span>
                    }
                    else if (!isLocal && (viewerType == "OfficeOnline"))
                    {
                        <span style="margin-left:8px;background:rgba(255,255,255,.18);border-radius:20px;padding:1px 9px;font-size:10.5px;">
                            <i class="fa-brands fa-microsoft"></i> Office Online
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="dv-tb-right">
            <!-- Fullscreen -->
            <button class="dv-btn dv-btn-fs" id="dvFsBtn" onclick="toggleFullscreen()" title="Toggle fullscreen">
                <i class="fa-solid fa-expand" id="dvFsIcon"></i>
                <span class="d-none d-sm-inline">Fullscreen</span>
            </button>
            <!-- Download (always shown) -->
            <a href="@downloadUrl" class="dv-btn dv-btn-dl" id="dvDlBtn" title="Download file">
                <i class="fa-solid fa-download"></i>
                <span class="d-none d-sm-inline">Download</span>
            </a>
        </div>
    </div>

    <!-- ── Warning strip: conversion failed ─────────────────────── -->
    @if (showConvWarn)
    {
        <div class="dv-notice-strip">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>
                Preview conversion failed. LibreOffice may not be installed or the file may be corrupt.
                Please <a href="@downloadUrl" style="color:#92400e;font-weight:700;">download the file</a> to view it locally.
                See <em>Setup Instructions</em> below to install LibreOffice.
            </span>
        </div>
    }

    <!-- ── Viewer area ─────────────────────────────────────────── -->
    <div class="dv-viewer-wrap" id="dvViewerWrap">

        <!-- Loading spinner -->
        <div class="dv-loader" id="dvLoader">
            <div class="dv-spinner"></div>
            <div class="dv-loader-text" id="dvLoaderText">
                @if (viewerType == "ConvertedPDF")
                {
                    <text>Loading converted PDF…</text>
                }
                else if (viewerType == "OfficeOnline")
                {
                    <text>Loading Microsoft Office Online Viewer…</text>
                }
                else if (viewerType == "PDF")
                {
                    <text>Loading PDF…</text>
                }
                else
                {
                    <text>Preparing preview…</text>
                }
            </div>
        </div>

        @if (viewerType == "PDF" || viewerType == "ConvertedPDF" || viewerType == "OfficeOnline")
        {
            <!-- Standard iframe viewer -->
            <iframe id="dvIframe"
                    class="dv-iframe"
                    src="@iframeSrc"
                    onload="hideLoader()"
                    onerror="showError('The file could not be loaded inside the viewer.')"
                    allow="fullscreen"
                    allowfullscreen
                    title="@Model.Title">
            </iframe>
        }
        else if (viewerType == "Image")
        {
            <div class="dv-img-wrap" id="dvImgWrap">
                <img src="@iframeSrc"
                     alt="@Model.Title"
                     onload="hideLoader()"
                     onerror="showError('Image could not be loaded.')" />
            </div>
        }
        else if (viewerType == "ConversionFailed")
        {
            <div class="dv-error-card">
                <div class="dv-error-inner">
                    <div class="dv-error-icon"><i class="fa-solid fa-circle-xmark" style="color:#ef4444;"></i></div>
                    <div class="dv-error-title">Preview Unavailable</div>
                    <div class="dv-error-desc">
                        The document (@extLabel) could not be converted for preview on this server.<br><br>
                        <strong>Possible causes:</strong><br>
                        • LibreOffice is not installed on the server.<br>
                        • The file may be password-protected or corrupt.<br><br>
                        You can download the file and open it with the appropriate application.
                    </div>
                    <a href="@downloadUrl" class="dv-error-dl">
                        <i class="fa-solid fa-download"></i> Download to View
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Unsupported file type -->
            <div class="dv-error-card">
                <div class="dv-error-inner">
                    <div class="dv-error-icon"><i class="fa-solid fa-file-circle-question" style="color:#94a3b8;"></i></div>
                    <div class="dv-error-title">Preview Not Available</div>
                    <div class="dv-error-desc">
                        The file format <strong>@extLabel</strong> cannot be previewed in the browser.<br>
                        Please download the file to open it with the appropriate application.
                    </div>
                    <a href="@downloadUrl" class="dv-error-dl">
                        <i class="fa-solid fa-download"></i> Download File
                    </a>
                </div>
            </div>
        }

    </div><!-- /dv-viewer-wrap -->

</div><!-- /dv-page -->

@section Scripts {
<script>
    // ── Hide loader ──────────────────────────────────────────────
    function hideLoader() {
        var l = document.getElementById('dvLoader');
        if (!l) return;
        l.style.opacity = '0';
        setTimeout(function() { l.style.display = 'none'; }, 400);
    }

    function showError(msg) {
        var l = document.getElementById('dvLoader');
        if (!l) return;
        l.innerHTML = '<div style="text-align:center;padding:24px;max-width:400px;">'
            + '<i class="fa-solid fa-circle-xmark" style="font-size:40px;color:#ef4444;margin-bottom:14px;display:block;"></i>'
            + '<div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:8px;">Preview Failed</div>'
            + '<div style="font-size:13px;color:#64748b;line-height:1.6;margin-bottom:20px;">' + msg + '</div>'
            + '<a href="' + (document.getElementById('dvDlBtn')?.href || '#') + '" style="display:inline-flex;align-items:center;gap:8px;padding:10px 22px;background:#6366f1;color:#fff;border-radius:9px;font-size:13px;font-weight:700;text-decoration:none;">'
            + '<i class="fa-solid fa-download"></i> Download File</a></div>';
        l.style.display = 'flex';
        l.style.opacity = '1';
    }

    // ── Fullscreen ───────────────────────────────────────────────
    var _inFs = false;
    function toggleFullscreen() {
        var el = document.getElementById('dvViewerWrap');
        if (!el) return;
        if (!_inFs) {
            var fn = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
            if (fn) fn.call(el);
        } else {
            var ex = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
            if (ex) ex.call(document);
        }
    }

    document.addEventListener('fullscreenchange',       onFsChange);
    document.addEventListener('webkitfullscreenchange', onFsChange);
    document.addEventListener('mozfullscreenchange',    onFsChange);
    document.addEventListener('MSFullscreenChange',     onFsChange);

    function onFsChange() {
        _inFs = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
        var icon = document.getElementById('dvFsIcon');
        if (icon) icon.className = _inFs ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
    }

    // ── Auto-hide loader for static/unsupported views ────────────
    window.addEventListener('DOMContentLoaded', function() {
        var vt = '@viewerType';
        if (vt === 'Unsupported' || vt === 'ConversionFailed') {
            hideLoader();
        }
        // Safety timeout: hide loader after 30 s in case iframe never fires onload
        setTimeout(function() {
            var l = document.getElementById('dvLoader');
            if (l && l.style.display !== 'none') hideLoader();
        }, 30000);
    });

    // ── Keep back button working even if referrer is empty ───────
    document.getElementById('dvBackBtn')?.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        if (!href || href === '' || href === '#') {
            e.preventDefault();
            history.length > 1 ? history.back() : (window.location.href = '/StudentCourseContent/Index');
        }
    });
</script>
}
