@model TMS.ViewModels.Academics.StudentCourseCategoryViewModel
@{ ViewData["Title"] = "My Courses"; }

<style>
    .sc-page { padding:24px 30px; max-width:1200px; font-family:'Jost','Segoe UI',sans-serif; }
    .sc-bc { font-size:13px; color:#94a3b8; margin-bottom:14px; display:flex; align-items:center; gap:6px; }
    .sc-bc a { color:#64748b; text-decoration:none; } .sc-bc a:hover { color:#6366f1; }
    .sc-bc strong { color:#1e293b; }
    .sc-hero { background:linear-gradient(135deg,#6366f1,#4f46e5 60%,#7c3aed); border-radius:18px; padding:32px 36px; color:#fff; margin-bottom:28px; position:relative; overflow:hidden; box-shadow:0 8px 32px rgba(99,102,241,.28); }
    .sc-hero::before { content:''; position:absolute; right:-60px; top:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,.06); }
    .sc-hero h1 { font-size:24px; font-weight:900; margin:0 0 8px; position:relative; z-index:1; }
    .sc-hero p { font-size:14px; opacity:.85; margin:0; line-height:1.7; position:relative; z-index:1; }
    .sc-hero-stats { display:flex; gap:28px; margin-top:18px; position:relative; z-index:1; }
    .sc-hero-stat .stat-val { font-size:28px; font-weight:900; } .sc-hero-stat .stat-lbl { font-size:11px; opacity:.7; text-transform:uppercase; letter-spacing:.6px; margin-top:4px; }
    .sc-sec-title { font-size:16px; font-weight:800; color:#1e293b; display:flex; align-items:center; gap:8px; margin-bottom:18px; }
    .sc-sec-title i { color:#6366f1; }
    .sem-card { background:#fff; border-radius:16px; border:1px solid #eef2f6; box-shadow:0 2px 16px rgba(0,0,0,.04); overflow:hidden; margin-bottom:22px; }
    .sem-header { display:flex; justify-content:space-between; align-items:center; padding:18px 26px; background:linear-gradient(135deg,#f8fafc,#f1f5f9); border-bottom:1px solid #eef2f6; }
    .sem-header-title { font-size:16px; font-weight:800; color:#1e293b; display:flex; align-items:center; gap:8px; }
    .sem-header-title i { color:#6366f1; font-size:14px; }
    .sem-count { font-size:12px; color:#fff; font-weight:700; background:#6366f1; padding:4px 12px; border-radius:20px; }
    .course-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; padding:20px 24px; }
    .course-card { background:#fff; border-radius:14px; border:1.5px solid #eef2f6; padding:22px; transition:all .22s; cursor:pointer; text-decoration:none; display:block; position:relative; overflow:hidden; }
    .course-card::before { content:''; position:absolute; top:0; left:0; width:4px; height:100%; background:#6366f1; transform:scaleY(0); transition:transform .2s; transform-origin:bottom; }
    .course-card:hover { transform:translateY(-4px); box-shadow:0 12px 32px rgba(99,102,241,.14); border-color:#c7d2fe; }
    .course-card:hover::before { transform:scaleY(1); }
    .cc-top { display:flex; align-items:flex-start; gap:14px; margin-bottom:14px; }
    .cc-icon { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
    .cc-info h4 { font-size:15px; font-weight:800; color:#1e293b; margin:0 0 4px; }
    .cc-code { font-size:12px; font-weight:600; color:#6366f1; background:#eff6ff; padding:2px 10px; border-radius:6px; }
    .cc-arrow { font-size:13px; font-weight:700; color:#6366f1; display:inline-flex; align-items:center; gap:6px; transition:gap .2s; }
    .course-card:hover .cc-arrow { gap:10px; }
    .sc-empty { text-align:center; padding:60px 24px; background:#fff; border-radius:16px; border:1px solid #eef2f6; }
    .sc-empty i { font-size:48px; color:#cbd5e1; margin-bottom:14px; display:block; }
    .sc-empty p { color:#94a3b8; font-size:15px; margin:0; }
    @@media(max-width:768px) { .sc-page{padding:16px;} .course-grid{grid-template-columns:1fr;padding:16px;} }
</style>

<div class="sc-page">
    <div class="sc-bc">
        <a asp-controller="Home" asp-action="StudentDashboard"><i class="fa-solid fa-house"></i> Dashboard</a>
        <span>/</span> <strong>My Courses</strong>
    </div>
    <div class="sc-hero">
        <h1><i class="fa-solid fa-graduation-cap" style="font-size:20px;opacity:.85;margin-right:8px;"></i>My Courses</h1>
        <p>@Model.CategoryDescription</p>
        <div class="sc-hero-stats">
            <div class="sc-hero-stat"><div class="stat-val">@(Model.Semesters?.Sum(s => s.Courses.Count) ?? 0)</div><div class="stat-lbl">Subjects</div></div>
            <div class="sc-hero-stat"><div class="stat-val">@(Model.Semesters?.Count ?? 0)</div><div class="stat-lbl">Semesters</div></div>
        </div>
    </div>
    <div class="sc-sec-title"><i class="fa-solid fa-book-open-reader"></i> Semester Subjects</div>
    @if (Model.Semesters != null && Model.Semesters.Any())
    {
        foreach (var sem in Model.Semesters)
        {
            <div class="sem-card">
                <div class="sem-header">
                    <span class="sem-header-title"><i class="fa-solid fa-calendar-days"></i> Semester @sem.Semester</span>
                    <span class="sem-count">@sem.Courses.Count Subjects</span>
                </div>
                <div class="course-grid">
                    @{ string[] cBg={"#eff6ff","#fef9c3","#f0fdf4","#fff7ed","#fdf4ff","#fef2f2"}; string[] cCl={"#3b82f6","#ca8a04","#16a34a","#ea580c","#a855f7","#ef4444"}; string[] cIc={"fa-book","fa-calculator","fa-flask","fa-landmark","fa-palette","fa-chart-line"}; int ci=0; }
                    @foreach (var course in sem.Courses)
                    { int cx=ci%6;
                        <a href="@Url.Action("Details","StudentCourse",new{courseId=course.CourseId})" class="course-card">
                            <div class="cc-top">
                                <div class="cc-icon" style="background:@cBg[cx];color:@cCl[cx];"><i class="fa-solid @cIc[cx]"></i></div>
                                <div class="cc-info"><h4>@course.CourseName</h4><span class="cc-code">@course.CourseCode</span></div>
                            </div>
                            <div class="cc-bottom"><span class="cc-arrow">Open Subject <i class="fa-solid fa-arrow-right"></i></span></div>
                        </a>
                        ci++;
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="sc-empty"><i class="fa-solid fa-book-open"></i><p>You are not enrolled in any courses yet.</p></div>
    }
</div>
