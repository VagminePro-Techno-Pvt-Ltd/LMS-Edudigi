@model IEnumerable<TMS.Models.Academics.AssignmentSubmission>
@{
    var grades = ViewBag.Grades as IEnumerable<TMS.Models.Academics.AssignmentGrade> ?? Enumerable.Empty<TMS.Models.Academics.AssignmentGrade>();
}

<div class="d-flex flex-column gap-3 font-9">
    @if (!Model.Any())
    {
        <p class="text-center text-muted my-3">No attempts submitted yet.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            var grade = grades.FirstOrDefault(g => g.SubmissionId == item.Id);
            <div class="p-3 border rounded shadow-sm bg-white" style="border-left: 4px solid @(item.Status == "Graded" ? "#198754" : (item.Status == "LateSubmitted" ? "#dc3545" : "#0dcaf0")) !important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="font-weight-bold text-dark">Attempt #@item.AttemptNumber</span>
                    <span class="text-muted font-85">@item.SubmittedOn.ToString("dd MMM yyyy hh:mm tt")</span>
                </div>
                
                @if (!string.IsNullOrEmpty(item.SubmissionText))
                {
                    <div class="text-secondary bg-light p-2 rounded mb-2 font-85">
                        @item.SubmissionText
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        @if (!string.IsNullOrEmpty(item.AttachmentPath))
                        {
                            <a href="@item.AttachmentPath" target="_blank" class="btn btn-xs btn-outline-secondary">
                                <i class="fa-solid fa-download me-1"></i> Download File
                            </a>
                        }
                    </div>
                    <div>
                        @if (grade != null)
                        {
                            <span class="badge bg-success">Graded: @grade.Marks Marks</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pending Grade</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
