@model TMS.ViewModels.Integration.IntegrationHubDashboardViewModel
@{
    ViewData["Title"] = "System Integrations & API Connectors";
}

<div class="container-fluid py-3" id="integrations-hub">
    <!-- Page Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fa-solid fa-network-wired text-primary me-2"></i>System Integrations &amp; API Connectors
            </h2>
            <p class="text-muted small mb-0">
                Centralized management, operational status, resilience policies, and credential security for EduDigiClass external services.
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm shadow-sm">
                <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Status
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Counters -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Total Connectors</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalIntegrations</h3>
                        <span class="text-muted" style="font-size:11.5px;">Registered providers</span>
                    </div>
                    <div style="width:48px; height:48px; border-radius:12px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:22px;">
                        <i class="fa-solid fa-plug"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Configured &amp; Active</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@Model.ConfiguredCount</h3>
                        <span class="text-muted" style="font-size:11.5px;">Ready for operations</span>
                    </div>
                    <div style="width:48px; height:48px; border-radius:12px; background:#ecfdf5; color:#059669; display:flex; align-items:center; justify-content:center; font-size:22px;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Needs Setup / Attention</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@Model.MisconfiguredCount</h3>
                        <span class="text-muted" style="font-size:11.5px;">Missing required keys</span>
                    </div>
                    <div style="width:48px; height:48px; border-radius:12px; background:#fffbeb; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:22px;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Disabled / Inactive</span>
                        <h3 class="fw-bold text-secondary mb-0 mt-1">@Model.DisabledCount</h3>
                        <span class="text-muted" style="font-size:11.5px;">Locally managed fallback</span>
                    </div>
                    <div style="width:48px; height:48px; border-radius:12px; background:#f1f5f9; color:#64748b; display:flex; align-items:center; justify-content:center; font-size:22px;">
                        <i class="fa-solid fa-power-off"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Integrations Grid -->
    <div class="row g-4 mb-4">
        @foreach (var provider in Model.Providers)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 position-relative" style="overflow:hidden;">
                    <!-- Top Category Accent Strip -->
                    <div style="height:4px; background:@provider.BadgeColor;"></div>

                    <div class="card-body p-4 d-flex flex-direction-column justify-content-between" style="display:flex; flex-direction:column;">
                        <div>
                            <!-- Header: Icon, Name & Status Pill -->
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width:44px; height:44px; border-radius:12px; background:@(provider.BadgeColor)15; color:@provider.BadgeColor; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
                                        <i class="@provider.IconClass"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0" style="font-size:15.5px;">@provider.DisplayName</h5>
                                        <span class="badge" style="background:#f1f5f9; color:#475569; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">
                                            @provider.Category
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    @switch (provider.Status)
                                    {
                                        case TMS.ViewModels.Integration.IntegrationOperationalStatus.Configured:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:11px;">
                                                <i class="fa-solid fa-check me-1"></i>Configured
                                            </span>
                                            break;
                                        case TMS.ViewModels.Integration.IntegrationOperationalStatus.Disabled:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" style="font-size:11px;">
                                                <i class="fa-solid fa-pause me-1"></i>Disabled
                                            </span>
                                            break;
                                        case TMS.ViewModels.Integration.IntegrationOperationalStatus.Misconfigured:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size:11px;">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Setup Needed
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" style="font-size:11px;">
                                                <i class="fa-solid fa-question me-1"></i>Unverified
                                            </span>
                                            break;
                                    }
                                </div>
                            </div>

                            <!-- Description -->
                            <p class="text-muted mb-3" style="font-size:12.5px; line-height:1.45;">
                                @provider.Description
                            </p>

                            <!-- Operational Summary Message -->
                            <div class="p-2 mb-3 rounded-2" style="background:#f8fafc; border:1px solid #e2e8f0; font-size:12px; color:#334155;">
                                <strong class="text-secondary small d-block mb-1" style="font-size:10.5px; text-transform:uppercase; letter-spacing:0.4px;">
                                    Status Summary:
                                </strong>
                                @provider.StatusSummary
                            </div>

                            <!-- Masked Configuration Parameters Table -->
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-borderless mb-0" style="font-size:11.5px;">
                                    <tbody>
                                        @foreach (var kvp in provider.MaskedConfig)
                                        {
                                            <tr style="border-bottom:1px dashed #f1f5f9;">
                                                <td class="text-muted ps-0 py-1" style="width:38%;">@kvp.Key:</td>
                                                <td class="font-monospace text-dark py-1 text-truncate" style="max-width:180px;">@kvp.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Warnings if present -->
                            @if (provider.Warnings.Any())
                            {
                                <div class="alert alert-warning py-1 px-2 mb-3" style="font-size:11.5px;">
                                    @foreach (var w in provider.Warnings)
                                    {
                                        <div><i class="fa-solid fa-circle-exclamation me-1"></i>@w</div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Card Actions -->
                        <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto">
                            @if (provider.SupportsLiveCheck)
                            {
                                <form asp-action="CheckHealth" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="providerKey" value="@provider.ProviderKey" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" style="font-size:11.5px;">
                                        <i class="fa-solid fa-stethoscope me-1"></i> Test Config
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:11px;">Managed locally</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(provider.AdminManagementUrl))
                            {
                                <a href="@provider.AdminManagementUrl" class="btn btn-primary btn-sm" style="font-size:11.5px; background:@provider.BadgeColor; border-color:@provider.BadgeColor;">
                                    <span>Manage</span> <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Outbox Activity & Structured Audit Logs -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Recent Outbox &amp; Integration Activity
                        </h5>
                        <p class="text-muted small mb-0">Sanitized delivery logs from the asynchronous transactional outbox.</p>
                    </div>
                    <div>
                        <a href="@Url.Action("Index", "EmailAdmin")" class="btn btn-sm btn-outline-secondary">
                            View Full Outbox Queue <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                        </a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size:12.5px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Timestamp (UTC)</th>
                                    <th>Provider</th>
                                    <th>Operation</th>
                                    <th>Status</th>
                                    <th>Correlation ID</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentActivityLogs.Any())
                                {
                                    @foreach (var log in Model.RecentActivityLogs)
                                    {
                                        <tr>
                                            <td class="ps-4 text-muted font-monospace" style="font-size:11.5px;">
                                                @log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@log.ProviderKey</span>
                                            </td>
                                            <td class="fw-semibold">@log.Operation</td>
                                            <td>
                                                @if (log.Level == "Information")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Success</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Warning</span>
                                                }
                                            </td>
                                            <td class="font-monospace text-muted" style="font-size:11px;">
                                                @(string.IsNullOrWhiteSpace(log.CorrelationId) ? "—" : log.CorrelationId)
                                            </td>
                                            <td class="text-truncate" style="max-width:320px;" title="@log.Message">
                                                @log.Message
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="fa-regular fa-folder-open d-block mb-2" style="font-size:24px;"></i>
                                            No recent outbox delivery events recorded yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
