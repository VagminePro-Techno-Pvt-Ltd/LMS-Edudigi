@model TMS.ViewModels.Masters.CourseMasterViewModel
@{
    var permissions = ViewContext.HttpContext.GetFormPermissions();
}

<style>
    .course-card-premium {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        border-radius: 24px;
        border: 1px solid rgba(226, 232, 240, 0.6);
        padding: 36px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.04);
    }

    .form-label-premium {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .form-label-premium .label-icon {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: white;
    }

    .input-premium {
        width: 100%;
        padding: 13px 18px;
        border-radius: 14px;
        border: 1.5px solid #e2e8f0;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        background: #f8fafc;
        font-size: 0.95rem;
        color: #1e293b;
    }

    .input-premium:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.08);
        background: #fff;
        outline: none;
    }

    .section-header-premium {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 28px;
        padding-bottom: 18px;
        border-bottom: 2px solid #f1f5f9;
    }

    .section-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #6366f1, #818cf8);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }

    .form-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
        margin: 28px 0;
    }

    .form-section-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e2e8f0;
    }

    .status-toggle-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px 20px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 14px;
        border: 1px solid #e2e8f0;
    }
</style>

<form method="post" class="noclick" id="frmItem" disabled="@(!permissions.Add && !permissions.Edit)">
    <div class="course-card-premium">
        <div class="section-header-premium">
            <div class="section-icon">📖</div>
            <div>
                <h3 style="margin:0; font-weight:800; color:#1e293b; letter-spacing:-0.02em;">
                    @(Model!.Id > 0 ? "Update Course" : "New Course Registration")
                </h3>
                <p style="margin:0; font-size:0.85rem; color:#64748b;">Define a course under a specific Program and Semester.</p>
            </div>
        </div>

        <input asp-for="Id" type="hidden" />
        <input id="hdAddEditActionAllowed" type="hidden" value="@permissions.CanShowAddEditButton(Model!.Id).ToString().ToLower()" />

        <!-- ═══════ SECTION: Program & Semester ═══════ -->
        <div class="form-section-label">
            <i class="fa fa-sitemap" style="color:#6366f1;"></i> Program & Semester
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-4">
                <label asp-for="CourseCategoryId" class="form-label-premium">
                    <span class="label-icon" style="background:#6366f1;">🎓</span> Select Program
                </label>
                <select asp-for="CourseCategoryId" asp-items="ViewBag.CourseCategoryId" class="input-premium" required id="ddlProgram"></select>
                <span asp-validation-for="CourseCategoryId" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6 mb-4">
                <label asp-for="SemesterId" class="form-label-premium">
                    <span class="label-icon" style="background:#8b5cf6;">📅</span> Semester / Level
                </label>
                <select asp-for="SemesterId" asp-items="ViewBag.SemesterId" class="input-premium" required id="ddlSemester"></select>
                <span asp-validation-for="SemesterId" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-divider"></div>

        <!-- ═══════ SECTION: Course Details ═══════ -->
        <div class="form-section-label">
            <i class="fa fa-book-open" style="color:#8b5cf6;"></i> Course Details
        </div>

        <div class="row">
            <div class="col-12 col-md-4 mb-4">
                <label asp-for="CourseCode" class="form-label-premium">
                    <span class="label-icon" style="background:#f59e0b;">🔖</span> Course Code
                </label>
                <input asp-for="CourseCode" class="input-premium" placeholder="e.g. CS101" required />
                <span asp-validation-for="CourseCode" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-8 mb-4">
                <label asp-for="Name" class="form-label-premium">
                    <span class="label-icon" style="background:#10b981;">📝</span> Full Course Title
                </label>
                <input asp-for="Name" class="input-premium" placeholder="e.g. Advanced Data Structures" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-12 mb-4">
                <label asp-for="Description" class="form-label-premium">
                    <span class="label-icon" style="background:#64748b;">📋</span> Course Description
                </label>
                <textarea asp-for="Description" class="input-premium" rows="3" placeholder="Explain what this course covers..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-divider"></div>

        <!-- ═══════ SECTION: Academic Info ═══════ -->
        <div class="form-section-label">
            <i class="fa fa-chart-bar" style="color:#ec4899;"></i> Academic Configuration
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-4">
                <label asp-for="NoofCredit" class="form-label-premium">
                    <span class="label-icon" style="background:#ec4899;">⭐</span> Credits
                </label>
                <input asp-for="NoofCredit" type="number" class="input-premium" placeholder="e.g. 4" required />
                <span asp-validation-for="NoofCredit" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6 mb-4">
                <label asp-for="CourseDurationMonths" class="form-label-premium">
                    <span class="label-icon" style="background:#0ea5e9;">⏱</span> Duration (Days)
                </label>
                <input asp-for="CourseDurationMonths" type="number" class="input-premium" placeholder="e.g. 180" required />
                <span asp-validation-for="CourseDurationMonths" class="text-danger small"></span>
            </div>
        </div>

        @if (Model?.Id > 0)
        {
            <div class="form-divider"></div>
            <div class="col-12">
                <div class="status-toggle-card">
                    <span class="form-label-premium" style="margin:0;">Course Visibility:</span>
                    <div class="form-check form-switch m-0">
                        <input asp-for="IsActive" class="form-check-input" style="cursor:pointer; width: 44px; height: 22px;">
                        <label class="form-check-label ms-2" style="font-weight:700; color: @(Model.IsActive ? "#10b981" : "#ef4444")">
                            @(Model.IsActive ? "ACTIVE" : "INACTIVE")
                        </label>
                    </div>
                </div>
            </div>
        }
    </div>
</form>

<script>
    // ═══════ DEPENDENT DROPDOWN: Program → Semester ═══════
    $(document).ready(function () {
        var $program = $('#ddlProgram');
        var $semester = $('#ddlSemester');
        var currentSemesterId = '@Model?.SemesterId';

        $program.on('change', function () {
            var programId = $(this).val();
            if (!programId || programId === '0' || programId === '') {
                $semester.html('<option value="">-- Select Program First --</option>');
                return;
            }

            $semester.html('<option value="">Loading...</option>');

            $.getJSON('@Url.Action("GetSemestersByProgram", "Course", new { area = "Admin" })?programId=' + programId, function (data) {
                var options = '<option value="">-- Select Semester --</option>';
                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        var selected = (currentSemesterId && item.id.toString() === currentSemesterId.toString()) ? ' selected' : '';
                        options += '<option value="' + item.id + '"' + selected + '>' + item.name + '</option>';
                    });
                } else {
                    options = '<option value="">No semesters available</option>';
                }
                $semester.html(options);
                // Clear the currentSemesterId after first load so it doesn't persist on subsequent changes
                currentSemesterId = null;
            });
        });
    });
</script>