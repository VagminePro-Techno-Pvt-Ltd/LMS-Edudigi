@model List<TMS.Models.Email.EmailOutboxJob>
@{
    ViewData["Title"] = "Email Notifications & Outbox Hub";
    var settings = ViewBag.Settings as TMS.ViewModels.Email.EmailSettings;
    bool isValid = ViewBag.IsValidConfig ?? false;
    string validationError = ViewBag.ValidationError as string ?? "";
}

<div class="container-fluid py-3" id="email-admin-hub">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-envelope-open-text text-primary me-2"></i>Automated Email Notifications & Outbox
            </h2>
            <p class="text-muted small mb-0">
                Transactional outbox monitoring, provider configuration status, rate limiting, and administrative email dispatch testing.
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="fas fa-sync-alt me-1"></i> Refresh Queue
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 text-center">
                    <span class="text-secondary small fw-bold text-uppercase">Pending</span>
                    <h3 class="fw-bold text-warning mb-0 mt-2">@ViewBag.PendingCount</h3>
                    <span class="text-muted" style="font-size:11px;">Awaiting worker</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 text-center">
                    <span class="text-secondary small fw-bold text-uppercase">Processing</span>
                    <h3 class="fw-bold text-primary mb-0 mt-2">@ViewBag.ProcessingCount</h3>
                    <span class="text-muted" style="font-size:11px;">Active lease</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 text-center">
                    <span class="text-secondary small fw-bold text-uppercase">Sent (Accepted)</span>
                    <h3 class="fw-bold text-success mb-0 mt-2">@ViewBag.SentCount</h3>
                    <span class="text-muted" style="font-size:11px;">Delivered to SMTP</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 text-center">
                    <span class="text-secondary small fw-bold text-uppercase">Failed</span>
                    <h3 class="fw-bold text-danger mb-0 mt-2">@ViewBag.FailedCount</h3>
                    <span class="text-muted" style="font-size:11px;">Retries exhausted</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 text-center">
                    <span class="text-secondary small fw-bold text-uppercase">Cancelled</span>
                    <h3 class="fw-bold text-secondary mb-0 mt-2">@ViewBag.CancelledCount</h3>
                    <span class="text-muted" style="font-size:11px;">Superseded</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Provider Configuration & Live Test Dispatch -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-server text-info me-2"></i>Provider & SMTP Configuration
                    </h5>
                    @if (isValid)
                    {
                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Config Valid</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-circle me-1"></i>Incomplete / Disabled</span>
                    }
                </div>
                <div class="card-body p-3">
                    @if (!isValid && !string.IsNullOrWhiteSpace(validationError))
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3">
                            <strong>Notice:</strong> @validationError
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size:13px;">
                            <tbody>
                                <tr>
                                    <th class="bg-light text-muted w-25">Master Switch</th>
                                    <td>
                                        @if (settings?.IsEnabled == true)
                                        {
                                            <span class="badge bg-success">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled (Safety Default)</span>
                                        }
                                    </td>
                                    <th class="bg-light text-muted w-25">Mode</th>
                                    <td>
                                        @if (settings?.TestMode == true)
                                        {
                                            <span class="badge bg-info text-dark">Test Mode (Restricted)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Production Live</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">SMTP Host</th>
                                    <td><code>@(settings?.Host ?? "Not set")</code>:<code>@(settings?.Port.ToString() ?? "587")</code></td>
                                    <th class="bg-light text-muted">TLS / SSL</th>
                                    <td>@(settings?.EnableSsl == true ? "Enabled (STARTTLS)" : "Disabled")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Sender Email</th>
                                    <td>@(settings?.SenderEmail ?? "Not set")</td>
                                    <th class="bg-light text-muted">Display Name</th>
                                    <td>@(settings?.SenderDisplayName ?? "Not set")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Account User</th>
                                    <td><code>@ViewBag.MaskedUser</code></td>
                                    <th class="bg-light text-muted">Test Recipient</th>
                                    <td><code>@(settings?.TestRecipientEmail ?? "None configured")</code></td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Rate Limit</th>
                                    <td>@(settings?.RateLimitPerMinute ?? 60) msgs/min</td>
                                    <th class="bg-light text-muted">Poll Interval</th>
                                    <td>@(settings?.DispatchIntervalSeconds ?? 10)s (Batch: @(settings?.BatchSize ?? 20))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="text-muted mt-2" style="font-size:11px;">
                        <i class="fas fa-lock me-1"></i>Passwords and secrets are securely protected and never exposed in the interface or client payloads.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-paper-plane text-primary me-2"></i>Send Test Email
                    </h5>
                </div>
                <div class="card-body p-3">
                    <p class="text-muted small mb-3">
                        Transmit a secure end-to-end verification message to confirm SMTP credentials, TLS handshake, and provider acceptance.
                    </p>
                    <form asp-action="SendTestEmail" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Authorized Test Recipient Address</label>
                            <input type="email" name="testRecipient" class="form-control form-control-sm" 
                                   value="@(settings?.TestRecipientEmail ?? "")" 
                                   placeholder="administrator@domain.com" required />
                            <div class="form-text" style="font-size:11px;">
                                Must be an administrator or developer authorized test mailbox.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100" @(settings?.IsEnabled == true ? "" : "disabled")>
                            <i class="fas fa-paper-plane me-1"></i> Dispatch Verification Email
                        </button>
                        @if (settings?.IsEnabled != true)
                        {
                            <div class="text-danger small mt-2 text-center" style="font-size:11px;">
                                <i class="fas fa-info-circle me-1"></i>Enable email in settings to send live test emails.
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Outbox Queue Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="fas fa-list-alt text-secondary me-2"></i>Recent Outbox Queue Activity (Last 50 Jobs)
            </h5>
            <span class="badge bg-light text-dark border">Total Loaded: @Model.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:13px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width:70px;">Job ID</th>
                            <th>Recipient</th>
                            <th>Subject & Event</th>
                            <th>Template</th>
                            <th style="width:110px;">Status</th>
                            <th style="width:70px;">Attempts</th>
                            <th>Scheduled / Sent</th>
                            <th>Last Error</th>
                            <th class="text-end pe-3" style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>No outbox jobs recorded yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in Model)
                            {
                                string badgeClass = job.Status switch
                                {
                                    "Sent" => "bg-success",
                                    "Pending" => "bg-warning text-dark",
                                    "Processing" => "bg-primary",
                                    "Failed" => "bg-danger",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-info text-dark"
                                };

                                <tr>
                                    <td class="ps-3 font-monospace fw-bold">#@job.Id</td>
                                    <td>
                                        <div class="fw-bold">@job.RecipientEmail</div>
                                        @if (!string.IsNullOrWhiteSpace(job.RecipientName))
                                        {
                                            <div class="text-muted" style="font-size:11px;">@job.RecipientName</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width:280px;" title="@job.Subject">@job.Subject</div>
                                        @if (!string.IsNullOrWhiteSpace(job.EventType))
                                        {
                                            <span class="badge bg-light text-secondary border mt-1" style="font-size:10px;">@job.EventType</span>
                                        }
                                    </td>
                                    <td><code>@job.TemplateName</code></td>
                                    <td><span class="badge @badgeClass">@job.Status</span></td>
                                    <td class="text-center">@job.AttemptCount / @job.MaxRetries</td>
                                    <td style="font-size:11px;">
                                        @if (job.SentAtUtc.HasValue)
                                        {
                                            <span class="text-success"><i class="fas fa-check me-1"></i>@job.SentAtUtc.Value.ToString("dd/MM/yy HH:mm") UTC</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sched: @job.ScheduledForUtc.ToString("dd/MM/yy HH:mm") UTC</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(job.LastError))
                                        {
                                            <span class="text-danger small text-truncate d-inline-block" style="max-width:200px;" title="@job.LastError">
                                                @job.LastError
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            @if (job.Status == "Failed")
                                            {
                                                <form asp-action="RetryJob" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning btn-sm" title="Retry Job">
                                                        <i class="fas fa-redo"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (job.Status == "Pending")
                                            {
                                                <form asp-action="CancelJob" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Cancel Job" onclick="return confirm('Cancel this pending email job?');">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
