@model TMS.ViewModels.Audit.AuditLogIndexViewModel

@{
    ViewData["Title"] = "Audit Trail & System Logs";
}

<style>
    .audit-page-container {
        padding: 24px 30px;
        background: #f8fafc;
        min-height: calc(100vh - 70px);
        color: #1e293b;
        font-family: 'Outfit', 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .audit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .audit-header-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .audit-header-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
    }

    .audit-header h2 {
        font-size: 24px;
        font-weight: 800;
        margin: 0;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    .audit-header p {
        color: #64748b;
        font-size: 13.5px;
        margin: 3px 0 0;
    }

    /* KPI Summary Cards */
    .audit-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .audit-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .audit-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    }

    .audit-stat-label {
        font-size: 12.5px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        display: block;
        margin-bottom: 6px;
    }

    .audit-stat-val {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }

    .audit-stat-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Filter Card */
    .audit-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }

    .audit-filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        align-items: end;
    }

    .audit-form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .audit-form-group label {
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .audit-form-group .form-control,
    .audit-form-group .form-select {
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 13.5px;
        padding: 8px 12px;
        color: #1e293b;
        background-color: #ffffff;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .audit-form-group .form-control:focus,
    .audit-form-group .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        outline: none;
    }

    .audit-filter-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    /* Table Container */
    .audit-table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        overflow: hidden;
    }

    .audit-table-header {
        padding: 16px 22px;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .audit-table-header-info {
        font-size: 13.5px;
        font-weight: 700;
        color: #334155;
    }

    .audit-table-header-info span {
        color: #2563eb;
    }

    .audit-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .audit-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        text-align: left;
    }

    .audit-table th {
        background: #f8fafc;
        color: #475569;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 12px 18px;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .audit-table td {
        padding: 14px 18px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #1e293b;
    }

    .audit-table tbody tr {
        transition: background-color 0.12s ease;
    }

    .audit-table tbody tr:hover {
        background-color: #f8fafc;
    }

    /* Badges */
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .badge-status.success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .badge-status.failure {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .badge-role {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .badge-role.admin { background: #e0e7ff; color: #4338ca; }
    .badge-role.faculty { background: #ecfdf5; color: #059669; }
    .badge-role.student { background: #e0f2fe; color: #0284c7; }
    .badge-role.system { background: #f1f5f9; color: #64748b; }

    .badge-module {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        font-size: 11.5px;
        font-weight: 600;
    }

    .badge-action {
        font-family: monospace;
        font-size: 12px;
        font-weight: 600;
        color: #0f172a;
        background: #f1f5f9;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .btn-detail {
        padding: 6px 12px;
        font-size: 12.5px;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-detail:hover {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }

    /* Pagination */
    .audit-pagination-wrapper {
        padding: 16px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        border-top: 1px solid #f1f5f9;
        background: #ffffff;
    }

    .audit-page-size-selector {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #64748b;
    }

    .audit-page-size-selector select {
        width: 75px;
        padding: 4px 8px;
        font-size: 13px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    /* Modal Styles */
    .modal-audit .modal-content {
        border-radius: 18px;
        border: none;
        box-shadow: 0 10px 40px rgba(15, 23, 42, 0.14);
        overflow: hidden;
    }

    .modal-audit .modal-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 18px 24px;
    }

    .modal-audit .modal-title {
        font-size: 17px;
        font-weight: 800;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-audit .modal-body {
        padding: 24px;
        max-height: calc(85vh - 120px);
        overflow-y: auto;
    }

    .audit-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .audit-detail-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .audit-detail-item .meta-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.5px;
    }

    .audit-detail-item .meta-val {
        font-size: 13.5px;
        font-weight: 600;
        color: #0f172a;
        word-break: break-word;
    }

    .diff-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-top: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .diff-table th {
        background: #f1f5f9;
        padding: 10px 14px;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
    }

    .diff-table td {
        padding: 10px 14px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: top;
    }

    .diff-table tr.row-changed {
        background-color: #fffbeb;
    }

    .diff-val {
        font-family: monospace;
        font-size: 12.5px;
        word-break: break-word;
        white-space: pre-wrap;
    }

    .diff-val.before {
        color: #b91c1c;
        background: #fef2f2;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .diff-val.after {
        color: #15803d;
        background: #f0fdf4;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .raw-json-box {
        background: #0f172a;
        color: #f8fafc;
        padding: 14px;
        border-radius: 10px;
        font-family: monospace;
        font-size: 12px;
        max-height: 240px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

<div class="audit-page-container">
    <!-- Header -->
    <div class="audit-header">
        <div class="audit-header-title">
            <div class="audit-header-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div>
                <h2>Audit Trail Management</h2>
                <p>Immutable system activity history, field-level change audits, and security compliance.</p>
            </div>
        </div>
        <div class="d-flex align-items:center gap-2">
            <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" id="btnExportCsv" style="border-radius:10px; font-weight:700; padding:8px 16px;">
                <i class="fa-solid fa-file-csv"></i> Export CSV
            </button>
        </div>
    </div>

    <!-- KPI Dashboard Summary Cards -->
    <div class="audit-summary-grid">
        <div class="audit-stat-card">
            <div>
                <span class="audit-stat-label">Total Logs</span>
                <span class="audit-stat-val">@Model.Summary.TotalLogs.ToString("N0")</span>
            </div>
            <div class="audit-stat-icon-wrap" style="background:#eff6ff; color:#2563eb;">
                <i class="fa-solid fa-database"></i>
            </div>
        </div>

        <div class="audit-stat-card">
            <div>
                <span class="audit-stat-label">Today's Activities</span>
                <span class="audit-stat-val">@Model.Summary.TodayActivities.ToString("N0")</span>
            </div>
            <div class="audit-stat-icon-wrap" style="background:#ecfdf5; color:#059669;">
                <i class="fa-solid fa-bolt"></i>
            </div>
        </div>

        <div class="audit-stat-card">
            <div>
                <span class="audit-stat-label">Active Users</span>
                <span class="audit-stat-val">@Model.Summary.ActiveUsers.ToString("N0")</span>
            </div>
            <div class="audit-stat-icon-wrap" style="background:#f5f3ff; color:#7c3aed;">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>

        <div class="audit-stat-card">
            <div>
                <span class="audit-stat-label">Failed Actions</span>
                <span class="audit-stat-val" style="color:@(Model.Summary.FailedActions > 0 ? "#dc2626" : "#0f172a");">
                    @Model.Summary.FailedActions.ToString("N0")
                </span>
            </div>
            <div class="audit-stat-icon-wrap" style="background:#fee2e2; color:#dc2626;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="audit-filter-card">
        <form method="get" id="auditFilterForm">
            <input type="hidden" name="pageNumber" value="1" />
            <div class="audit-filter-row">
                <div class="audit-form-group" style="grid-column: span 2;">
                    <label>Search All Fields</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by username, action, module, ID, or IP..." value="@Model.Filter.SearchTerm" />
                </div>

                <div class="audit-form-group">
                    <label>From Date</label>
                    <input type="date" name="startDate" class="form-control" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="audit-form-group">
                    <label>To Date</label>
                    <input type="date" name="endDate" class="form-control" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="audit-form-group">
                    <label>User Role</label>
                    <select name="userRole" class="form-select">
                        <option value="">All Roles</option>
                        <option value="Admin" selected="@(Model.Filter.UserRole == "Admin")">Admin</option>
                        <option value="Faculty" selected="@(Model.Filter.UserRole == "Faculty")">Faculty</option>
                        <option value="Student" selected="@(Model.Filter.UserRole == "Student")">Student</option>
                        <option value="Anonymous" selected="@(Model.Filter.UserRole == "Anonymous")">Anonymous / Guest</option>
                    </select>
                </div>

                <div class="audit-form-group">
                    <label>Module</label>
                    <select name="moduleName" class="form-select">
                        <option value="">All Modules</option>
                        @foreach (var mod in Model.AvailableModules)
                        {
                            <option value="@mod" selected="@(Model.Filter.ModuleName == mod)">@mod</option>
                        }
                    </select>
                </div>

                <div class="audit-form-group">
                    <label>Action Type</label>
                    <select name="actionType" class="form-select">
                        <option value="">All Action Types</option>
                        @foreach (var act in Model.AvailableActionTypes)
                        {
                            <option value="@act" selected="@(Model.Filter.ActionType == act)">@act</option>
                        }
                    </select>
                </div>

                <div class="audit-form-group">
                    <label>Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="SUCCESS" selected="@(Model.Filter.Status == "SUCCESS")">Success</option>
                        <option value="FAILURE" selected="@(Model.Filter.Status == "FAILURE")">Failure</option>
                    </select>
                </div>

                <div class="audit-filter-actions">
                    <button type="submit" class="btn btn-primary" style="border-radius:10px; font-weight:700; padding:8px 18px;">
                        <i class="fa-solid fa-filter"></i> Apply
                    </button>
                    <a href="/Admin/AuditLogs" class="btn btn-outline-secondary" style="border-radius:10px; font-weight:600; padding:8px 14px;">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Main Table Card -->
    <div class="audit-table-card">
        <div class="audit-table-header">
            <div class="audit-table-header-info">
                Found <span>@Model.TotalCount.ToString("N0")</span> audit entries matching filter
            </div>
            <div class="audit-page-size-selector">
                <span>Show:</span>
                <select id="pageSizeSelect" class="form-select form-select-sm" onchange="changePageSize(this.value)">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                </select>
                <span>per page</span>
            </div>
        </div>

        <div class="audit-table-responsive">
            <table class="audit-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time (UTC / Local)</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Changed Fields</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:40px; color:#94a3b8;">
                                <i class="fa-regular fa-folder-open" style="font-size:32px; display:block; margin-bottom:10px;"></i>
                                No audit records found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var roleClass = (item.UserRole ?? "").ToLower() switch
                            {
                                "admin" or "super admin" => "admin",
                                "faculty" or "teacher" => "faculty",
                                "student" => "student",
                                _ => "system"
                            };

                            <tr>
                                <td>
                                    <div style="font-weight:600; color:#0f172a;" class="local-timestamp" data-utc="@item.TimestampUtc.ToString("o")">
                                        @item.FormattedTimestampUtc
                                    </div>
                                    <small style="color:#94a3b8; font-size:11px;" title="Server UTC Time">
                                        UTC: @item.FormattedTimestampUtc
                                    </small>
                                </td>
                                <td>
                                    <div style="font-weight:700; color:#1e293b;">
                                        @(string.IsNullOrWhiteSpace(item.Username) ? "Anonymous" : item.Username)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.IpAddress))
                                    {
                                        <small style="color:#64748b; font-size:11px;">IP: @item.IpAddress</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge-role @roleClass">
                                        @(string.IsNullOrWhiteSpace(item.UserRole) ? "SYSTEM" : item.UserRole)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-module">@item.ModuleName</span>
                                </td>
                                <td>
                                    <span class="badge-action">@item.ActionType</span>
                                </td>
                                <td>
                                    @if (item.Status == "SUCCESS")
                                    {
                                        <span class="badge-status success">
                                            <i class="fa-solid fa-circle-check"></i> Success
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status failure">
                                            <i class="fa-solid fa-circle-xmark"></i> Failure
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ChangedFields))
                                    {
                                        <span style="font-size:12px; font-weight:600; color:#b45309; background:#fef3c7; padding:2px 8px; border-radius:4px; max-width:200px; display:inline-block; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;" title="@item.ChangedFields">
                                            @item.ChangedFields
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Details))
                                    {
                                        <span style="font-size:12px; color:#64748b; max-width:200px; display:inline-block; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;" title="@item.Details">
                                            @item.Details
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8; font-size:12px;">&mdash;</span>
                                    }
                                </td>
                                <td style="text-align:right;">
                                    <button type="button" class="btn-detail" onclick="openDetailsModal(@item.Id)">
                                        <i class="fa-regular fa-eye"></i> View Details
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="audit-pagination-wrapper">
                <div style="font-size:13px; color:#64748b;">
                    Showing page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                </div>
                <div class="btn-group" role="group">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="javascript:goToPage(@(Model.PageNumber - 1))" class="btn btn-outline-secondary btn-sm" style="border-radius:8px 0 0 8px;">
                            <i class="fa-solid fa-chevron-left"></i> Previous
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm disabled" style="border-radius:8px 0 0 8px;">
                            <i class="fa-solid fa-chevron-left"></i> Previous
                        </button>
                    }

                    @{
                        int startPage = Math.Max(1, Model.PageNumber - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <a href="javascript:goToPage(@p)" class="btn btn-sm @(p == Model.PageNumber ? "btn-primary font-weight-bold" : "btn-outline-secondary")">
                            @p
                        </a>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a href="javascript:goToPage(@(Model.PageNumber + 1))" class="btn btn-outline-secondary btn-sm" style="border-radius:0 8px 8px 0;">
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm disabled" style="border-radius:0 8px 8px 0;">
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade modal-audit" id="auditDetailModal" tabindex="-1" aria-labelledby="auditDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="auditDetailModalLabel">
                    <i class="fa-solid fa-shield-halved text-primary"></i> Audit Entry Details #<span id="modalAuditId"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalAuditBody">
                <div class="text-center py-4" id="modalAuditLoading">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading audit details...</p>
                </div>

                <div id="modalAuditContent" style="display:none;">
                    <!-- Metadata Grid -->
                    <div class="audit-detail-grid">
                        <div class="audit-detail-item">
                            <span class="meta-label">Date &amp; Time (UTC)</span>
                            <span class="meta-val" id="mdTimestamp"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">User / Initiator</span>
                            <span class="meta-val" id="mdUser"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">Role</span>
                            <span class="meta-val" id="mdRole"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">Module Name</span>
                            <span class="meta-val" id="mdModule"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">Action Type</span>
                            <span class="meta-val" id="mdAction"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">Status</span>
                            <span class="meta-val" id="mdStatus"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">Entity</span>
                            <span class="meta-val" id="mdEntity"></span>
                        </div>
                        <div class="audit-detail-item">
                            <span class="meta-label">IP Address</span>
                            <span class="meta-val" id="mdIp"></span>
                        </div>
                        <div class="audit-detail-item" style="grid-column: 1 / -1;">
                            <span class="meta-label">Correlation ID</span>
                            <span class="meta-val font-monospace" id="mdCorrelation"></span>
                        </div>
                        <div class="audit-detail-item" style="grid-column: 1 / -1;" id="mdDetailsWrapper">
                            <span class="meta-label">Operational Summary</span>
                            <span class="meta-val" id="mdDetails"></span>
                        </div>
                    </div>

                    <!-- Before vs After Comparison -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 style="font-weight:800; color:#0f172a; margin:0;">
                                <i class="fa-solid fa-code-compare text-primary me-1"></i> Field-Level Change Comparison
                            </h6>
                            <span id="mdOperationBadge" class="badge bg-secondary">UPDATE</span>
                        </div>

                        <div id="noChangesAlert" class="alert alert-info py-2" style="font-size:13px; display:none;">
                            No structured field-level property diff for this event (e.g. authentication or system trigger).
                        </div>

                        <div class="table-responsive" id="diffTableWrapper">
                            <table class="diff-table">
                                <thead>
                                    <tr>
                                        <th style="width:25%;">Field</th>
                                        <th style="width:37%;">Previous Value (Before)</th>
                                        <th style="width:38%;">Updated Value (After)</th>
                                    </tr>
                                </thead>
                                <tbody id="diffTableBody"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Raw JSON Viewer Accordion -->
                    <div class="accordion" id="accordionRawJson">
                        <div class="accordion-item" style="border-radius:10px; overflow:hidden; border:1px solid #e2e8f0;">
                            <h2 class="accordion-header" id="headingRawJson">
                                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRawJson" aria-expanded="false" aria-controls="collapseRawJson" style="font-size:13px; font-weight:700;">
                                    <i class="fa-solid fa-code me-2"></i> Inspect Raw Payloads (Before / After JSON)
                                </button>
                            </h2>
                            <div id="collapseRawJson" class="accordion-collapse collapse" aria-labelledby="headingRawJson" data-bs-parent="#accordionRawJson">
                                <div class="accordion-body p-3">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="meta-label mb-1">OldValuesJson (Before)</label>
                                            <div class="raw-json-box" id="rawOldJson">null</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="meta-label mb-1">NewValuesJson (After)</label>
                                            <div class="raw-json-box" id="rawNewJson">null</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Localize timestamps on client side
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.local-timestamp').forEach(function (el) {
            const utc = el.getAttribute('data-utc');
            if (utc) {
                try {
                    const d = new Date(utc);
                    el.textContent = d.toLocaleString();
                } catch (e) {}
            }
        });

        // Wire Export CSV
        document.getElementById('btnExportCsv').addEventListener('click', function () {
            const form = document.getElementById('auditFilterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);
            window.location.href = '/Admin/AuditLogs/ExportCsv?' + params.toString();
        });
    });

    function goToPage(page) {
        const form = document.getElementById('auditFilterForm');
        form.querySelector('input[name="pageNumber"]').value = page;
        form.submit();
    }

    function changePageSize(size) {
        const form = document.getElementById('auditFilterForm');
        form.querySelector('input[name="pageNumber"]').value = 1;
        let sizeInput = form.querySelector('input[name="pageSize"]');
        if (!sizeInput) {
            sizeInput = document.createElement('input');
            sizeInput.type = 'hidden';
            sizeInput.name = 'pageSize';
            form.appendChild(sizeInput);
        }
        sizeInput.value = size;
        form.submit();
    }

    function openDetailsModal(id) {
        const modal = new bootstrap.Modal(document.getElementById('auditDetailModal'));
        document.getElementById('modalAuditId').textContent = id;
        document.getElementById('modalAuditLoading').style.display = 'block';
        document.getElementById('modalAuditContent').style.display = 'none';
        modal.show();

        fetch('/Admin/AuditLogs/Details/' + id)
            .then(res => res.json())
            .then(res => {
                document.getElementById('modalAuditLoading').style.display = 'none';
                if (!res.success || !res.data) {
                    alert(res.message || 'Error loading audit details.');
                    return;
                }

                const data = res.data;
                document.getElementById('modalAuditContent').style.display = 'block';

                document.getElementById('mdTimestamp').textContent = data.formattedTimestampUtc;
                document.getElementById('mdUser').textContent = data.username || 'Anonymous';
                document.getElementById('mdRole').textContent = data.userRole || 'System';
                document.getElementById('mdModule').textContent = data.moduleName;
                document.getElementById('mdAction').textContent = data.actionType;
                document.getElementById('mdStatus').innerHTML = data.status === 'SUCCESS'
                    ? '<span class="badge-status success"><i class="fa-solid fa-circle-check"></i> Success</span>'
                    : '<span class="badge-status failure"><i class="fa-solid fa-circle-xmark"></i> Failure</span>';

                document.getElementById('mdEntity').textContent = (data.entityType || 'None') + (data.entityId ? (' #' + data.entityId) : '');
                document.getElementById('mdIp').textContent = data.ipAddress || 'Not recorded';
                document.getElementById('mdCorrelation').textContent = data.correlationId || 'N/A';

                if (data.details) {
                    document.getElementById('mdDetailsWrapper').style.display = 'flex';
                    document.getElementById('mdDetails').textContent = data.details;
                } else {
                    document.getElementById('mdDetailsWrapper').style.display = 'none';
                }

                // Operation badge
                const opBadge = document.getElementById('mdOperationBadge');
                opBadge.textContent = data.operationType;
                opBadge.className = 'badge ' + (
                    data.operationType === 'CREATE' ? 'bg-success' :
                    data.operationType === 'DELETE' ? 'bg-danger' :
                    data.operationType === 'UPDATE' ? 'bg-warning text-dark' : 'bg-primary'
                );

                // Build Field Changes table
                const tbody = document.getElementById('diffTableBody');
                tbody.innerHTML = '';

                if (data.fieldChanges && data.fieldChanges.length > 0) {
                    document.getElementById('diffTableWrapper').style.display = 'block';
                    document.getElementById('noChangesAlert').style.display = 'none';

                    data.fieldChanges.forEach(f => {
                        const tr = document.createElement('tr');
                        if (f.isChanged) {
                            tr.className = 'row-changed';
                        }

                        const tdField = document.createElement('td');
                        tdField.innerHTML = '<strong>' + escapeHtml(f.fieldName) + '</strong>' +
                            (f.isChanged ? ' <span class="badge bg-warning text-dark ms-1" style="font-size:10px;">Changed</span>' : '');

                        const tdBefore = document.createElement('td');
                        tdBefore.innerHTML = f.oldValue !== null && f.oldValue !== undefined
                            ? '<span class="diff-val before">' + escapeHtml(f.oldValue) + '</span>'
                            : '<span class="text-muted fst-italic">null (Created)</span>';

                        const tdAfter = document.createElement('td');
                        tdAfter.innerHTML = f.newValue !== null && f.newValue !== undefined
                            ? '<span class="diff-val after">' + escapeHtml(f.newValue) + '</span>'
                            : '<span class="text-muted fst-italic">null (Deleted)</span>';

                        tr.appendChild(tdField);
                        tr.appendChild(tdBefore);
                        tr.appendChild(tdAfter);
                        tbody.appendChild(tr);
                    });
                } else {
                    document.getElementById('diffTableWrapper').style.display = 'none';
                    document.getElementById('noChangesAlert').style.display = 'block';
                }

                // Raw JSON
                document.getElementById('rawOldJson').textContent = formatJson(data.oldValuesJson);
                document.getElementById('rawNewJson').textContent = formatJson(data.newValuesJson);
            })
            .catch(err => {
                document.getElementById('modalAuditLoading').style.display = 'none';
                alert('Failed to fetch details: ' + err);
            });
    }

    function formatJson(str) {
        if (!str) return 'null';
        try {
            return JSON.stringify(JSON.parse(str), null, 2);
        } catch (e) {
            return str;
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.toString().replace(/[&<>"']/g, m => map[m]);
    }
</script>

