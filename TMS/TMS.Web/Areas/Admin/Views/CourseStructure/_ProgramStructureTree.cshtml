@model TMS.ViewModels.Academics.ProgramStructureViewModel

@{
    bool isFaculty = ViewBag.IsFaculty ??
        (ViewContext.HttpContext.User.FindFirst("role")?.Value?.ToLower() == "faculty");

    var semColors = new[]
    {
        "#6366f1",
        "#8b5cf6",
        "#16a34a",
        "#f59e0b",
        "#ec4899",
        "#0ea5e9",
        "#14b8a6",
        "#f97316"
    };

    var totalCourses = Model?.SemesterGroups?.Sum(x => x.Courses.Count) ?? 0;
    var totalContent = Model?.SemesterGroups?.Sum(x => x.Courses.Sum(c => c.ContentCount)) ?? 0;
}

@if (Model == null)
{
    <div class="cb-empty-state">
        <div class="cb-empty-icon">
            <i class="fa-solid fa-building-columns"></i>
        </div>
        <h4>No program data available</h4>
        <p>Select another program and try again.</p>
    </div>

    return;
}

<div class="ps-program-header">
    <div class="ps-program-main">
        <div class="ps-program-icon">
            <i class="fa-solid fa-building-columns"></i>
        </div>

        <div class="ps-program-info">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h2>@Model.ProgramName</h2>

                @if (!isFaculty)
                {
                    <div class="ps-program-actions">
                        <button type="button"
                                class="btn-ps-action btn-ps-primary cb-prog-add-course-btn btn-program-add-course"
                                data-program-id="@Model.ProgramId"
                                data-program-name="@Model.ProgramName"
                                title="Add Course to this Program">
                            <i class="fa-solid fa-plus me-1"></i> Add Course
                        </button>

                        <button type="button"
                                class="btn-ps-action btn-ps-secondary cb-prog-edit-btn cb-edit-program-btn btn-edit-program"
                                data-program-id="@Model.ProgramId"
                                data-program-name="@Model.ProgramName"
                                data-semesters="@Model.NoOfSemester"
                                data-description="@Model.ProgramDescription"
                                title="Edit Program Details">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Program
                        </button>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ProgramDescription))
            {
                <p>@Model.ProgramDescription</p>
            }

            <div class="ps-program-stats">
                <span>
                    <i class="fa-regular fa-calendar"></i>
                    @Model.NoOfSemester Semester@(Model.NoOfSemester == 1 ? "" : "s")
                </span>

                <span>
                    <i class="fa-solid fa-book-open"></i>
                    @totalCourses Course@(totalCourses == 1 ? "" : "s")
                </span>

                <span>
                    <i class="fa-regular fa-file-lines"></i>
                    @totalContent Content Item@(totalContent == 1 ? "" : "s")
                </span>
            </div>
        </div>
    </div>
</div>

@if (Model.SemesterGroups == null || !Model.SemesterGroups.Any())
{
    <div class="cb-empty-state">
        <div class="cb-empty-icon">
            <i class="fa-regular fa-folder-open"></i>
        </div>

        <h4>No semester structure found</h4>

        <p>
            No semesters or courses are currently defined for
            <strong>@Model.ProgramName</strong>.
        </p>

        @if (!isFaculty)
        {
            <button type="button"
                    class="cb-empty-action cb-prog-add-course-btn"
                    data-program-id="@Model.ProgramId"
                    data-program-name="@Model.ProgramName">
                <i class="fa-solid fa-plus me-1"></i> Add First Course
            </button>
        }
    </div>
}
else
{
    <div class="ps-semester-list">
        @{
            int semesterIndex = 0;
        }

        @foreach (var semester in Model.SemesterGroups)
        {
            var color = semColors[semesterIndex % semColors.Length];
            var semesterContentCount = semester.Courses.Sum(x => x.ContentCount);

            <section class="ps-semester"
                     data-semester-id="@semester.SemesterId">

                <div class="ps-semester-header"
                     style="--semester-color:@color;"
                     data-bs-toggle="collapse"
                     data-bs-target="#sem-collapse-@semester.SemesterId"
                     aria-expanded="true"
                     role="button">

                    <span class="ps-semester-icon"
                          style="background:@color;">
                        <i class="fa-regular fa-calendar"></i>
                    </span>

                    <span class="ps-semester-heading">
                        <strong>@semester.SemesterName</strong>

                        <small>
                            @semester.Courses.Count Course@(semester.Courses.Count == 1 ? "" : "s")

                            @if (semesterContentCount > 0)
                            {
                                <span>• @semesterContentCount Content Item@(semesterContentCount == 1 ? "" : "s")</span>
                            }
                        </small>
                    </span>

                    <div class="ps-semester-header-actions" onclick="event.stopPropagation();">
                        @if (!isFaculty && semester.SemesterId > 0)
                        {
                            <button type="button"
                                    class="ps-sem-add-btn cb-sem-add-course-btn"
                                    data-semester-id="@semester.SemesterId"
                                    data-semester-name="@semester.SemesterName"
                                    title="Add Course to @semester.SemesterName">
                                <i class="fa-solid fa-plus"></i>
                                <span>Add Course</span>
                            </button>
                        }

                        <span class="ps-semester-chevron">
                            <i class="fa-solid fa-chevron-down"></i>
                        </span>
                    </div>
                </div>

                <div class="ps-semester-body" id="sem-collapse-@semester.SemesterId">
                    @if (!semester.Courses.Any())
                    {
                        <div class="ps-semester-empty-card">
                            <div class="ps-sem-empty-icon">
                                <i class="fa-solid fa-book-medical"></i>
                            </div>
                            <div class="ps-sem-empty-text">
                                No courses added to <strong>@semester.SemesterName</strong> yet.
                            </div>
                            @if (!isFaculty && semester.SemesterId > 0)
                            {
                                <button type="button"
                                        class="ps-sem-empty-btn cb-sem-add-course-btn"
                                        data-semester-id="@semester.SemesterId"
                                        data-semester-name="@semester.SemesterName">
                                    <i class="fa-solid fa-plus me-1"></i> Add Course to @semester.SemesterName
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var course in semester.Courses)
                        {
                            <div class="ps-course-wrapper">

                                <div class="ps-course-card">

                                    <div class="ps-course-icon">
                                        <i class="fa-solid fa-book"></i>
                                    </div>

                                    <div class="ps-course-info">
                                        <div class="ps-course-name"
                                             title="@course.CourseName">
                                            @course.CourseName
                                        </div>

                                        <div class="ps-course-meta">
                                            @if (!string.IsNullOrWhiteSpace(course.CourseCode))
                                            {
                                                <span class="badge-code">
                                                    <i class="fa-solid fa-hashtag"></i>
                                                    @course.CourseCode
                                                </span>
                                            }

                                            <span class="badge-credit">
                                                <i class="fa-regular fa-star"></i>
                                                @course.Credits Credit@(course.Credits == 1 ? "" : "s")
                                            </span>

                                            @if (course.DurationMonths > 0)
                                            {
                                                <span class="badge-duration">
                                                    <i class="fa-regular fa-clock"></i>
                                                    @course.DurationMonths Mo
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(course.Description))
                                        {
                                            <div class="ps-course-desc">
                                                @course.Description
                                            </div>
                                        }
                                    </div>

                                    <div class="ps-course-actions">

                                        @if (course.ContentCount > 0)
                                        {
                                            <button type="button"
                                                    class="ps-content-badge cb-view-content-badge"
                                                    data-course-id="@course.CourseId"
                                                    aria-expanded="false"
                                                    title="View assigned content">
                                                <i class="fa-regular fa-file-lines"></i>
                                                <span>@course.ContentCount Content</span>
                                                <i class="fa-solid fa-chevron-down ps-content-chevron ms-1"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="ps-zero-content">
                                                0 Content
                                            </span>
                                        }

                                        @if (!isFaculty)
                                        {
                                            <button type="button"
                                                    class="ps-action-btn cb-assign-faculty-btn"
                                                    data-course-id="@course.CourseId"
                                                    data-course-name="@course.CourseName (@course.CourseCode)"
                                                    title="Assign Faculty / Instructors"
                                                    aria-label="Assign Faculty for @course.CourseName">
                                                <i class="fa-solid fa-chalkboard-user text-success"></i>
                                            </button>

                                            <button type="button"
                                                    class="ps-action-btn cb-manage-content-btn"
                                                    data-course-id="@course.CourseId"
                                                    data-course-name="@course.CourseName (@course.CourseCode)"
                                                    title="Manage Content (Quadrants)"
                                                    aria-label="Manage content for @course.CourseName">
                                                <i class="fa-solid fa-link"></i>
                                            </button>

                                            <button type="button"
                                                    class="ps-action-btn cb-edit-course-btn"
                                                    data-course-id="@course.CourseId"
                                                    title="Edit Course Details"
                                                    aria-label="Edit @course.CourseName">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="ps-action-btn ps-action-btn-danger cb-delete-course-btn"
                                                    data-course-id="@course.CourseId"
                                                    data-course-name="@course.CourseName"
                                                    title="Remove Course"
                                                    aria-label="Remove @course.CourseName">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="ps-course-content-list"
                                     id="content-list-@course.CourseId"
                                     style="display:none;">
                                </div>
                            </div>
                        }

                        @if (!isFaculty && semester.SemesterId > 0)
                        {
                            <div class="ps-sem-footer">
                                <button type="button"
                                        class="ps-sem-footer-add-btn cb-sem-add-course-btn"
                                        data-semester-id="@semester.SemesterId"
                                        data-semester-name="@semester.SemesterName">
                                    <i class="fa-solid fa-plus me-1"></i> Add Another Course to @semester.SemesterName
                                </button>
                            </div>
                        }
                    }
                </div>
            </section>

            semesterIndex++;
        }
    </div>
}
