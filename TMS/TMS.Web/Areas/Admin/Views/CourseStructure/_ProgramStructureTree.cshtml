@model TMS.ViewModels.Academics.ProgramStructureViewModel

@{
    bool isFaculty = ViewBag.IsFaculty ??
        (ViewContext.HttpContext.User.FindFirst("role")?.Value?.ToLower() == "faculty");

    var semColors = new[]
    {
        "#6366f1",
        "#8b5cf6",
        "#16a34a",
        "#f59e0b",
        "#ec4899",
        "#0ea5e9",
        "#14b8a6",
        "#f97316"
    };

    var totalCourses = Model?.SemesterGroups?.Sum(x => x.Courses.Count) ?? 0;
    var totalContent = Model?.SemesterGroups?.Sum(x => x.Courses.Sum(c => c.ContentCount)) ?? 0;
}

@if (Model == null)
{
    <div class="cb-empty-state">
        <div class="cb-empty-icon">
            <i class="fa-solid fa-building-columns"></i>
        </div>
        <h4>No program data available</h4>
        <p>Select another program and try again.</p>
    </div>

    return;
}

<div class="ps-program-header">
    <div class="ps-program-main">
        <div class="ps-program-icon">
            <i class="fa-solid fa-building-columns"></i>
        </div>

        <div class="ps-program-info">
            <h2>@Model.ProgramName</h2>

            @if (!string.IsNullOrWhiteSpace(Model.ProgramDescription))
            {
                <p>@Model.ProgramDescription</p>
            }

            <div class="ps-program-stats">
                <span>
                    <i class="fa-regular fa-calendar"></i>
                    @Model.NoOfSemester Semester@(Model.NoOfSemester == 1 ? "" : "s")
                </span>

                <span>
                    <i class="fa-solid fa-book-open"></i>
                    @totalCourses Course@(totalCourses == 1 ? "" : "s")
                </span>

                <span>
                    <i class="fa-regular fa-file-lines"></i>
                    @totalContent Content Item@(totalContent == 1 ? "" : "s")
                </span>
            </div>
        </div>
    </div>
</div>

@if (Model.SemesterGroups == null || !Model.SemesterGroups.Any())
{
    <div class="cb-empty-state">
        <div class="cb-empty-icon">
            <i class="fa-regular fa-folder-open"></i>
        </div>

        <h4>No courses found</h4>

        <p>
            No active courses are currently assigned to
            <strong>@Model.ProgramName</strong>.
        </p>

        @if (!isFaculty)
        {
            <a href="@Url.Action("Index", "Course", new { area = "Admin" })"
               class="cb-empty-action">
                <i class="fa-solid fa-plus"></i>
                Manage Courses
            </a>
        }
    </div>
}
else
{
    <div class="ps-semester-list">
        @{
            int semesterIndex = 0;
        }

        @foreach (var semester in Model.SemesterGroups)
        {
            var color = semColors[semesterIndex % semColors.Length];
            var semesterContentCount = semester.Courses.Sum(x => x.ContentCount);

            <section class="ps-semester"
                     data-semester-id="@semester.SemesterId">

                <button type="button"
                        class="ps-semester-header"
                        style="--semester-color:@color;"
                        aria-expanded="true">

                    <span class="ps-semester-icon"
                          style="background:@color;">
                        <i class="fa-regular fa-calendar"></i>
                    </span>

                    <span class="ps-semester-heading">
                        <strong>@semester.SemesterName</strong>

                        <small>
                            @semester.Courses.Count Course@(semester.Courses.Count == 1 ? "" : "s")

                            @if (semesterContentCount > 0)
                            {
                                <span>• @semesterContentCount Content Item@(semesterContentCount == 1 ? "" : "s")</span>
                            }
                        </small>
                    </span>

                    <span class="ps-semester-chevron">
                        <i class="fa-solid fa-chevron-down"></i>
                    </span>
                </button>

                <div class="ps-semester-body">
                    @if (!semester.Courses.Any())
                    {
                        <div class="ps-semester-empty">
                            No courses are assigned to this semester.
                        </div>
                    }
                    else
                    {
                        @foreach (var course in semester.Courses)
                        {
                            <div class="ps-course-wrapper">

                                <div class="ps-course-card">

                                    <div class="ps-course-icon">
                                        <i class="fa-solid fa-book"></i>
                                    </div>

                                    <div class="ps-course-info">
                                        <div class="ps-course-name"
                                             title="@course.CourseName">
                                            @course.CourseName
                                        </div>

                                        <div class="ps-course-meta">

                                            @if (!string.IsNullOrWhiteSpace(course.CourseCode))
                                            {
                                                <span>
                                                    <i class="fa-solid fa-hashtag"></i>
                                                    @course.CourseCode
                                                </span>
                                            }

                                            <span>
                                                <i class="fa-regular fa-star"></i>
                                                @course.Credits Credit@(course.Credits == 1 ? "" : "s")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="ps-course-actions">

                                        @if (course.ContentCount > 0)
                                        {
                                            <button type="button"
                                                    class="ps-content-badge cb-view-content-badge"
                                                    data-course-id="@course.CourseId"
                                                    aria-expanded="false"
                                                    title="View assigned content">

                                                <i class="fa-regular fa-file-lines"></i>

                                                <span>@course.ContentCount</span>

                                                <i class="fa-solid fa-chevron-down ps-content-chevron"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="ps-zero-content">
                                                No content
                                            </span>
                                        }

                                        @if (!isFaculty)
                                        {
                                            <button type="button"
                                                    class="ps-action-btn cb-manage-content-btn"
                                                    data-course-id="@course.CourseId"
                                                    data-course-name="@course.CourseName (@course.CourseCode)"
                                                    title="Manage Content"
                                                    aria-label="Manage content for @course.CourseName">

                                                <i class="fa-solid fa-link"></i>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="ps-course-content-list"
                                     id="content-list-@course.CourseId"
                                     style="display:none;">
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>

            semesterIndex++;
        }
    </div>
}
