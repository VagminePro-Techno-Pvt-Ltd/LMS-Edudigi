                $("#programForm").on("submit", function (e) {
                    e.preventDefault();
                    const progId = Number($("#progId").val()) || 0;
                    const name = $("#progName").val().trim();
                    const semesters = Number($("#progSemesters").val()) || 6;
                    const desc = $("#progDescription").val().trim();
                    const btn = $("#saveProgramBtn");

                    if (!name) {
                        $("#progErrorAlert").text("Program Name is required.").removeClass("d-none");
                        return;
                    }

                    $("#progErrorAlert").addClass("d-none");
                    btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...');

                    const targetUrl = progId > 0 ? urls.updateProgram : urls.createProgram;
                    const postData = {
                        __RequestVerificationToken: getAntiForgeryToken(),
                        name: name,
                        noOfSemester: semesters,
                        description: desc
                    };
                    if (progId > 0) {
                        postData.programId = progId;
                    }

                    $.ajax({
                        url: targetUrl,
                        type: "POST",
                        data: postData
                    })
                    .done(function (res) {
                        if (res && res.success) {
                            sessionStorage.setItem("cb_toast_msg", res.message || (progId > 0 ? "Program updated successfully!" : "Program created successfully!"));
                            sessionStorage.setItem("cb_toast_type", "success");
                            hideModal("programModal");
                            if (res.programId) {
                                window.location.href = window.location.pathname + "?programId=" + encodeURIComponent(res.programId);
                            } else {
                                window.location.reload();
                            }
                        } else {
                            $("#progErrorAlert").text(res?.message || "Failed to save program.").removeClass("d-none");
                            btn.prop("disabled", false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save Program');
                        }
                    })
                    .fail(function () {
                        $("#progErrorAlert").text("An error occurred while saving the program.").removeClass("d-none");
                        btn.prop("disabled", false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save Program');
