@model TMS.ViewModels.Academics.CurriculumBuilderPageViewModel

@{
    ViewData["Title"] = "Curriculum Builder";
    bool isFaculty = ViewBag.IsFaculty ?? false;
}

<link rel="stylesheet" href="~/css/content-library.css" />
<link rel="stylesheet" href="~/css/course-structure.css" />

<style>
    .cb-shell {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 24px 28px 40px;
        box-sizing: border-box;
    }

    .cb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 118px;
        padding: 24px 30px;
        margin-bottom: 22px;
        border: 1px solid #e4e7ff;
        border-radius: 20px;
        background: linear-gradient(135deg, #fafaff 0%, #f6f5ff 100%);
    }

    .cb-header-main {
        min-width: 0;
    }

    .cb-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 7px;
    }

    .cb-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        color: #111827;
        font-size: 26px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.035em;
    }

    .cb-title i {
        color: #6366f1;
    }

    .cb-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 15px;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        font-size: 12px;
        line-height: 1.4;
        font-weight: 700;
        white-space: nowrap;
    }

    .cb-subtitle {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.5;
    }

    .cb-program-tabs {
        display: flex;
        align-items: stretch;
        gap: 10px;
        flex-wrap: wrap;
        margin: 0 0 22px;
    }

    .cb-program-tab {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        min-height: 48px;
        padding: 10px 18px;
        border: 1px solid #dfe5ee;
        border-radius: 13px;
        background: #fff;
        color: #334155;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .02);
        transition:
            background .18s ease,
            border-color .18s ease,
            color .18s ease,
            transform .18s ease,
            box-shadow .18s ease;
    }

    .cb-program-tab:hover {
        color: #4f46e5;
        border-color: #a5b4fc;
        background: #fafaff;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(99, 102, 241, .08);
    }

    .cb-program-tab.active {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(135deg, #6366f1, #7c3aed);
        box-shadow: 0 7px 18px rgba(99, 102, 241, .24);
    }

    .cb-program-tab i {
        flex: 0 0 auto;
    }

    .cb-program-name {
        max-width: 310px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 4px 8px;
        margin-left: 2px;
        border-radius: 7px;
        color: #475569;
        background: #f1f5f9;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .cb-program-tab.active .cb-tab-badge {
        color: #fff;
        background: rgba(255, 255, 255, .18);
    }

    .cb-board {
        width: 100%;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .02);
    }

    .cb-board-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 220px;
        padding: 40px 20px;
        color: #64748b;
    }

    .cb-board-loading p {
        margin: 0;
        font-size: 14px;
    }

    .cb-error-state {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 180px;
        padding: 30px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
    }

    .cb-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 245px;
        padding: 42px 24px;
        text-align: center;
    }

    .cb-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin-bottom: 14px;
        border-radius: 18px;
        color: #94a3b8;
        background: #f1f5f9;
        font-size: 28px;
    }

    .cb-empty-state h4 {
        margin: 0 0 6px;
        color: #334155;
        font-size: 18px;
        font-weight: 800;
    }

    .cb-empty-state p {
        max-width: 500px;
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.55;
    }

    .cb-empty-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 18px;
        padding: 9px 16px;
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .cb-empty-action:hover {
        color: #fff;
        border-color: #6366f1;
        background: #6366f1;
    }

    .ps-program-header {
        padding: 22px 26px;
        border-bottom: 1px solid #edf1f5;
        background: linear-gradient(135deg, #ffffff, #fbfbff);
    }

    .ps-program-main {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .ps-program-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        color: #6366f1;
        background: #eef2ff;
        font-size: 20px;
    }

    .ps-program-info {
        min-width: 0;
        flex: 1;
    }

    .ps-program-info h2 {
        margin: 0;
        color: #0f172a;
        font-size: 22px;
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .ps-program-info p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .ps-program-stats {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 9px;
    }

    .ps-program-stats span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 9px;
        border-radius: 7px;
        color: #475569;
        background: #f1f5f9;
        font-size: 11px;
        font-weight: 700;
    }

    .ps-semester-list {
        padding: 18px;
    }

    .ps-semester {
        overflow: hidden;
        margin-bottom: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: #fff;
        transition: box-shadow .18s ease;
    }

    .ps-semester:last-child {
        margin-bottom: 0;
    }

    .ps-semester:hover {
        box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
    }

    .ps-semester-header {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 14px 17px;
        border: 0;
        border-left: 4px solid var(--semester-color);
        background: #fff;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }

    .ps-semester-header:hover {
        background: #fcfcfd;
    }

    .ps-semester-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: #fff;
        font-size: 15px;
    }

    .ps-semester-heading {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        gap: 2px;
    }

    .ps-semester-heading strong {
        overflow: hidden;
        color: #1e293b;
        font-size: 14px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ps-semester-heading small {
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
    }

    .ps-semester-chevron {
        color: #94a3b8;
        font-size: 12px;
        transition: transform .2s ease;
    }

    .ps-semester.collapsed .ps-semester-chevron {
        transform: rotate(-90deg);
    }

    .ps-semester.collapsed .ps-semester-body {
        display: none;
    }

    .ps-semester-body {
        padding: 0 14px 14px;
    }

    .ps-course-wrapper {
        margin-top: 8px;
    }

    .ps-course-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 66px;
        padding: 11px 13px;
        border: 1px solid #edf1f5;
        border-radius: 11px;
        background: #fafbfc;
        transition:
            background .16s ease,
            border-color .16s ease,
            transform .16s ease;
    }

    .ps-course-card:hover {
        border-color: #dbe2ea;
        background: #fff;
        transform: translateX(2px);
    }

    .ps-course-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        color: #475569;
        background: #eef2f7;
        font-size: 14px;
    }

    .ps-course-info {
        flex: 1;
        min-width: 0;
    }

    .ps-course-name {
        overflow: hidden;
        color: #1e293b;
        font-size: 13px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ps-course-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10.5px;
        font-weight: 600;
    }

    .ps-course-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 7px;
    }

    .ps-content-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 31px;
        padding: 5px 9px;
        border: 1px solid #c7d2fe;
        border-radius: 8px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .ps-content-chevron {
        margin-left: 2px;
        font-size: 8px;
        transition: transform .18s ease;
    }

    .ps-content-badge[aria-expanded="true"] .ps-content-chevron {
        transform: rotate(180deg);
    }

    .ps-zero-content {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
    }

    .ps-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #6366f1;
        background: #fff;
        cursor: pointer;
        transition: all .16s ease;
    }

    .ps-action-btn:hover {
        color: #fff;
        border-color: #6366f1;
        background: #6366f1;
    }

    .ps-course-content-list {
        margin-top: -1px;
        padding: 10px 12px 10px 48px;
        border: 1px solid #e2e8f0;
        border-top: 0;
        border-radius: 0 0 11px 11px;
        background: #fafbff;
    }

    .ps-semester-empty {
        padding: 22px;
        color: #94a3b8;
        font-size: 12px;
        text-align: center;
    }

    .cb-content-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 9px;
        margin-bottom: 5px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fff;
    }

    .cb-content-item:last-child {
        margin-bottom: 0;
    }

    .cb-content-item-main {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 7px;
    }

    .cb-content-item-main i {
        color: #6366f1;
        font-size: 11px;
    }

    .cb-content-item-title {
        overflow: hidden;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-quadrant-badge {
        flex: 0 0 auto;
        padding: 2px 7px;
        border-radius: 5px;
        color: #4f46e5;
        background: #e0e7ff;
        font-size: 9px;
        font-weight: 800;
    }

    .cb-mapping-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
        max-height: 420px;
    }

    .cb-mapping-column {
        overflow-y: auto;
        padding: 16px;
    }

    .cb-mapping-divider {
        background: #e2e8f0;
    }

    .cb-mapping-heading {
        margin-bottom: 11px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .cb-library-search {
        width: 100%;
        padding: 9px 13px;
        margin-bottom: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        outline: none;
        font-size: 13px;
    }

    .cb-library-search:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, .10);
    }

    .cb-resource-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 10px;
        margin-bottom: 6px;
        border: 1px solid #edf1f5;
        border-radius: 9px;
        background: #f8fafc;
    }

    .cb-resource-info {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 8px;
    }

    .cb-resource-info i {
        flex: 0 0 auto;
        color: #6366f1;
    }

    .cb-resource-title {
        overflow: hidden;
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-resource-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 29px;
        width: 29px;
        height: 29px;
        padding: 0;
        border: 0;
        border-radius: 7px;
        background: transparent;
        cursor: pointer;
    }

    .cb-resource-button.add {
        color: #10b981;
    }

    .cb-resource-button.remove {
        color: #ef4444;
    }

    .cb-resource-button:hover {
        background: #fff;
    }

    .cb-small-empty {
        padding: 18px 8px;
        color: #94a3b8;
        font-size: 12px;
        text-align: center;
    }

    /* Manage Content modal */
    #manageContentModal .modal-dialog { width: min(920px, calc(100vw - 32px)); max-width: 920px; margin: 24px auto; }
    #manageContentModal .modal-content { max-height: calc(100vh - 48px); border: 0; border-radius: 18px; overflow: hidden; background: #fff; box-shadow: 0 24px 70px rgba(15, 23, 42, .22); }
    #manageContentModal .modal-header { flex: 0 0 auto; padding: 20px 22px; border-bottom: 1px solid #e2e8f0; }
    #manageContentModal .modal-body { min-height: 0; overflow: auto; }
    #manageContentModal .modal-footer { flex: 0 0 auto; justify-content: flex-end !important; gap: 10px; padding: 14px 22px; border-top: 1px solid #e2e8f0; background: #fff; }
    #manageContentModal .modal-footer .btn { min-width: 100px; border-radius: 9px; font-weight: 700; }

    @@media (max-width: 991px) {
        .cb-shell {
            padding: 18px;
        }

        .cb-header {
            min-height: auto;
            padding: 20px;
        }

        .cb-title {
            font-size: 22px;
        }

        .cb-program-tab {
            flex: 1 1 220px;
        }
    }

    @@media (max-width: 767px) {
        .cb-shell {
            padding: 12px;
        }

        .cb-header {
            margin-bottom: 16px;
            padding: 18px;
            border-radius: 15px;
        }

        .cb-title-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .cb-title {
            font-size: 20px;
        }

        .cb-pill {
            white-space: normal;
        }

        .cb-program-tabs {
            gap: 8px;
            margin-bottom: 16px;
        }

        .cb-program-tab {
            flex: 1 1 100%;
            width: 100%;
        }

        .cb-program-name {
            flex: 1;
            max-width: none;
            text-align: left;
        }

        .cb-board {
            border-radius: 15px;
        }

        .ps-program-header {
            padding: 18px;
        }

        .ps-program-main {
            align-items: flex-start;
        }

        .ps-semester-list {
            padding: 12px;
        }

        .ps-course-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .ps-course-info {
            min-width: calc(100% - 50px);
        }

        .ps-course-actions {
            width: 100%;
            padding-left: 48px;
        }

        .ps-course-content-list {
            padding-left: 12px;
        }

        .cb-mapping-grid {
            display: block;
            max-height: none;
        }

        .cb-mapping-divider {
            width: 100%;
            height: 1px;
        }

        .cb-mapping-column {
            max-height: 300px;
        }
    }
</style>

@Html.AntiForgeryToken()

<div class="cb-shell">

    <div class="cb-header">
        <div class="cb-header-main">

            <div class="cb-title-row">
                <h1 class="cb-title">
                    <i class="fa-solid fa-graduation-cap"></i>
                    Curriculum Builder
                </h1>

                <span class="cb-pill">
                    Program → Semester → Course → Content
                </span>
            </div>

            <p class="cb-subtitle">
                Organize your complete academic hierarchy from a single interface.
            </p>
        </div>
    </div>

    @if (Model.Programs != null && Model.Programs.Any())
    {
        <div class="cb-program-tabs"
             id="programTabs"
             role="tablist">

            @foreach (var program in Model.Programs)
            {
                bool active = program.Id == Model.SelectedProgramId;

                <button type="button"
                        class="cb-program-tab @(active ? "active" : "")"
                        data-program-id="@program.Id"
                        role="tab"
                        aria-selected="@(active ? "true" : "false")">

                    <i class="fa-solid fa-building-columns"></i>

                    <span class="cb-program-name"
                          title="@program.Name">
                        @program.Name
                    </span>

                    <span class="cb-tab-badge">
                        @(program.NoOfSemester ?? 0) Sem
                    </span>
                </button>
            }
        </div>
    }

    <div class="cb-board"
         id="structureBoard">

        @if (Model.Programs == null || !Model.Programs.Any())
        {
            <div class="cb-empty-state">
                <div class="cb-empty-icon">
                    <i class="fa-solid fa-building-columns"></i>
                </div>

                <h4>No programs available</h4>

                <p>
                    Create an active program before building the curriculum.
                </p>
            </div>
        }
        else if (Model.SelectedProgramStructure != null)
        {
            <partial name="_ProgramStructureTree"
                     model="Model.SelectedProgramStructure" />
        }
        else
        {
            <div class="cb-empty-state">
                <div class="cb-empty-icon">
                    <i class="fa-regular fa-folder-open"></i>
                </div>

                <h4>No curriculum available</h4>

                <p>
                    Select a program to view its curriculum structure.
                </p>
            </div>
        }
    </div>
</div>

@if (!isFaculty)
{
    <div class="modal fade"
         id="manageContentModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content"
                 style="border:0;border-radius:20px;overflow:hidden;box-shadow:0 25px 60px -15px rgba(15,23,42,.30);">

                <div class="modal-header"
                     style="padding:20px 22px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);">

                    <div>
                        <h5 class="modal-title fw-bold"
                            style="color:#0f172a;">
                            Map Content Resources
                        </h5>

                        <div class="text-muted"
                             style="font-size:12px;margin-top:3px;">
                            Assigning to:
                            <strong id="mappingCourseTitle"
                                    class="text-primary"></strong>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close js-close-manage-content"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">

                    <input type="hidden"
                           id="mapCourseId" />

                    <div class="p-3 border-bottom">
                        <label for="mapQuadrantId"
                               class="form-label fw-bold"
                               style="font-size:11px;color:#64748b;text-transform:uppercase;">
                            Quadrant
                        </label>

                        <select id="mapQuadrantId"
                                class="form-select"
                                style="max-width:330px;border-radius:9px;">

                            @if (Model.AllQuadrants != null &&
                                 Model.AllQuadrants.Any())
                            {
                                foreach (var quadrant in Model.AllQuadrants)
                                {
                                    <option value="@quadrant.Id"
                                            data-quadrant-number="@quadrant.QuadrantNumber">
                                        @quadrant.Name
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="">
                                    No quadrants available
                                </option>
                            }
                        </select>
                    </div>

                    <div class="cb-mapping-grid">

                        <div class="cb-mapping-column">

                            <div class="cb-mapping-heading">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                Library Resources
                            </div>

                            <input type="search"
                                   id="librarySearch"
                                   class="cb-library-search"
                                   autocomplete="off"
                                   placeholder="Search content..." />

                            <div id="libraryItemsList"></div>
                        </div>

                        <div class="cb-mapping-divider"></div>

                        <div class="cb-mapping-column">

                            <div class="cb-mapping-heading">
                                <i class="fa-solid fa-link"></i>
                                Assigned to this Course
                            </div>

                            <div id="mappedItemsList"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn btn-primary px-4 js-close-manage-content">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <script>
        (function () {
            "use strict";

            const isFaculty = @(isFaculty ? "true" : "false");

            const urls = {
                getProgramStructure: '@Url.Action("GetProgramStructure", "CourseStructure", new { area = "Admin" })',
                getCourseContent: '@Url.Action("GetCourseContent", "CourseStructure", new { area = "Admin" })',
                getLibraryItems: '@Url.Action("GetLibraryItems", "CourseStructure", new { area = "Admin" })',
                assignContent: '@Url.Action("AssignContent", "CourseStructure", new { area = "Admin" })',
                unassignContent: '@Url.Action("UnassignContent", "CourseStructure", new { area = "Admin" })'
            };

            function getAntiForgeryToken() {
                return document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value || "";
            }

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function materialIcon(type) {
                switch ((type || "").toLowerCase()) {
                    case "video":
                        return "fa-video";

                    case "videourl":
                    case "url":
                    case "link":
                        return "fa-link";

                    case "audio":
                        return "fa-volume-high";

                    case "image":
                        return "fa-image";

                    default:
                        return "fa-file-lines";
                }
            }

            function showBoardLoading() {
                $("#structureBoard").html(
                    '<div class="cb-board-loading">' +
                    '<div class="spinner-border text-primary" role="status"></div>' +
                    '<p>Loading curriculum...</p>' +
                    '</div>'
                );
            }

            function showBoardError(message) {
                $("#structureBoard").html(
                    '<div class="cb-error-state">' +
                    '<i class="fa-solid fa-circle-exclamation"></i>' +
                    '<span>' + escapeHtml(message) + '</span>' +
                    '</div>'
                );
            }

            function refreshStructure() {
                const activeTab = $(".cb-program-tab.active");
                const programId = Number(activeTab.data("program-id"));

                if (!programId) {
                    return;
                }

                $.ajax({
                    url: urls.getProgramStructure,
                    type: "GET",
                    data: {
                        programId: programId
                    }
                })
                .done(function (html) {
                    $("#structureBoard").html(html);
                })
                .fail(function () {
                    showBoardError(
                        "Unable to refresh curriculum structure."
                    );
                });
            }

            function renderLibraryItems(items) {
                const container = $("#libraryItemsList");

                if (!Array.isArray(items) || items.length === 0) {
                    container.html(
                        '<div class="cb-small-empty">' +
                        'No library resources found.' +
                        '</div>'
                    );
                    return;
                }

                let html = "";

                items.forEach(function (item) {
                    html +=
                        '<div class="cb-resource-row">' +
                            '<div class="cb-resource-info">' +
                                '<i class="fa-solid ' +
                                    materialIcon(item.type) +
                                '"></i>' +
                                '<span class="cb-resource-title" title="' +
                                    escapeHtml(item.title) +
                                '">' +
                                    escapeHtml(item.title) +
                                '</span>' +
                            '</div>' +

                            '<button type="button" ' +
                                    'class="cb-resource-button add js-assign-content" ' +
                                    'data-material-id="' +
                                    Number(item.id) +
                                    '" data-material-type="' +
                                    escapeHtml(item.type || "") +
                                    '" title="Assign content">' +
                                '<i class="fa-solid fa-circle-plus"></i>' +
                            '</button>' +
                        '</div>';
                });

                container.html(html);
            }

            function renderMappedItems(items) {
                const container = $("#mappedItemsList");

                if (!Array.isArray(items) || items.length === 0) {
                    container.html(
                        '<div class="cb-small-empty">' +
                        'No content assigned yet.' +
                        '</div>'
                    );
                    return;
                }

                let html = "";

                items.forEach(function (item) {
                    html +=
                        '<div class="cb-resource-row">' +

                            '<div class="cb-resource-info">' +
                                '<i class="fa-solid ' +
                                    materialIcon(item.type) +
                                '"></i>' +

                                '<div style="min-width:0;">' +
                                    '<div class="cb-resource-title" title="' +
                                        escapeHtml(item.title) +
                                    '">' +
                                        escapeHtml(item.title) +
                                    '</div>' +

                                    '<div style="font-size:9px;color:#8b5cf6;font-weight:700;margin-top:2px;">' +
                                        escapeHtml(item.quadrant) +
                                    '</div>' +
                                '</div>' +
                            '</div>' +

                            '<button type="button" ' +
                                    'class="cb-resource-button remove js-unassign-content" ' +
                                    'data-mapping-id="' +
                                    Number(item.mappingId) +
                                    '" title="Remove content">' +
                                '<i class="fa-solid fa-trash"></i>' +
                            '</button>' +

                        '</div>';
                });

                container.html(html);
            }

            function loadLibrary(searchText) {
                $("#libraryItemsList").html(
                    '<div class="cb-small-empty">' +
                    '<i class="fa-solid fa-spinner fa-spin"></i> Loading...' +
                    '</div>'
                );

                $.ajax({
                    url: urls.getLibraryItems,
                    type: "GET",
                    data: {
                        search: searchText || ""
                    }
                })
                .done(function (items) {
                    renderLibraryItems(items);
                })
                .fail(function () {
                    $("#libraryItemsList").html(
                        '<div class="cb-small-empty text-danger">' +
                        'Unable to load library resources.' +
                        '</div>'
                    );
                });
            }

            function loadMappedItems() {
                const courseId = Number($("#mapCourseId").val());

                if (!courseId) {
                    return;
                }

                $("#mappedItemsList").html(
                    '<div class="cb-small-empty">' +
                    '<i class="fa-solid fa-spinner fa-spin"></i> Loading...' +
                    '</div>'
                );

                $.ajax({
                    url: urls.getCourseContent,
                    type: "GET",
                    data: {
                        courseId: courseId
                    }
                })
                .done(function (items) {
                    renderMappedItems(items);
                })
                .fail(function () {
                    $("#mappedItemsList").html(
                        '<div class="cb-small-empty text-danger">' +
                        'Unable to load assigned content.' +
                        '</div>'
                    );
                });
            }

            function loadMappingData() {
                loadLibrary($("#librarySearch").val());
                loadMappedItems();
            }

            $(document).on(
                "click",
                ".cb-program-tab",
                function () {
                    const button = $(this);
                    const programId = Number(
                        button.data("program-id")
                    );

                    if (!programId ||
                        button.hasClass("active")) {
                        return;
                    }

                    $(".cb-program-tab")
                        .removeClass("active")
                        .attr("aria-selected", "false");

                    button
                        .addClass("active")
                        .attr("aria-selected", "true");

                    showBoardLoading();

                    $.ajax({
                        url: urls.getProgramStructure,
                        type: "GET",
                        data: {
                            programId: programId
                        }
                    })
                    .done(function (html) {
                        $("#structureBoard").html(html);

                        const newUrl =
                            window.location.pathname +
                            "?programId=" +
                            encodeURIComponent(programId);

                        window.history.replaceState(
                            {},
                            "",
                            newUrl
                        );
                    })
                    .fail(function () {
                        showBoardError(
                            "Unable to load the selected program."
                        );
                    });
                }
            );

            $(document).on(
                "click",
                ".ps-semester-header",
                function () {
                    const semester = $(this)
                        .closest(".ps-semester");

                    semester.toggleClass("collapsed");

                    const collapsed =
                        semester.hasClass("collapsed");

                    $(this).attr(
                        "aria-expanded",
                        collapsed ? "false" : "true"
                    );
                }
            );

            $(document).on(
                "click",
                ".cb-view-content-badge",
                function () {
                    const button = $(this);
                    const courseId = Number(
                        button.data("course-id")
                    );

                    const container = $(
                        "#content-list-" + courseId
                    );

                    if (!courseId) {
                        return;
                    }

                    if (container.is(":visible")) {
                        container.stop(true, true).slideUp(160);
                        button.attr("aria-expanded", "false");
                        return;
                    }

                    button.attr("aria-expanded", "true");

                    container
                        .html(
                            '<div class="cb-small-empty">' +
                            '<i class="fa-solid fa-spinner fa-spin"></i> Loading content...' +
                            '</div>'
                        )
                        .stop(true, true)
                        .slideDown(160);

                    $.ajax({
                        url: urls.getCourseContent,
                        type: "GET",
                        data: {
                            courseId: courseId
                        }
                    })
                    .done(function (items) {
                        if (!Array.isArray(items) ||
                            items.length === 0) {

                            container.html(
                                '<div class="cb-small-empty">' +
                                'No content assigned.' +
                                '</div>'
                            );

                            return;
                        }

                        let html = "";

                        items.forEach(function (item) {
                            html +=
                                '<div class="cb-content-item">' +

                                    '<div class="cb-content-item-main">' +
                                        '<i class="fa-solid ' +
                                            materialIcon(item.type) +
                                        '"></i>' +

                                        '<span class="cb-content-item-title" title="' +
                                            escapeHtml(item.title) +
                                        '">' +
                                            escapeHtml(item.title) +
                                        '</span>' +
                                    '</div>' +

                                    '<span class="cb-quadrant-badge">' +
                                        escapeHtml(item.quadrant) +
                                    '</span>' +

                                '</div>';
                        });

                        container.html(html);
                    })
                    .fail(function () {
                        container.html(
                            '<div class="cb-small-empty text-danger">' +
                            'Unable to load assigned content.' +
                            '</div>'
                        );
                    });
                }
            );

            if (!isFaculty) {
                let manageContentModalInstance = null;

                function closeManageContentModal() {
                    const modalElement = document.getElementById("manageContentModal");
                    if (!modalElement) return;

                    if (manageContentModalInstance && typeof manageContentModalInstance.hide === "function") {
                        manageContentModalInstance.hide();
                        return;
                    }

                    if (window.jQuery && $.fn && typeof $.fn.modal === "function") {
                        $(modalElement).modal("hide");
                    }
                }

                $(document).on("click", ".js-close-manage-content", function (event) {
                    event.preventDefault();
                    closeManageContentModal();
                });

                $(document).on(
                    "click",
                    ".cb-manage-content-btn",
                    function () {
                        const courseId = Number(
                            $(this).data("course-id")
                        );

                        const courseName =
                            $(this).data("course-name") || "";

                        if (!courseId) {
                            return;
                        }

                        $("#mapCourseId").val(courseId);
                        $("#mappingCourseTitle").text(courseName);
                        $("#librarySearch").val("");

                        loadMappingData();

                        const modalElement =
                            document.getElementById(
                                "manageContentModal"
                            );

                        if (!modalElement) {
                            return;
                        }

                        if (!manageContentModalInstance) {
                            manageContentModalInstance = new bootstrap.Modal(modalElement);
                        }

                        manageContentModalInstance.show();
                    }
                );

                $("#manageContentModal").on("hidden.bs.modal", function () {
                    $("#librarySearch").val("");
                    $("#mapCourseId").val("");
                    $("#mappingCourseTitle").text("");
                    $("#libraryItemsList").empty();
                    $("#mappedItemsList").empty();
                    $("body").removeClass("modal-open");
                    $(".modal-backdrop").remove();
                });

                let searchTimer = null;

                $(document).on(
                    "input",
                    "#librarySearch",
                    function () {
                        const searchText = $(this).val();

                        window.clearTimeout(searchTimer);

                        searchTimer = window.setTimeout(
                            function () {
                                loadLibrary(searchText);
                            },
                            300
                        );
                    }
                );

                $(document).on(
                    "click",
                    ".js-assign-content",
                    function () {
                        const button = $(this);

                        const materialId = Number(
                            button.data("material-id")
                        );

                        const courseId = Number(
                            $("#mapCourseId").val()
                        );

                        const materialType = String(
                            button.data("material-type") || ""
                        ).trim().toLowerCase();

                        const automaticQuadrantNumber =
                            materialType === "video" ||
                            materialType === "videourl" ||
                            materialType === "url" ||
                            materialType === "link"
                                ? 2
                                : materialType === "document"
                                    ? 1
                                    : null;

                        if (automaticQuadrantNumber !== null) {
                            const automaticOption = $(
                                '#mapQuadrantId option[data-quadrant-number="' +
                                automaticQuadrantNumber +
                                '"]'
                            );

                            if (automaticOption.length) {
                                $("#mapQuadrantId").val(automaticOption.val());
                            }
                        }

                        const quadrantId = Number(
                            $("#mapQuadrantId").val()
                        );

                        if (!materialId || !courseId) {
                            return;
                        }

                        if (!quadrantId) {
                            alert(
                                "Please select a valid quadrant."
                            );
                            return;
                        }

                        button
                            .prop("disabled", true)
                            .html(
                                '<i class="fa-solid fa-spinner fa-spin"></i>'
                            );

                        $.ajax({
                            url: urls.assignContent,
                            type: "POST",
                            data: {
                                __RequestVerificationToken:
                                    getAntiForgeryToken(),

                                materialId: materialId,
                                courseId: courseId,
                                quadrantId: quadrantId
                            }
                        })
                        .done(function (response) {
                            if (!response ||
                                response.success !== true) {

                                alert(
                                    response?.message ||
                                    "Unable to assign content."
                                );

                                return;
                            }

                            loadMappingData();
                            refreshStructure();
                        })
                        .fail(function () {
                            alert(
                                "Unable to assign content. Please try again."
                            );
                        })
                        .always(function () {
                            button
                                .prop("disabled", false)
                                .html(
                                    '<i class="fa-solid fa-circle-plus"></i>'
                                );
                        });
                    }
                );

                $(document).on(
                    "click",
                    ".js-unassign-content",
                    function () {
                        const button = $(this);

                        const mappingId = Number(
                            button.data("mapping-id")
                        );

                        if (!mappingId) {
                            return;
                        }

                        button
                            .prop("disabled", true)
                            .html(
                                '<i class="fa-solid fa-spinner fa-spin"></i>'
                            );

                        $.ajax({
                            url: urls.unassignContent,
                            type: "POST",
                            data: {
                                __RequestVerificationToken:
                                    getAntiForgeryToken(),

                                mappingId: mappingId
                            }
                        })
                        .done(function (response) {
                            if (!response ||
                                response.success !== true) {

                                alert(
                                    response?.message ||
                                    "Unable to remove content."
                                );

                                return;
                            }

                            loadMappingData();
                            refreshStructure();
                        })
                        .fail(function () {
                            alert(
                                "Unable to remove content. Please try again."
                            );
                        })
                        .always(function () {
                            button
                                .prop("disabled", false)
                                .html(
                                    '<i class="fa-solid fa-trash"></i>'
                                );
                        });
                    }
                );
            }
        })();
    </script>
}


