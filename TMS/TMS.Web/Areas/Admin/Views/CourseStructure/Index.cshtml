                    $(".ah-nav-tab").removeClass("active");
                    $(`.ah-nav-tab[data-view="${viewName}"]`).addClass("active");
                    $(".ah-view-container").addClass("d-none");
                    $(`#hubView_${viewName}`).removeClass("d-none");

                    if (history.replaceState) {
                        const url = new URL(window.location);
                        url.searchParams.set("view", viewName);
                        history.replaceState(null, "", url.toString());
                    }
                }

                $(document).on("click", ".ah-nav-tab", function () {
                    const view = $(this).data("view");
                    switchHubView(view);
                });

                // Auto-detect initial view from URL
                const urlParams = new URLSearchParams(window.location.search);
                const initialView = urlParams.get("view") || window.location.hash.replace("#", "");
                if (initialView && ["tree", "courses", "programs"].includes(initialView)) {
                    switchHubView(initialView);
                }

                // ========================================================
                // COURSE CATALOG: FILTERING & SEARCH
                // ========================================================
                function filterCourseCatalog() {
                    const search = ($("#courseCatalogSearch").val() || "").toLowerCase().trim();
                    const programFilter = $("#courseCatalogProgramFilter").val();
                    const semesterFilter = $("#courseCatalogSemesterFilter").val();

                    let visibleCount = 0;
                    $(".ah-catalog-card").each(function () {
                        const card = $(this);
                        const name = (card.data("name") || "").toString().toLowerCase();
                        const code = (card.data("code") || "").toString().toLowerCase();
                        const prog = (card.data("program-id") || "").toString();
                        const sem = (card.data("semester-id") || "").toString();

                        const matchSearch = !search || name.includes(search) || code.includes(search);
                        const matchProg = !programFilter || programFilter === "all" || prog === programFilter;
                        const matchSem = !semesterFilter || semesterFilter === "all" || sem === semesterFilter;

                        if (matchSearch && matchProg && matchSem) {
                            card.removeClass("d-none");
                            visibleCount++;
                        } else {
                            card.addClass("d-none");
                        }
                    });

                    if (visibleCount === 0) {
                        $("#catalogEmptyState").removeClass("d-none");
                    } else {
                        $("#catalogEmptyState").addClass("d-none");
                    }
                }

                $(document).on("input", "#courseCatalogSearch", filterCourseCatalog);
                $(document).on("change", "#courseCatalogProgramFilter, #courseCatalogSemesterFilter", filterCourseCatalog);

                // ========================================================
                // PROGRAM SEMESTERS LOADER HELPER
                // ========================================================
                function loadProgramSemesters(programId, targetSemesterId, callback) {
                    const select = $("#acSemesterSelect");
                    select.html('<option value="">Loading semesters...</option>');

                    if (!programId) {
                        select.html('<option value="">-- Choose Program First --</option>');
                        return;
                    }

                    $.ajax({
                        url: urls.getProgramSemesters,
                        type: "GET",
                        data: { programId: programId }
                    })
                    .done(function (semesters) {
                        select.empty();
                        if (Array.isArray(semesters) && semesters.length > 0) {
                            semesters.forEach(function (s) {
                                select.append(`<option value="${s.id}">${escapeHtml(s.name)}</option>`);
                            });
                            if (targetSemesterId > 0) {
                                select.val(targetSemesterId);
                            }
                        } else {
                            select.append('<option value="">No semesters configured</option>');
                        }
                        if (typeof callback === "function") callback();
                    })
                    .fail(function () {
                        select.html('<option value="">Error loading semesters</option>');
                    });
                }

                $(document).on("change", "#acProgramSelect", function () {
                    const progId = Number($(this).val()) || 0;
                    $("#acProgramId").val(progId);
                    loadProgramSemesters(progId, 0);
                });

                // ========================================================
                // OPEN ADD COURSE MODAL
                // ========================================================
                function openAddCourseModalWithStructure(programId, targetSemesterId) {
                    if (!programId) {
                        programId = Number($(".cb-program-tab.active").data("program-id")) || Number($("#acProgramSelect option:first").val()) || 0;
                    }

                    $("#addCourseModalTitle").text("Add Course");
                    $("#addCourseModalSubtitle").text("Create a new course and manage its structure");
                    $("#acCourseId").val("0");
                    $("#acProgramId").val(programId);
                    $("#acProgramSelect").val(programId);
                    $("#acCourseCode").val("");
                    $("#acCourseTitle").val("");
                    $("#acCourseDescription").val("");
                    $("#acCourseCredits").val(4);
                    $("#acCourseDuration").val(6);
                    $("#acErrorAlert").addClass("d-none").text("");

                    currentModules = [
                        {
                            id: 0,
                            name: "Introduction to Course",
                            topics: [
                                { id: 0, name: "Overview and Foundations" },
                                { id: 0, name: "Core Concepts & Methodology" }
                            ]
                        },
                        {
                            id: 0,
                            name: "Advanced Principles",
                            topics: [
                                { id: 0, name: "Practical Implementations" }
                            ]
                        }
                    ];
                    renderModulesEditor();
                    loadProgramSemesters(programId, targetSemesterId);
                    showModal("addCourseStructuredModal");
                }

                $(document).on("click", "#btnHeaderAddCourse, .btn-open-add-course", function () {
                    const activeProg = Number($(".cb-program-tab.active").data("program-id")) || 0;
                    openAddCourseModalWithStructure(activeProg);
                });

                $(document).on("click", ".cb-quick-add-course-btn, .cb-sem-add-course-btn", function () {
                    const programId = Number($(this).data("program-id")) || Number($(".cb-program-tab.active").data("program-id")) || 0;
                    const targetSemesterId = Number($(this).data("semester-id")) || 0;
                    openAddCourseModalWithStructure(programId, targetSemesterId);
                });

                $(document).on("click", ".btn-program-add-course, .cb-prog-add-course-btn", function () {
                    const programId = Number($(this).data("program-id"));
                    openAddCourseModalWithStructure(programId);
                });

                // ========================================================
                // OPEN EDIT COURSE MODAL & STRUCTURE
                // ========================================================
                function loadAndOpenCourseFullStructure(courseId) {
                    if (!courseId) return;

                    $("#acErrorAlert").addClass("d-none").text("");

                    $.ajax({
                        url: urls.getCourseFullDetails,
                        type: "GET",
                        data: { courseId: courseId }
                    })
                    .done(function (course) {
                        if (!course) return;

                        $("#addCourseModalTitle").text("Edit Course");
                        $("#addCourseModalSubtitle").text("Update course details and manage its structure");

                        $("#acCourseId").val(course.courseId);
                        $("#acProgramId").val(course.programId);
                        $("#acProgramSelect").val(course.programId);
                        $("#acCourseCode").val(course.courseCode || "");
                        $("#acCourseTitle").val(course.courseTitle || "");
                        $("#acCourseDescription").val(course.description || "");
                        $("#acCourseCredits").val(course.credits || 4);
                        $("#acCourseDuration").val(course.durationMonths || 6);

                        loadProgramSemesters(course.programId, course.semesterId);

                        if (course.modules && course.modules.length > 0) {
                            currentModules = course.modules.map(function (m) {
                                return {
                                    id: m.id || 0,
                                    name: m.name || '',
                                    topics: (m.topics || []).map(function (t) {
                                        return {
                                            id: t.id || 0,
                                            name: t.name || ''
                                        };
                                    })
                                };
                            });
                        } else {
                            currentModules = [
                                {
                                    id: 0,
                                    name: "Module 1",
                                    topics: [{ id: 0, name: "Topic 1" }]
                                }
                            ];
                        }
                        renderModulesEditor();
                        showModal("addCourseStructuredModal");
                    })
                    .fail(function () {
                        alert("Unable to load course structure.");
                    });
                }

                $(document).on("click", ".cb-edit-course-btn, .btn-catalog-edit, .btn-catalog-manage-structure", function () {
                    const courseId = Number($(this).data("course-id"));
                    loadAndOpenCourseFullStructure(courseId);
                });

                $(document).on("click", ".btn-catalog-content", function () {
                    const courseId = Number($(this).data("course-id"));
                    const courseName = $(this).data("course-name") || "Course";
                    openContentModal(courseId, courseName);
                });

                $(document).on("click", ".cb-assign-faculty-btn, .btn-catalog-assign-faculty", function () {
                    const courseId = Number($(this).data("course-id"));
                    const courseName = $(this).data("course-name") || "Course";
                    if (!courseId) return;
                    $("#hubFacultyMappingModalLabel").html(`<i class="fa fa-chalkboard-user me-2"></i> Faculty Mapping: ${escapeHtml(courseName)}`);
                    $("#hubFacultyMappingModalBody").html('<div class="text-center py-5"><i class="fa fa-spinner fa-spin fa-2x text-primary mb-2"></i><p class="text-muted mb-0">Loading instructors...</p></div>');
                    showModal("hubFacultyMappingModal");
                    $("#hubFacultyMappingModalBody").load(`/Admin/FacultyMapping/ManageMapping?courseId=${courseId}`);
                });

                // ========================================================
                // PROGRAM DIRECTORY ACTIONS
                // ========================================================
                $(document).on("click", ".btn-explore-program", function () {
                    const programId = Number($(this).data("program-id"));
                    if (!programId) return;
                    $(`.cb-program-tab[data-program-id="${programId}"]`).click();
                    switchHubView("tree");
                });

                $(document).on("click", ".btn-edit-program", function () {
                    const programId = Number($(this).data("program-id")) || 0;
                    const programName = $(this).data("program-name") || "";
                    const semesters = Number($(this).data("semesters")) || 6;
                    const desc = $(this).data("description") || "";

                    $("#progId").val(programId);
                    $("#progName").val(programName);
                    $("#progSemesters").val(semesters);
                    $("#progDurationMonths").val(semesters * 6);
                    $("#progDescription").val(desc);
                    $("#progErrorAlert").addClass("d-none").text("");
                    $("#programModalTitle").text("Edit Program: " + programName);
                    showModal("programModal");
                });

                $(document).on("click", ".btn-delete-program", function () {
                    const programId = Number($(this).data("program-id"));
                    const programName = $(this).data("program-name") || "this program";
                    const courseCount = Number($(this).data("course-count")) || 0;

                    if (courseCount > 0) {
                        alert(`Cannot delete '${programName}' because it has ${courseCount} courses assigned. Please remove or move its courses first.`);
                        return;
                    }

                    $("#deleteProgramId").val(programId);
                    $("#deleteProgramNameDisplay").text(programName);
                    showModal("deleteProgramModal");
                });

                $(document).on("click", "#confirmDeleteProgramBtn", function () {
                    const programId = Number($("#deleteProgramId").val());
                    const btn = $(this);
                    if (!programId) return;

                    btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Deleting...');

                    $.ajax({
                        url: urls.deleteProgram,
                        type: "POST",
                        data: {
                            __RequestVerificationToken: getAntiForgeryToken(),
                            programId: programId
                        }
                    })
                    .done(function (res) {
                        if (res && res.success) {
                            sessionStorage.setItem("cb_toast_msg", res.message || "Program removed successfully!");
                            sessionStorage.setItem("cb_toast_type", "success");
                            hideModal("deleteProgramModal");
                            window.location.reload();
                        } else {
                            alert(res?.message || "Failed to delete program.");
                        }
                    })
                    .fail(function () {
                        alert("An error occurred while deleting the program.");
                    })
                    .always(function () {
                        btn.prop("disabled", false).html('<i class="fa-solid fa-trash me-1"></i> Delete');
                    });
                });

                // ========================================================
                // SAVE COURSE FORM SUBMISSION
                // ========================================================
                $("#acCourseForm").on("submit", function (e) {
                    e.preventDefault();
                    const courseId = Number($("#acCourseId").val()) || 0;
                    const programId = Number($("#acProgramId").val());
                    const semesterId = Number($("#acSemesterSelect").val());
                    const code = $("#acCourseCode").val().trim();
                    const title = $("#acCourseTitle").val().trim();
                    const desc = $("#acCourseDescription").val().trim();
                    const credits = Number($("#acCourseCredits").val()) || 4;
                    const duration = Number($("#acCourseDuration").val()) || 6;
                    const btn = $("#acSaveCourseBtn");

                    if (!programId) {
                        $("#acErrorAlert").text("Please select a valid Program.").removeClass("d-none");
                        return;
                    }

                    if (!semesterId) {
                        $("#acErrorAlert").text("Please select a Target Semester.").removeClass("d-none");
                        return;
                    }

                    if (!code) {
                        $("#acErrorAlert").text("Course Code is required.").removeClass("d-none");
                        return;
                    }

                    if (!title) {
                        $("#acErrorAlert").text("Full Course Title is required.").removeClass("d-none");
                        return;
                    }

                    const modulesPayload = currentModules.map(function (mod, modIdx) {
                        return {
                            id: mod.id || 0,
                            name: mod.name || `Module ${modIdx + 1}`,
                            sortOrder: modIdx + 1,
                            topics: (mod.topics || []).map(function (top, topIdx) {
                                return {
                                    id: top.id || 0,
                                    name: top.name || `Topic ${topIdx + 1}`,
                                    sortOrder: topIdx + 1
                                };
                            })
                        };
                    });

                    const payload = {
                        courseId: courseId,
                        programId: programId,
                        semesterId: semesterId,
                        courseCode: code,
                        courseTitle: title,
                        description: desc,
                        credits: credits,
                        durationMonths: duration,
                        modules: modulesPayload
                    };

                    $("#acErrorAlert").addClass("d-none");
                    btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving Course...');

                    $.ajax({
                        url: urls.saveCourseFullStructure,
                        type: "POST",
                        contentType: "application/json",
                        headers: {
                            "RequestVerificationToken": getAntiForgeryToken()
                        },
                        data: JSON.stringify(payload)
                    })
                    .done(function (res) {
                        if (res && res.success) {
                            sessionStorage.setItem("cb_toast_msg", res.message || (courseId > 0 ? "Course updated successfully!" : "Course created and structured successfully!"));
                            sessionStorage.setItem("cb_toast_type", "success");
                            hideModal("addCourseStructuredModal");
                            window.location.reload();
                        } else {
                            $("#acErrorAlert").text(res?.message || "Failed to save course.").removeClass("d-none");
                        }
                    })
                    .fail(function () {
                        $("#acErrorAlert").text("An error occurred while saving the course.").removeClass("d-none");
                    })
                    .always(function () {
                        btn.prop("disabled", false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save Course');
                    });
                });

                $(document).on("click", "#acSaveCourseBtn", function () {
                    $("#acCourseForm").submit();
                });

                // ========================================================
                // DELETE COURSE
                // ========================================================
                $(document).on("click", ".cb-delete-course-btn, .btn-catalog-delete", function () {
                    const courseId = Number($(this).data("course-id"));
                    const courseName = $(this).data("course-name") || "this course";

                    if (!courseId) return;

                    $("#deleteCourseId").val(courseId);
                    $("#deleteCourseNameDisplay").text(courseName);
                    showModal("deleteCourseModal");
                });

                $(document).on("click", "#confirmDeleteCourseBtn", function () {
                    const courseId = Number($("#deleteCourseId").val());
                    const btn = $(this);

                    if (!courseId) return;

                    btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Deleting...');

                    $.ajax({
                        url: urls.deleteCourse,
                        type: "POST",
                        data: {
                            __RequestVerificationToken: getAntiForgeryToken(),
                            courseId: courseId
                        }
                    })
                    .done(function (res) {
                        if (res && res.success) {
                            sessionStorage.setItem("cb_toast_msg", res.message || "Course removed successfully!");
                            sessionStorage.setItem("cb_toast_type", "success");
                            hideModal("deleteCourseModal");
                            window.location.reload();
                        } else {
                            alert(res?.message || "Failed to delete course.");
                        }
                    })
                    .fail(function () {
                        alert("An error occurred while deleting the course.");
                    })
                    .always(function () {
                        btn.prop("disabled", false).html('<i class="fa-solid fa-trash me-1"></i> Delete');
                    });
                });
            }
        })();
    </script>
}
