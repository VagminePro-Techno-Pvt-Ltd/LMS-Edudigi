@model TMS.ViewModels.Academics.CurriculumBuilderPageViewModel
@{
    ViewData["Title"] = "Curriculum Builder";
    bool isFaculty = ViewBag.IsFaculty ?? false;
}

<link rel="stylesheet" href="~/css/content-library.css" />
<link rel="stylesheet" href="~/css/course-structure.css" />

<style>
    .cb-shell {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .cb-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
        padding: 28px 32px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.04), rgba(139, 92, 246, 0.04));
        border-radius: 20px;
        border: 1px solid rgba(99, 102, 241, 0.08);
    }

    .cb-header h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
        margin: 0 0 4px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cb-header h1 i { color: #6366f1; }

    .cb-subtitle {
        color: #64748b;
        font-size: 0.88rem;
        margin: 0;
    }

    .cb-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        border-radius: 999px;
        letter-spacing: 0.04em;
    }

    /* ─── PROGRAM TABS ─── */
    .cb-program-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 0 0 20px 0;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 24px;
    }

    .cb-program-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        color: #475569;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cb-program-tab:hover {
        border-color: #6366f1;
        color: #6366f1;
        background: rgba(99, 102, 241, 0.04);
        transform: translateY(-1px);
    }

    .cb-program-tab.active {
        background: linear-gradient(135deg, #6366f1, #7c3aed);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
    }

    .cb-program-tab .tab-badge {
        background: rgba(255,255,255,0.2);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.72rem;
    }

    .cb-program-tab.active .tab-badge {
        background: rgba(255,255,255,0.25);
    }

    /* ─── STRUCTURE BOARD ─── */
    .cb-board {
        min-height: 400px;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .cb-board-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        color: #94a3b8;
    }
</style>

<div class="cb-shell">
    <!-- HEADER -->
    <div class="cb-header">
        <div>
            <h1>
                <i class="fa-solid fa-graduation-cap"></i>
                Curriculum Builder
                <span class="cb-pill">Program → Semester → Course → Content</span>
            </h1>
            <p class="cb-subtitle">
                Organize your complete academic hierarchy from a single interface.

            </p>
        </div>
    </div>

    <!-- PROGRAM TABS -->
    <div class="cb-program-tabs" id="programTabs">
        @foreach (var prog in Model.Programs)
        {
            <div class="cb-program-tab @(prog.Id == Model.SelectedProgramId ? "active" : "")"
                 data-program-id="@prog.Id">
                <i class="fa-solid fa-building-columns"></i>
                @prog.Name
                <span class="tab-badge">@(prog.NoOfSemester ?? 0) Sem</span>
            </div>
        }
    </div>

    <!-- STRUCTURE BOARD -->
    <div class="cb-board" id="structureBoard">
        @if (Model.SelectedProgramStructure != null)
        {
            <partial name="_ProgramStructureTree" model="Model.SelectedProgramStructure" />
        }
        else
        {
            <div class="cb-board-loading">
                <i class="fa-solid fa-building-columns" style="font-size:48px; color:#e2e8f0;"></i>
                <p style="margin-top:16px; font-size:0.95rem;">Select a program above to view its curriculum.</p>
            </div>
        }
    </div>
</div>

<!-- ═══════ CONTENT MAPPING MODAL ═══════ -->
<div class="modal fade" id="manageContentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 24px; border: none; box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3); overflow: hidden; background: #fff;">
            <div class="modal-body p-0">
                <div class="p-4 border-bottom" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold mb-1" style="color: #0f172a;">Map Content Resources</h4>
                            <p class="text-muted mb-0">Assigning to: <span id="mappingCourseTitle" class="fw-bold text-primary"></span></p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <input type="hidden" id="mapCourseId" />

                <!-- Quadrant Selection -->
                <div class="p-3 border-bottom" style="background: #fff;">
                    <label class="form-label fw-bold" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px; color:#64748b;">Quadrant</label>
                    <select id="mapQuadrantId" class="form-select" style="border-radius:10px; max-width:300px;">
                        @if (Model.AllQuadrants != null)
                        {
                            foreach (var q in Model.AllQuadrants)
                            {
                                <option value="@q.Id">@q.Name</option>
                            }
                        }
                    </select>
                </div>

                <div style="display:grid; grid-template-columns:1fr auto 1fr; max-height:420px;">
                    <div style="overflow-y:auto; padding:16px;">
                        <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:#94a3b8; margin-bottom:12px; letter-spacing:0.5px;">
                            <i class="fa fa-search"></i> Library Resources
                        </div>
                        <input type="text" id="librarySearch" placeholder="Search content..."
                               style="width:100%; padding:8px 14px; border:1px solid #e2e8f0; border-radius:10px; margin-bottom:12px; font-size:0.88rem;">
                        <div id="libraryItemsList"></div>
                    </div>
                    <div style="width:1px; background:#e2e8f0;"></div>
                    <div style="overflow-y:auto; padding:16px;">
                        <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:#94a3b8; margin-bottom:12px; letter-spacing:0.5px;">
                            <i class="fa fa-link"></i> Assigned to this Course
                        </div>
                        <div id="mappedItemsList"></div>
                    </div>
                </div>

                <div class="p-3 text-center border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius:10px; padding:8px 28px;">Done</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var isFaculty = @(isFaculty ? "true" : "false");
        var urls = {
            getProgramStructure: '@Url.Action("GetProgramStructure", "CourseStructure")',
            getCourseContent: '@Url.Action("GetCourseContent", "CourseStructure")',
            getLib: '@Url.Action("GetLibraryItems", "CourseStructure")',
            assign: '@Url.Action("AssignContent", "CourseStructure")',
            unassign: '@Url.Action("UnassignContent", "CourseStructure")'
        };

        $(document).ready(function () {
            // ═══════ PROGRAM TAB CLICK ═══════
            $(document).on('click', '.cb-program-tab', function () {
                var id = $(this).data('program-id');
                $('.cb-program-tab').removeClass('active');
                $(this).addClass('active');
                $('#structureBoard').html('<div class="cb-board-loading"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Loading structure...</p></div>');
                $.get(urls.getProgramStructure, { programId: id }, function (html) {
                    $('#structureBoard').html(html);
                });
            });

            // ═══════ CONTENT MAPPING ═══════
            $(document).on('click', '.cb-manage-content-btn', function () {
                var courseId = $(this).data('course-id');
                var courseName = $(this).data('course-name');
                $('#mapCourseId').val(courseId);
                $('#mappingCourseTitle').text(courseName);
                loadMappingData();
                new bootstrap.Modal('#manageContentModal').show();
            });

            function loadMappingData() {
                var courseId = $('#mapCourseId').val();

                // Load library items
                $.get(urls.getLib, function (lib) {
                    var html = '';
                    if (lib.length === 0) {
                        html = '<div class="text-muted text-center p-3" style="font-size:13px;">No items in library.</div>';
                    }
                    lib.forEach(function (i) {
                        var icon = i.type === 'Video' ? 'fa-video' : i.type === 'VideoURL' ? 'fa-link' : 'fa-file-alt';
                        html += '<div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-radius:10px; margin-bottom:6px; background:#f8fafc; border:1px solid #f1f5f9;">' +
                                    '<div style="display:flex; align-items:center; gap:8px;"><i class="fa ' + icon + '" style="color:#6366f1;"></i> <span style="font-size:0.88rem;">' + i.title + '</span></div>' +
                                    '<button class="btn btn-sm btn-link p-0" onclick="assignContent(' + i.id + ')"><i class="fa fa-plus-circle" style="color:#10b981; font-size:1.1rem;"></i></button>' +
                                '</div>';
                    });
                    $('#libraryItemsList').html(html);
                });

                // Load assigned items
                $.get(urls.getCourseContent, { courseId: courseId }, function (mapped) {
                    var html = '';
                    if (mapped.length === 0) {
                        html = '<div class="text-muted text-center p-3" style="font-size:13px;">No content assigned yet.</div>';
                    }
                    mapped.forEach(function (i) {
                        var icon = i.type === 'Video' ? 'fa-video' : i.type === 'VideoURL' ? 'fa-link' : 'fa-file-alt';
                        html += '<div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-radius:10px; margin-bottom:6px; background:#fef2f2; border:1px solid #fee2e2;">' +
                                    '<div style="display:flex; align-items:center; gap:8px;"><i class="fa ' + icon + '" style="color:#8b5cf6;"></i> <span style="font-size:0.88rem;">' + i.title + '</span></div>' +
                                    '<button class="btn btn-sm btn-link p-0" onclick="unassignContent(' + i.mappingId + ')"><i class="fa fa-trash" style="color:#ef4444; font-size:0.9rem;"></i></button>' +
                                '</div>';
                    });
                    $('#mappedItemsList').html(html);
                });
            }

            // Library search
            var searchTimer;
            $('#librarySearch').on('input', function () {
                clearTimeout(searchTimer);
                var val = $(this).val();
                searchTimer = setTimeout(function () {
                    $.get(urls.getLib, { search: val }, function (lib) {
                        var html = '';
                        lib.forEach(function (i) {
                            var icon = i.type === 'Video' ? 'fa-video' : i.type === 'VideoURL' ? 'fa-link' : 'fa-file-alt';
                            html += '<div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-radius:10px; margin-bottom:6px; background:#f8fafc; border:1px solid #f1f5f9;">' +
                                        '<div style="display:flex; align-items:center; gap:8px;"><i class="fa ' + icon + '" style="color:#6366f1;"></i> <span style="font-size:0.88rem;">' + i.title + '</span></div>' +
                                        '<button class="btn btn-sm btn-link p-0" onclick="assignContent(' + i.id + ')"><i class="fa fa-plus-circle" style="color:#10b981; font-size:1.1rem;"></i></button>' +
                                    '</div>';
                        });
                        $('#libraryItemsList').html(html);
                    });
                }, 300);
            });

            function refreshStructure() {
                var id = $('.cb-program-tab.active').data('program-id');
                if (!id) return;
                $.get(urls.getProgramStructure, { programId: id }, function (html) {
                    $('#structureBoard').html(html);
                });
            }

            // Global functions
            window.assignContent = function (materialId) {
                var quadrantId = $('#mapQuadrantId').val();
                $.post(urls.assign, {
                    materialId: materialId,
                    courseId: $('#mapCourseId').val(),
                    quadrantId: quadrantId
                }, function (res) {
                    if (res.success) {
                        loadMappingData();
                        refreshStructure();
                    } else {
                        alert(res.message || 'Failed to assign.');
                    }
                });
            };

            window.unassignContent = function (mappingId) {
                $.post(urls.unassign, { mappingId: mappingId }, function () {
                    loadMappingData();
                    refreshStructure();
                });
            };

            // ═══════ CLICK BADGE TO VIEW CONTENT ═══════
            $(document).on('click', '.cb-view-content-badge', function () {
                var courseId = $(this).data('course-id');
                var listContainer = $('#content-list-' + courseId);

                if (listContainer.is(':visible')) {
                    listContainer.slideUp(200);
                    return;
                }

                listContainer.html('<div class="text-muted small p-1" style="font-size:11px;"><i class="fa fa-spinner fa-spin me-1"></i> Loading content...</div>').slideDown(200);

                $.get(urls.getCourseContent, { courseId: courseId }, function (mapped) {
                    if (mapped.length === 0) {
                        listContainer.html('<div class="text-muted small p-1" style="font-size:11px;"><i class="fa fa-info-circle me-1"></i> No content assigned.</div>');
                        return;
                    }

                    var html = '<div style="display: flex; flex-direction: column; gap: 4px;">';
                    mapped.forEach(function (i) {
                        var icon = i.type === 'Video' ? 'fa-video' : i.type === 'VideoURL' ? 'fa-link' : 'fa-file-alt';
                        html += '<div style="display:flex; justify-content:space-between; align-items:center; padding: 4px 10px; background:#f8fafc; border-radius: 6px; border: 1px solid #f1f5f9;">' +
                                    '<div style="display:flex; align-items:center; gap:6px;"><i class="fa ' + icon + '" style="color:#6366f1; font-size:11px;"></i> <span style="font-size:11px; color:#334155; font-weight:600;">' + i.title + '</span></div>' +
                                    '<span style="font-size:9px; background:#e0e7ff; color:#4f46e5; padding: 1px 6px; border-radius: 4px; font-weight:700;">' + i.quadrant + '</span>' +
                                '</div>';
                    });
                    html += '</div>';
                    listContainer.html(html);
                });
            });
        });
    </script>
}
