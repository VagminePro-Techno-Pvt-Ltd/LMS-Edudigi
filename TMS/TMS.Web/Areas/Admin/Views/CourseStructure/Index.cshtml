                $(document).on("click", ".cb-edit-program-btn, .cb-prog-edit-btn, .btn-edit-program", function () {
                    const programId = Number($(this).data("program-id")) || 0;
                    const programName = $(this).data("program-name") || "";
                    const semesters = Number($(this).data("semesters")) || 6;
                    const desc = $(this).data("description") || "";

                    $("#progId").val(programId);
                    $("#progName").val(programName);
                    $("#progSemesters").val(semesters);
                    $("#progDurationMonths").val(semesters * 6);
                    $("#progDescription").val(desc);
