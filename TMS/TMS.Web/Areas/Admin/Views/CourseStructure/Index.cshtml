    .cb-toast-item.cb-toast-info { border-left: 5px solid #3b82f6; }
</style>

@Html.AntiForgeryToken()

<!-- Floating Toast Container -->
<div id="cbToastContainer"></div>

<div class="cb-shell">

    <!-- ACADEMIC HUB HEADER -->
    <div class="ah-hub-header">
        <div class="cb-header-main">
            <div class="cb-title-row">
                <h1 class="cb-title">
                    <i class="fa-solid fa-graduation-cap"></i>
                    Academic Hub
                </h1>
                <span class="cb-pill">
                    Programs • Courses • Curriculum Hierarchy
                </span>
            </div>
            <p class="cb-subtitle">
                Centralized command center for managing Degree Programs, Course Catalog, and Syllabus Structure.
            </p>
            <div class="ah-stats-ribbon">
                <span class="ah-stat-chip purple">
                    <i class="fa-solid fa-building-columns"></i>
                    <strong>@(Model.Programs?.Count ?? 0)</strong> Programs
                </span>
                <span class="ah-stat-chip blue">
                    <i class="fa-solid fa-book-bookmark"></i>
                    <strong>@(Model.AllCourses?.Count ?? 0)</strong> Courses
                </span>
                <span class="ah-stat-chip emerald">
                    <i class="fa-solid fa-star"></i>
                    <strong>@(Model.AllCourses?.Sum(c => c.NoofCredit) ?? 0)</strong> Total Credits
                </span>
                <span class="ah-stat-chip">
                    <i class="fa-solid fa-calendar-days"></i>
                    <strong>@(Model.AllSemesters?.Count ?? 0)</strong> Semesters
                </span>
            </div>
        </div>

        @if (!isFaculty)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a href="/Admin/ContentSync" class="btn btn-outline-info fw-semibold px-3 py-2" style="border-radius:10px;font-size:13px;text-decoration:none;">
                    <i class="fa-solid fa-cloud-arrow-up me-1"></i> Auto Content Sync
                </a>
                <button type="button" class="btn btn-outline-primary fw-semibold px-3 py-2" id="btnHeaderNewProgram" style="border-radius:10px;font-size:13px;">
                    <i class="fa-solid fa-plus me-1"></i> New Program
                </button>
                <button type="button" class="btn btn-primary fw-semibold px-3 py-2" id="btnHeaderAddCourse" style="border-radius:10px;font-size:13px;background:linear-gradient(135deg,#4f46e5,#6366f1);border:none;box-shadow:0 4px 12px rgba(79,70,229,0.25);">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Add Course &amp; Structure
                </button>
            </div>
        }
    </div>

    <!-- CENTRAL VIEW SWITCHER BAR -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="ah-nav-switcher">
            <button type="button" class="ah-nav-tab @(Model.ActiveView == "tree" ? "active" : "")" data-view="tree">
                <i class="fa-solid fa-sitemap"></i>
                <span>Curriculum Hierarchy</span>
                <span class="ah-nav-badge">Tree View</span>
            </button>
            <button type="button" class="ah-nav-tab @(Model.ActiveView == "courses" ? "active" : "")" data-view="courses">
                <i class="fa-solid fa-book-bookmark"></i>
                <span>Course Catalog</span>
                <span class="ah-nav-badge">@(Model.AllCourses?.Count ?? 0)</span>
            </button>
            <button type="button" class="ah-nav-tab @(Model.ActiveView == "programs" ? "active" : "")" data-view="programs">
                <i class="fa-solid fa-building-columns"></i>
                <span>Programs Directory</span>
                <span class="ah-nav-badge">@(Model.Programs?.Count ?? 0)</span>
            </button>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 1: CURRICULUM HIERARCHY (TREE VIEW)   -->
    <!-- ========================================== -->
    <div class="ah-view-container @(Model.ActiveView == "tree" ? "" : "d-none")" id="hubView_tree">
        <div class="cb-programs-toolbar">
            <div class="cb-program-tabs mb-0" id="programTabs" role="tablist">
                @if (Model.Programs != null && Model.Programs.Any())
                {
                    @foreach (var program in Model.Programs)
                    {
                        bool active = program.Id == Model.SelectedProgramId;

                        <button type="button"
                                class="cb-program-tab @(active ? "active" : "")"
                                data-program-id="@program.Id"
                                role="tab"
                                aria-selected="@(active ? "true" : "false")">

                            <i class="fa-solid fa-building-columns"></i>

                            <span class="cb-program-name"
                                  title="@program.Name">
                                @program.Name
                            </span>

                            <span class="cb-tab-badge">
                                @(program.NoOfSemester ?? 0) Sem
                            </span>
                        </button>
                    }
                }
            </div>

            @if (!isFaculty)
            {
                <button type="button"
                        class="cb-new-program-btn"
                        id="btnOpenNewProgramModal"
                        title="Create a new academic program">
                    <i class="fa-solid fa-plus"></i>
                    <span>New Program</span>
                </button>
            }
        </div>

        <div class="cb-board" id="structureBoard">
            @if (Model.Programs == null || !Model.Programs.Any())
            {
                <div class="cb-empty-state">
                    <div class="cb-empty-icon" style="color: #6366f1; background: #eef2ff;">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>

                    @if (isFaculty)
                    {
                        <h4>No Courses Assigned Yet</h4>
                        <p>
                            You have not been assigned to any courses in the Faculty Course Mapping yet. Please contact your administrator to map your subjects.
                        </p>
                    }
                    else
                    {
                        <h4>No programs available</h4>
                        <p>
                            Create an active program before building the curriculum.
                        </p>
                    }
                </div>
            }
            else if (Model.SelectedProgramStructure != null)
            {
                <partial name="_ProgramStructureTree"
                         model="Model.SelectedProgramStructure" />
            }
            else
            {
                <div class="cb-empty-state">
                    <div class="cb-empty-icon">
                        <i class="fa-regular fa-folder-open"></i>
                    </div>

                    <h4>No curriculum available</h4>

                    <p>
                        Select a program to view its curriculum structure.
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 2: COURSE CATALOG                     -->
    <!-- ========================================== -->
    <div class="ah-view-container @(Model.ActiveView == "courses" ? "" : "d-none")" id="hubView_courses">
        <div class="ah-catalog-toolbar">
            <div class="ah-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="courseCatalogSearch" class="ah-search-input" placeholder="Search courses by title or code..." />
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <select id="courseCatalogProgramFilter" class="form-select form-select-sm fw-semibold" style="width:auto;border-radius:10px;min-width:180px;">
                    <option value="all">All Programs (@(Model.Programs?.Count ?? 0))</option>
                    @if (Model.Programs != null)
                    {
                        foreach (var prog in Model.Programs)
                        {
                            <option value="@prog.Id">@prog.Name</option>
                        }
                    }
                </select>
                <select id="courseCatalogSemesterFilter" class="form-select form-select-sm fw-semibold" style="width:auto;border-radius:10px;min-width:150px;">
                    <option value="all">All Semesters</option>
                    @if (Model.AllSemesters != null)
                    {
                        foreach (var sem in Model.AllSemesters)
                        {
                            <option value="@sem.Id">@sem.Name</option>
                        }
                    }
                </select>
                @if (!isFaculty)
                {
                    <button type="button" class="btn btn-primary btn-sm fw-semibold px-3 py-2 btn-open-add-course" style="border-radius:10px;background:linear-gradient(135deg,#4f46e5,#6366f1);border:none;">
                        <i class="fa-solid fa-plus me-1"></i> Add Course
                    </button>
                }
            </div>
        </div>

        <div class="ah-catalog-grid" id="courseCatalogGrid">
            @if (Model.AllCourses != null && Model.AllCourses.Any())
            {
                foreach (var course in Model.AllCourses)
                {
                    <div class="ah-catalog-card"
                         data-name="@(course.Name ?? "")"
                         data-code="@(course.CourseCode ?? "")"
                         data-program-id="@course.CourseCategoryId"
                         data-semester-id="@(course.SemesterId ?? 0)">
                        <div>
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <span class="ah-code-pill">@(string.IsNullOrWhiteSpace(course.CourseCode) ? "N/A" : course.CourseCode)</span>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-light text-secondary border" style="font-size:11px;">
                                        <i class="fa-regular fa-star text-warning me-1"></i>@course.NoofCredit Cr
                                    </span>
                                    @if ((course.CourseDurationMonths ?? 0) > 0)
                                    {
                                        <span class="badge bg-light text-secondary border" style="font-size:11px;">
                                            <i class="fa-regular fa-clock text-info me-1"></i>@(course.CourseDurationMonths) Mo
                                        </span>
                                    }
                                </div>
                            </div>
                            <h3 class="ah-course-title">@course.Name</h3>
                            <div class="ah-course-meta-tags">
                                <span class="ah-prog-badge" title="Program">
                                    <i class="fa-solid fa-graduation-cap me-1"></i>@(course.CourseCategory?.Name ?? "General")
                                </span>
                                <span class="ah-sem-badge" title="Semester">
                                    <i class="fa-regular fa-calendar-check me-1"></i>@(course.Semester?.Name ?? "Semester Unassigned")
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(course.Description))
                            {
                                <p class="text-muted small mb-3" style="line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                    @course.Description
                                </p>
                            }
                        </div>
                        <div class="ah-card-actions">
                            <button type="button" class="ah-btn-structure btn-catalog-manage-structure"
                                    data-course-id="@course.Id"
                                    data-course-name="@course.Name"
                                    data-course-code="@course.CourseCode"
                                    data-program-id="@course.CourseCategoryId"
                                    data-semester-id="@(course.SemesterId ?? 0)"
                                    title="Manage Modules, Topics &amp; Structure">
                                <i class="fa-solid fa-sitemap"></i>
                                <span>Structure</span>
                            </button>

                            <button type="button" class="btn btn-light btn-sm fw-semibold text-secondary btn-catalog-content"
                                    data-course-id="@course.Id"
                                    data-course-name="@course.Name"
                                    style="border-radius:8px;font-size:12px;"
                                    title="Content Library">
                                <i class="fa-solid fa-layer-group text-warning"></i>
                            </button>

                            @if (!isFaculty)
                            {
                                <button type="button" class="btn btn-light btn-sm fw-semibold text-success btn-catalog-assign-faculty"
                                        data-course-id="@course.Id"
                                        data-course-name="@course.Name"
                                        style="border-radius:8px;font-size:12px;"
                                        title="Assign Faculty / Instructors">
                                    <i class="fa-solid fa-chalkboard-user"></i>
                                </button>
                                <button type="button" class="btn btn-light btn-sm fw-semibold text-secondary btn-catalog-edit"
                                        data-course-id="@course.Id"
                                        style="border-radius:8px;font-size:12px;"
                                        title="Edit Course Info">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="btn btn-light btn-sm fw-semibold text-danger btn-catalog-delete"
                                        data-course-id="@course.Id"
                                        data-course-name="@course.Name"
                                        style="border-radius:8px;font-size:12px;"
                                        title="Delete Course">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <div id="catalogEmptyState" class="cb-empty-state d-none py-5">
            <div class="cb-empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
            <h4>No courses found</h4>
            <p>Try adjusting your search query or filter options.</p>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 3: PROGRAMS DIRECTORY                 -->
    <!-- ========================================== -->
    <div class="ah-view-container @(Model.ActiveView == "programs" ? "" : "d-none")" id="hubView_programs">
        <div class="ah-programs-grid">
            @if (Model.Programs != null && Model.Programs.Any())
            {
                foreach (var prog in Model.Programs)
                {
                    var progCourses = Model.AllCourses?.Where(c => c.CourseCategoryId == prog.Id).ToList() ?? new List<TMS.ViewModels.Masters.CourseMasterViewModel>();
                    int totalCredits = progCourses.Sum(c => c.NoofCredit);

                    <div class="ah-program-card">
                        <div class="ah-program-top-bar"></div>
                        <div>
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:11px;">
                                    <i class="fa-solid fa-circle-check me-1"></i> Active Program
                                </span>
                                <span class="text-muted small fw-semibold">ID: #@prog.Id</span>
                            </div>
                            <h3 class="ah-program-title">@prog.Name</h3>
                            <p class="ah-program-desc">
                                @(string.IsNullOrWhiteSpace(prog.Description) ? "Comprehensive academic degree curriculum with structured semester modules." : prog.Description)
                            </p>
                            <div class="ah-program-stats">
                                <div>
                                    <div class="ah-pstat-num">@(prog.NoOfSemester ?? 0)</div>
                                    <div class="ah-pstat-label">Semesters</div>
                                </div>
                                <div>
                                    <div class="ah-pstat-num">@progCourses.Count</div>
                                    <div class="ah-pstat-label">Courses</div>
                                </div>
                                <div>
                                    <div class="ah-pstat-num">@totalCredits</div>
                                    <div class="ah-pstat-label">Credits</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2 pt-3 border-top flex-wrap">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold btn-explore-program"
                                    data-program-id="@prog.Id"
                                    style="border-radius:8px;font-size:12px;">
                                <i class="fa-solid fa-sitemap me-1"></i> Explore Tree
                            </button>
                            <div class="d-flex align-items-center gap-1">
                                @if (!isFaculty)
                                {
                                    <button type="button" class="btn btn-primary btn-sm fw-semibold btn-program-add-course"
                                            data-program-id="@prog.Id"
                                            data-program-name="@prog.Name"
                                            data-semesters="@(prog.NoOfSemester ?? 6)"
                                            style="border-radius:8px;font-size:12px;background:#4f46e5;border:none;"
                                            title="Add Course to this Program">
                                        <i class="fa-solid fa-plus me-1"></i> Add Course
                                    </button>
                                    <button type="button" class="btn btn-light btn-sm fw-semibold text-secondary btn-edit-program"
                                            data-program-id="@prog.Id"
                                            data-program-name="@prog.Name"
                                            data-semesters="@(prog.NoOfSemester ?? 6)"
                                            data-description="@(prog.Description ?? "")"
                                            style="border-radius:8px;font-size:12px;"
                                            title="Edit Program Details">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-light btn-sm fw-semibold text-danger btn-delete-program"
                                            data-program-id="@prog.Id"
                                            data-program-name="@prog.Name"
                                            data-course-count="@progCourses.Count"
                                            style="border-radius:8px;font-size:12px;"
                                            title="Delete Program">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }

            @if (!isFaculty)
            {
                <div class="ah-new-prog-card" id="btnCardNewProgram">
                    <div class="ah-new-prog-icon">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-dark" style="font-size:16px;">New Degree Program</h4>
                    <p class="text-muted small mb-0">Create another degree or diploma track</p>
                </div>
            }
        </div>
    </div>
</div>

@if (!isFaculty)
{
    <div class="modal fade"
         id="manageContentModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content"
                 style="border:0;border-radius:20px;overflow:hidden;box-shadow:0 25px 60px -15px rgba(15,23,42,.30);">

                <div class="modal-header"
                     style="padding:20px 22px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);">

                    <div>
                        <h5 class="modal-title fw-bold"
                            style="color:#0f172a;">
                            Map Content Resources
                        </h5>

                        <div class="text-muted"
                             style="font-size:12px;margin-top:3px;">
                            Assigning to:
                            <strong id="mappingCourseTitle"
                                    class="text-primary"></strong>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close js-close-manage-content"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <input type="hidden" id="mapCourseId" />

                    <div class="p-3 px-4 border-bottom bg-light">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                            <label class="form-label fw-bold mb-0 text-muted small text-uppercase">
                                <i class="fa-solid fa-shapes text-primary me-1"></i> Target Learning Quadrant
                            </label>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold" id="selectedQuadrantBadge">Quadrant 1 (e-Tutorial)</span>
                        </div>
                        <div class="cb-quadrant-pills-row d-flex gap-2 flex-wrap" id="quadrantPillsContainer">
                            @if (Model.AllQuadrants != null && Model.AllQuadrants.Any())
                            {
                                int qIdx = 0;
                                foreach (var q in Model.AllQuadrants)
                                {
                                    var iconClass = q.QuadrantNumber switch {
                                        1 => "fa-video text-danger",
                                        2 => "fa-file-lines text-primary",
                                        3 => "fa-comments text-warning",
                                        4 => "fa-list-check text-success",
                                        _ => "fa-layer-group text-secondary"
                                    };
                                    <button type="button"
                                            class="cb-quad-pill @(qIdx == 0 ? "active" : "")"
                                            data-quad-id="@q.Id"
                                            data-quad-number="@q.QuadrantNumber"
                                            data-quad-name="@q.Name">
                                        <i class="fa-solid @iconClass me-1"></i> @q.Name
                                    </button>
                                    qIdx++;
                                }
                            }
                        </div>
                        <select id="mapQuadrantId" class="d-none">
                            @if (Model.AllQuadrants != null && Model.AllQuadrants.Any())
                            {
                                foreach (var quadrant in Model.AllQuadrants)
                                {
                                    <option value="@quadrant.Id" data-quadrant-number="@quadrant.QuadrantNumber">@quadrant.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="cb-mapping-grid">
                        <div class="cb-mapping-column">
                            <div class="cb-mapping-heading">
                                <span><i class="fa-solid fa-magnifying-glass me-1 text-primary"></i> Library Resources</span>
                                <span class="badge bg-light text-muted border" id="libraryCountBadge">0 items</span>
                            </div>

                            <input type="search"
                                   id="librarySearch"
                                   class="cb-library-search"
                                   autocomplete="off"
                                   placeholder="Search central library resources..." />

                            <div id="libraryItemsList"></div>
                        </div>

                        <div class="cb-mapping-divider"></div>

                        <div class="cb-mapping-column">
                            <div class="cb-mapping-heading">
                                <span><i class="fa-solid fa-link me-1 text-success"></i> Assigned to this Course</span>
                                <span class="badge bg-light text-muted border" id="mappedCountBadge">0 items</span>
                            </div>

                            <div id="mappedItemsList"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn btn-primary px-4 js-close-manage-content">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- PROGRAM MODAL (CREATE / EDIT) -->
    <!-- ========================================== -->
    <div class="modal fade" id="programModal" tabindex="-1" aria-labelledby="programModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;overflow:hidden;border:none;box-shadow:0 20px 40px rgba(0,0,0,0.15);">
                <div class="modal-header bg-light border-bottom px-4 py-3">
                    <h5 class="modal-title fw-bold" id="programModalLabel">
                        <i class="fa-solid fa-graduation-cap text-primary me-2"></i><span id="programModalTitle">New Degree Program</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="programForm">
                    <input type="hidden" id="progId" value="0" />
                    <div class="modal-body px-4 py-3">
                        <div class="mb-3">
                            <label for="progName" class="form-label fw-semibold" style="font-size:13px;">Program Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="progName" placeholder="e.g. Bachelor of Computer Applications (BCA)" required style="border-radius:8px;" />
                            <small class="text-muted" style="font-size:11px;">Enter the full title of the degree or diploma.</small>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="progSemesters" class="form-label fw-semibold" style="font-size:13px;">Number of Semesters <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="progSemesters" min="1" max="12" value="6" required style="border-radius:8px;" />
                                <small class="text-muted" style="font-size:11px;">e.g. 6 for 3-yr, 8 for 4-yr degrees.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="progDurationMonths" class="form-label fw-semibold" style="font-size:13px;">Total Duration (Months)</label>
                                <input type="number" class="form-control" id="progDurationMonths" min="1" value="36" style="border-radius:8px;" />
                                <small class="text-muted" style="font-size:11px;">e.g. 36 for 3 years, 24 for 2 years.</small>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label for="progDescription" class="form-label fw-semibold" style="font-size:13px;">Description / Overview</label>
                            <textarea class="form-control" id="progDescription" rows="3" placeholder="Brief overview of learning outcomes, eligibility, etc." style="border-radius:8px;"></textarea>
                        </div>
                        <div id="progErrorAlert" class="alert alert-danger py-2 px-3 mt-3 d-none" style="font-size:12px;border-radius:8px;"></div>
                    </div>
                    <div class="modal-footer bg-light border-top px-4 py-3">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold" id="saveProgramBtn" style="border-radius:8px;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Program
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- ADD / EDIT COURSE STRUCTURED MODAL (Matches Reference)   -->
    <!-- ======================================================== -->
    <div class="modal fade" id="addCourseStructuredModal" tabindex="-1" aria-labelledby="addCourseModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header border-0 pb-0 pt-4 px-4 align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ac-header-icon-box">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark" id="addCourseModalTitle">Add Course</h4>
                            <p class="text-muted mb-0 small" id="addCourseModalSubtitle">Create a new course and manage its structure</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body with 2-Column Split -->
                <div class="modal-body p-0 pt-3">
                    <div class="ac-modal-container">
                        <!-- LEFT SIDEBAR -->
                        <div class="ac-sidebar">
                            <!-- Step 1: Course Details -->
                            <div class="ac-step-item active" id="acNavDetails" title="Go to Course Details">
                                <div class="ac-step-badge bg-emerald">
                                    <i class="fa-solid fa-file-lines"></i>
                                </div>
                                <div class="ac-step-info">
                                    <div class="ac-step-title">Course Details</div>
                                    <div class="ac-step-sub">Basic information</div>
                                </div>
                                <span class="ac-step-num">1</span>
                            </div>

                            <!-- Step 2: Structure -->
                            <div class="ac-step-item" id="acNavStructure" title="Go to Course Structure">
                                <div class="ac-step-badge bg-amber">
                                    <i class="fa-solid fa-list-ul"></i>
                                </div>
                                <div class="ac-step-info">
                                    <div class="ac-step-title">Structure</div>
                                    <div class="ac-step-sub">Add modules and topics</div>
                                </div>
                                <span class="ac-step-num">2</span>
                            </div>

                            <!-- LIVE TREE PREVIEW (Directly below Step 2) -->
                            <div class="ac-tree-preview" id="acSidebarTree">
                                <!-- Rendered dynamically by JS -->
                            </div>

                            <!-- Step 3: Additional Settings -->
                            <div class="ac-step-item" id="acNavSettings" title="Go to Credits & Duration">
                                <div class="ac-step-badge bg-purple">
                                    <i class="fa-solid fa-gear"></i>
                                </div>
                                <div class="ac-step-info">
                                    <div class="ac-step-title">Additional Settings</div>
                                    <div class="ac-step-sub">Credits, duration and more</div>
                                </div>
                                <span class="ac-step-num">3</span>
                            </div>
                        </div>

                        <!-- RIGHT MAIN PANEL -->
                        <div class="ac-main-content">
                            <form id="acCourseForm">
                                <input type="hidden" id="acCourseId" value="0" />
                                <input type="hidden" id="acProgramId" value="0" />

                                <!-- Meta Info Bar (Program & Semester) -->
                                <div class="ac-meta-bar mb-3 p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-3">
                                    <div class="d-flex align-items-center gap-2" style="min-width: 220px; flex: 1;">
                                        <label for="acProgramSelect" class="form-label mb-0 fw-bold small text-secondary text-nowrap">
                                            <i class="fa-solid fa-graduation-cap text-primary me-1"></i> Program *
                                        </label>
                                        <select id="acProgramSelect" class="form-select form-select-sm fw-semibold" style="border-radius:8px;" required>
                                            @if (Model.Programs != null)
                                            {
                                                foreach (var p in Model.Programs)
                                                {
                                                    <option value="@p.Id" data-name="@p.Name" data-semesters="@(p.NoOfSemester ?? 6)">@p.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-2" style="min-width: 200px; flex: 1;">
                                        <label for="acSemesterSelect" class="form-label mb-0 fw-bold small text-secondary text-nowrap">
                                            <i class="fa-regular fa-calendar-check text-success me-1"></i> Semester *
                                        </label>
                                        <select id="acSemesterSelect" class="form-select form-select-sm fw-semibold" style="border-radius:8px;" required>
                                            <option value="">-- Choose Semester --</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- SECTION 1: Course Details -->
                                <div class="ac-section-header d-flex align-items-center gap-2 mb-2" id="acSectionDetails">
                                    <div class="ac-section-icon bg-emerald-solid">
                                        <i class="fa-solid fa-book-open"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark">Course Details</h5>
                                        <p class="text-muted mb-0 small">Enter the basic information for your course</p>
                                    </div>
                                </div>

                                <div class="ac-card mb-4">
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <label for="acCourseCode" class="form-label fw-semibold small">Course Code <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white text-primary border-end-0" style="border-radius:8px 0 0 8px;">
                                                    <i class="fa-solid fa-link"></i>
                                                </span>
                                                <input type="text" class="form-control border-start-0" id="acCourseCode" placeholder="e.g. BCA001" required style="border-radius:0 8px 8px 0; font-weight:600; font-family:monospace;" />
                                            </div>
                                        </div>
                                        <div class="col-md-7">
                                            <label for="acCourseTitle" class="form-label fw-semibold small">Full Course Title <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white text-muted border-end-0 fw-bold" style="border-radius:8px 0 0 8px; font-size:15px;">T</span>
                                                <input type="text" class="form-control border-start-0" id="acCourseTitle" placeholder="e.g. C Programming" required style="border-radius:0 8px 8px 0; font-weight:600;" />
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label for="acCourseDescription" class="form-label fw-semibold small">Course Description <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white text-muted border-end-0 align-items-start pt-2" style="border-radius:8px 0 0 8px;">
                                                    <i class="fa-regular fa-file-lines"></i>
                                                </span>
                                                <textarea class="form-control border-start-0" id="acCourseDescription" rows="3" placeholder="This course covers the fundamentals of C programming, including syntax, data types, control structures, functions, arrays, pointers and file handling." required style="border-radius:0 8px 8px 0;"></textarea>
                                            </div>
                                        </div>
                                        <div class="col-md-6" id="acSectionSettings">
                                            <label for="acCourseCredits" class="form-label fw-semibold small">Credits <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white text-primary border-end-0" style="border-radius:8px 0 0 8px;">
                                                    <i class="fa-solid fa-award"></i>
                                                </span>
                                                <input type="number" class="form-control border-start-0" id="acCourseCredits" min="1" max="30" value="4" required style="border-radius:0 8px 8px 0; font-weight:600;" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="acCourseDuration" class="form-label fw-semibold small">Duration (Months) <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white text-primary border-end-0" style="border-radius:8px 0 0 8px;">
                                                    <i class="fa-regular fa-calendar"></i>
                                                </span>
                                                <input type="number" class="form-control border-start-0" id="acCourseDuration" min="1" max="60" value="6" required style="border-radius:0 8px 8px 0; font-weight:600;" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SECTION 2: Course Structure -->
                                <div class="d-flex align-items-center justify-content-between mb-3" id="acSectionStructure">
                                    <div class="ac-section-header d-flex align-items-center gap-2">
                                        <div class="ac-section-icon bg-amber-solid">
                                            <i class="fa-solid fa-list-ul"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">Course Structure</h5>
                                            <p class="text-muted mb-0 small">Organize the course into modules and topics</p>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-3" id="acAddModuleBtn" style="border-radius:8px;">
                                        <i class="fa-solid fa-plus me-1"></i> Add Module
                                    </button>
                                </div>

                                <!-- MODULES CONTAINER -->
                                <div id="acModulesContainer">
                                    <!-- Rendered dynamically by JS -->
                                </div>

                                <div id="acErrorAlert" class="alert alert-danger py-2 px-3 mt-3 d-none" style="font-size:12px;border-radius:8px;"></div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-0 px-4 py-3 bg-white d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light px-4 border fw-semibold" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 fw-semibold" id="acSaveCourseBtn" style="border-radius:10px; background:#4f46e5; border-color:#4f46e5;">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Course
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- DELETE COURSE CONFIRM MODAL -->
    <!-- ========================================== -->
    <div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-labelledby="deleteCourseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="border-radius:16px;overflow:hidden;border:none;box-shadow:0 20px 40px rgba(0,0,0,0.15);">
                <div class="modal-body text-center p-4">
                    <div style="width:56px;height:56px;border-radius:50%;background:#fee2e2;color:#ef4444;display:inline-flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:16px;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Delete Course?</h5>
                    <p class="text-muted" style="font-size:13px;line-height:1.5;">
                        Are you sure you want to remove <strong id="deleteCourseNameDisplay" class="text-dark"></strong> from this curriculum?
                    </p>
                    <input type="hidden" id="deleteCourseId" />
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius:8px;font-weight:600;">Cancel</button>
                        <button type="button" class="btn btn-danger px-4" id="confirmDeleteCourseBtn" style="border-radius:8px;font-weight:600;">
                            <i class="fa-solid fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- DELETE PROGRAM CONFIRM MODAL -->
    <!-- ========================================== -->
    <div class="modal fade" id="deleteProgramModal" tabindex="-1" aria-labelledby="deleteProgramModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="border-radius:16px;overflow:hidden;border:none;box-shadow:0 20px 40px rgba(0,0,0,0.15);">
                <div class="modal-body text-center p-4">
                    <div style="width:56px;height:56px;border-radius:50%;background:#fee2e2;color:#ef4444;display:inline-flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:16px;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Delete Program?</h5>
                    <p class="text-muted" style="font-size:13px;line-height:1.5;">
                        Are you sure you want to delete <strong id="deleteProgramNameDisplay" class="text-dark"></strong>? This cannot be undone.
                    </p>
                    <input type="hidden" id="deleteProgramId" />
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius:8px;font-weight:600;">Cancel</button>
                        <button type="button" class="btn btn-danger px-4" id="confirmDeleteProgramBtn" style="border-radius:8px;font-weight:600;">
                            <i class="fa-solid fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FACULTY MAPPING MODAL (Direct access from Academic Hub) -->
    <div class="modal fade" id="hubFacultyMappingModal" tabindex="-1" aria-labelledby="hubFacultyMappingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white rounded-top-4" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);">
                    <h5 class="modal-title fw-bold" id="hubFacultyMappingModalLabel">
                        <i class="fa fa-chalkboard-user me-2"></i> Faculty Course Mapping
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3" id="hubFacultyMappingModalBody">
                    <div class="text-center py-5">
                        <i class="fa fa-spinner fa-spin fa-2x text-primary mb-2"></i>
                        <p class="text-muted mb-0">Loading instructors...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <script>
        (function () {
            "use strict";

            const isFaculty = @(isFaculty ? "true" : "false");

            const urls = {
                getProgramStructure: '@Url.Action("GetProgramStructure", "CourseStructure", new { area = "Admin" })',
                getCourseContent: '@Url.Action("GetCourseContent", "CourseStructure", new { area = "Admin" })',
                getLibraryItems: '@Url.Action("GetLibraryItems", "CourseStructure", new { area = "Admin" })',
                assignContent: '@Url.Action("AssignContent", "CourseStructure", new { area = "Admin" })',
                unassignContent: '@Url.Action("UnassignContent", "CourseStructure", new { area = "Admin" })',
                createProgram: '@Url.Action("CreateProgram", "CourseStructure", new { area = "Admin" })',
                updateProgram: '@Url.Action("UpdateProgram", "CourseStructure", new { area = "Admin" })',
                quickAddCourse: '@Url.Action("QuickAddCourse", "CourseStructure", new { area = "Admin" })',
                updateCourse: '@Url.Action("UpdateCourse", "CourseStructure", new { area = "Admin" })',
                getCourseDetails: '@Url.Action("GetCourseDetails", "CourseStructure", new { area = "Admin" })',
                getProgramSemesters: '@Url.Action("GetProgramSemesters", "CourseStructure", new { area = "Admin" })',
                getCourseFullDetails: '@Url.Action("GetCourseFullDetails", "CourseStructure", new { area = "Admin" })',
                saveCourseFullStructure: '@Url.Action("SaveCourseFullStructure", "CourseStructure", new { area = "Admin" })',
                deleteCourse: '@Url.Action("DeleteCourse", "CourseStructure", new { area = "Admin" })',
                deleteProgram: '@Url.Action("DeleteProgram", "CourseStructure", new { area = "Admin" })'
            };

            function getAntiForgeryToken() {
                return document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value || "";
            }

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function showCbToast(title, message, type) {
                type = type || "success";
                const isSuccess = type === "success";
                const iconClass = isSuccess ? "fa-circle-check text-success" : (type === "error" ? "fa-circle-xmark text-danger" : "fa-circle-info text-primary");
                const toastClass = isSuccess ? "cb-toast-success" : (type === "error" ? "cb-toast-error" : "cb-toast-info");

                const toastHtml = $(`
                    <div class="cb-toast-item ${toastClass}">
                        <i class="fa-solid ${iconClass} fs-4"></i>
                        <div style="flex:1;">
                            <strong class="d-block text-dark fw-bold" style="font-size:13.5px;">${escapeHtml(title || (isSuccess ? "Success" : "Notification"))}</strong>
                            <span class="text-secondary" style="font-size:12.5px; line-height:1.4;">${escapeHtml(message || "")}</span>
                        </div>
                        <button type="button" class="btn-close ms-auto" style="font-size:11px;" onclick="$(this).closest('.cb-toast-item').removeClass('show').delay(300).queue(function(){ $(this).remove(); });"></button>
                    </div>
                `);

                $("#cbToastContainer").append(toastHtml);
                setTimeout(() => toastHtml.addClass("show"), 50);

                setTimeout(function () {
                    toastHtml.removeClass("show");
                    setTimeout(() => toastHtml.remove(), 350);
                }, 4500);
            }

            // Check for pending flash message from previous action
            $(function () {
                const pendingToast = sessionStorage.getItem("cb_toast_msg");
                if (pendingToast) {
                    const toastType = sessionStorage.getItem("cb_toast_type") || "success";
                    showCbToast(toastType === "success" ? "Success" : "Notification", pendingToast, toastType);
                    sessionStorage.removeItem("cb_toast_msg");
                    sessionStorage.removeItem("cb_toast_type");
                }
            });

            function materialIcon(type) {
                switch ((type || "").toLowerCase()) {
                    case "video":
                        return "fa-video";

                    case "videourl":
                    case "url":
                    case "link":
                        return "fa-link";

                    case "audio":
                        return "fa-volume-high";

                    case "image":
                        return "fa-image";

                    default:
                        return "fa-file-lines";
                }
            }

            function showBoardLoading() {
                $("#structureBoard").html(
                    '<div class="cb-board-loading">' +
                    '<div class="spinner-border text-primary" role="status"></div>' +
                    '<p>Loading curriculum...</p>' +
                    '</div>'
                );
            }

            function showBoardError(message) {
                $("#structureBoard").html(
                    '<div class="cb-error-state">' +
                    '<i class="fa-solid fa-circle-exclamation"></i>' +
                    '<span>' + escapeHtml(message) + '</span>' +
                    '</div>'
                );
            }

            function refreshStructure() {
                const activeTab = $(".cb-program-tab.active");
                const programId = Number(activeTab.data("program-id"));

                if (!programId) {
                    return;
                }

                $.ajax({
                    url: urls.getProgramStructure,
                    type: "GET",
                    data: {
                        programId: programId
                    }
                })
                .done(function (html) {
                    $("#structureBoard").html(html);
                })
                .fail(function () {
                    showBoardError(
                        "Unable to refresh curriculum structure."
                    );
                });
            }

            function renderLibraryItems(items) {
                const container = $("#libraryItemsList");
                const countBadge = $("#libraryCountBadge");

                if (!Array.isArray(items) || items.length === 0) {
                    countBadge.text("0 items");
                    container.html(
                        '<div class="cb-small-empty">' +
                        '<i class="fa-solid fa-folder-open d-block mb-2 fs-4 text-muted"></i>' +
                        'No library resources found.' +
                        '</div>'
                    );
                    return;
                }

                countBadge.text(items.length + " items");
                let html = "";

                items.forEach(function (item) {
                    const typeLower = (item.type || "").toLowerCase();
                    let badgeClass = "doc";
                    let typeLabel = "Document";

                    if (typeLower.indexOf("video") !== -1) {
                        badgeClass = "video";
                        typeLabel = "Video";
                    } else if (typeLower.indexOf("ppt") !== -1 || typeLower.indexOf("powerpoint") !== -1) {
                        badgeClass = "ppt";
                        typeLabel = "Presentation";
                    } else if (typeLower.indexOf("quiz") !== -1) {
                        badgeClass = "quiz";
                        typeLabel = "Quiz";
                    }

                    html +=
                        '<div class="cb-resource-row">' +
                            '<div class="cb-resource-info">' +
                                '<div class="cb-resource-type-icon ' + badgeClass + '">' +
                                    '<i class="fa-solid ' + materialIcon(item.type) + '"></i>' +
                                '</div>' +
                                '<div style="min-width:0; flex:1;">' +
                                    '<div class="cb-resource-title" title="' + escapeHtml(item.title) + '">' +
                                        escapeHtml(item.title) +
                                    '</div>' +
                                    '<div class="cb-resource-subtext">' +
                                        '<span class="badge bg-light text-secondary border me-1" style="font-size:9.5px;">' + typeLabel + '</span>' +
                                    '</div>' +
                                '</div>' +
                            '</div>' +

                            '<button type="button" ' +
                                    'class="cb-assign-btn js-assign-content" ' +
                                    'data-material-id="' + Number(item.id) + '" ' +
                                    'data-material-type="' + escapeHtml(item.type || "") + '" ' +
                                    'title="Assign to selected quadrant">' +
                                '<i class="fa-solid fa-plus"></i> Assign' +
                            '</button>' +
                        '</div>';
                });

                container.html(html);
            }

            function renderMappedItems(items) {
                const container = $("#mappedItemsList");
                const countBadge = $("#mappedCountBadge");

                if (!Array.isArray(items) || items.length === 0) {
                    countBadge.text("0 items");
                    container.html(
                        '<div class="cb-small-empty">' +
                        '<i class="fa-solid fa-link-slash d-block mb-2 fs-4 text-muted"></i>' +
                        'No content assigned to this course yet.' +
                        '</div>'
                    );
                    return;
                }

                countBadge.text(items.length + " items");
                let html = "";

                items.forEach(function (item) {
                    const typeLower = (item.type || "").toLowerCase();
                    let badgeClass = "doc";
                    if (typeLower.indexOf("video") !== -1) badgeClass = "video";
                    else if (typeLower.indexOf("ppt") !== -1) badgeClass = "ppt";
                    else if (typeLower.indexOf("quiz") !== -1) badgeClass = "quiz";

                    html +=
                        '<div class="cb-resource-row">' +
                            '<div class="cb-resource-info">' +
                                '<div class="cb-resource-type-icon ' + badgeClass + '">' +
                                    '<i class="fa-solid ' + materialIcon(item.type) + '"></i>' +
                                '</div>' +
                                '<div style="min-width:0; flex:1;">' +
                                    '<div class="cb-resource-title" title="' + escapeHtml(item.title) + '">' +
                                        escapeHtml(item.title) +
                                    '</div>' +
                                    '<div class="cb-resource-subtext">' +
                                        '<span class="badge bg-primary bg-opacity-10 text-primary fw-bold" style="font-size:10px;">' +
                                            escapeHtml(item.quadrant || "Quadrant") +
                                        '</span>' +
                                    '</div>' +
                                '</div>' +
                            '</div>' +

                            '<button type="button" ' +
                                    'class="cb-unassign-btn js-unassign-content" ' +
                                    'data-mapping-id="' + Number(item.mappingId) + '" ' +
                                    'title="Remove content mapping">' +
                                '<i class="fa-solid fa-trash-can"></i>' +
                            '</button>' +
                        '</div>';
                });

                container.html(html);
            }

            function loadLibrary(searchText) {
                $("#libraryItemsList").html(
                    '<div class="cb-small-empty">' +
                    '<i class="fa-solid fa-spinner fa-spin"></i> Loading...' +
                    '</div>'
                );

                $.ajax({
                    url: urls.getLibraryItems,
                    type: "GET",
                    data: {
                        search: searchText || ""
                    }
                })
                .done(function (items) {
                    renderLibraryItems(items);
                })
                .fail(function () {
                    $("#libraryItemsList").html(
                        '<div class="cb-small-empty text-danger">' +
                        'Unable to load library resources.' +
                        '</div>'
                    );
                });
            }

            function loadMappedItems() {
                const courseId = Number($("#mapCourseId").val());

                if (!courseId) {
                    return;
                }

                $("#mappedItemsList").html(
                    '<div class="cb-small-empty">' +
                    '<i class="fa-solid fa-spinner fa-spin"></i> Loading...' +
                    '</div>'
                );

                $.ajax({
                    url: urls.getCourseContent,
                    type: "GET",
                    data: {
                        courseId: courseId
                    }
                })
                .done(function (items) {
                    renderMappedItems(items);
                })
                .fail(function () {
                    $("#mappedItemsList").html(
                        '<div class="cb-small-empty text-danger">' +
                        'Unable to load assigned content.' +
                        '</div>'
                    );
                });
            }

            function loadMappingData() {
                loadLibrary($("#librarySearch").val());
                loadMappedItems();
            }

            $(document).on(
                "click",
                ".cb-program-tab",
                function () {
                    const button = $(this);
                    const programId = Number(
                        button.data("program-id")
                    );

                    if (!programId ||
                        button.hasClass("active")) {
                        return;
                    }

                    $(".cb-program-tab")
                        .removeClass("active")
                        .attr("aria-selected", "false");

                    button
                        .addClass("active")
                        .attr("aria-selected", "true");

                    showBoardLoading();

                    $.ajax({
                        url: urls.getProgramStructure,
                        type: "GET",
                        data: {
                            programId: programId
                        }
                    })
                    .done(function (html) {
                        $("#structureBoard").html(html);

                        const newUrl =
                            window.location.pathname +
                            "?programId=" +
                            encodeURIComponent(programId);

                        window.history.replaceState(
                            {},
                            "",
                            newUrl
                        );
                    })
                    .fail(function () {
                        showBoardError(
                            "Unable to load the selected program."
                        );
