@model TMS.ViewModels.Academics.CurriculumBuilderPageViewModel

@{
    ViewData["Title"] = "Curriculum Builder";
    bool isFaculty = ViewBag.IsFaculty ?? false;
}

<link rel="stylesheet" href="~/css/content-library.css" />
<link rel="stylesheet" href="~/css/course-structure.css" />

<style>
    .cb-shell {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 24px 28px 40px;
        box-sizing: border-box;
    }

    .cb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 118px;
        padding: 24px 30px;
        margin-bottom: 22px;
        border: 1px solid #e4e7ff;
        border-radius: 20px;
        background: linear-gradient(135deg, #fafaff 0%, #f6f5ff 100%);
    }

    .cb-header-main {
        min-width: 0;
    }

    .cb-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 7px;
    }

    .cb-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        color: #111827;
        font-size: 26px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.035em;
    }

    .cb-title i {
        color: #6366f1;
    }

    .cb-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 15px;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        font-size: 12px;
        line-height: 1.4;
        font-weight: 700;
        white-space: nowrap;
    }

    .cb-subtitle {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.5;
    }

    .cb-program-tabs {
        display: flex;
        align-items: stretch;
        gap: 10px;
        flex-wrap: wrap;
        margin: 0 0 22px;
    }

    .cb-program-tab {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        min-height: 48px;
        padding: 10px 18px;
        border: 1px solid #dfe5ee;
        border-radius: 13px;
        background: #fff;
        color: #334155;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .02);
        transition:
            background .18s ease,
            border-color .18s ease,
            color .18s ease,
            transform .18s ease,
            box-shadow .18s ease;
    }

    .cb-program-tab:hover {
        color: #4f46e5;
        border-color: #a5b4fc;
        background: #fafaff;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(99, 102, 241, .08);
    }

    .cb-program-tab.active {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(135deg, #6366f1, #7c3aed);
        box-shadow: 0 7px 18px rgba(99, 102, 241, .24);
    }

    .cb-program-tab i {
        flex: 0 0 auto;
    }

    .cb-program-name {
        max-width: 310px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 4px 8px;
        margin-left: 2px;
        border-radius: 7px;
        color: #475569;
        background: #f1f5f9;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .cb-program-tab.active .cb-tab-badge {
        color: #fff;
        background: rgba(255, 255, 255, .18);
    }

    .cb-board {
        width: 100%;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .02);
    }

    .cb-board-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 220px;
        padding: 40px 20px;
        color: #64748b;
    }

    .cb-board-loading p {
        margin: 0;
        font-size: 14px;
    }

    .cb-error-state {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 180px;
        padding: 30px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
    }

    .cb-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 245px;
        padding: 42px 24px;
        text-align: center;
    }

    .cb-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin-bottom: 14px;
        border-radius: 18px;
        color: #94a3b8;
        background: #f1f5f9;
        font-size: 28px;
    }

    .cb-empty-state h4 {
        margin: 0 0 6px;
        color: #334155;
        font-size: 18px;
        font-weight: 800;
    }

    .cb-empty-state p {
        max-width: 500px;
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.55;
    }

    .cb-empty-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 18px;
        padding: 9px 16px;
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .cb-empty-action:hover {
        color: #fff;
        border-color: #6366f1;
        background: #6366f1;
    }

    .ps-program-header {
        padding: 22px 26px;
        border-bottom: 1px solid #edf1f5;
        background: linear-gradient(135deg, #ffffff, #fbfbff);
    }

    .ps-program-main {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .ps-program-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        color: #6366f1;
        background: #eef2ff;
        font-size: 20px;
    }

    .ps-program-info {
        min-width: 0;
        flex: 1;
    }

    .ps-program-info h2 {
        margin: 0;
        color: #0f172a;
        font-size: 22px;
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .ps-program-info p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .ps-program-stats {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 9px;
    }

    .ps-program-stats span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 9px;
        border-radius: 7px;
        color: #475569;
        background: #f1f5f9;
        font-size: 11px;
        font-weight: 700;
    }

    .ps-semester-list {
        padding: 18px;
    }

    .ps-semester {
        overflow: hidden;
        margin-bottom: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: #fff;
        transition: box-shadow .18s ease;
    }

    .ps-semester:last-child {
        margin-bottom: 0;
    }

    .ps-semester:hover {
        box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
    }

    .ps-semester-header {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 14px 17px;
        border: 0;
        border-left: 4px solid var(--semester-color);
        background: #fff;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }

    .ps-semester-header:hover {
        background: #fcfcfd;
    }

    .ps-semester-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: #fff;
        font-size: 15px;
    }

    .ps-semester-heading {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        gap: 2px;
    }

    .ps-semester-heading strong {
        overflow: hidden;
        color: #1e293b;
        font-size: 14px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ps-semester-heading small {
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
    }

    .ps-semester-chevron {
        color: #94a3b8;
        font-size: 12px;
        transition: transform .2s ease;
    }

    .ps-semester.collapsed .ps-semester-chevron {
        transform: rotate(-90deg);
    }

    .ps-semester.collapsed .ps-semester-body {
        display: none;
    }

    .ps-semester-body {
        padding: 0 14px 14px;
    }

    .ps-course-wrapper {
        margin-top: 8px;
    }

    .ps-course-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 66px;
        padding: 11px 13px;
        border: 1px solid #edf1f5;
        border-radius: 11px;
        background: #fafbfc;
        transition:
            background .16s ease,
            border-color .16s ease,
            transform .16s ease;
    }

    .ps-course-card:hover {
        border-color: #dbe2ea;
        background: #fff;
        transform: translateX(2px);
    }

    .ps-course-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        color: #475569;
        background: #eef2f7;
        font-size: 14px;
    }

    .ps-course-info {
        flex: 1;
        min-width: 0;
    }

    .ps-course-name {
        overflow: hidden;
        color: #1e293b;
        font-size: 13px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ps-course-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10.5px;
        font-weight: 600;
    }

    .ps-course-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 7px;
    }

    .ps-content-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 31px;
        padding: 5px 9px;
        border: 1px solid #c7d2fe;
        border-radius: 8px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .ps-content-chevron {
        margin-left: 2px;
        font-size: 8px;
        transition: transform .18s ease;
    }

    .ps-content-badge[aria-expanded="true"] .ps-content-chevron {
        transform: rotate(180deg);
    }

    .ps-zero-content {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
    }

    .ps-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #6366f1;
        background: #fff;
        cursor: pointer;
        transition: all .16s ease;
    }

    .ps-action-btn:hover {
        color: #fff;
        border-color: #6366f1;
        background: #6366f1;
    }

    .ps-course-content-list {
        margin-top: -1px;
        padding: 10px 12px 10px 48px;
        border: 1px solid #e2e8f0;
        border-top: 0;
        border-radius: 0 0 11px 11px;
        background: #fafbff;
    }

    .ps-semester-empty {
        padding: 22px;
        color: #94a3b8;
        font-size: 12px;
        text-align: center;
    }

    .cb-content-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 9px;
        margin-bottom: 5px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fff;
    }

    .cb-content-item:last-child {
        margin-bottom: 0;
    }

    .cb-content-item-main {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 7px;
    }

    .cb-content-item-main i {
        color: #6366f1;
        font-size: 11px;
    }

    .cb-content-item-title {
        overflow: hidden;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-quadrant-badge {
        flex: 0 0 auto;
        padding: 2px 7px;
        border-radius: 5px;
        color: #4f46e5;
        background: #e0e7ff;
        font-size: 9px;
        font-weight: 800;
    }

    .cb-mapping-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) 1px minmax(0, 0.9fr);
        min-height: 380px;
        max-height: 480px;
        background: #ffffff;
    }

    .cb-mapping-column {
        overflow-y: auto;
        padding: 20px;
        background: #ffffff;
    }

    .cb-mapping-divider {
        background: #e2e8f0;
    }

    .cb-mapping-heading {
        margin-bottom: 14px;
        color: #475569;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .cb-quad-pill {
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 600;
        transition: all 0.2s ease;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
    }
    .cb-quad-pill:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #1e293b;
    }
    .cb-quad-pill.active {
        background: #2563eb !important;
        border-color: #2563eb !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }
    .cb-quad-pill.active i {
        color: #ffffff !important;
    }

    .cb-library-search {
        width: 100%;
        padding: 10px 14px;
        margin-bottom: 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        font-size: 13.5px;
        background: #f8fafc;
        transition: all 0.2s;
    }

    .cb-library-search:focus {
        background: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
    }

    .cb-resource-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        margin-bottom: 8px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        transition: all 0.2s ease;
    }

    .cb-resource-row:hover {
        background: #ffffff;
        border-color: #bfdbfe;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.05);
        transform: translateY(-1px);
    }

    .cb-resource-info {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 10px;
        flex: 1;
    }

    .cb-resource-type-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }
    .cb-resource-type-icon.video { background: #fee2e2; color: #dc2626; }
    .cb-resource-type-icon.doc { background: #dbeafe; color: #2563eb; }
    .cb-resource-type-icon.ppt { background: #ffedd5; color: #ea580c; }
    .cb-resource-type-icon.quiz { background: #dcfce7; color: #16a34a; }

    .cb-resource-title {
        overflow: hidden;
        color: #1e293b;
        font-size: 13px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-resource-subtext {
        font-size: 11px;
        color: #64748b;
        margin-top: 1px;
    }

    .cb-assign-btn {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .cb-assign-btn:hover {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }

    .cb-unassign-btn {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #fecdd3;
        border-radius: 8px;
        padding: 5px 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        flex-shrink: 0;
    }

    .cb-unassign-btn:hover {
        background: #e11d48;
        color: #ffffff;
        border-color: #e11d48;
    }

    .cb-small-empty {
        padding: 30px 12px;
        color: #94a3b8;
        font-size: 13px;
        text-align: center;
        font-weight: 500;
    }

    /* Manage Content modal */
    #manageContentModal .modal-dialog { width: min(960px, calc(100vw - 32px)); max-width: 960px; margin: 24px auto; }
    #manageContentModal .modal-content { max-height: calc(100vh - 48px); border: 0; border-radius: 20px; overflow: hidden; background: #fff; box-shadow: 0 25px 70px rgba(15, 23, 42, .25); }
    #manageContentModal .modal-header { flex: 0 0 auto; padding: 20px 26px; border-bottom: 1px solid #e2e8f0; }
    #manageContentModal .modal-body { min-height: 0; overflow: auto; }
    #manageContentModal .modal-footer { flex: 0 0 auto; justify-content: flex-end !important; gap: 10px; padding: 14px 26px; border-top: 1px solid #e2e8f0; background: #fff; }
    #manageContentModal .modal-footer .btn { min-width: 100px; border-radius: 10px; font-weight: 700; }

    @@media (max-width: 991px) {
        .cb-shell {
            padding: 18px;
        }

        .cb-header {
            min-height: auto;
            padding: 20px;
        }

        .cb-title {
            font-size: 22px;
        }

        .cb-program-tab {
            flex: 1 1 220px;
        }
    }

    @@media (max-width: 767px) {
        .cb-shell {
            padding: 12px;
        }

        .cb-header {
            margin-bottom: 16px;
            padding: 18px;
            border-radius: 15px;
        }

        .cb-title-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .cb-title {
            font-size: 20px;
        }

        .cb-pill {
            white-space: normal;
        }

        .cb-program-tabs {
            gap: 8px;
            margin-bottom: 16px;
        }

        .cb-program-tab {
            flex: 1 1 100%;
            width: 100%;
        }

        .cb-program-name {
            flex: 1;
            max-width: none;
            text-align: left;
        }

        .cb-board {
            border-radius: 15px;
        }

        .ps-program-header {
            padding: 18px;
        }

        .ps-program-main {
            align-items: flex-start;
        }

        .ps-semester-list {
            padding: 12px;
        }

        .ps-course-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .ps-course-info {
            min-width: calc(100% - 50px);
        }

        .ps-course-actions {
            width: 100%;
            padding-left: 48px;
        }

        .ps-course-content-list {
            padding-left: 12px;
        }

        .cb-mapping-grid {
            display: block;
            max-height: none;
        }

        .cb-mapping-divider {
            width: 100%;
            height: 1px;
        }

        .cb-mapping-column {
            max-height: 300px;
        }
    }

    /* Program Toolbar & Action Styling */
    .cb-programs-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 22px;
    }

    .cb-new-program-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 48px;
        padding: 10px 20px;
        border: 1.5px dashed #6366f1;
        border-radius: 13px;
        background: #f5f3ff;
        color: #6366f1;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all .18s ease;
        box-shadow: 0 2px 6px rgba(99,102,241,.06);
    }

    .cb-new-program-btn:hover {
        background: #6366f1;
        color: #fff;
        border-style: solid;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(99,102,241,.24);
    }

    .ps-program-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-ps-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all .16s ease;
    }

    .btn-ps-primary {
        background: #6366f1;
        color: #fff;
        border: 1px solid #6366f1;
    }

    .btn-ps-primary:hover {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #fff;
    }

    .btn-ps-secondary {
        background: #fff;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

    .btn-ps-secondary:hover {
        background: #f1f5f9;
