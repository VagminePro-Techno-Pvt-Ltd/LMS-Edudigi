@model TMS.Repository.Managers.ExamAnalyticsViewModel

@{
    ViewData["Title"] = "Assessment Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="exam-page">
    <!-- Page Header -->
    <div class="exam-page-header">
        <div>
            <h1>
                <span class="header-icon" style="background:#fff7ed; color:#ea580c;">
                    <i class="fa-solid fa-chart-line"></i>
                </span>
                Deep Performance Analytics
            </h1>
            <p>Assessment: <strong style="color:#7c3aed;">@Model.ExamTitle</strong></p>
        </div>
        <div class="header-actions">
            <a asp-action="Index" class="exam-btn exam-btn-secondary">
                <i class="fa-solid fa-chevron-left"></i> Supervisor Dashboard
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="exam-stats-row">
        <div class="exam-stat-card purple">
            <span class="stat-label">Mapped</span>
            <span class="stat-value">@Model.TotalAssigned</span>
            <span class="stat-sub">Candidates assigned</span>
        </div>
        <div class="exam-stat-card green">
            <span class="stat-label">Attempts</span>
            <span class="stat-value">@Model.TotalAttempts</span>
            <span class="stat-sub">@Model.AttendancePercentage% attendance</span>
        </div>
        <div class="exam-stat-card blue">
            <span class="stat-label">Pass Rate</span>
            <span class="stat-value">@Model.PassPercentage%</span>
            <span class="stat-sub">@Model.PassedCount Pass / @Model.FailedCount Fail</span>
        </div>
        <div class="exam-stat-card orange">
            <span class="stat-label">Avg Score</span>
            <span class="stat-value">@Math.Round(Model.AverageScore, 1)</span>
            <span class="stat-sub">Class average</span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Question Analysis -->
        <div class="col-lg-7">
            <div class="exam-section-box" style="padding:0; overflow:hidden;">
                <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9;">
                    <h3 style="font-size:16px; font-weight:700; color:#1e293b; margin:0; display:flex; align-items:center; gap:10px;">
                        <span class="title-icon" style="background:#eff6ff; color:#3b82f6; width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:14px;">
                            <i class="fa-solid fa-chart-bar"></i>
                        </span>
                        Question Quality Analysis
                    </h3>
                </div>
                <table class="exam-table">
                    <thead>
                        <tr>
                            <th>Question</th>
                            <th>Type</th>
                            <th>Success</th>
                            <th>Difficulty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.QuestionAnalysis == null || !Model.QuestionAnalysis.Any())
                        {
                            <tr><td colspan="4" style="text-align:center; padding:30px; color:#94a3b8;">No data yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var qa in Model.QuestionAnalysis)
                            {
                                <tr>
                                    <td style="max-width:250px;">
                                        <strong style="color:#1e293b; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden;" title="@qa.QuestionText">@qa.QuestionText</strong>
                                    </td>
                                    <td>
                                        <span style="background:#eff6ff; color:#3b82f6; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:700;">@qa.QuestionType</span>
                                    </td>
                                    <td style="min-width:180px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:12px; font-weight:700; color:#1e293b; min-width:40px;">@(Math.Round(qa.CorrectResponsePercentage, 1))%</span>
                                            <div class="exam-progress" style="flex:1;">
                                                <div class="exam-progress-bar @(qa.CorrectResponsePercentage >= 70 ? "green" : qa.CorrectResponsePercentage >= 40 ? "blue" : "red")" style="width:@(qa.CorrectResponsePercentage)%;"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (qa.DeducedDifficulty == "Easy") { <span class="exam-badge active">Easy</span> }
                                        else if (qa.DeducedDifficulty == "Medium") { <span class="exam-badge pending">Medium</span> }
                                        else { <span class="exam-badge failed">Hard</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Performers -->
        <div class="col-lg-5">
            <div class="exam-section-box">
                <div class="exam-section-title">
                    <span class="title-icon" style="background:#fef9c3; color:#ca8a04;">
                        <i class="fa-solid fa-trophy"></i>
                    </span>
                    Assessment Performers
                </div>

                @if (Model.TopPerformers == null || !Model.TopPerformers.Any())
                {
                    <div style="text-align:center; padding:30px; color:#94a3b8;">No performers logged yet.</div>
                }
                else
                {
                    var rank = 1;
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        @foreach (var performer in Model.TopPerformers)
                        {
                            <div style="display:flex; align-items:center; gap:12px; padding:12px; background:#f8fafc; border-radius:10px; border:1px solid #f1f5f9;">
                                <div style="width:32px; height:32px; border-radius:8px; background:@(rank == 1 ? "linear-gradient(135deg,#ffd700,#ffa500)" : rank == 2 ? "linear-gradient(135deg,#c0c0c0,#808080)" : rank == 3 ? "linear-gradient(135deg,#cd7f32,#8b4513)" : "#e2e8f0"); color:white; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; flex-shrink:0;">
                                    @rank
                                </div>
                                <div style="flex:1; min-width:0;">
                                    <div style="font-size:13px; font-weight:700; color:#1e293b;">@performer.StudentName</div>
                                    <div style="font-size:11px; color:#64748b;">@performer.Email</div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:15px; font-weight:800; color:#ea580c;">@performer.Score</div>
                                    <div style="font-size:10px; color:#64748b;">@performer.Percentage%</div>
                                </div>
                            </div>
                            rank++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
