@model IEnumerable<TMS.Models.Assessments.StudentExamAttempt>

@{
    ViewData["Title"] = "System Assessment Attempts Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="exam-page">
    <!-- Page Header -->
    <div class="exam-page-header">
        <div>
            <h1>
                <span class="header-icon" style="background:#f5f3ff; color:#7c3aed;">
                    <i class="fa-solid fa-history"></i>
                </span>
                System Attempts Log
            </h1>
            <p>Platform-wide audit stream of all student exam submissions, scores, and evaluations.</p>
        </div>
        <div class="header-actions">
            <a asp-action="Index" class="exam-btn exam-btn-secondary">
                <i class="fa-solid fa-chevron-left"></i> Supervisor Dashboard
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="exam-section-box" style="padding:0; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9;">
            <h3 style="font-size:16px; font-weight:700; color:#1e293b; margin:0; display:flex; align-items:center; gap:10px;">
                <span class="title-icon" style="background:#eff6ff; color:#3b82f6; width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:14px;">
                    <i class="fa-solid fa-table-cells"></i>
                </span>
                All Attempt Records
            </h3>
        </div>
        <table class="exam-table">
            <thead>
                <tr>
                    <th>Candidate</th>
                    <th>Assessment</th>
                    <th>Started At</th>
                    <th>Marks</th>
                    <th>Percentage</th>
                    <th>Outcome</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="exam-empty-state" style="border:none;">
                                <div class="empty-icon"><i class="fa-solid fa-folder-open"></i></div>
                                <h3>No Attempts Logged</h3>
                                <p>No student attempts have been logged on the platform yet.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color:#1e293b;">@attempt.Student?.Name</strong>
                                <div style="font-size:11px; color:#64748b;">@attempt.Student?.Email</div>
                            </td>
                            <td>
                                <strong style="color:#1e293b;">@attempt.Exam?.Title</strong>
                                <div style="font-size:11px; color:#64748b;">Attempt #@attempt.AttemptNumber</div>
                            </td>
                            <td style="font-size:12.5px;">@attempt.StartedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <strong style="color:#1e293b;">@(attempt.Score ?? 0)</strong>
                                <span style="font-size:11px; color:#64748b;">/ @attempt.Exam?.TotalMarks</span>
                            </td>
                            <td>
                                <strong style="color:#3b82f6;">@(attempt.Percentage ?? 0)%</strong>
                            </td>
                            <td>
                                @if (attempt.ResultStatus == "Passed")
                                {
                                    <span class="exam-badge passed"><i class="fa-solid fa-check"></i> Passed</span>
                                }
                                else if (attempt.ResultStatus == "Failed")
                                {
                                    <span class="exam-badge failed"><i class="fa-solid fa-xmark"></i> Failed</span>
                                }
                                else if (attempt.ResultStatus == "Pending")
                                {
                                    <span class="exam-badge pending"><i class="fa-solid fa-clock"></i> Pending</span>
                                }
                                else
                                {
                                    <span class="exam-badge draft">Draft</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
