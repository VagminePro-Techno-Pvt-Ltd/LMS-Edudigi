@model IEnumerable<TMS.Models.Assessments.StudentExamAttempt>

@{
    ViewData["Title"] = "Live Exam Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var exam = ViewBag.Exam as TMS.Models.Assessments.ExamMaster;
}

<div class="exam-page">
    <!-- Page Header -->
    <div class="exam-page-header">
        <div>
            <h1>
                <span class="header-icon" style="background:#ecfdf5; color:#059669;">
                    <i class="fa-solid fa-satellite-dish"></i>
                </span>
                Live Exam Monitor
            </h1>
            <p>
                Exam: <strong style="color:#1e293b;">@exam?.Title</strong> · 
                Course: <strong style="color:#7c3aed;">@exam?.Course?.Name</strong>
            </p>
        </div>
        <div class="header-actions">
            <span class="exam-badge live" style="padding:8px 16px; font-size:13px;">
                <i class="fa-solid fa-users"></i> @Model.Count() Active
            </span>
            <a asp-action="Index" class="exam-btn exam-btn-secondary">
                <i class="fa-solid fa-chevron-left"></i> Supervisor Panel
            </a>
        </div>
    </div>

    <!-- Live Candidates Table -->
    <div class="exam-section-box" style="padding:0; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
            <h3 style="font-size:16px; font-weight:700; color:#1e293b; margin:0; display:flex; align-items:center; gap:10px;">
                <span class="title-icon" style="background:#ecfdf5; color:#059669; width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:14px;">
                    <i class="fa-solid fa-signal"></i>
                </span>
                Live Candidate Stream
            </h3>
        </div>
        <table class="exam-table">
            <thead>
                <tr>
                    <th>Candidate</th>
                    <th>Started At</th>
                    <th>Attempt</th>
                    <th>Duration / Elapsed</th>
                    <th>Progress</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="exam-empty-state" style="border:none;">
                                <div class="empty-icon"><i class="fa-solid fa-user-clock"></i></div>
                                <h3>No Active Candidates</h3>
                                <p>No candidates are actively taking this exam right now.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var attempt in Model)
                    {
                        var totalSeconds = exam?.DurationMinutes * 60 ?? 1;
                        var elapsedSeconds = totalSeconds - attempt.RemainingSeconds;
                        if (elapsedSeconds < 0) elapsedSeconds = 0;
                        var elapsedPercent = Math.Round((double)elapsedSeconds / totalSeconds * 100, 1);
                        if (elapsedPercent > 100) elapsedPercent = 100;

                        <tr>
                            <td>
                                <strong style="color:#1e293b;">@attempt.Student?.Name</strong>
                                <div style="font-size:11px; color:#64748b;">@attempt.Student?.Email</div>
                            </td>
                            <td style="font-size:12.5px;">@attempt.StartedAt.ToString("hh:mm:ss tt")</td>
                            <td>
                                <span style="background:#f1f5f9; color:#64748b; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:700;">
                                    #@attempt.AttemptNumber
                                </span>
                            </td>
                            <td>
                                <strong style="color:#1e293b;">@(elapsedSeconds / 60) min elapsed</strong>
                                <div style="font-size:11px; color:#64748b;">
                                    Remaining: @(attempt.RemainingSeconds / 60)m @(attempt.RemainingSeconds % 60)s
                                </div>
                            </td>
                            <td style="width:200px;">
                                <div class="exam-progress" style="margin-bottom:4px;">
                                    <div class="exam-progress-bar @(elapsedPercent > 80 ? "red" : "blue")" style="width:@(elapsedPercent)%;"></div>
                                </div>
                                <span style="font-size:10.5px; color:#64748b;">@(elapsedPercent)% elapsed</span>
                            </td>
                            <td>
                                @if (attempt.ResultStatus == "Pending")
                                {
                                    <span class="exam-badge live"><i class="fa-solid fa-pen"></i> Writing</span>
                                }
                                else
                                {
                                    <span class="exam-badge pending"><i class="fa-solid fa-check-double"></i> Evaluating</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
