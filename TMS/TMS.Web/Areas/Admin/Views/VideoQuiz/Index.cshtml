@model List<TMS.Web.Areas.Admin.Controllers.VideoListItemVm>
@{
    ViewData["Title"] = "Video Quiz Manager";
}

<style>
    .vq-page { padding: 8px 4px 40px; font-family: 'Jost','Segoe UI',sans-serif; }
    .vq-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; }
    .vq-title { font-size:22px; font-weight:800; color:#1e293b; display:flex; align-items:center; gap:10px; }
    .vq-title i { color:#6366f1; }
    .vq-subtitle { font-size:13px; color:#64748b; margin-top:2px; }

    .vq-search { position:relative; }
    .vq-search input { padding:8px 14px 8px 36px; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; width:240px; outline:none; transition:border-color .18s; }
    .vq-search input:focus { border-color:#6366f1; }
    .vq-search i { position:absolute; left:11px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:13px; }

    .vq-table-wrap { background:#fff; border-radius:16px; border:1px solid #eef2f6; box-shadow:0 2px 12px rgba(0,0,0,.05); overflow:hidden; }
    .vq-table { width:100%; border-collapse:collapse; }
    .vq-table thead { background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; }
    .vq-table thead th { padding:14px 18px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
    .vq-table tbody tr { border-bottom:1px solid #f1f5f9; transition:background .14s; }
    .vq-table tbody tr:last-child { border-bottom:none; }
    .vq-table tbody tr:hover { background:#fafbff; }
    .vq-table tbody td { padding:14px 18px; font-size:13.5px; color:#1e293b; vertical-align:middle; }

    .vq-badge-type { padding:3px 10px; border-radius:12px; font-size:11px; font-weight:700; }
    .vq-badge-video { background:#eff6ff; color:#3b82f6; }
    .vq-badge-url   { background:#fef9c3; color:#ca8a04; }

    .vq-q-count { display:inline-flex; align-items:center; gap:5px; font-size:13px; font-weight:700; }
    .vq-q-count.has   { color:#16a34a; }
    .vq-q-count.empty { color:#94a3b8; }

    .btn-manage {
        background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; border:none;
        border-radius:8px; padding:7px 18px; font-size:12px; font-weight:700;
        cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:6px;
        transition:opacity .18s;
    }
    .btn-manage:hover { opacity:.88; color:#fff; }

    .vq-empty { text-align:center; padding:60px 24px; }
    .vq-empty i { font-size:40px; color:#cbd5e1; display:block; margin-bottom:14px; }
    .vq-empty p { color:#94a3b8; font-size:15px; }

    @@media(max-width:600px){ .vq-table thead { display:none; } .vq-table tbody td { display:block; } }
</style>

<div class="vq-page">
    <div class="vq-header">
        <div>
            <div class="vq-title"><i class="fa-solid fa-circle-question"></i> Video Quiz Manager</div>
            <div class="vq-subtitle">Attach MCQ questions to video lectures. Questions appear as popups during playback.</div>
        </div>
        <div class="vq-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Search videos…" oninput="filterTable()" />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="vq-table-wrap">
        @if (Model == null || !Model.Any())
        {
            <div class="vq-empty">
                <i class="fa-solid fa-video-slash"></i>
                <p>No video materials found.<br/>Upload video content in the <a href="@Url.Action("Index","LectureMaterial",new{area="Admin"})">Content Library</a> first.</p>
            </div>
        }
        else
        {
            <table class="vq-table" id="videoTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Video Title</th>
                        <th>Type</th>
                        <th>Quiz Questions</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td style="color:#94a3b8;font-weight:600;">@i</td>
                            <td>
                                <div style="font-weight:700;color:#1e293b;">@v.Title</div>
                                @if (!string.IsNullOrEmpty(v.FilePath))
                                {
                                    <div style="font-size:11px;color:#94a3b8;margin-top:2px;word-break:break-all;">@v.FilePath</div>
                                }
                            </td>
                            <td>
                                <span class="vq-badge-type @(v.MaterialType=="VideoURL" ? "vq-badge-url" : "vq-badge-video")">
                                    @(v.MaterialType == "VideoURL" ? "🔗 URL" : "🎥 File")
                                </span>
                            </td>
                            <td>
                                @if (v.QuestionCount > 0)
                                {
                                    <span class="vq-q-count has"><i class="fa-solid fa-circle-check"></i> @v.QuestionCount Question@(v.QuestionCount != 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span class="vq-q-count empty"><i class="fa-regular fa-circle"></i> No questions</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Manage","VideoQuiz",new{area="Admin",materialId=v.Id})" class="btn-manage">
                                    <i class="fa-solid fa-gear"></i> Manage Quiz
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterTable() {
        var q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('#videoTable tbody tr').forEach(function(row) {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }
</script>
}
