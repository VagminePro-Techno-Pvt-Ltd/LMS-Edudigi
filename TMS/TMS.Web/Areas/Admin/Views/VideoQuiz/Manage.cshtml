@model TMS.Web.Areas.Admin.Controllers.ManageVideoQuizVm
@{
    ViewData["Title"] = "Manage Quiz — " + Model.VideoTitle;
}

<style>
    .mq-page { padding: 8px 4px 48px; font-family: 'Jost','Segoe UI',sans-serif; }

    /* Breadcrumb */
    .mq-bc { font-size:13px; color:#94a3b8; margin-bottom:16px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .mq-bc a { color:#64748b; text-decoration:none; } .mq-bc a:hover { color:#6366f1; }
    .mq-bc .sep { color:#cbd5e1; }

    /* Video Info Banner */
    .mq-banner {
        background:linear-gradient(135deg,#6366f1 0%,#4f46e5 60%,#7c3aed 100%);
        border-radius:16px; padding:22px 28px; color:#fff; margin-bottom:28px;
        display:flex; align-items:center; gap:18px; flex-wrap:wrap;
        box-shadow:0 8px 28px rgba(99,102,241,.25);
    }
    .mq-banner-icon { width:52px; height:52px; border-radius:14px; background:rgba(255,255,255,.18); display:flex; align-items:center; justify-content:center; font-size:24px; flex-shrink:0; }
    .mq-banner-info h2 { font-size:18px; font-weight:800; margin:0 0 4px; }
    .mq-banner-info p  { font-size:13px; opacity:.8; margin:0; }

    /* Layout: two columns */
    .mq-layout { display:grid; grid-template-columns:1fr 400px; gap:24px; align-items:start; }
    @@media(max-width:960px){ .mq-layout { grid-template-columns:1fr; } }

    /* Questions list card */
    .mq-card { background:#fff; border-radius:16px; border:1px solid #eef2f6; box-shadow:0 2px 12px rgba(0,0,0,.05); overflow:hidden; }
    .mq-card-header { padding:16px 22px; background:#f8fafc; border-bottom:1px solid #eef2f6; display:flex; align-items:center; justify-content:space-between; }
    .mq-card-header h3 { font-size:15px; font-weight:800; color:#1e293b; margin:0; display:flex; align-items:center; gap:8px; }
    .mq-card-header h3 i { color:#6366f1; }

    /* Question Row */
    .mq-q-row { padding:18px 22px; border-bottom:1px solid #f1f5f9; transition:background .14s; }
    .mq-q-row:last-child { border-bottom:none; }
    .mq-q-row:hover { background:#fafbff; }
    .mq-q-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .mq-q-time { flex-shrink:0; background:#eff6ff; color:#3b82f6; font-size:11px; font-weight:700; padding:4px 10px; border-radius:8px; display:flex; align-items:center; gap:4px; }
    .mq-q-text { font-size:14px; font-weight:700; color:#1e293b; flex:1; line-height:1.4; }
    .mq-q-options { display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-top:10px; }
    .mq-opt { font-size:12px; color:#475569; background:#f8fafc; border-radius:7px; padding:5px 10px; display:flex; align-items:center; gap:6px; }
    .mq-opt.correct { background:#f0fdf4; color:#16a34a; font-weight:700; }
    .mq-opt-key { width:20px; height:20px; border-radius:6px; background:#e2e8f0; color:#475569; font-size:10px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .mq-opt.correct .mq-opt-key { background:#16a34a; color:#fff; }
    .btn-del { background:#fef2f2; color:#ef4444; border:none; border-radius:7px; padding:5px 12px; font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:4px; transition:background .15s; flex-shrink:0; }
    .btn-del:hover { background:#ef4444; color:#fff; }

    .mq-empty { text-align:center; padding:40px 24px; }
    .mq-empty i { font-size:36px; color:#cbd5e1; display:block; margin-bottom:12px; }
    .mq-empty p { color:#94a3b8; font-size:14px; }

    /* Add question form card */
    .mq-form-card { background:#fff; border-radius:16px; border:1px solid #eef2f6; box-shadow:0 2px 12px rgba(0,0,0,.05); overflow:hidden; position:sticky; top:80px; }
    .mq-form-header { padding:16px 22px; background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; }
    .mq-form-header h3 { font-size:15px; font-weight:800; margin:0; display:flex; align-items:center; gap:8px; }
    .mq-form-body { padding:22px; }
    .mq-form-body .form-label { font-size:12px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:.4px; margin-bottom:4px; }
    .mq-form-body .form-control, .mq-form-body .form-select { border:1px solid #e2e8f0; border-radius:8px; font-size:13.5px; padding:9px 12px; }
    .mq-form-body .form-control:focus, .mq-form-body .form-select:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,.12); }

    .mq-time-hint { font-size:11px; color:#94a3b8; margin-top:4px; }

    .mq-options-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .mq-option-field { position:relative; }
    .mq-option-field .opt-label { position:absolute; left:10px; top:50%; transform:translateY(-50%); width:22px; height:22px; border-radius:6px; background:#6366f1; color:#fff; font-size:10px; font-weight:700; display:flex; align-items:center; justify-content:center; }
    .mq-option-field input { padding-left:40px; }

    .btn-add-q { background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; border:none; border-radius:10px; padding:12px 24px; font-size:14px; font-weight:700; width:100%; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition:opacity .18s; margin-top:6px; }
    .btn-add-q:hover { opacity:.88; }

    .back-link { color:#64748b; text-decoration:none; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:8px; background:#f1f5f9; transition:background .15s; margin-bottom:20px; }
    .back-link:hover { background:#e2e8f0; color:#1e293b; }

    .mq-counter-badge { background:#6366f1; color:#fff; border-radius:20px; padding:2px 10px; font-size:11px; font-weight:700; }
</style>

<div class="mq-page">
    <div class="mq-bc">
        <a asp-area="Admin" asp-controller="VideoQuiz" asp-action="Index"><i class="fa-solid fa-house"></i> Video Quiz Manager</a>
        <span class="sep">/</span>
        <strong>@Model.VideoTitle</strong>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mq-banner">
        <div class="mq-banner-icon">🎥</div>
        <div class="mq-banner-info">
            <h2>@Model.VideoTitle</h2>
            <p>@(Model.MaterialType == "VideoURL" ? "🔗 Video URL" : "📁 Local File") — Add MCQ questions that will appear at specific timestamps during playback.</p>
        </div>
    </div>

    <div class="mq-layout">
        <!-- Left: Questions List -->
        <div class="mq-card">
            <div class="mq-card-header">
                <h3><i class="fa-solid fa-list-check"></i> Quiz Questions</h3>
                <span class="mq-counter-badge">@Model.Questions.Count</span>
            </div>

            @if (!Model.Questions.Any())
            {
                <div class="mq-empty">
                    <i class="fa-solid fa-circle-question"></i>
                    <p>No quiz questions yet.<br />Add your first question using the form →</p>
                </div>
            }
            else
            {
                @foreach (var q in Model.Questions)
                {
                    int mins = q.ShowAtSeconds / 60;
                    int secs = q.ShowAtSeconds % 60;
                    string timeLabel = mins > 0 ? $"{mins}m {secs:D2}s" : $"{secs}s";

                    <div class="mq-q-row">
                        <div class="mq-q-top">
                            <div class="mq-q-time"><i class="fa-regular fa-clock"></i> @timeLabel</div>
                            <div class="mq-q-text">@q.QuestionText</div>
                            <form asp-area="Admin" asp-controller="VideoQuiz" asp-action="DeleteQuestion" method="post" style="margin:0;"
                                  onsubmit="return confirm('Remove this question?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="questionId" value="@q.Id" />
                                <input type="hidden" name="materialId" value="@Model.MaterialId" />
                                <button type="submit" class="btn-del"><i class="fa-solid fa-trash"></i> Remove</button>
                            </form>
                        </div>
                        <div class="mq-q-options">
                            @{ var opts = new[] { ("A", q.OptionA), ("B", q.OptionB), ("C", q.OptionC), ("D", q.OptionD) }; }
                            @foreach (var (key, text) in opts)
                            {
                                if (!string.IsNullOrEmpty(text))
                                {
                                    bool isCorrect = key == q.CorrectOption.ToUpper();
                                    <div class="mq-opt @(isCorrect ? "correct" : "")">
                                        <div class="mq-opt-key">@key</div>
                                        <span>@text @(isCorrect ? "✓" : "")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Right: Add Question Form -->
        <div class="mq-form-card">
            <div class="mq-form-header">
                <h3><i class="fa-solid fa-plus-circle"></i> Add Quiz Question</h3>
            </div>
            <div class="mq-form-body">
                <form asp-area="Admin" asp-controller="VideoQuiz" asp-action="AddQuestion" method="post" id="addQForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LectureMaterialId" value="@Model.MaterialId" />

                    <!-- Timestamp -->
                    <div class="mb-3">
                        <label class="form-label">Show At (seconds into video)</label>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <input type="number" name="ShowAtSeconds" class="form-control" id="showAtSeconds"
                                   min="0" placeholder="e.g. 300" required />
                            <span id="timePreview" style="font-size:12px; color:#6366f1; font-weight:700; white-space:nowrap;"></span>
                        </div>
                        <div class="mq-time-hint">300 = 5 min, 600 = 10 min, 3600 = 1 hour</div>
                    </div>

                    <!-- Question -->
                    <div class="mb-3">
                        <label class="form-label">Question Text</label>
                        <textarea name="QuestionText" class="form-control" rows="3"
                                  placeholder="What is marketing management?" required></textarea>
                    </div>

                    <!-- Options -->
                    <div class="mb-3">
                        <label class="form-label">Options</label>
                        <div class="mq-options-grid">
                            <div class="mq-option-field">
                                <div class="opt-label">A</div>
                                <input type="text" name="OptionA" class="form-control" placeholder="Option A" required />
                            </div>
                            <div class="mq-option-field">
                                <div class="opt-label" style="background:#3b82f6;">B</div>
                                <input type="text" name="OptionB" class="form-control" placeholder="Option B" />
                            </div>
                            <div class="mq-option-field">
                                <div class="opt-label" style="background:#16a34a;">C</div>
                                <input type="text" name="OptionC" class="form-control" placeholder="Option C" />
                            </div>
                            <div class="mq-option-field">
                                <div class="opt-label" style="background:#ea580c;">D</div>
                                <input type="text" name="OptionD" class="form-control" placeholder="Option D" />
                            </div>
                        </div>
                    </div>

                    <!-- Correct Option -->
                    <div class="mb-4">
                        <label class="form-label">Correct Answer</label>
                        <select name="CorrectOption" class="form-select" required>
                            <option value="">-- Select Correct Option --</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-add-q">
                        <i class="fa-solid fa-plus"></i> Add Question
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('showAtSeconds').addEventListener('input', function () {
        var s = parseInt(this.value) || 0;
        var m = Math.floor(s / 60);
        var sec = s % 60;
        var h = Math.floor(m / 60);
        m = m % 60;
        var label = h > 0 ? h + 'h ' + m + 'm ' + sec + 's' : (m > 0 ? m + 'm ' + sec + 's' : sec + 's');
        document.getElementById('timePreview').textContent = '= ' + label;
    });
</script>
}
