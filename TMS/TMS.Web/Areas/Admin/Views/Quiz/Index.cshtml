            // Anti-Forgery Token Helper
            function getAntiForgeryToken() {
                return $('input[name="__RequestVerificationToken"]').val();
            }

            // Global State Cache
            let cachedCourses = [];
            let cachedSemesters = [];
            let cachedSubjects = [];
            let savedBankQuestions = [];
            let currentSuggestedQuestions = [];
            let paperQuestions = []; // Array of QuestionPaperQuestionItemViewModel

            // =================================================================
            // 1. INITIAL DATA LOADING & DROPDOWN POPULATION
            // =================================================================
            function loadFacultyCourses() {
                return $.ajax({
                    url: '@Url.Action("GetFacultyCourses", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    success: function (data) {
                        cachedCourses = data || [];
                        populateCourseDropdowns();
                    }
                });
            }

            function loadSemesters(courseId) {
                return $.ajax({
                    url: '@Url.Action("GetCourseSemesters", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { courseId: courseId || 0 },
                    success: function (data) {
                        cachedSemesters = data || [];
                    }
                });
            }

            function loadSubjects(semesterId, courseId) {
                return $.ajax({
                    url: '@Url.Action("GetSubjects", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { semesterId: semesterId || 0, courseId: courseId || 0 },
                    success: function (data) {
                        cachedSubjects = data || [];
                    }
                });
            }

            function populateCourseDropdowns() {
                const options = ['<option value="">All Assigned Courses</option>'];
                const requiredOptions = ['<option value="">Select Course...</option>'];

                cachedCourses.forEach(c => {
                    const opt = `<option value="${c.id}" data-semester="${c.semesterId || ''}">${c.name} ${c.code ? '(' + c.code + ')' : ''}</option>`;
                    options.push(opt);
                    requiredOptions.push(opt);
                });

                $('#bankCourseFilter').html(options.join(''));
                $('#suggestedCourseSelect').html(requiredOptions.join(''));
                $('#paperCourseSelect').html(requiredOptions.join(''));
                $('#modalCourseSelect').html(requiredOptions.join(''));

                // Auto-select first course if available
                if (cachedCourses.length > 0) {
                    $('#suggestedCourseSelect').val(cachedCourses[0].id).trigger('change');
                    $('#paperCourseSelect').val(cachedCourses[0].id).trigger('change');
                }
            }

            // Course selection cascades to Semester and Subject
            function handleCourseChange(courseId, semesterSelectId, subjectSelectId, onComplete) {
                if (!courseId) {
                    $(`#${semesterSelectId}`).html('<option value="">Select Semester...</option>');
                    $(`#${subjectSelectId}`).html('<option value="">Select Subject...</option>');
                    if (onComplete) onComplete();
                    return;
                }

                $.when(loadSemesters(courseId), loadSubjects(null, courseId)).done(function () {
                    // Populate Semester
                    const semOpts = ['<option value="">Select Semester...</option>'];
                    cachedSemesters.forEach(s => {
                        const sel = s.isCourseDefault ? 'selected' : '';
                        semOpts.push(`<option value="${s.id}" ${sel}>${s.name}</option>`);
                    });
                    $(`#${semesterSelectId}`).html(semOpts.join(''));

                    // Populate Subject
                    const subOpts = ['<option value="">Select Subject...</option>'];
                    cachedSubjects.forEach(sub => {
                        subOpts.push(`<option value="${sub.id}" data-semester="${sub.semesterId || ''}">${sub.name} ${sub.code ? '(' + sub.code + ')' : ''}</option>`);
                    });
                    $(`#${subjectSelectId}`).html(subOpts.join(''));

                    if (cachedSubjects.length > 0) {
                        $(`#${subjectSelectId}`).val(cachedSubjects[0].id).trigger('change');
                    }

                    if (onComplete) onComplete();
                });
            }

            // Syllabus Units & Topics Cascade Helpers
            function loadSubjectUnits(subjectId, targetSelectId, selectedUnitId, onComplete) {
                if (!subjectId) {
                    const isFilter = targetSelectId.indexOf('Filter') >= 0;
                    $(`#${targetSelectId}`).html(`<option value="">${isFilter ? 'All Units' : 'Select Unit / Module...'}</option>`);
                    if (onComplete) onComplete();
                    return;
                }
                $.ajax({
                    url: '@Url.Action("GetSubjectUnits", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { subjectId: subjectId },
                    success: function (units) {
                        const isFilter = targetSelectId.indexOf('Filter') >= 0;
                        const defLabel = isFilter ? 'All Units' : 'Select Unit / Module...';
                        const opts = [`<option value="">${defLabel}</option>`];
                        (units || []).forEach(u => {
                            const sel = (selectedUnitId && selectedUnitId == u.id) ? 'selected' : '';
                            opts.push(`<option value="${u.id}" ${sel}>${escapeHtml(u.name)}</option>`);
                        });
                        $(`#${targetSelectId}`).html(opts.join(''));
                        if (onComplete) onComplete();
                    }
                });
            }

            function loadUnitTopics(unitId, targetSelectId, selectedTopicId, onComplete) {
                if (!unitId) {
                    const isFilter = targetSelectId.indexOf('Filter') >= 0;
                    $(`#${targetSelectId}`).html(`<option value="">${isFilter ? 'All Topics' : 'Select Topic...'}</option>`);
                    if (onComplete) onComplete();
                    return;
                }
                $.ajax({
                    url: '@Url.Action("GetUnitTopics", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { unitId: unitId },
                    success: function (topics) {
                        const isFilter = targetSelectId.indexOf('Filter') >= 0;
                        const defLabel = isFilter ? 'All Topics' : 'Select Topic...';
                        const opts = [`<option value="">${defLabel}</option>`];
                        (topics || []).forEach(t => {
                            const sel = (selectedTopicId && selectedTopicId == t.id) ? 'selected' : '';
                            opts.push(`<option value="${t.id}" ${sel}>${escapeHtml(t.name)}</option>`);
                        });
                        $(`#${targetSelectId}`).html(opts.join(''));
                        if (onComplete) onComplete();
                    }
                });
            }

            // Dropdown change events
            $('#suggestedCourseSelect').on('change', function () {
                handleCourseChange($(this).val(), 'suggestedSemesterSelect', 'suggestedSubjectSelect');
            });

            $('#suggestedSubjectSelect').on('change', function () {
                loadSubjectUnits($(this).val(), 'suggestedUnitSelect', null, function () {
                    $('#suggestedTopicSelect').html('<option value="">All Unit Topics</option>');
                });
            });

            $('#suggestedUnitSelect').on('change', function () {
                loadUnitTopics($(this).val(), 'suggestedTopicSelect');
            });

            $('#paperCourseSelect').on('change', function () {
                handleCourseChange($(this).val(), 'paperSemesterSelect', 'paperSubjectSelect');
            });

            $('#modalCourseSelect').on('change', function () {
                handleCourseChange($(this).val(), 'modalSemesterSelect', 'modalSubjectSelect');
            });

            $('#modalSubjectSelect').on('change', function () {
                loadSubjectUnits($(this).val(), 'modalUnitSelect', null, function () {
                    $('#modalTopicSelect').html('<option value="">Select Topic...</option>');
                });
            });

            $('#modalUnitSelect').on('change', function () {
                loadUnitTopics($(this).val(), 'modalTopicSelect');
            });

            $('#bankCourseFilter').on('change', function () {
                const cId = $(this).val();
                if (cId) {
                    loadSubjects(null, cId).done(function () {
                        const subOpts = ['<option value="">All Subjects</option>'];
                        cachedSubjects.forEach(s => subOpts.push(`<option value="${s.id}">${s.name}</option>`));
                        $('#bankSubjectFilter').html(subOpts.join(''));
                        $('#bankUnitFilter').html('<option value="">All Units</option>');
                        $('#bankTopicFilter').html('<option value="">All Topics</option>');
                        loadBankQuestions(1);
                    });
                } else {
                    $('#bankSubjectFilter').html('<option value="">All Subjects</option>');
                    $('#bankUnitFilter').html('<option value="">All Units</option>');
                    $('#bankTopicFilter').html('<option value="">All Topics</option>');
                    loadBankQuestions(1);
                }
            });

            $('#bankSubjectFilter').on('change', function () {
                loadSubjectUnits($(this).val(), 'bankUnitFilter', null, function () {
                    $('#bankTopicFilter').html('<option value="">All Topics</option>');
                    loadBankQuestions(1);
                });
            });

            $('#bankUnitFilter').on('change', function () {
                loadUnitTopics($(this).val(), 'bankTopicFilter', null, function () {
                    loadBankQuestions(1);
                });
            });

            $('#bankTopicFilter, #bankOutcomeFilter').on('change', function () {
                loadBankQuestions(1);
            });

            $('#bankSemesterFilter').on('change', function () {
                loadBankQuestions(1);
            });

            // Quick button from Hero banner
            $('#btnHeroSuggested').on('click', function () {
                $('#tab-suggested-link').tab('show');
            });

            // =================================================================
            // 2. TAB 1: QUESTION BANK LOGIC & PAGINATION
            // =================================================================
            let currentBankPage = 1;
            const bankPageSize = 10;

            function loadBankQuestions(page) {
                currentBankPage = page || 1;
                const courseId = $('#bankCourseFilter').val();
                const semesterId = $('#bankSemesterFilter').val();
                const subjectId = $('#bankSubjectFilter').val();
                const unitId = $('#bankUnitFilter').val();
                const topicId = $('#bankTopicFilter').val();
                const outcome = $('#bankOutcomeFilter').val();
                const qType = $('#btnGroupQuestionType .active').data('type');
                const diff = $('#btnGroupDifficulty .active').data('diff');
                const search = $('#bankSearch').val();

                $('#bankTableBody').html(`
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                            Loading Question Bank...
                        </td>
                    </tr>
                `);

                $.ajax({
                    url: '@Url.Action("GetQuestions", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: {
                        courseId: courseId || null,
                        semesterId: semesterId || null,
                        subjectId: subjectId || null,
                        unitId: unitId || null,
                        topicId: topicId || null,
                        learningOutcome: outcome || null,
                        questionType: qType || null,
                        difficulty: diff || null,
                        search: search || null,
                        page: currentBankPage,
                        pageSize: bankPageSize
                    },
                    success: function (res) {
                        if (res.success) {
                            savedBankQuestions = res.questions || [];
                            renderBankTable(savedBankQuestions);
                            renderBankPagination(res.page || 1, res.totalPages || 1, res.totalCount || 0);
                            $('#heroTotalQuestions').text(res.totalCount || 0);
                            $('#badgeSavedCount').text(res.totalCount || 0);
                            $('#bankResultsSummary').text(`Showing ${savedBankQuestions.length} of ${res.totalCount || 0} saved question(s)`);
                        } else {
                            $('#bankTableBody').html(`<tr><td colspan="7" class="text-center text-danger py-4"><i class="fa-solid fa-triangle-exclamation me-1"></i> ${escapeHtml(res.message || 'Error loading questions.')}</td></tr>`);
                        }
                    },
                    error: function (xhr) {
                        const errMsg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Failed to connect to database.';
                        $('#bankTableBody').html(`<tr><td colspan="7" class="text-center text-danger py-4"><i class="fa-solid fa-triangle-exclamation me-1"></i> ${escapeHtml(errMsg)}</td></tr>`);
                    }
                });
            }

            function renderBankTable(questions) {
                if (!questions || questions.length === 0) {
                    $('#bankTableBody').html(`
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-database fa-3x mb-3 text-secondary opacity-50"></i>
                                <h6 class="fw-bold text-dark">No Questions Found</h6>
                                <p class="small text-muted mb-3">No saved questions match your active filters. Add questions manually or use Suggested Questions.</p>
                                <button type="button" class="btn btn-sm btn-primary px-3 rounded-pill" onclick="$('#btnAddManualQuestionModal').click()">
                                    <i class="fa-solid fa-plus me-1"></i> Add Question
                                </button>
                            </td>
                        </tr>
                    `);
                    return;
                }

                let html = '';
                questions.forEach(q => {
                    const diffBadge = q.difficultyLevel === 'Easy' ? 'badge-diff-easy' : q.difficultyLevel === 'Hard' ? 'badge-diff-hard' : 'badge-diff-medium';
                    const typeBadge = q.questionType === 'MCQ' ? 'badge-type-mcq' : q.questionType === 'Short Answer' ? 'badge-type-short' : 'badge-type-long';

                    let optionsHtml = '';
                    if (q.questionType === 'MCQ' && q.options && q.options.length > 0) {
                        optionsHtml = `
                            <div class="mt-2 pt-2 border-top">
                                <div class="row g-1">
                                    ${q.options.map((o, idx) => `
                                        <div class="col-md-6">
                                            <div class="mcq-option-pill py-1 px-2 ${o.isCorrect ? 'is-correct' : ''}" style="font-size: 0.8rem;">
                                                <span class="mcq-badge" style="width: 18px; height: 18px; font-size: 0.7rem;">${String.fromCharCode(65 + idx)}</span>
                                                <span class="text-truncate">${escapeHtml(o.optionText)}</span>
                                                ${o.isCorrect ? '<i class="fa-solid fa-check text-success ms-auto"></i>' : ''}
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `;
                    } else if (q.correctAnswer) {
                        optionsHtml = `
                            <div class="mt-2 pt-1 small text-muted">
                                <strong>Model Answer:</strong> <span class="text-dark">${escapeHtml(q.correctAnswer)}</span>
                            </div>
                        `;
                    }

                    let syllabusMetaHtml = '';
                    if (q.unitName) {
                        syllabusMetaHtml += `<div class="mt-1"><span class="badge bg-light text-primary border" style="font-size: 10.5px; font-weight:600;"><i class="fa-solid fa-book-open me-1"></i>${escapeHtml(q.unitName)}</span></div>`;
                    }
                    if (q.topicName) {
                        syllabusMetaHtml += `<div><span class="badge bg-light text-secondary border" style="font-size: 10px;"><i class="fa-solid fa-tag me-1"></i>${escapeHtml(q.topicName)}</span></div>`;
                    }

                    let outcomeHtml = '';
                    if (q.learningOutcome) {
                        outcomeHtml = `<span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 mt-1" style="font-size: 10.5px;"><i class="fa-solid fa-bullseye me-1"></i>${escapeHtml(q.learningOutcome)}</span>`;
                    }

                    html += `
                        <tr data-id="${q.id}">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input bank-item-checkbox" value="${q.id}" />
                            </td>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 0.92rem; line-height: 1.4;">${escapeHtml(q.questionText)}</div>
                                ${optionsHtml}
                                ${outcomeHtml}
                                ${q.explanation ? `<small class="text-muted d-block mt-1 fst-italic"><i class="fa-solid fa-info-circle me-1"></i>${escapeHtml(q.explanation)}</small>` : ''}
                            </td>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 0.82rem;">${escapeHtml(q.courseName || 'Course')}</div>
                                <small class="text-muted">${escapeHtml(q.subjectName || 'General Subject')}</small>
                                ${syllabusMetaHtml}
                            </td>
                            <td class="text-center">
                                <span class="badge ${typeBadge} px-2 py-1">${escapeHtml(q.questionType)}</span>
                            </td>
                            <td class="text-center">
                                <span class="badge ${diffBadge} px-2 py-1">${escapeHtml(q.difficultyLevel)}</span>
                            </td>
                            <td class="text-center fw-bold text-dark">
                                ${q.marks} M
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <button type="button" class="btn btn-outline-primary btn-action-pill btn-edit-question" data-id="${q.id}" title="Edit Question">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-action-pill btn-delete-question" data-id="${q.id}" title="Delete Question">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                $('#bankTableBody').html(html);
                updateBankSelectedCount();
            }

            function renderBankPagination(page, totalPages, totalCount) {
                if (!totalPages || totalPages <= 1) {
                    $('#bankPaginationContainer').addClass('d-none');
                    return;
                }
                $('#bankPaginationContainer').removeClass('d-none');
                $('#bankPaginationInfo').text(`Showing page ${page} of ${totalPages} (${totalCount} total questions)`);

                let html = '';
                html += `<li class="page-item ${page <= 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${page - 1}">&laquo; Prev</a>
                </li>`;

                const startPage = Math.max(1, page - 2);
                const endPage = Math.min(totalPages, page + 2);

                if (startPage > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`;
                    if (startPage > 2) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }

                for (let p = startPage; p <= endPage; p++) {
                    html += `<li class="page-item ${p === page ? 'active' : ''}">
                        <a class="page-link" href="#" data-page="${p}">${p}</a>
                    </li>`;
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                    html += `<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`;
                }

                html += `<li class="page-item ${page >= totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${page + 1}">Next &raquo;</a>
                </li>`;

                $('#bankPaginationList').html(html);
            }

            $(document).on('click', '#bankPaginationList .page-link', function (e) {
                e.preventDefault();
                const p = parseInt($(this).data('page'));
                if (p && p >= 1 && p !== currentBankPage) {
                    loadBankQuestions(p);
                }
            });

            // Filter button groups
            $('#btnGroupQuestionType button').on('click', function () {
                $('#btnGroupQuestionType button').removeClass('active');
                $(this).addClass('active');
                loadBankQuestions(1);
            });

            $('#btnGroupDifficulty button').on('click', function () {
                $('#btnGroupDifficulty button').removeClass('active');
                $(this).addClass('active');
                loadBankQuestions(1);
            });

            // Live Search
            let searchTimeout = null;
            $('#bankSearch').on('keyup', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () { loadBankQuestions(1); }, 350);
            });

            $('#btnResetBankFilters').on('click', function () {
                $('#bankSearch').val('');
                $('#bankCourseFilter').val('');
                $('#bankSemesterFilter').val('');
                $('#bankSubjectFilter').val('');
                $('#bankUnitFilter').html('<option value="">All Units</option>');
                $('#bankTopicFilter').html('<option value="">All Topics</option>');
                $('#bankOutcomeFilter').val('');
                $('#btnGroupQuestionType button').removeClass('active').filter('[data-type="All"]').addClass('active');
                $('#btnGroupDifficulty button').removeClass('active').filter('[data-diff="All"]').addClass('active');
                loadBankQuestions(1);
            });

            // Select All Checkbox in Bank
            $('#bankSelectAll').on('change', function () {
                $('.bank-item-checkbox').prop('checked', $(this).is(':checked'));
                updateBankSelectedCount();
            });

            $(document).on('change', '.bank-item-checkbox', function () {
                updateBankSelectedCount();
            });

            function updateBankSelectedCount() {
                const count = $('.bank-item-checkbox:checked').length;
                $('#bankSelectedCount').text(count);
                $('#btnCreatePaperWithSelected').prop('disabled', count === 0);
            }

            $('#btnCreatePaperWithSelected').on('click', function () {
                const selectedIds = [];
                $('.bank-item-checkbox:checked').each(function () {
                    const id = parseInt($(this).val());
                    if (id > 0) selectedIds.push(id);
                });

                if (selectedIds.length === 0) {
                    alert('Please select at least one question from the Question Bank.');
                    return;
                }

                // Switch to Question Papers tab
                $('#tab-paper-link').tab('show');

                let addedCount = 0;
                selectedIds.forEach(id => {
                    if (paperQuestions.some(p => p.questionBankId === id)) return;
                    const q = savedBankQuestions.find(x => x.id === id);
                    if (q) {
                        paperQuestions.push({
                            questionBankId: q.id,
                            sectionName: 'Section A',
                            sectionInstructions: '',
                            displayOrder: paperQuestions.length + 1,
                            marks: q.marks || 1,
                            questionText: q.questionText,
                            questionType: q.questionType,
                            difficultyLevel: q.difficultyLevel,
                            options: q.options || [],
                            correctAnswer: q.correctAnswer || '',
                            explanation: q.explanation || ''
                        });
                        addedCount++;
                    }
                });

                renderPaperQuestionsTable();
                updatePaperMarksSummary();

                if (addedCount > 0) {
                    alert(`Successfully added ${addedCount} question(s) to Question Paper Builder.`);
                } else {
                    alert('All selected questions are already included in the current Question Paper.');
                }
            });

            // Duplicate Check in Add / Edit Question Modal
            function checkModalDuplicate() {
                const text = $('#modalQuestionText').val().trim();
                const courseId = parseInt($('#modalCourseSelect').val()) || 0;
                const subjectId = parseInt($('#modalSubjectSelect').val()) || null;
                const excludeId = parseInt($('#editQuestionId').val()) || null;

                if (!text || text.length < 5) {
                    $('#modalDuplicateAlert').addClass('d-none').empty();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("CheckDuplicateQuestion", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({
                        questionText: text,
                        courseId: courseId,
                        subjectId: subjectId,
                        excludeQuestionId: excludeId
                    }),
                    success: function (res) {
                        const $alert = $('#modalDuplicateAlert').removeClass('d-none');
                        if (res.isDuplicate && res.duplicateType === 'Exact') {
                            $alert.html(`
                                <div class="alert alert-danger py-2 px-3 small mb-0 d-flex align-items-center">
                                    <i class="fa-solid fa-ban fs-5 me-2"></i>
                                    <div><strong>Exact Duplicate Detected:</strong> An identical question already exists in this course / subject (Question #${res.existingQuestionId}).</div>
                                </div>
                            `);
                        } else if (res.isDuplicate && res.duplicateType === 'Similar') {
                            $alert.html(`
                                <div class="alert alert-warning py-2 px-3 small mb-0 d-flex align-items-center">
                                    <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
                                    <div>
                                        <strong>High Similarity (${Math.round((res.similarityScore || 0) * 100)}% match):</strong>
                                        Matches existing Question #${res.existingQuestionId}: "${escapeHtml(res.existingQuestionText || '')}".
                                    </div>
                                </div>
                            `);
                        } else {
                            $alert.html(`
                                <div class="alert alert-success py-2 px-3 small mb-0 d-flex align-items-center">
                                    <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                                    <div><strong>Unique Question:</strong> Verified against the Question Bank repository.</div>
                                </div>
                            `);
                        }
                    }
                });
            }

            $('#btnCheckModalDuplicate').on('click', checkModalDuplicate);
            $('#modalQuestionText').on('blur', checkModalDuplicate);

            // Add Manual Question Modal
            $('#btnAddManualQuestionModal').on('click', function () {
                $('#editQuestionId').val('0');
                $('#questionModalTitle').html('<i class="fa-solid fa-circle-plus text-primary me-2"></i> Add Question to Bank');
                $('#modalQuestionText').val('');
                $('#modalMarks').val(1);
                $('#modalTypeSelect').val('MCQ').trigger('change');
                $('#modalDiffSelect').val('Medium');
                $('#modalOptA').val('');
                $('#modalOptB').val('');
                $('#modalOptC').val('');
                $('#modalOptD').val('');
                $('input[name="modalCorrectRadio"][value="0"]').prop('checked', true);
                $('#modalCorrectAnswer').val('');
                $('#modalExplanation').val('');
                $('#modalUnitSelect').html('<option value="">Select Unit / Module...</option>');
                $('#modalTopicSelect').html('<option value="">Select Topic...</option>');
                $('#modalLearningOutcome').val('');
                $('#modalDuplicateAlert').addClass('d-none').empty();

                if (cachedCourses.length > 0 && !$('#modalCourseSelect').val()) {
                    $('#modalCourseSelect').val(cachedCourses[0].id).trigger('change');
                }

                $('#questionModal').modal('show');
            });

            // Edit Question Modal
            $(document).on('click', '.btn-edit-question', function () {
                const id = $(this).data('id');
                const q = savedBankQuestions.find(x => x.id === id);
                if (!q) return;

                $('#editQuestionId').val(q.id);
                $('#questionModalTitle').html('<i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit Question');
                $('#modalCourseSelect').val(q.courseId);
                $('#modalDuplicateAlert').addClass('d-none').empty();
                $('#modalLearningOutcome').val(q.learningOutcome || '');

                handleCourseChange(q.courseId, 'modalSemesterSelect', 'modalSubjectSelect', function () {
                    if (q.semesterId) $('#modalSemesterSelect').val(q.semesterId);
                    if (q.subjectId) {
                        $('#modalSubjectSelect').val(q.subjectId);
                        loadSubjectUnits(q.subjectId, 'modalUnitSelect', q.unitId, function () {
                            if (q.unitId) {
                                loadUnitTopics(q.unitId, 'modalTopicSelect', q.topicId);
                            }
                        });
                    }
                });

                $('#modalTypeSelect').val(q.questionType).trigger('change');
                $('#modalDiffSelect').val(q.difficultyLevel);
                $('#modalMarks').val(q.marks);
                $('#modalQuestionText').val(q.questionText);
                $('#modalExplanation').val(q.explanation || '');
                $('#modalCorrectAnswer').val(q.correctAnswer || '');

                if (q.questionType === 'MCQ' && q.options) {
                    $('#modalOptA').val(q.options[0]?.optionText || '');
                    $('#modalOptB').val(q.options[1]?.optionText || '');
                    $('#modalOptC').val(q.options[2]?.optionText || '');
                    $('#modalOptD').val(q.options[3]?.optionText || '');

                    const correctIdx = q.options.findIndex(o => o.isCorrect);
                    $('input[name="modalCorrectRadio"]').prop('checked', false);
                    if (correctIdx >= 0) {
                        $(`input[name="modalCorrectRadio"][value="${correctIdx}"]`).prop('checked', true);
                    } else {
                        $('input[name="modalCorrectRadio"][value="0"]').prop('checked', true);
                    }
                }

                $('#questionModal').modal('show');
            });

            // Toggle MCQ vs Subjective inputs in Modal
            $('#modalTypeSelect').on('change', function () {
                const val = $(this).val();
                if (val === 'MCQ') {
                    $('#modalMcqContainer').removeClass('d-none');
                    $('#modalSubjectiveContainer').addClass('d-none');
                } else {
                    $('#modalMcqContainer').addClass('d-none');
                    $('#modalSubjectiveContainer').removeClass('d-none');
                }
            });

            // Save Question from Modal (Manual Create or Update)
            $('#btnSaveQuestionModal').on('click', function () {
                const id = parseInt($('#editQuestionId').val()) || 0;
                const courseId = parseInt($('#modalCourseSelect').val()) || 0;
                const semesterId = parseInt($('#modalSemesterSelect').val()) || null;
                const subjectId = parseInt($('#modalSubjectSelect').val()) || null;
                const unitId = parseInt($('#modalUnitSelect').val()) || null;
                const topicId = parseInt($('#modalTopicSelect').val()) || null;
                const outcome = $('#modalLearningOutcome').val().trim();
                const qType = $('#modalTypeSelect').val();
                const diff = $('#modalDiffSelect').val();
                const marks = parseFloat($('#modalMarks').val()) || 1;
                const text = $('#modalQuestionText').val().trim();
                const explanation = $('#modalExplanation').val().trim();

                if (!courseId) {
                    alert('Please select a Course.');
                    return;
                }
                if (!text) {
                    alert('Please enter question text.');
                    return;
                }

                const options = [];
                let correctAnswer = '';

                if (qType === 'MCQ') {
                    const optA = $('#modalOptA').val().trim();
                    const optB = $('#modalOptB').val().trim();
                    const optC = $('#modalOptC').val().trim();
                    const optD = $('#modalOptD').val().trim();

                    if (!optA || !optB || !optC || !optD) {
                        alert('Please fill out all 4 MCQ options (A, B, C, D).');
                        return;
                    }

                    const correctIndex = parseInt($('input[name="modalCorrectRadio"]:checked').val()) || 0;
                    const optTexts = [optA, optB, optC, optD];

                    optTexts.forEach((t, i) => {
                        options.push({
                            optionText: t,
                            isCorrect: (i === correctIndex)
                        });
                    });

                    correctAnswer = optTexts[correctIndex];
                } else {
                    correctAnswer = $('#modalCorrectAnswer').val().trim();
                }

                const payload = {
                    id: id,
                    courseId: courseId,
                    semesterId: semesterId,
                    subjectId: subjectId,
                    unitId: unitId,
                    topicId: topicId,
                    learningOutcome: outcome || null,
                    questionType: qType,
                    difficultyLevel: diff,
                    marks: marks,
                    questionText: text,
                    correctAnswer: correctAnswer,
                    explanation: explanation,
                    options: options
                };

                const url = id > 0
                    ? '@Url.Action("UpdateQuestion", "Quiz", new { area = "Admin" })'
                    : '@Url.Action("CreateQuestion", "Quiz", new { area = "Admin" })';

                const $btn = $(this).prop('disabled', true);

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $btn.prop('disabled', false);
                        if (res.success) {
                            $('#questionModal').modal('hide');
                            alert(res.message);
                            loadBankQuestions(currentBankPage);
                        } else {
                            alert(res.message || 'Error saving question.');
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        alert('Server error occurred while saving question.');
                    }
                });
            });

            // Delete Question
            $(document).on('click', '.btn-delete-question', function () {
                const id = $(this).data('id');
                if (!confirm('Are you sure you want to delete this question from the Question Bank?')) return;

                $.ajax({
                    url: '@Url.Action("DeleteQuestion", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({ id: id }),
                    success: function (res) {
                        if (res.success) {
                            loadBankQuestions(currentBankPage);
                        } else {
                            alert(res.message || 'Error deleting question.');
                        }
                    },
                    error: function () {
                        alert('Server error occurred while deleting question.');
                    }
                });
            });

            // Question Bank Intelligence & Analytics Modal
            $('#btnQuestionBankAnalytics').on('click', function () {
                const courseId = $('#bankCourseFilter').val();
                const subjectId = $('#bankSubjectFilter').val();

                $('#modalAnalytics').modal('show');
                $('#analyticsLoading').removeClass('d-none');
                $('#analyticsContent').addClass('d-none');

                $.ajax({
                    url: '@Url.Action("GetQuestionBankAnalytics", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: {
                        courseId: courseId || null,
                        subjectId: subjectId || null
                    },
                    success: function (res) {
                        $('#analyticsLoading').addClass('d-none');
                        if (res.success && res.analytics) {
                            renderAnalyticsModal(res.analytics);
                            $('#analyticsContent').removeClass('d-none');
                        } else {
                            alert(res.message || 'Unable to load analytics.');
                        }
                    },
                    error: function () {
                        $('#analyticsLoading').addClass('d-none');
                        alert('Server error occurred while loading analytics.');
                    }
                });
            });

            function renderAnalyticsModal(data) {
                $('#analyticsTotalQuestions').text(data.totalQuestions || 0);

                const types = data.questionsByType || {};
                $('#analyticsMcqCount').text(types['MCQ'] || 0);
                $('#analyticsShortCount').text(types['Short Answer'] || 0);
                $('#analyticsLongCount').text(types['Long Answer'] || 0);

                // Difficulty Distribution
                const diff = data.questionsByDifficulty || {};
                const total = data.totalQuestions || 1;
                const easy = diff['Easy'] || 0;
                const medium = diff['Medium'] || 0;
                const hard = diff['Hard'] || 0;

                const easyPct = Math.round((easy / total) * 100);
                const medPct = Math.round((medium / total) * 100);
                const hardPct = Math.round((hard / total) * 100);

                $('#analyticsDifficultyBars').html(`
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span><span class="badge bg-success me-1">Easy</span> (${easy} questions)</span>
                            <span>${easyPct}%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" style="width: ${easyPct}%;"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span><span class="badge bg-warning text-dark me-1">Medium</span> (${medium} questions)</span>
                            <span>${medPct}%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-warning" style="width: ${medPct}%;"></div>
                        </div>
                    </div>
                    <div class="mb-1">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span><span class="badge bg-danger me-1">Hard</span> (${hard} questions)</span>
                            <span>${hardPct}%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-danger" style="width: ${hardPct}%;"></div>
                        </div>
                    </div>
                `);

                // Outcomes
                const outcomes = data.questionsByLearningOutcome || {};
                let outcomeRows = '';
                Object.keys(outcomes).forEach(k => {
                    const c = outcomes[k];
                    const pct = Math.round((c / total) * 100);
                    outcomeRows += `<tr><td><strong>${escapeHtml(k)}</strong></td><td class="text-end fw-bold">${c}</td><td class="text-end text-muted small">${pct}%</td></tr>`;
                });
                $('#analyticsOutcomeTable tbody').html(outcomeRows || '<tr><td colspan="3" class="text-center text-muted py-2">No learning outcome tags assigned.</td></tr>');

                // Units
                const units = data.questionsByUnit || {};
                let unitRows = '';
                Object.keys(units).forEach(k => {
                    const c = units[k];
                    const pct = Math.round((c / total) * 100);
                    unitRows += `<tr><td><strong>${escapeHtml(k)}</strong></td><td class="text-end fw-bold">${c}</td><td class="text-end text-muted small">${pct}%</td></tr>`;
                });
                $('#analyticsUnitTable tbody').html(unitRows || '<tr><td colspan="3" class="text-center text-muted py-2">No unit mappings found.</td></tr>');

                // Subjects
                const subs = data.questionsBySubject || {};
                let subRows = '';
                Object.keys(subs).forEach(k => {
                    const c = subs[k];
                    const pct = Math.round((c / total) * 100);
                    subRows += `<tr><td><strong>${escapeHtml(k)}</strong></td><td class="text-end fw-bold">${c}</td><td class="text-end text-muted small">${pct}%</td></tr>`;
                });
                $('#analyticsSubjectTable tbody').html(subRows || '<tr><td colspan="3" class="text-center text-muted py-2">No questions loaded.</td></tr>');
            }

            // Create Paper with Selected Bank Questions
            $('#btnCreatePaperWithSelected').on('click', function () {
                const selectedIds = [];
                $('.bank-item-checkbox:checked').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) {
                    alert('Please select at least one question from the list.');
                    return;
                }

                // Append to paperQuestions
                selectedIds.forEach(id => {
                    const q = savedBankQuestions.find(x => x.id === id);
                    if (q && !paperQuestions.some(p => p.questionBankId === q.id)) {
                        paperQuestions.push({
                            questionBankId: q.id,
                            displayOrder: paperQuestions.length + 1,
                            marks: q.marks,
                            questionText: q.questionText,
                            questionType: q.questionType,
                            difficultyLevel: q.difficultyLevel,
                            options: q.options || [],
                            correctAnswer: q.correctAnswer,
                            explanation: q.explanation
                        });
                    }
                });

                renderPaperQuestions();
                $('#tab-paper-link').tab('show');
            });

            // =================================================================
            // 3. TAB 2: SUGGESTED QUESTIONS LOGIC
            // =================================================================
            $('#btnGetSuggested').on('click', function () {
                const courseId = parseInt($('#suggestedCourseSelect').val()) || 0;
                const semesterId = parseInt($('#suggestedSemesterSelect').val()) || null;
                const subjectId = parseInt($('#suggestedSubjectSelect').val()) || 0;
                const unitId = parseInt($('#suggestedUnitSelect').val()) || null;
                const topicId = parseInt($('#suggestedTopicSelect').val()) || null;
                const outcome = $('#suggestedOutcome').val().trim();
                const qType = $('#suggestedTypeSelect').val();
                const diff = $('#suggestedDiffSelect').val();
                const count = parseInt($('#suggestedCount').val()) || 5;
                const marks = parseFloat($('#suggestedMarks').val()) || 1;
                const topic = $('#suggestedTopic').val().trim();

                if (!courseId) {
                    alert('Please select a Course.');
                    return;
                }
                if (!subjectId) {
                    alert('Please select a Subject.');
                    return;
                }

                const payload = {
                    courseId: courseId,
                    semesterId: semesterId,
                    subjectId: subjectId,
                    unitId: unitId,
                    topicId: topicId,
                    learningOutcome: outcome || null,
                    questionType: qType,
                    difficultyLevel: diff,
                    questionCount: count,
                    marksPerQuestion: marks,
                    topicContext: topic || null
                };

                $('#suggestedTopicRequiredAlert').addClass('d-none');
                $('#suggestedEmptyState').addClass('d-none');
                $('#suggestedResultsContainer').addClass('d-none');
                $('#suggestedLoadingOverlay').show();
                $('#btnGetSuggested').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("GenerateSuggestedQuestions", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $('#suggestedLoadingOverlay').hide();
                        $('#btnGetSuggested').prop('disabled', false);

                        if (res.success && res.questions && res.questions.length > 0) {
                            currentSuggestedQuestions = res.questions;
                            renderSuggestedCards(currentSuggestedQuestions);
                        } else if (res.requiresTopic) {
                            $('#suggestedTopicRequiredText').text(res.message);
                            $('#suggestedTopicRequiredAlert').removeClass('d-none');
                            $('#suggestedEmptyState').removeClass('d-none');
                            $('#suggestedTopic').focus();
                        } else {
                            alert(res.message || 'Unable to generate questions.');
                            $('#suggestedEmptyState').removeClass('d-none');
                        }
                    },
                    error: function () {
                        $('#suggestedLoadingOverlay').hide();
                        $('#btnGetSuggested').prop('disabled', false);
                        alert('An error occurred during question generation. Please check your connection.');
                        $('#suggestedEmptyState').removeClass('d-none');
                    }
                });
            });

            function renderSuggestedCards(questions) {
                if (!questions || questions.length === 0) {
                    $('#suggestedResultsContainer').addClass('d-none');
                    $('#suggestedEmptyState').removeClass('d-none');
                    return;
                }

                $('#suggestedCountDisplay').text(questions.length);
                let html = '';

                questions.forEach((q, idx) => {
                    const diffBadge = q.difficultyLevel === 'Easy' ? 'badge-diff-easy' : q.difficultyLevel === 'Hard' ? 'badge-diff-hard' : 'badge-diff-medium';
                    const typeBadge = q.questionType === 'MCQ' ? 'badge-type-mcq' : q.questionType === 'Short Answer' ? 'badge-type-short' : 'badge-type-long';

                    let optionsHtml = '';
                    if (q.questionType === 'MCQ' && q.options && q.options.length > 0) {
                        optionsHtml = `
                            <div class="row g-2 mt-2">
                                ${q.options.map((opt, oIdx) => {
                                    const isCorrect = (opt === q.correctAnswer || opt.trim().toLowerCase() === (q.correctAnswer || '').trim().toLowerCase());
                                    return `
                                        <div class="col-md-6">
                                            <div class="mcq-option-pill ${isCorrect ? 'is-correct' : ''}">
                                                <span class="mcq-badge">${String.fromCharCode(65 + oIdx)}</span>
                                                <span>${escapeHtml(opt)}</span>
                                                ${isCorrect ? '<span class="badge bg-success ms-auto"><i class="fa-solid fa-check me-1"></i>Correct Answer</span>' : ''}
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        `;
                    } else if (q.correctAnswer) {
                        optionsHtml = `
                            <div class="p-3 rounded-3 mt-2" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="small fw-bold text-primary mb-1"><i class="fa-solid fa-key me-1"></i>Model Answer &amp; Key Rubric Points:</div>
                                <div class="small text-dark">${escapeHtml(q.correctAnswer)}</div>
                            </div>
                        `;
                    }

                    let tagsHtml = '';
                    const unitName = q.unitName || $('#suggestedUnitSelect option:selected').text();
                    const hasUnit = unitName && unitName !== 'All Units / General Syllabus' && unitName !== 'Select Unit...';
                    if (hasUnit) {
                        tagsHtml += `<span class="badge bg-light text-primary border me-1" style="font-size: 10.5px;"><i class="fa-solid fa-book-open me-1"></i>${escapeHtml(unitName)}</span>`;
                    }
                    if (q.topicName) {
                        tagsHtml += `<span class="badge bg-light text-secondary border me-1" style="font-size: 10px;"><i class="fa-solid fa-tag me-1"></i>${escapeHtml(q.topicName)}</span>`;
                    }
                    const outcomeText = q.learningOutcome || $('#suggestedOutcome').val().trim();
                    if (outcomeText) {
                        tagsHtml += `<span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 me-1" style="font-size: 10.5px;"><i class="fa-solid fa-bullseye me-1"></i>${escapeHtml(outcomeText)}</span>`;
                    }
                    tagsHtml += `<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 10.5px;"><i class="fa-solid fa-shield-check me-1"></i>Verified Unique</span>`;

                    html += `
                        <div class="question-card ${q.isAccepted ? 'is-saved' : ''}" data-tempid="${q.tempId}" id="suggestedCard_${q.tempId}">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <input type="checkbox" class="form-check-input suggested-checkbox" data-tempid="${q.tempId}" ${q.isAccepted ? 'disabled' : 'checked'} />
                                    <strong class="text-dark">Question #${idx + 1}</strong>
                                    <span class="badge ${typeBadge}">${escapeHtml(q.questionType)}</span>
                                    <span class="badge ${diffBadge}">${escapeHtml(q.difficultyLevel)}</span>
                                    <span class="badge bg-light text-dark border">${q.marks} Mark${q.marks > 1 ? 's' : ''}</span>
                                    ${tagsHtml}
                                </div>
                                <div class="d-flex gap-1">
                                    ${q.isAccepted ? `
                                        <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-check-circle me-1"></i> Saved to Bank</span>
                                    ` : `
                                        <button type="button" class="btn btn-sm btn-outline-success btn-accept-single" data-tempid="${q.tempId}">
                                            <i class="fa-solid fa-check me-1"></i> Accept &amp; Save
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit-suggested" data-tempid="${q.tempId}">
                                            <i class="fa-solid fa-pen me-1"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning btn-regen-single" data-tempid="${q.tempId}">
                                            <i class="fa-solid fa-rotate me-1"></i> Regenerate
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-reject-single" data-tempid="${q.tempId}">
                                            <i class="fa-solid fa-xmark me-1"></i> Reject
                                        </button>
                                    `}
                                </div>
                            </div>

                            <div class="fw-semibold text-dark mb-1" style="font-size: 0.96rem; line-height: 1.45;">
                                ${escapeHtml(q.questionText)}
                            </div>

                            ${optionsHtml}

                            ${q.explanation ? `
                                <div class="mt-2 small text-muted fst-italic">
                                    <i class="fa-solid fa-circle-info text-info me-1"></i>${escapeHtml(q.explanation)}
                                </div>
                            ` : ''}
                        </div>
                    `;
                });

                $('#suggestedCardsList').html(html);
                $('#suggestedResultsContainer').removeClass('d-none');
            }

            // Select All Suggestions
            $('#btnSelectAllSuggested').on('click', function () {
                const areAllChecked = $('.suggested-checkbox:not(:disabled):checked').length === $('.suggested-checkbox:not(:disabled)').length;
                $('.suggested-checkbox:not(:disabled)').prop('checked', !areAllChecked);
            });

            // Accept & Save Single Suggested Question
            $(document).on('click', '.btn-accept-single', function () {
                const tempId = $(this).data('tempid');
                const q = currentSuggestedQuestions.find(x => x.tempId === tempId);
                if (!q) return;

                saveSuggestedQuestionsBatch([q], function () {
                    q.isAccepted = true;
                    renderSuggestedCards(currentSuggestedQuestions);
                    loadBankQuestions(1);
                });
            });

            // Save Selected Suggested Questions
            $('#btnSaveSelectedSuggestions').on('click', function () {
                const selectedTempIds = [];
                $('.suggested-checkbox:checked').each(function () {
                    selectedTempIds.push($(this).data('tempid'));
                });

                if (selectedTempIds.length === 0) {
                    alert('Please select at least one suggested question to save.');
                    return;
                }

                const selected = currentSuggestedQuestions.filter(x => selectedTempIds.includes(x.tempId));
                saveSuggestedQuestionsBatch(selected, function () {
                    selected.forEach(x => x.isAccepted = true);
                    renderSuggestedCards(currentSuggestedQuestions);
                    loadBankQuestions(1);
                });
            });

            function saveSuggestedQuestionsBatch(questionsList, onSuccess) {
                const courseId = parseInt($('#suggestedCourseSelect').val()) || 0;
                const semesterId = parseInt($('#suggestedSemesterSelect').val()) || null;
                const subjectId = parseInt($('#suggestedSubjectSelect').val()) || 0;
                const unitId = parseInt($('#suggestedUnitSelect').val()) || null;
                const topicId = parseInt($('#suggestedTopicSelect').val()) || null;
                const outcome = $('#suggestedOutcome').val().trim() || null;

                questionsList.forEach(q => {
                    if (!q.unitId && unitId) q.unitId = unitId;
                    if (!q.topicId && topicId) q.topicId = topicId;
                    if (!q.learningOutcome && outcome) q.learningOutcome = outcome;
                });

                const payload = {
                    courseId: courseId,
                    semesterId: semesterId,
                    subjectId: subjectId,
                    unitId: unitId,
                    topicId: topicId,
                    learningOutcome: outcome,
                    questions: questionsList
                };

                $.ajax({
                    url: '@Url.Action("SaveSuggestedQuestions", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            if (onSuccess) onSuccess(res);
                        } else {
                            alert(res.message || 'Error saving questions to Question Bank.');
                        }
                    },
                    error: function () {
                        alert('Server error occurred while saving questions.');
                    }
                });
            }

            // Reject Single Question Card
            $(document).on('click', '.btn-reject-single', function () {
                const tempId = $(this).data('tempid');
                $(`#suggestedCard_${tempId}`).fadeOut(300, function () {
                    currentSuggestedQuestions = currentSuggestedQuestions.filter(x => x.tempId !== tempId);
                    renderSuggestedCards(currentSuggestedQuestions);
                });
            });

            // Regenerate Single Question Card
            $(document).on('click', '.btn-regen-single', function () {
                const tempId = $(this).data('tempid');
                const q = currentSuggestedQuestions.find(x => x.tempId === tempId);
                if (!q) return;

                const $card = $(`#suggestedCard_${tempId}`);
                $card.css('opacity', '0.5');

                const courseId = parseInt($('#suggestedCourseSelect').val()) || 0;
                const semesterId = parseInt($('#suggestedSemesterSelect').val()) || null;
                const subjectId = parseInt($('#suggestedSubjectSelect').val()) || 0;
                const topic = $('#suggestedTopic').val().trim();

                const payload = {
                    question: q,
                    context: {
                        courseId: courseId,
                        semesterId: semesterId,
                        subjectId: subjectId,
                        questionType: q.questionType,
                        difficultyLevel: q.difficultyLevel,
                        questionCount: 1,
                        marksPerQuestion: q.marks,
                        topicContext: topic || null
                    }
                };

                $.ajax({
                    url: '@Url.Action("RegenerateQuestion", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $card.css('opacity', '1');
                        if (res.success && res.question) {
                            const idx = currentSuggestedQuestions.findIndex(x => x.tempId === tempId);
                            if (idx >= 0) {
                                currentSuggestedQuestions[idx] = res.question;
                                renderSuggestedCards(currentSuggestedQuestions);
                            }
                        } else {
                            alert(res.message || 'Failed to regenerate question.');
                        }
                    },
                    error: function () {
                        $card.css('opacity', '1');
                        alert('Server error during regeneration.');
                    }
                });
            });

            // Edit Suggested Question inline via Modal
            $(document).on('click', '.btn-edit-suggested', function () {
                const tempId = $(this).data('tempid');
                const q = currentSuggestedQuestions.find(x => x.tempId === tempId);
                if (!q) return;

                // Load into modal with a flag that it's a suggestion
                $('#editQuestionId').val('0'); // Will save to bank
                $('#modalCourseSelect').val($('#suggestedCourseSelect').val());
                $('#modalSemesterSelect').val($('#suggestedSemesterSelect').val());
                $('#modalSubjectSelect').val($('#suggestedSubjectSelect').val());
                $('#modalTypeSelect').val(q.questionType).trigger('change');
                $('#modalDiffSelect').val(q.difficultyLevel);
                $('#modalMarks').val(q.marks);
                $('#modalQuestionText').val(q.questionText);
                $('#modalExplanation').val(q.explanation || '');
                $('#modalCorrectAnswer').val(q.correctAnswer || '');

                if (q.questionType === 'MCQ' && q.options) {
                    $('#modalOptA').val(q.options[0] || '');
                    $('#modalOptB').val(q.options[1] || '');
                    $('#modalOptC').val(q.options[2] || '');
                    $('#modalOptD').val(q.options[3] || '');

                    const correctIdx = q.options.findIndex(o => o === q.correctAnswer);
                    $('input[name="modalCorrectRadio"]').prop('checked', false);
                    if (correctIdx >= 0) {
                        $(`input[name="modalCorrectRadio"][value="${correctIdx}"]`).prop('checked', true);
                    } else {
                        $('input[name="modalCorrectRadio"][value="0"]').prop('checked', true);
                    }
                }

                $('#questionModal').modal('show');
            });

            // Add Suggested Questions Directly to Question Paper
            $('#btnSendSuggestionsToPaper').on('click', function () {
                const selected = [];
                $('.suggested-checkbox:checked').each(function () {
                    const tempId = $(this).data('tempid');
                    const q = currentSuggestedQuestions.find(x => x.tempId === tempId);
                    if (q) selected.push(q);
                });

                if (selected.length === 0) {
                    alert('Please select at least one question to add to the paper.');
                    return;
                }

                // First save selected to Question Bank so they have permanent QuestionBankIds
                saveSuggestedQuestionsBatch(selected, function (res) {
                    selected.forEach(x => x.isAccepted = true);
                    renderSuggestedCards(currentSuggestedQuestions);

                    // Re-query latest saved questions for this course & subject
                    loadBankQuestions();

                    // Load saved IDs into paper questions
                    const savedIds = res.savedIds || [];
                    if (savedIds.length > 0) {
                        $.ajax({
                            url: '@Url.Action("GetQuestions", "Quiz", new { area = "Admin" })',
                            type: 'GET',
                            data: { courseId: $('#suggestedCourseSelect').val() },
                            success: function (qRes) {
                                if (qRes.success && qRes.questions) {
                                    savedIds.forEach(sId => {
                                        const bQ = qRes.questions.find(x => x.id === sId);
                                        if (bQ && !paperQuestions.some(p => p.questionBankId === bQ.id)) {
                                            paperQuestions.push({
                                                questionBankId: bQ.id,
                                                displayOrder: paperQuestions.length + 1,
                                                marks: bQ.marks,
                                                questionText: bQ.questionText,
                                                questionType: bQ.questionType,
                                                difficultyLevel: bQ.difficultyLevel,
                                                options: bQ.options || [],
                                                correctAnswer: bQ.correctAnswer,
                                                explanation: bQ.explanation
                                            });
                                        }
                                    });

                                    renderPaperQuestions();
                                    $('#tab-paper-link').tab('show');
                                }
                            }
                        });
                    }
                });
            });

            // =================================================================
            // 4. TAB 3: CREATE QUESTION PAPER LOGIC
            // =================================================================
            function loadSavedPapers() {
                const courseId = $('#paperCourseSelect').val();
                $.ajax({
                    url: '@Url.Action("GetQuestionPapers", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { courseId: courseId || null },
                    success: function (res) {
                        if (res.success) {
                            renderPapersTable(res.papers || []);
                            $('#heroTotalPapers').text(res.papers ? res.papers.length : 0);
                            $('#badgePaperCount').text(res.papers ? res.papers.length : 0);
                        }
                    }
                });
            }

            function renderPapersTable(papers) {
                if (!papers || papers.length === 0) {
                    $('#papersTableBody').html('<tr><td colspan="5" class="text-center text-muted py-3">No question papers created yet.</td></tr>');
                    return;
                }

                let html = '';
                papers.forEach(p => {
                    const isPublished = (p.status === 'Published');
                    html += `
                        <tr>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 140px;">${escapeHtml(p.title)}</div>
                                <small class="text-muted">${p.assessmentType}</small>
                            </td>
                            <td>
                                <div class="small text-truncate" style="max-width: 120px;">${escapeHtml(p.courseName)}</div>
                            </td>
                            <td class="text-center fw-bold text-dark">${p.totalMarks} M</td>
                            <td class="text-center">
                                <span class="badge ${isPublished ? 'bg-success' : 'bg-secondary'}">${p.status}</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary btn-preview-paper" data-id="${p.id}" title="Preview Paper">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-reopen-paper" data-id="${p.id}" title="Edit / Reopen">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </button>
                                    ${!isPublished && p.canPublish ? `
                                        <button type="button" class="btn btn-outline-success btn-publish-paper" data-id="${p.id}" title="Publish Paper">
                                            <i class="fa-solid fa-bullhorn"></i>
                                        </button>
                                    ` : ''}
                                    <a href="/Admin/Quiz/ExportQuestionPaperPdf?id=${p.id}" target="_blank" class="btn btn-outline-dark" title="Print Hardcopy / PDF">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-delete-paper" data-id="${p.id}" title="Delete Paper">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                $('#papersTableBody').html(html);
            }

            $('#btnRefreshPapers').on('click', loadSavedPapers);

            // Paper Question List Rendering
            function renderPaperQuestions() {
                if (paperQuestions.length === 0) {
                    $('#paperQuestionsList').html(`
                        <div class="text-center py-5 text-muted" id="paperQuestionsEmpty">
                            <i class="fa-solid fa-clipboard-list fa-3x mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold text-dark">No Questions Added Yet</h6>
                            <p class="small text-muted mb-3">Add questions from the Question Bank or import freshly suggested questions.</p>
                        </div>
                    `);
                    $('#paperQuestionsCount').text(0);
                    updatePaperMarksGauge();
                    return;
                }

                $('#paperQuestionsCount').text(paperQuestions.length);
                let html = '';

                paperQuestions.forEach((q, idx) => {
                    q.displayOrder = idx + 1;
                    const typeBadge = q.questionType === 'MCQ' ? 'badge-type-mcq' : 'badge-type-short';

                    html += `
                        <div class="p-3 mb-2 rounded-3" style="background: #ffffff; border: 1px solid #e2e8f0;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-dark text-white rounded-circle p-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">${q.displayOrder}</span>
                                    <span class="badge ${typeBadge}">${q.questionType}</span>
                                    <span class="badge bg-light text-muted border">${q.difficultyLevel}</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group input-group-sm" style="width: 120px;">
                                        <span class="input-group-text">Marks</span>
                                        <input type="number" class="form-control paper-q-marks" data-index="${idx}" value="${q.marks}" min="0.5" max="100" step="0.5" />
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary btn-paper-move-up" data-index="${idx}" ${idx === 0 ? 'disabled' : ''}>
                                            <i class="fa-solid fa-arrow-up"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-paper-move-down" data-index="${idx}" ${idx === paperQuestions.length - 1 ? 'disabled' : ''}>
                                            <i class="fa-solid fa-arrow-down"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-paper-remove-q" data-index="${idx}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="small fw-semibold text-dark" style="line-height: 1.4;">
                                ${escapeHtml(q.questionText)}
                            </div>
                        </div>
                    `;
                });

                $('#paperQuestionsList').html(html);
                updatePaperMarksGauge();
            }

            // Real-time Marks Calculation & Gauge
            function updatePaperMarksGauge() {
                const targetMarks = parseFloat($('#paperTotalMarks').val()) || 0;
                let assignedMarks = 0;

                paperQuestions.forEach(q => {
                    assignedMarks += parseFloat(q.marks) || 0;
                });

                $('#displayTargetMarks').text(targetMarks);
                $('#displayAssignedMarks').text(assignedMarks);

                const diff = targetMarks - assignedMarks;
                const $alert = $('#paperMarksStatusAlert');

                if (paperQuestions.length === 0) {
                    $alert.removeClass('text-success text-warning').addClass('text-danger')
                        .html('<i class="fa-solid fa-circle-exclamation me-1"></i> Add questions to build the paper.');
                    $('#btnPublishPaper').prop('disabled', true);
                } else if (Math.abs(diff) < 0.01) {
                    $alert.removeClass('text-danger text-warning').addClass('text-success')
                        .html('<i class="fa-solid fa-circle-check me-1"></i> Marks match! Ready to save or publish.');
                    $('#btnPublishPaper').prop('disabled', false);
                } else if (diff > 0) {
                    $alert.removeClass('text-success text-danger').addClass('text-warning')
                        .html(`<i class="fa-solid fa-triangle-exclamation me-1"></i> Question marks (${assignedMarks}) &lt; Target (${targetMarks}). Need ${diff.toFixed(1)} more marks.`);
                    $('#btnPublishPaper').prop('disabled', true);
                } else {
                    $alert.removeClass('text-success text-warning').addClass('text-danger')
                        .html(`<i class="fa-solid fa-circle-exclamation me-1"></i> Question marks (${assignedMarks}) &gt; Target (${targetMarks}). Exceeds by ${Math.abs(diff).toFixed(1)} marks.`);
                    $('#btnPublishPaper').prop('disabled', true);
                }
            }

            $('#paperTotalMarks').on('input change', updatePaperMarksGauge);

            // Change individual question marks
            $(document).on('input change', '.paper-q-marks', function () {
                const idx = $(this).data('index');
                const val = parseFloat($(this).val()) || 0;
                if (paperQuestions[idx]) {
                    paperQuestions[idx].marks = val;
                    updatePaperMarksGauge();
                }
            });

            // Move Question Up
            $(document).on('click', '.btn-paper-move-up', function () {
                const idx = $(this).data('index');
                if (idx > 0) {
                    const temp = paperQuestions[idx];
                    paperQuestions[idx] = paperQuestions[idx - 1];
                    paperQuestions[idx - 1] = temp;
                    renderPaperQuestions();
                }
            });

            // Move Question Down
            $(document).on('click', '.btn-paper-move-down', function () {
                const idx = $(this).data('index');
                if (idx < paperQuestions.length - 1) {
                    const temp = paperQuestions[idx];
                    paperQuestions[idx] = paperQuestions[idx + 1];
                    paperQuestions[idx + 1] = temp;
                    renderPaperQuestions();
                }
            });

            // Remove Question from Paper
            $(document).on('click', '.btn-paper-remove-q', function () {
                const idx = $(this).data('index');
                paperQuestions.splice(idx, 1);
                renderPaperQuestions();
            });

            // Clear All Paper Questions
            $('#btnClearPaperQuestions').on('click', function () {
                if (confirm('Clear all questions from this paper?')) {
                    paperQuestions = [];
                    renderPaperQuestions();
                }
            });

            // New Paper Button
            $('#btnNewPaper').on('click', function () {
                $('#paperId').val('0');
                $('#paperTitle').val('');
                $('#paperTotalMarks').val('20');
                $('#paperAssessmentType').val('Internal Assessment');
                paperQuestions = [];
                renderPaperQuestions();
            });

            // Open Bank Picker Modal
            $('#btnOpenBankPicker').on('click', function () {
                const courseId = $('#paperCourseSelect').val();
                if (!courseId) {
                    alert('Please select a Course first.');
                    return;
                }

                $('#pickerTableBody').html('<tr><td colspan="5" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading questions...</td></tr>');
                $('#bankPickerModal').modal('show');

                $.ajax({
                    url: '@Url.Action("GetQuestions", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { courseId: courseId },
                    success: function (res) {
                        if (res.success && res.questions) {
                            renderPickerTable(res.questions);
                        } else {
                            $('#pickerTableBody').html('<tr><td colspan="5" class="text-center text-muted py-4">No questions found for this course.</td></tr>');
                        }
                    }
                });
            });

            function renderPickerTable(questions) {
                if (!questions || questions.length === 0) {
                    $('#pickerTableBody').html('<tr><td colspan="5" class="text-center text-muted py-4">No saved questions found in Question Bank.</td></tr>');
                    $('#pickerSummary').text('0 questions available');
                    return;
                }

                $('#pickerSummary').text(`${questions.length} question(s) available`);
                let html = '';

                questions.forEach(q => {
                    const isAlreadyAdded = paperQuestions.some(p => p.questionBankId === q.id);
                    html += `
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input picker-item-checkbox" value="${q.id}" ${isAlreadyAdded ? 'disabled checked' : ''} />
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small" style="line-height: 1.4;">${escapeHtml(q.questionText)}</div>
                                <small class="text-muted">${q.subjectName || ''}</small>
                            </td>
                            <td class="text-center"><span class="badge bg-light text-dark border">${q.questionType}</span></td>
                            <td class="text-center"><span class="badge bg-light text-muted border">${q.difficultyLevel}</span></td>
                            <td class="text-center fw-bold text-dark">${q.marks} M</td>
                        </tr>
                    `;
                });

                $('#pickerTableBody').html(html);
            }

            $('#pickerSelectAll').on('change', function () {
                $('.picker-item-checkbox:not(:disabled)').prop('checked', $(this).is(':checked'));
            });

            // Confirm Picker Selection
            $('#btnConfirmPickerSelection').on('click', function () {
                const selectedIds = [];
                $('.picker-item-checkbox:checked:not(:disabled)').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) {
                    $('#bankPickerModal').modal('hide');
                    return;
                }

                // Fetch details of selected
                selectedIds.forEach(id => {
                    const q = savedBankQuestions.find(x => x.id === id);
                    if (q && !paperQuestions.some(p => p.questionBankId === q.id)) {
                        paperQuestions.push({
                            questionBankId: q.id,
                            displayOrder: paperQuestions.length + 1,
                            marks: q.marks,
                            questionText: q.questionText,
                            questionType: q.questionType,
                            difficultyLevel: q.difficultyLevel,
                            options: q.options || [],
                            correctAnswer: q.correctAnswer,
                            explanation: q.explanation
                        });
                    }
                });

                renderPaperQuestions();
                $('#bankPickerModal').modal('hide');
            });

            // Save Paper (Draft or Publish)
            function savePaper(isPublish) {
                const paperId = parseInt($('#paperId').val()) || 0;
                const courseId = parseInt($('#paperCourseSelect').val()) || 0;
                const semesterId = parseInt($('#paperSemesterSelect').val()) || null;
                const subjectId = parseInt($('#paperSubjectSelect').val()) || null;
                const title = $('#paperTitle').val().trim();
                const assessType = $('#paperAssessmentType').val();
                const totalMarks = parseFloat($('#paperTotalMarks').val()) || 0;

                if (!courseId) {
                    alert('Please select a Course.');
                    return;
                }
                if (!title) {
                    alert('Please enter a Question Paper Title.');
                    return;
                }
                if (totalMarks <= 0) {
                    alert('Total marks must be greater than zero.');
                    return;
                }
                if (paperQuestions.length === 0) {
                    alert('Please add at least one question to the paper.');
                    return;
                }

                let assignedMarks = 0;
                paperQuestions.forEach(q => assignedMarks += parseFloat(q.marks) || 0);

                if (isPublish && Math.abs(assignedMarks - totalMarks) > 0.01) {
                    alert(`Cannot publish: Total question marks (${assignedMarks}) must equal configured total marks (${totalMarks}). Please adjust marks before publishing.`);
                    return;
                }

                const payload = {
                    id: paperId,
                    courseId: courseId,
                    semesterId: semesterId,
                    subjectId: subjectId,
                    title: title,
                    assessmentType: assessType,
                    totalMarks: totalMarks,
                    status: isPublish ? 'Published' : 'Draft',
                    questions: paperQuestions
                };

                const url = paperId > 0
                    ? '@Url.Action("UpdateQuestionPaper", "Quiz", new { area = "Admin" })'
                    : '@Url.Action("CreateQuestionPaper", "Quiz", new { area = "Admin" })';

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            $('#paperId').val(res.id || paperId);
                            loadSavedPapers();
                        } else {
                            alert(res.message || 'Error saving question paper.');
                        }
                    },
                    error: function () {
                        alert('Server error occurred while saving question paper.');
                    }
                });
            }

            $('#btnSavePaperDraft').on('click', function () { savePaper(false); });
            $('#btnPublishPaper').on('click', function () { savePaper(true); });

            // Reopen / Edit Existing Paper
            function loadPaperForEditing(id) {
                if (!id) return;
                $.ajax({
                    url: '@Url.Action("GetQuestionPaperDetails", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (res.success && res.paper) {
                            const p = res.paper;
                            $('#paperId').val(p.id);
                            $('#paperCourseSelect').val(p.courseId);
                            handleCourseChange(p.courseId, 'paperSemesterSelect', 'paperSubjectSelect', function () {
                                if (p.semesterId) $('#paperSemesterSelect').val(p.semesterId);
                                if (p.subjectId) $('#paperSubjectSelect').val(p.subjectId);
                            });
                            $('#paperTitle').val(p.title);
                            $('#paperAssessmentType').val(p.assessmentType);
                            $('#paperTotalMarks').val(p.totalMarks);

                            paperQuestions = (p.questions || []).map(q => ({
                                questionBankId: q.questionBankId,
                                displayOrder: q.displayOrder,
                                marks: q.marks,
                                questionText: q.questionText,
                                questionType: q.questionType,
                                difficultyLevel: q.difficultyLevel,
                                options: q.options || [],
                                correctAnswer: q.correctAnswer,
                                explanation: q.explanation
                            }));

                            renderPaperQuestions();
                        } else {
                            alert(res.message || 'Error loading paper details.');
                        }
                    }
                });
            }

            $(document).on('click', '.btn-reopen-paper', function () {
                const id = $(this).data('id');
                loadPaperForEditing(id);
            });

            // Preview Paper
            $('#btnPreviewPaper').on('click', function () {
                if (paperQuestions.length === 0) {
                    alert('Add questions to the paper first to preview.');
                    return;
                }

                $('#previewPaperTitle').text($('#paperTitle').val() || 'QUESTION PAPER');
                $('#previewCourseName').text($('#paperCourseSelect option:selected').text());
                $('#previewSubjectName').text($('#paperSubjectSelect option:selected').text() || 'All Topics');
                $('#previewTotalMarks').text($('#paperTotalMarks').val() || '20');

                renderPreviewQuestions(paperQuestions);
                $('#paperPreviewModal').modal('show');
            });

            $(document).on('click', '.btn-preview-paper', function () {
                const id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("GetQuestionPaperDetails", "Quiz", new { area = "Admin" })',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (res.success && res.paper) {
                            const p = res.paper;
                            $('#previewPaperTitle').text(p.title);
                            $('#previewCourseName').text(p.courseName);
                            $('#previewSubjectName').text(p.subjectName || 'All Topics');
                            $('#previewTotalMarks').text(p.totalMarks);

                            renderPreviewQuestions(p.questions || []);
                            $('#paperPreviewModal').modal('show');
                        }
                    }
                });
            });

            function renderPreviewQuestions(questions) {
                const showAnswers = $('#toggleFacultyAnswers').is(':checked');
                let html = '';

                questions.forEach((q, idx) => {
                    let optHtml = '';
                    if (q.questionType === 'MCQ' && q.options && q.options.length > 0) {
                        optHtml = `
                            <div class="row g-2 mt-1 mb-2">
                                ${q.options.map((o, oIdx) => {
                                    const optText = o.optionText || o;
                                    const isCorrect = showAnswers && (o.isCorrect || optText === q.correctAnswer);
                                    return `
                                        <div class="col-md-6">
                                            <div class="mcq-option-pill ${isCorrect ? 'is-correct' : ''}">
                                                <span class="mcq-badge">${String.fromCharCode(65 + oIdx)}</span>
                                                <span>${escapeHtml(optText)}</span>
                                                ${isCorrect ? '<span class="badge bg-success ms-auto"><i class="fa-solid fa-check me-1"></i>Answer</span>' : ''}
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        `;
                    } else if (showAnswers && q.correctAnswer) {
                        optHtml = `
                            <div class="p-2 rounded bg-light border mt-2 small">
                                <strong>Model Answer:</strong> ${escapeHtml(q.correctAnswer)}
                            </div>
                        `;
                    }

                    html += `
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="fw-bold text-dark mb-1">
                                    Q${idx + 1}. ${escapeHtml(q.questionText)}
                                </div>
                                <span class="badge bg-light text-dark border ms-2">${q.marks} Mark${q.marks > 1 ? 's' : ''}</span>
                            </div>
                            ${optHtml}
                            ${showAnswers && q.explanation ? `<small class="text-muted d-block mt-1"><em>Rationale: ${escapeHtml(q.explanation)}</em></small>` : ''}
                        </div>
                    `;
                });

                $('#previewQuestionsContainer').html(html);
            }

            $('#toggleFacultyAnswers').on('change', function () {
                renderPreviewQuestions(paperQuestions);
            });

            // Publish Paper from Saved Papers table
            $(document).on('click', '.btn-publish-paper', function () {
                const id = $(this).data('id');
                if (!confirm('Are you sure you want to publish this question paper for formal assessment?')) return;

                $.ajax({
                    url: '@Url.Action("PublishQuestionPaper", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({ id: id }),
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            loadSavedPapers();
                        } else {
                            alert(res.message || 'Error publishing question paper.');
                        }
                    },
                    error: function () {
                        alert('Server error occurred while publishing.');
                    }
                });
            });

            // Delete Paper
            $(document).on('click', '.btn-delete-paper', function () {
                const id = $(this).data('id');
                if (!confirm('Delete this question paper? This will not delete questions from the Question Bank.')) return;

                $.ajax({
                    url: '@Url.Action("DeleteQuestionPaper", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({ id: id }),
                    success: function (res) {
                        if (res.success) {
                            loadSavedPapers();
                        } else {
                            alert(res.message || 'Error deleting question paper.');
                        }
                    }
                });
            });

            // =================================================================
            // 5. TAB 4: LEGACY QUIZ DELETE HANDLER
            // =================================================================
            $("#quizTableSearch").on("keyup", function () {
                const val = $(this).val().toLowerCase();
                $(".quiz-row").each(function () {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(val) > -1);
                });
            });

            $(document).on("click", ".delete-quiz-btn", function () {
                const quizId = $(this).data("id");
                const quizTitle = $(this).data("title");
                const $row = $(this).closest("tr");

                if (confirm('Are you sure you want to delete the quiz: "' + quizTitle + '"? This will remove associated questions.')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Quiz", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: quizId },
                        success: function (res) {
                            if (res.success) {
                                $row.fadeOut(300, function () { $(this).remove(); });
                            } else {
                                alert(res.message || 'Error deleting quiz.');
                            }
                        },
                        error: function () {
                            alert('An error occurred while deleting the quiz.');
                        }
                    });
                }
            });

            // Utility
            function escapeHtml(text) {
                if (!text) return '';
                return $('<div>').text(text).html();
            }

            // =================================================================
            // 5B. FEATURE 25: BLUEPRINT AUTO-ASSEMBLY JAVASCRIPT
            // =================================================================
            function configureBlueprintSectionsForTarget(targetMarks) {
                targetMarks = parseFloat(targetMarks) || 20;
                let html = '';
                if (targetMarks <= 25) {
                    // E.g. 20 marks: 10 MCQs x 1M = 10M, 2 Short x 5M = 10M
                    const mcqCount = Math.min(10, Math.max(1, Math.floor(targetMarks / 2)));
                    const remainingMarks = targetMarks - mcqCount;
                    const shortMarksEach = remainingMarks >= 10 && remainingMarks % 5 === 0 ? 5 : (remainingMarks >= 4 && remainingMarks % 2 === 0 ? 2 : remainingMarks);
                    const shortCount = Math.max(1, Math.round(remainingMarks / shortMarksEach));
                    html += buildBlueprintSectionCardHtml(0, 'A', 'Section A (Objective)', 'MCQ', mcqCount, 1, 'Easy', 'Remember');
                    html += buildBlueprintSectionCardHtml(1, 'B', 'Section B (Descriptive)', 'Short Answer', shortCount, shortMarksEach, 'Medium', 'Understand');
                } else if (targetMarks <= 60) {
                    // E.g. 50 marks: 10 MCQs x 1M = 10M, 4 Short x 5M = 20M, 2 Long x 10M = 20M
                    html += buildBlueprintSectionCardHtml(0, 'A', 'Section A (Objective)', 'MCQ', 10, 1, 'Easy', 'Remember');
                    html += buildBlueprintSectionCardHtml(1, 'B', 'Section B (Analytical)', 'Short Answer', 4, 5, 'Medium', 'Apply');
                    const longCount = Math.max(1, Math.round((targetMarks - 30) / 10));
                    html += buildBlueprintSectionCardHtml(2, 'C', 'Section C (Comprehensive)', 'Long Answer', longCount, 10, 'Hard', 'Analyze');
                } else {
                    // E.g. 100 marks: 20 MCQs x 1M = 20M, 6 Short x 5M = 30M, 5 Long x 10M = 50M
                    html += buildBlueprintSectionCardHtml(0, 'A', 'Section A (Objective)', 'MCQ', 20, 1, 'Easy', 'Remember');
                    html += buildBlueprintSectionCardHtml(1, 'B', 'Section B (Analytical)', 'Short Answer', 6, 5, 'Medium', 'Apply');
                    html += buildBlueprintSectionCardHtml(2, 'C', 'Section C (Comprehensive)', 'Long Answer', 5, 10, 'Hard', 'Analyze');
                }
                $('#blueprintSectionsContainer').html(html);
                calculateBlueprintTotalMarks();
            }

            function buildBlueprintSectionCardHtml(idx, letter, name, type, count, marks, diff, outcome) {
                return `
                    <div class="p-3 rounded-3 border bg-light blueprint-section-card" data-section-index="${idx}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-primary section-card-title">${escapeHtml(name)}</strong>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-remove-blueprint-section"><i class="fa-solid fa-trash"></i></button>
                        </div>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Section Name</label>
                                <input type="text" class="form-control form-control-sm sec-name" value="${escapeHtml(name)}" />
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Type</label>
                                <select class="form-select form-select-sm sec-type">
                                    <option value="MCQ" ${type === 'MCQ' ? 'selected' : ''}>MCQ</option>
                                    <option value="Short Answer" ${type === 'Short Answer' ? 'selected' : ''}>Short Answer</option>
                                    <option value="Long Answer" ${type === 'Long Answer' ? 'selected' : ''}>Long Answer</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Questions</label>
                                <input type="number" class="form-control form-control-sm sec-count" value="${count}" min="1" max="50" />
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Marks/Q</label>
                                <input type="number" class="form-control form-control-sm sec-marks" value="${marks}" min="0.5" max="50" step="0.5" />
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Difficulty</label>
                                <select class="form-select form-select-sm sec-diff">
                                    <option value="Any" ${diff === 'Any' ? 'selected' : ''}>Any</option>
                                    <option value="Easy" ${diff === 'Easy' ? 'selected' : ''}>Easy</option>
                                    <option value="Medium" ${diff === 'Medium' ? 'selected' : ''}>Medium</option>
                                    <option value="Hard" ${diff === 'Hard' ? 'selected' : ''}>Hard</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Bloom's Tag</label>
                                <select class="form-select form-select-sm sec-outcome">
                                    <option value="Any" ${outcome === 'Any' ? 'selected' : ''}>Any</option>
                                    <option value="Remember" ${outcome === 'Remember' ? 'selected' : ''}>Remember</option>
                                    <option value="Understand" ${outcome === 'Understand' ? 'selected' : ''}>Understand</option>
                                    <option value="Apply" ${outcome === 'Apply' ? 'selected' : ''}>Apply</option>
                                    <option value="Analyze" ${outcome === 'Analyze' ? 'selected' : ''}>Analyze</option>
                                    <option value="Evaluate" ${outcome === 'Evaluate' ? 'selected' : ''}>Evaluate</option>
                                </select>
                            </div>
                        </div>
                    </div>
                `;
            }

            $('#btnOpenBlueprintModal').on('click', function () {
                const selectedCourse = $('#paperCourseSelect').val();
                const selectedSemester = $('#paperSemesterSelect').val();
                const selectedSubject = $('#paperSubjectSelect').val();
                const currentTitle = ($('#paperTitle').val() || '').trim();
                const targetMarks = parseFloat($('#paperTotalMarks').val()) || 20;
                const currentAssessType = $('#paperAssessmentType').val() || 'Internal Assessment';

                // Populate Courses
                $('#blueprintCourseSelect').html($('#paperCourseSelect').html());
                if (selectedCourse) {
                    $('#blueprintCourseSelect').val(selectedCourse);
                    handleCourseChange(selectedCourse, 'blueprintSemesterSelect', 'blueprintSubjectSelect', function () {
                        if (selectedSemester) $('#blueprintSemesterSelect').val(selectedSemester);
                        if (selectedSubject) $('#blueprintSubjectSelect').val(selectedSubject);
                    });
                } else if (cachedCourses.length > 0) {
                    $('#blueprintCourseSelect').val(cachedCourses[0].id);
                    handleCourseChange(cachedCourses[0].id, 'blueprintSemesterSelect', 'blueprintSubjectSelect');
                }

                // Title pre-fill
                if (currentTitle) {
                    $('#blueprintTitle').val(currentTitle);
                } else {
                    const subText = $('#paperSubjectSelect option:selected').text();
                    const titleFallback = subText && subText.indexOf('Select') < 0
                        ? `${subText} - ${currentAssessType}`
                        : `${currentAssessType} Blueprint - ${new Date().getFullYear()}`;
                    $('#blueprintTitle').val(titleFallback);
                }

                $('#blueprintAssessmentType').val(currentAssessType);

                // Configure sections matching target marks
                configureBlueprintSectionsForTarget(targetMarks);

                $('#blueprintWarningsAlert').addClass('d-none').empty();
                $('#modalBlueprintAssembly').modal('show');
            });

            $('#blueprintCourseSelect').on('change', function () {
                const cId = $(this).val();
                if (cId) {
                    handleCourseChange(cId, 'blueprintSemesterSelect', 'blueprintSubjectSelect');
                }
            });

            $('#blueprintSemesterSelect').on('change', function () {
                const cId = $('#blueprintCourseSelect').val();
                const sId = $(this).val();
                if (cId) {
                    loadSubjects(sId, cId).done(function () {
                        const subOpts = ['<option value="">Select Subject...</option>'];
                        cachedSubjects.forEach(sub => {
                            subOpts.push(`<option value="${sub.id}">${sub.name} ${sub.code ? '(' + sub.code + ')' : ''}</option>`);
                        });
                        $('#blueprintSubjectSelect').html(subOpts.join(''));
                    });
                }
            });

            function calculateBlueprintTotalMarks() {
                let total = 0;
                $('.blueprint-section-card').each(function () {
                    const count = parseFloat($(this).find('.sec-count').val()) || 0;
                    const marks = parseFloat($(this).find('.sec-marks').val()) || 0;
                    total += (count * marks);
                });
                $('#blueprintTotalMarksDisplay').text(total + ' M');
            }

            $(document).on('input change', '.sec-count, .sec-marks', calculateBlueprintTotalMarks);

            $(document).on('click', '.btn-remove-blueprint-section', function () {
                if ($('.blueprint-section-card').length > 1) {
                    $(this).closest('.blueprint-section-card').remove();
                    calculateBlueprintTotalMarks();
                } else {
                    alert('At least one section must be specified in the blueprint.');
                }
            });

            $('#btnAddBlueprintSection').on('click', function () {
                const count = $('.blueprint-section-card').length;
                const nextLetter = String.fromCharCode(65 + count);
                const html = buildBlueprintSectionCardHtml(count, nextLetter, `Section ${nextLetter}`, 'Long Answer', 2, 10, 'Hard', 'Analyze');
                $('#blueprintSectionsContainer').append(html);
                calculateBlueprintTotalMarks();
            });

            $('#btnRunBlueprintAssembly').on('click', function () {
                const courseId = parseInt($('#blueprintCourseSelect').val());
                const semesterId = parseInt($('#blueprintSemesterSelect').val()) || null;
                let subjectId = parseInt($('#blueprintSubjectSelect').val()) || 0;
                if (!subjectId) {
                    const firstSubVal = $('#blueprintSubjectSelect option:not([value=""])').first().val();
                    if (firstSubVal) {
                        subjectId = parseInt(firstSubVal);
                        $('#blueprintSubjectSelect').val(firstSubVal);
                    }
                }
                const title = $('#blueprintTitle').val().trim();
                const assessmentType = $('#blueprintAssessmentType').val();
                const duration = parseInt($('#blueprintDuration').val()) || 180;
                const autoAi = $('#blueprintAiCheckbox').is(':checked');

                if (!courseId) {
                    alert('Please select a Course for the blueprint.');
                    return;
                }
                if (!title) {
                    alert('Please enter a Paper Title for the blueprint.');
                    return;
                }

                const sections = [];
                $('.blueprint-section-card').each(function () {
                    sections.push({
                        sectionName: $(this).find('.sec-name').val() || 'Section A',
                        questionType: $(this).find('.sec-type').val(),
                        numberOfQuestions: parseInt($(this).find('.sec-count').val()) || 1,
                        marksPerQuestion: parseFloat($(this).find('.sec-marks').val()) || 1,
                        difficultyLevel: $(this).find('.sec-diff').val(),
                        learningOutcome: $(this).find('.sec-outcome').val()
                    });
                });

                if (sections.length === 0) {
                    alert('Please add at least one section to the blueprint.');
                    return;
                }

                const payload = {
                    courseId: courseId,
                    semesterId: semesterId,
                    subjectId: subjectId > 0 ? subjectId : null,
                    title: title,
                    assessmentType: assessmentType,
                    durationMinutes: duration,
                    sections: sections,
                    autoGenerateMissingWithAi: autoAi
                };

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Auto-Assembling...');

                $.ajax({
                    url: '@Url.Action("AutoAssemblePaperFromBlueprint", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-bolt me-1"></i> Auto-Assemble Question Paper');
                        if (res.success) {
                            $('#modalBlueprintAssembly').modal('hide');
                            alert(res.message);
                            loadSavedPapers();
                            if (res.questionPaperId) {
                                loadPaperForEditing(res.questionPaperId);
                            }
                        } else {
                            if (res.warnings && res.warnings.length > 0) {
                                $('#blueprintWarningsAlert').removeClass('d-none').html('<strong>Shortage Warnings:</strong><br/>' + res.warnings.join('<br/>'));
                            }
                            alert(res.message || 'Error auto-assembling question paper.');
                        }
                    },
                    error: function (xhr) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-bolt me-1"></i> Auto-Assemble Question Paper');
                        alert('Server error auto-assembling question paper: ' + (xhr.responseJSON ? xhr.responseJSON.message : xhr.responseText));
                    }
                });
            });

            // =================================================================
            // 5C. FEATURE 26: BULK IMPORT JAVASCRIPT
            // =================================================================
            $('#btnOpenBulkImportModal').on('click', function () {
                $('#bulkImportCourseSelect').html($('#bankCourseFilter').html());
                $('#bulkImportSubjectSelect').html($('#bankSubjectFilter').html());
                $('#bulkImportCourseSelect').val($('#bankCourseFilter').val());
                $('#bulkImportSubjectSelect').val($('#bankSubjectFilter').val());
                $('#bulkImportFeedback').addClass('d-none').empty();
                $('#bulkImportFileInput').val('');
                $('#modalBulkQuestionImport').modal('show');
            });

            $('#bulkImportCourseSelect').on('change', function () {
                const cId = $(this).val();
                if (cId) {
                    loadSubjects(null, cId).done(function () {
                        const subOpts = ['<option value="">Select Subject...</option>'];
                        cachedSubjects.forEach(s => subOpts.push(`<option value="${s.id}">${s.name}</option>`));
                        $('#bulkImportSubjectSelect').html(subOpts.join(''));
                    });
                } else {
                    $('#bulkImportSubjectSelect').html('<option value="">Select Subject...</option>');
                }
            });

            $('#btnSubmitBulkImport').on('click', function () {
                const cId = $('#bulkImportCourseSelect').val();
                const sId = $('#bulkImportSubjectSelect').val();
                const file = $('#bulkImportFileInput')[0].files[0];

                if (!cId || !sId || !file) {
                    alert('Please select Course, Subject, and choose a CSV file.');
                    return;
                }

                const formData = new FormData();
                formData.append('courseId', cId);
                formData.append('subjectId', sId);
                formData.append('file', file);
                formData.append('__RequestVerificationToken', getAntiForgeryToken());

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Importing...');

                $.ajax({
                    url: '@Url.Action("BulkImportQuestions", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-upload me-1"></i> Upload & Import');
                        if (res.success) {
                            let fbHtml = `<div class="alert alert-success"><strong>Success!</strong> ${res.message}</div>`;
                            if (res.rowErrors && res.rowErrors.length > 0) {
                                fbHtml += `<div class="alert alert-warning small"><strong>Row Notices:</strong><br/>${res.rowErrors.join('<br/>')}</div>`;
                            }
                            $('#bulkImportFeedback').removeClass('d-none').html(fbHtml);
                            loadBankQuestions();
                        } else {
                            let fbHtml = `<div class="alert alert-danger"><strong>Import Failed:</strong> ${res.message || 'Validation error'}</div>`;
                            if (res.rowErrors && res.rowErrors.length > 0) {
                                fbHtml += `<div class="alert alert-warning small"><strong>Errors:</strong><br/>${res.rowErrors.join('<br/>')}</div>`;
                            }
                            $('#bulkImportFeedback').removeClass('d-none').html(fbHtml);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-upload me-1"></i> Upload & Import');
                        alert('Server error executing bulk import.');
                    }
                });
            });

            // =================================================================
            // 5D. FEATURE 26: AI BATCH CLASSIFICATION JAVASCRIPT
            // =================================================================
            $('#btnOpenBatchClassifyModal').on('click', function () {
                $('#batchClassifyCourseSelect').html($('#bankCourseFilter').html());
                $('#batchClassifySubjectSelect').html($('#bankSubjectFilter').html());
                $('#batchClassifyCourseSelect').val($('#bankCourseFilter').val());
                $('#batchClassifySubjectSelect').val($('#bankSubjectFilter').val());
                $('#unclassifiedContainer').addClass('d-none');
                $('#classifySuggestionsContainer').addClass('d-none');
                $('#modalBatchClassify').modal('show');
            });

            $('#batchClassifyCourseSelect').on('change', function () {
                const cId = $(this).val();
                if (cId) {
                    loadSubjects(null, cId).done(function () {
                        const subOpts = ['<option value="">All Subjects</option>'];
                        cachedSubjects.forEach(s => subOpts.push(`<option value="${s.id}">${s.name}</option>`));
                        $('#batchClassifySubjectSelect').html(subOpts.join(''));
                    });
                } else {
                    $('#batchClassifySubjectSelect').html('<option value="">All Subjects</option>');
                }
            });

            $('#btnFetchUnclassified').on('click', function () {
                const cId = $('#batchClassifyCourseSelect').val();
                const sId = $('#batchClassifySubjectSelect').val();
                if (!cId) { alert('Please select a Course.'); return; }

                $.get('@Url.Action("GetLegacyUnclassifiedQuestions", "Quiz", new { area = "Admin" })', { courseId: cId, subjectId: sId }, function (res) {
                    if (res.success && res.questions && res.questions.length > 0) {
                        let rows = '';
                        res.questions.forEach(q => {
                            rows += `
                                <tr>
                                    <td class="text-center"><input type="checkbox" class="unclassified-chk" value="${q.id}" checked /></td>
                                    <td>${escapeHtml(q.questionText)}</td>
                                    <td><span class="badge bg-light text-dark">${q.currentType || 'MCQ'}</span></td>
                                    <td class="text-center">${q.marks} M</td>
                                </tr>
                            `;
                        });
                        $('#unclassifiedCount').text(res.questions.length);
                        $('#unclassifiedTableBody').html(rows);
                        $('#unclassifiedContainer').removeClass('d-none');
                        $('#classifySuggestionsContainer').addClass('d-none');
                    } else {
                        alert('No unaligned questions found for this Course/Subject.');
                        $('#unclassifiedContainer').addClass('d-none');
                    }
                });
            });

            let currentClassificationSuggestions = [];

            $('#btnRunAiClassify').on('click', function () {
                const selectedIds = [];
                $('.unclassified-chk:checked').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) { alert('Please select at least one question.'); return; }

                const cId = parseInt($('#batchClassifyCourseSelect').val());
                const sId = parseInt($('#batchClassifySubjectSelect').val()) || 0;

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Classifying...');

                $.ajax({
                    url: '@Url.Action("BatchClassifyQuestions", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken(), 'Content-Type': 'application/json' },
                    data: JSON.stringify({ courseId: cId, subjectId: sId, questionIds: selectedIds }),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-wand-magic-sparkles me-1"></i> Classify with AI');
                        if (res.success && res.suggestions && res.suggestions.length > 0) {
                            currentClassificationSuggestions = res.suggestions;
                            let html = '';
                            res.suggestions.forEach(s => {
                                html += `
                                    <tr>
                                        <td class="text-center"><input type="checkbox" class="classify-apply-chk" value="${s.questionId}" checked /></td>
                                        <td class="small" style="max-width: 250px;">${escapeHtml(s.questionText)}</td>
                                        <td><span class="badge bg-primary bg-opacity-10 text-primary">${escapeHtml(s.suggestedUnitName || 'Unit ' + s.suggestedUnitId)}</span></td>
                                        <td><span class="badge bg-info bg-opacity-10 text-info">${escapeHtml(s.suggestedTopicName || 'Topic ' + s.suggestedTopicId)}</span></td>
                                        <td><span class="badge bg-warning bg-opacity-10 text-dark">${s.suggestedDifficultyLevel}</span></td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success">${s.suggestedLearningOutcome}</span></td>
                                        <td class="small text-muted">${escapeHtml(s.rationale)}</td>
                                    </tr>
                                `;
                            });
                            $('#classifySuggestionsTableBody').html(html);
                            $('#classifySuggestionsContainer').removeClass('d-none');
                        } else {
                            alert(res.message || 'No suggestions returned.');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-wand-magic-sparkles me-1"></i> Classify with AI');
                        alert('Server error generating AI classifications.');
                    }
                });
            });

            $('#btnApplyApprovedClassifications').on('click', function () {
                const approved = [];
                $('.classify-apply-chk:checked').each(function () {
                    const qId = parseInt($(this).val());
                    const item = currentClassificationSuggestions.find(x => x.questionId === qId);
                    if (item) {
                        approved.push({
                            questionId: qId,
                            unitId: item.suggestedUnitId,
                            topicId: item.suggestedTopicId,
                            difficultyLevel: item.suggestedDifficultyLevel,
                            learningOutcome: item.suggestedLearningOutcome
                        });
                    }
                });

                if (approved.length === 0) { alert('Please select at least one suggestion to approve.'); return; }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

                $.ajax({
                    url: '@Url.Action("ApplyQuestionClassifications", "Quiz", new { area = "Admin" })',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken(), 'Content-Type': 'application/json' },
                    data: JSON.stringify(approved),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Apply Approved Tags');
                        if (res.success) {
                            alert(res.message);
                            $('#modalBatchClassify').modal('hide');
                            loadBankQuestions();
                        } else {
                            alert(res.message || 'Error saving classifications.');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Apply Approved Tags');
                        alert('Server error saving classifications.');
                    }
                });
            });

            // =================================================================
            // 6. INITIAL RUN
            // =================================================================
            loadFacultyCourses().done(function () {
                loadBankQuestions();
                loadSavedPapers();
            });
        });
    </script>
}
