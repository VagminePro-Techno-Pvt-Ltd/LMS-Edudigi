@using Microsoft.AspNetCore.Mvc.Rendering
@using TMS.ViewModels
@using TMS.ViewModels.Masters
@using TMS.Web.Areas.Admin.Controllers
@model TMS.ViewModels.Masters.CourseEnrollmentViewModel

@{
    var studentList = ViewBag.StudentList as List<SelectListItem>;
    var studentDetails = ViewBag.StudentDetails as List<UserViewModel>;
    var selectedCount = studentList?.Count(s => s.Selected) ?? 0;
    var totalCount = studentList?.Count ?? 0;
    var courseCount = (int)(ViewBag.CourseCount ?? 0);
    var studentEnrollments = ViewBag.StudentEnrollments as Dictionary<int, List<StudentEnrolledCourseBadgeVM>>;
    var programId = Model.CourseId; // Carries ProgramId

    // Counters for quick filtering
    int notEnrolledCount = 0;
    int thisProgCount = 0;
    int otherProgCount = 0;

    if (studentDetails != null && studentEnrollments != null)
    {
        foreach (var s in studentDetails)
        {
            if (studentEnrollments.TryGetValue(s.Id, out var enrolled) && enrolled.Any())
            {
                if (enrolled.Any(e => e.ProgramId == programId))
                    thisProgCount++;
                else
                    otherProgCount++;
            }
            else
            {
                notEnrolledCount++;
            }
        }
    }
}

<style>
    .enroll-search {
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 9px 16px;
        width: 100%;
        font-size: 13px;
        transition: all 0.2s;
    }
    .enroll-search:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }
    .student-table { margin: 0; }
    .student-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 16px;
        border-bottom: 1px solid #e2e8f0;
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .student-table tbody td {
        padding: 12px 16px;
        font-size: 13px;
        color: #1e293b;
        border-color: #f1f5f9;
        vertical-align: middle;
    }
    .student-table tbody tr:hover { background: #f8fafc; }
    .student-table input[type="checkbox"] { width: 17px; height: 17px; cursor: pointer; accent-color: #6366f1; }
    .enroll-footer {
        padding: 16px 24px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .counter-badge {
        background: #eff6ff;
        color: #3b82f6;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .btn-save-enrollment {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.2s;
    }
    .btn-save-enrollment:hover { transform: translateY(-1px); color: white; }
    .filter-pill-btn {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
    }
    .filter-pill-btn:hover { background: #e2e8f0; }
    .filter-pill-btn.active {
        background: #4f46e5;
        border-color: #4f46e5;
        color: white;
    }
</style>

<div>
    @* ── Program Info ── *@
    <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; background: #fafafa;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-1" style="color:#1e293b;">
                    <i class="fas fa-graduation-cap me-1" style="color:#6366f1;"></i>
                    @ViewBag.ProgramName
                </h6>
                @if (courseCount > 0)
                {
                    <small class="text-muted">
                        <i class="fas fa-info-circle text-primary me-1"></i>
                        Enrolling in this program grants students access to all <strong>@courseCount course(s)</strong> under it.
                    </small>
                }
                else
                {
                    <small class="text-warning fw-bold">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        This program currently has <strong>0 courses</strong>. Please add courses in Course Structure.
                    </small>
                }
            </div>
            <span class="counter-badge" id="selectedCounter">@selectedCount / @totalCount selected</span>
        </div>
    </div>

    @* ── Quick Filters Bar ── *@
    <div style="padding: 12px 24px 0 24px;">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="small fw-bold text-secondary me-1">Quick Filter:</span>
            <button type="button" class="filter-pill-btn active" data-filter="all">
                All Students (@totalCount)
            </button>
            <button type="button" class="filter-pill-btn" data-filter="not-enrolled">
                <i class="fas fa-user-clock me-1 text-warning"></i> Not Enrolled Yet (@notEnrolledCount)
            </button>
            <button type="button" class="filter-pill-btn" data-filter="this-program">
                <i class="fas fa-check-circle me-1 text-success"></i> In this Program (@thisProgCount)
            </button>
            @if (otherProgCount > 0)
            {
                <button type="button" class="filter-pill-btn" data-filter="other-program">
                    Other Programs (@otherProgCount)
                </button>
            }
        </div>
    </div>

    <form id="enrollmentForm" asp-action="SaveMapping" asp-controller="CourseEnrollment">
        @* CourseId field carries ProgramId *@
        <input type="hidden" asp-for="CourseId" />

        @* ── Search + Select All ── *@
        <div style="padding: 14px 24px;">
            <div class="d-flex gap-3 align-items-center">
                <div class="flex-grow-1">
                    <input type="text" id="studentSearch" class="enroll-search" placeholder="🔍  Search students by name, email, or course..." />
                </div>
                <label class="d-flex align-items-center gap-2" style="cursor:pointer; white-space:nowrap;">
                    <input type="checkbox" id="selectAll" style="width:18px; height:18px; accent-color:#6366f1;" />
                    <span class="fw-bold small">Select All Visible</span>
                </label>
            </div>
        </div>

        @* ── Student Table ── *@
        <div style="max-height: 420px; overflow-y: auto;">
            <table class="table student-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">Select</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Current Enrolled Course(s)</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    @if (studentList != null && studentDetails != null)
                    {
                        foreach (var student in studentList)
                        {
                            var studentObj = studentDetails.FirstOrDefault(s => s.Id == int.Parse(student.Value));
                            if (studentObj == null) continue;

                            List<StudentEnrolledCourseBadgeVM>? enrolledList = null;
                            var hasEnrollments = studentEnrollments != null && studentEnrollments.TryGetValue(studentObj.Id, out enrolledList) && enrolledList != null && enrolledList.Any();
                            var inThisProgram = hasEnrollments && enrolledList!.Any(e => e.ProgramId == programId);
                            var inOtherProgram = hasEnrollments && !inThisProgram;

                            <tr class="student-row"
                                data-name="@studentObj.Name?.ToLower()"
                                data-email="@studentObj.Email?.ToLower()"
                                data-enrolled="@(hasEnrollments ? "yes" : "no")"
                                data-this-prog="@(inThisProgram ? "yes" : "no")"
                                data-other-prog="@(inOtherProgram ? "yes" : "no")">
                                <td class="text-center">
                                    <input type="checkbox" name="SelectedStudentIds" value="@student.Value" class="student-checkbox"
                                        @(student.Selected ? "checked" : "") />
                                </td>
                                <td class="fw-bold text-dark">
                                    @studentObj.Name
                                    @if (student.Selected)
                                    {
                                        <span class="badge bg-success ms-1" style="font-size:10px;">Enrolled</span>
                                    }
                                </td>
                                <td>@studentObj.Email</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(studentObj.ContactNo) ? "-" : studentObj.ContactNo)</td>
                                <td>
                                    @if (hasEnrollments)
                                    {
                                        var progGroups = enrolledList!.GroupBy(c => c.ProgramName);
                                        foreach (var pg in progGroups)
                                        {
                                            <div class="mb-1">
                                                <span class="badge bg-primary text-white" style="font-size:11px;">
                                                    <i class="fas fa-graduation-cap me-1"></i>@pg.Key
                                                </span>
                                                <span class="text-secondary small ms-1">(@string.Join(", ", pg.Select(c => c.CourseCode)))</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size:11px;">
                                            <i class="fas fa-minus-circle me-1"></i> Not Enrolled Yet
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-user-slash" style="font-size:24px; color:#cbd5e1;"></i>
                                <div class="mt-2">No student records found in the database.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Footer ── *@
        <div class="enroll-footer">
            <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
            <button type="submit" class="btn-save-enrollment" @(courseCount == 0 ? "disabled" : "")>
                <i class="fas fa-save me-1"></i> Enroll in Program (@courseCount courses)
            </button>
        </div>
    </form>
</div>

<script>
    var currentFilter = 'all';

    // Quick filter buttons
    $('.filter-pill-btn').on('click', function () {
        $('.filter-pill-btn').removeClass('active');
        $(this).addClass('active');
        currentFilter = $(this).data('filter');
        applyFilters();
    });

    // Search filter
    $('#studentSearch').on('input', applyFilters);

    function applyFilters() {
        var q = $('#studentSearch').val().toLowerCase();
        $('.student-row').each(function () {
            var name = $(this).data('name') || '';
            var email = $(this).data('email') || '';
            var enrolled = $(this).data('enrolled');
            var thisProg = $(this).data('this-prog');
            var otherProg = $(this).data('other-prog');

            var matchesSearch = (name.indexOf(q) > -1 || email.indexOf(q) > -1);
            var matchesCategory = true;

            if (currentFilter === 'not-enrolled') {
                matchesCategory = (enrolled === 'no');
            } else if (currentFilter === 'this-program') {
                matchesCategory = (thisProg === 'yes');
            } else if (currentFilter === 'other-program') {
                matchesCategory = (otherProg === 'yes');
            }

            $(this).toggle(matchesSearch && matchesCategory);
        });
        updateCounter();
    }

    // Select All
    $('#selectAll').on('change', function () {
        var checked = $(this).is(':checked');
        $('.student-row:visible .student-checkbox').prop('checked', checked);
        updateCounter();
    });

    // Counter update
    $(document).on('change', '.student-checkbox', updateCounter);
    function updateCounter() {
        var selected = $('.student-checkbox:checked').length;
        var total = $('.student-checkbox').length;
        $('#selectedCounter').text(selected + ' / ' + total + ' selected');
    }
</script>
