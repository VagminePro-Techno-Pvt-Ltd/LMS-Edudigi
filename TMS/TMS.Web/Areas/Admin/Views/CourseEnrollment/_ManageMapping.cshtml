@using Microsoft.AspNetCore.Mvc.Rendering
@using TMS.ViewModels
@using TMS.ViewModels.Masters
@model TMS.ViewModels.Masters.CourseEnrollmentViewModel

@{
    var studentList = ViewBag.StudentList as List<SelectListItem>;
    var studentDetails = ViewBag.StudentDetails as List<UserViewModel>;
    var selectedCount = studentList?.Count(s => s.Selected) ?? 0;
    var totalCount = studentList?.Count ?? 0;
    var courseCount = (int)(ViewBag.CourseCount ?? 0);
}

<style>
    .enroll-search { border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 16px; width: 100%; font-size: 14px; transition: all 0.2s; }
    .enroll-search:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
    .student-table { margin: 0; }
    .student-table thead th { background: #f8fafc; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px; border: none; position: sticky; top: 0; z-index: 1; }
    .student-table tbody td { padding: 10px 16px; font-size: 13px; color: #1e293b; border-color: #f1f5f9; vertical-align: middle; }
    .student-table tbody tr:hover { background: #f8fafc; }
    .student-table input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: #6366f1; }
    .enroll-footer { padding: 16px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; }
    .counter-badge { background: #eff6ff; color: #3b82f6; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; }
    .btn-save-enrollment { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 700; transition: all 0.2s; }
    .btn-save-enrollment:hover { transform: translateY(-1px); color: white; }
    .program-info-bar { background: linear-gradient(135deg, #eef2ff, #e0e7ff); padding: 12px 20px; border-radius: 10px; margin-bottom: 12px; }
</style>

<div>
    @* ── Program Info ── *@
    <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-1" style="color:#1e293b;">
                    <i class="fas fa-graduation-cap me-1" style="color:#6366f1;"></i>
                    @ViewBag.ProgramName
                </h6>
                <small class="text-muted">
                    <i class="fas fa-info-circle"></i>
                    Enrolling in this program will give students access to all <strong>@courseCount course(s)</strong> under it.
                </small>
            </div>
            <span class="counter-badge" id="selectedCounter">@selectedCount / @totalCount selected</span>
        </div>
    </div>

    <form id="enrollmentForm" asp-action="SaveMapping" asp-controller="CourseEnrollment">
        @* CourseId field carries ProgramId *@
        <input type="hidden" asp-for="CourseId" />

        @* ── Search + Select All ── *@
        <div style="padding: 16px 24px;">
            <div class="d-flex gap-3 align-items-center">
                <div class="flex-grow-1">
                    <input type="text" id="studentSearch" class="enroll-search" placeholder="🔍  Search students by name or email..." />
                </div>
                <label class="d-flex align-items-center gap-2" style="cursor:pointer; white-space:nowrap;">
                    <input type="checkbox" id="selectAll" style="width:18px; height:18px; accent-color:#6366f1;" />
                    <span class="fw-bold small">Select All</span>
                </label>
            </div>
        </div>

        @* ── Student Table ── *@
        <div style="max-height: 400px; overflow-y: auto;">
            <table class="table student-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">Select</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    @if (studentList != null && studentDetails != null)
                    {
                        foreach (var student in studentList)
                        {
                            var studentObj = studentDetails.FirstOrDefault(s => s.Id == int.Parse(student.Value));
                            <tr class="student-row" data-name="@studentObj?.Name?.ToLower()" data-email="@studentObj?.Email?.ToLower()">
                                <td class="text-center">
                                    <input type="checkbox" name="SelectedStudentIds" value="@student.Value" class="student-checkbox"
                                        @(student.Selected ? "checked" : "") />
                                </td>
                                <td class="fw-semibold">@studentObj?.Name</td>
                                <td>@studentObj?.Email</td>
                                <td class="text-muted">@studentObj?.ContactNo</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fas fa-user-slash" style="font-size:24px; color:#cbd5e1;"></i>
                                <div class="mt-2">No students available. Create students first via User Management.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Footer ── *@
        <div class="enroll-footer">
            <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
            <button type="submit" class="btn-save-enrollment">
                <i class="fas fa-save"></i> Enroll in Program (@courseCount courses)
            </button>
        </div>
    </form>
</div>

<script>
    // Search filter
    $('#studentSearch').on('input', function () {
        var q = $(this).val().toLowerCase();
        $('.student-row').each(function () {
            var name = $(this).data('name') || '';
            var email = $(this).data('email') || '';
            $(this).toggle(name.indexOf(q) > -1 || email.indexOf(q) > -1);
        });
    });

    // Select All
    $('#selectAll').on('change', function () {
        var checked = $(this).is(':checked');
        $('.student-row:visible .student-checkbox').prop('checked', checked);
        updateCounter();
    });

    // Counter update
    $(document).on('change', '.student-checkbox', updateCounter);
    function updateCounter() {
        var selected = $('.student-checkbox:checked').length;
        var total = $('.student-checkbox').length;
        $('#selectedCounter').text(selected + ' / ' + total + ' selected');
    }
</script>
