@model TMS.Web.Areas.Admin.Controllers.AcademicEnrollmentDashboardVM
@{
    ViewData["Title"] = "Academic Enrollment Center";
}

<style>
    .enroll-wrapper {
        max-width: 1300px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .hero-banner {
        background: linear-gradient(135deg, #4338ca 0%, #3b82f6 50%, #6366f1 100%);
        border-radius: 20px;
        padding: 32px 36px;
        color: white;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px rgba(67, 56, 202, 0.18);
        position: relative;
        overflow: hidden;
    }
    .hero-banner::after {
        content: '';
        position: absolute;
        bottom: -40px;
        right: -40px;
        width: 220px;
        height: 220px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        pointer-events: none;
    }
    .hero-title {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }
    .hero-subtitle {
        font-size: 14px;
        opacity: 0.9;
        margin-bottom: 20px;
        max-width: 650px;
    }

    .stat-badge-box {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        padding: 10px 18px;
        border-radius: 14px;
        color: white;
    }
    .stat-badge-num {
        font-size: 20px;
        font-weight: 800;
        line-height: 1;
    }
    .stat-badge-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        opacity: 0.85;
    }

    /* Controls Bar */
    .controls-bar {
        background: white;
        border-radius: 16px;
        padding: 14px 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        border: 1px solid #e2e8f0;
        margin-bottom: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
    }
    .search-box-input {
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 9px 18px 9px 38px;
        font-size: 13px;
        width: 320px;
        transition: all 0.2s;
    }
    .search-box-input:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .view-toggle-btn {
        background: #f1f5f9;
        color: #475569;
        border: none;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .view-toggle-btn.active {
        background: #4f46e5;
        color: white;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }

    /* Program Cards */
    .prog-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .prog-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
        border-color: #cbd5e1;
    }
    .prog-card-top {
        padding: 22px 24px;
        flex-grow: 1;
    }
    .prog-card-title {
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }
    .prog-card-desc {
        font-size: 12px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 16px;
        min-height: 36px;
    }
    .prog-card-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
    }
    .p-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .p-badge.courses { background: #eff6ff; color: #2563eb; }
    .p-badge.semesters { background: #fef3c7; color: #b45309; }
    .p-badge.students { background: #ecfdf5; color: #059669; }
    .p-badge.none { background: #f8fafc; color: #94a3b8; border: 1px solid #e2e8f0; }

    .prog-card-footer {
        padding: 14px 24px;
        background: #f8fafc;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }
    .btn-studio-open {
        background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        color: white !important;
        border: none;
        padding: 9px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-studio-open:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

    /* Courses Table */
    .course-table-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        overflow: hidden;
    }
    .course-table {
        margin: 0;
    }
    .course-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        padding: 14px 20px;
        border-bottom: 1px solid #e2e8f0;
    }
    .course-table tbody td {
        padding: 14px 20px;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .course-table tbody tr:hover {
        background: #f8fafc;
    }
</style>

<div class="enroll-wrapper">

    @* ── Top Hero Banner ── *@
    <div class="hero-banner">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="hero-title"><i class="fas fa-user-graduate me-2"></i>Academic Enrollment Center</h1>
                <p class="hero-subtitle">
                    Assign, manage, and audit student enrollments across Academic Programs and Individual Courses. Students instantly gain access to enrolled materials upon assignment.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/BulkUserUpload" class="btn btn-light fw-bold px-3 py-2" style="border-radius:12px; font-size:13px;">
                    <i class="fas fa-file-excel text-success me-1"></i> Bulk Upload Users
                </a>
                <a href="/Admin/CourseEnrollment/BulkEnroll" class="btn btn-outline-light fw-bold px-3 py-2" style="border-radius:12px; font-size:13px;">
                    <i class="fas fa-upload me-1"></i> Mass Enroll (CSV)
                </a>
            </div>
        </div>

        @* Quick Stats *@
        <div class="d-flex flex-wrap gap-3 mt-2">
            <div class="stat-badge-box">
                <i class="fas fa-graduation-cap" style="font-size:22px; opacity:0.9;"></i>
                <div>
                    <div class="stat-badge-num">@Model.TotalPrograms</div>
                    <div class="stat-badge-label">Programs</div>
                </div>
            </div>
            <div class="stat-badge-box">
                <i class="fas fa-book" style="font-size:22px; opacity:0.9;"></i>
                <div>
                    <div class="stat-badge-num">@Model.TotalCourses</div>
                    <div class="stat-badge-label">Active Courses</div>
                </div>
            </div>
            <div class="stat-badge-box">
                <i class="fas fa-users" style="font-size:22px; opacity:0.9;"></i>
                <div>
                    <div class="stat-badge-num">@Model.TotalStudents</div>
                    <div class="stat-badge-label">Students</div>
                </div>
            </div>
            <div class="stat-badge-box">
                <i class="fas fa-id-card" style="font-size:22px; opacity:0.9;"></i>
                <div>
                    <div class="stat-badge-num">@Model.TotalActiveEnrollments</div>
                    <div class="stat-badge-label">Active Enrollments</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Controls Bar: Search & View Toggle ── *@
    <div class="controls-bar">
        <div class="position-relative">
            <i class="fas fa-search position-absolute text-muted" style="left: 14px; top: 12px; font-size:13px;"></i>
            <input type="text" id="mainEnrollSearch" class="search-box-input" placeholder="Search programs or courses..." />
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small fw-bold me-1">View By:</span>
            <button type="button" class="view-toggle-btn active" id="btnViewPrograms" onclick="toggleView('programs')">
                <i class="fas fa-graduation-cap me-1"></i> Programs (@Model.TotalPrograms)
            </button>
            <button type="button" class="view-toggle-btn" id="btnViewCourses" onclick="toggleView('courses')">
                <i class="fas fa-book-open me-1"></i> Individual Courses (@Model.TotalCourses)
            </button>
        </div>
    </div>

    @* ── SECTION 1: Programs Grid ── *@
    <div id="sectionPrograms">
        @if (!Model.Programs.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="fas fa-folder-open text-muted" style="font-size:42px;"></i>
                <h6 class="mt-3 fw-bold text-dark">No Programs Found</h6>
                <p class="text-muted small">Create programs first via Programs Offered menu.</p>
            </div>
        }
        else
        {
            <div class="row g-4" id="programsGrid">
                @foreach (var prog in Model.Programs)
                {
                    <div class="col-12 col-md-6 col-lg-4 prog-card-col" data-title="@prog.ProgramName.ToLower()" data-desc="@(prog.ProgramDescription?.ToLower() ?? "")">
                        <div class="prog-card">
                            <div class="prog-card-top">
                                <div class="prog-card-title">
                                    <i class="fas fa-graduation-cap text-primary me-2"></i>@prog.ProgramName
                                </div>
                                <div class="prog-card-desc">
                                    @(string.IsNullOrWhiteSpace(prog.ProgramDescription) ? "Academic program curriculum and courses" : prog.ProgramDescription)
                                </div>

                                <div class="prog-card-badges">
                                    @if (prog.CourseCount > 0)
                                    {
                                        <span class="p-badge courses">
                                            <i class="fas fa-book"></i> @prog.CourseCount Course(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="p-badge none text-warning">
                                            <i class="fas fa-exclamation-triangle"></i> 0 Courses
                                        </span>
                                    }

                                    @if (prog.NoOfSemester > 0)
                                    {
                                        <span class="p-badge semesters">
                                            <i class="fas fa-calendar-alt"></i> @prog.NoOfSemester Semesters
                                        </span>
                                    }

                                    @if (prog.EnrolledStudentCount > 0)
                                    {
                                        <span class="p-badge students">
                                            <i class="fas fa-users"></i> @prog.EnrolledStudentCount Enrolled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="p-badge none">
                                            <i class="fas fa-user-slash"></i> 0 Enrolled
                                        </span>
                                    }
                                </div>

                                @if (prog.CourseCount == 0)
                                {
                                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small" style="border-radius:8px; font-size:11px;">
                                        <i class="fas fa-info-circle me-1"></i> Add courses to this program in Course Structure
                                    </div>
                                }
                            </div>

                            <div class="prog-card-footer">
                                <button type="button" class="btn-studio-open open-studio-btn" data-program-id="@prog.ProgramId">
                                    <i class="fas fa-cog"></i> Manage & Enroll
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ── SECTION 2: Individual Courses Table ── *@
    <div id="sectionCourses" style="display:none;">
        <div class="course-table-card">
            <div class="table-responsive">
                <table class="table course-table">
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Title</th>
                            <th>Program</th>
                            <th>Semester</th>
                            <th>Enrolled Students</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="courseTableBody">
                        @foreach (var c in Model.Courses)
                        {
                            <tr class="course-row" data-code="@c.CourseCode.ToLower()" data-name="@c.CourseName.ToLower()" data-prog="@c.ProgramName.ToLower()">
                                <td>
                                    <span class="badge bg-light text-primary border fw-bold px-2 py-1">@c.CourseCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@c.CourseName</div>
                                </td>
                                <td>
                                    <span class="text-secondary small">@c.ProgramName</span>
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border">@c.SemesterName</span>
                                </td>
                                <td>
                                    @if (c.EnrolledStudentCount > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border px-2 py-1 fw-bold">
                                            <i class="fas fa-users me-1"></i> @c.EnrolledStudentCount Students
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No students</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold open-studio-btn" data-course-id="@c.CourseId" style="border-radius:8px;">
                                        <i class="fas fa-user-plus me-1"></i> Manage Enrollment
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@* ── Unified Enrollment Studio Modal ── *@
<div class="modal fade" id="enrollmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 20px; overflow: hidden; border: none; box-shadow: 0 25px 50px rgba(0,0,0,0.25);">
            <div class="modal-body" id="enrollmentModalBody" style="padding:0; min-height: 480px;">
                <div class="text-center text-muted py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-3 fw-bold">Loading Enrollment Studio...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleView(mode) {
            if (mode === 'programs') {
                $('#btnViewPrograms').addClass('active');
                $('#btnViewCourses').removeClass('active');
                $('#sectionPrograms').show();
                $('#sectionCourses').hide();
            } else {
                $('#btnViewCourses').addClass('active');
                $('#btnViewPrograms').removeClass('active');
                $('#sectionCourses').show();
                $('#sectionPrograms').hide();
            }
        }

        // Live Search Filter for both views
        $('#mainEnrollSearch').on('input', function () {
            var q = $(this).val().toLowerCase().trim();

            // Filter Program Cards
            $('.prog-card-col').each(function () {
                var title = $(this).data('title') || '';
                var desc = $(this).data('desc') || '';
                $(this).toggle(title.indexOf(q) > -1 || desc.indexOf(q) > -1);
            });

            // Filter Course Rows
            $('.course-row').each(function () {
                var code = $(this).data('code') || '';
                var name = $(this).data('name') || '';
                var prog = $(this).data('prog') || '';
                $(this).toggle(code.indexOf(q) > -1 || name.indexOf(q) > -1 || prog.indexOf(q) > -1);
            });
        });

        // Open Unified Studio Modal (Works for both Program and Course)
        $(document).on('click', '.open-studio-btn', function () {
            var progId = $(this).data('program-id');
            var courseId = $(this).data('course-id');
            var query = courseId ? `courseId=${courseId}` : `programId=${progId}`;

            $('#enrollmentModalBody').html(`
                <div class="text-center text-muted py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-3 fw-bold">Loading Enrollment Studio...</div>
                </div>
            `);
            $('#enrollmentModal').modal('show');

            $('#enrollmentModalBody').load(`/Admin/CourseEnrollment/Studio?${query}`);
        });
    </script>
}
