@model IEnumerable<TMS.Web.Areas.Admin.Controllers.ProgramEnrollmentSummaryVM>
@{
    ViewData["Title"] = "Program Enrollment Management";
}

<style>
    .enrollment-container { max-width: 1200px; margin: 0 auto; }
    .enrollment-hero {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #7c3aed 100%);
        border-radius: 20px; padding: 30px 40px; color: white; margin-bottom: 24px;
        position: relative; overflow: hidden;
    }
    .enrollment-hero::before {
        content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
        background: rgba(255,255,255,0.05); border-radius: 50%;
    }
    .enrollment-hero h2 { font-weight: 800; margin-bottom: 4px; position: relative; }
    .enrollment-hero p { opacity: 0.85; font-size: 14px; margin: 0; position: relative; }

    .program-card {
        background: white; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04); transition: all 0.3s; overflow: hidden;
    }
    .program-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .program-card .card-top { padding: 20px 24px; }
    .program-card .card-bottom {
        padding: 12px 24px; background: #f8fafc; border-top: 1px solid #f1f5f9;
        display: flex; gap: 8px; justify-content: flex-end;
    }

    .program-name { font-weight: 700; font-size: 17px; color: #1e293b; margin-bottom: 6px; }
    .program-desc { font-size: 12px; color: #64748b; margin-bottom: 10px; min-height: 18px; }

    .stat-row { display: flex; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .stat-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
    }
    .stat-pill.courses { background: #eff6ff; color: #3b82f6; }
    .stat-pill.semesters { background: #fef3c7; color: #d97706; }
    .stat-pill.students { background: #f0fdf4; color: #16a34a; }
    .stat-pill.no-students { background: #f8fafc; color: #94a3b8; }

    .btn-manage {
        background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none;
        padding: 8px 18px; border-radius: 10px; font-weight: 600; font-size: 13px; transition: all 0.2s;
    }
    .btn-manage:hover { transform: translateY(-1px); color: white; box-shadow: 0 4px 12px rgba(99,102,241,0.3); }
    .btn-view {
        background: white; color: #6366f1; border: 1px solid #6366f1;
        padding: 8px 18px; border-radius: 10px; font-weight: 600; font-size: 13px; transition: all 0.2s;
    }
    .btn-view:hover { background: #eef2ff; }
</style>

<div class="enrollment-container">

    @* ── Hero ── *@
    <div class="enrollment-hero">
        <h2><i class="fas fa-graduation-cap me-2"></i>Program Enrollment</h2>
        <p>Select a program to enroll students. Students enrolled in a program automatically get access to all its courses.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-folder-open" style="font-size:48px; color:#cbd5e1;"></i>
            <h5 class="mt-3 fw-bold text-muted">No Programs Found</h5>
            <p class="text-muted">Create programs first via <strong>Programs Offered</strong> menu.</p>
        </div>
    }
    else
    {
        @* ── Program Grid ── *@
        <div class="row g-3">
            @foreach (var program in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="program-card">
                        <div class="card-top">
                            <div class="program-name">
                                <i class="fas fa-book-reader me-1" style="color:#6366f1;"></i>
                                @program.ProgramName
                            </div>
                            <div class="program-desc">@(program.ProgramDescription ?? "")</div>
                            <div class="stat-row">
                                <span class="stat-pill courses">
                                    <i class="fas fa-book"></i> @program.CourseCount Courses
                                </span>
                                @if (program.NoOfSemester > 0)
                                {
                                    <span class="stat-pill semesters">
                                        <i class="fas fa-calendar-alt"></i> @program.NoOfSemester Semesters
                                    </span>
                                }
                                @if (program.EnrolledStudentCount > 0)
                                {
                                    <span class="stat-pill students">
                                        <i class="fas fa-users"></i> @program.EnrolledStudentCount Students
                                    </span>
                                }
                                else
                                {
                                    <span class="stat-pill no-students">
                                        <i class="fas fa-user-slash"></i> No students
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-bottom">
                            <button class="btn-view view-enrollment" data-id="@program.ProgramId">
                                <i class="fas fa-eye"></i> View
                            </button>
                            <button class="btn-manage manage-enrollment" data-id="@program.ProgramId">
                                <i class="fas fa-user-plus"></i> Enroll Students
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Enrollment Modal -->
<div class="modal fade" id="enrollmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background:#f8fafc; border-bottom: 1px solid #e2e8f0;">
                <h5 class="modal-title fw-bold">Manage Enrollment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="enrollmentModalBody" style="padding:0;">
                <div class="text-center text-muted py-5">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Manage enrollment - now passes programId
        $(document).on("click", ".manage-enrollment", function () {
            const id = $(this).data("id");
            $("#enrollmentModalBody").load(`/Admin/CourseEnrollment/ManageMapping?programId=${id}`, function () {
                $("#enrollmentModal").modal("show");
            });
        });

        // View enrollment - now passes programId
        $(document).on("click", ".view-enrollment", function () {
            const id = $(this).data("id");
            $("#enrollmentModalBody").load(`/Admin/CourseEnrollment/ViewMapping?programId=${id}`, function () {
                $("#enrollmentModal").modal("show");
            });
        });
    </script>
}
