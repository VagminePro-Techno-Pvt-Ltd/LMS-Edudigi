@model TMS.ViewModels.Masters.CourseFacultyMapViewModel

@{
    var facultyList = ViewBag.FacultyList as List<SelectListItem> ?? new List<SelectListItem>();
    var totalFaculty = facultyList.Count;
    var assignedCount = facultyList.Count(f => f.Selected);
}

<style>
    .manage-fmap-shell {
        color: #1e293b;
    }
    .manage-fmap-header {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 16px;
    }
    .fmap-modal-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.82rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(67, 56, 202, 0.2);
    }
    .faculty-table-container {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        max-height: 380px;
        overflow-y: auto;
        background: #ffffff;
    }
    .faculty-row {
        transition: background 0.15s ease;
        cursor: pointer;
    }
    .faculty-row:hover {
        background: #f8fafc !important;
    }
    .faculty-row.is-selected {
        background: #f0fdf4;
    }
    .modal-filter-btn {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s;
    }
    .modal-filter-btn.active {
        background: #4338ca;
        color: #fff;
        border-color: #4338ca;
    }
</style>

<div class="manage-fmap-shell p-1">
    <div class="manage-fmap-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <span class="badge bg-indigo bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 mb-1 font-monospace" style="font-size: 0.8rem;">
                @(ViewBag.CourseCode ?? "COURSE")
            </span>
            <h5 class="mb-0 fw-bold text-dark">@ViewBag.CourseName</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold" id="assignedCounterBadge">
                <i class="fa fa-user-check me-1"></i> <span id="currentAssignedCount">@assignedCount</span> / @totalFaculty Assigned
            </span>
        </div>
    </div>

    <form id="mappingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CourseId" value="@Model.CourseId" />

        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
            <div class="input-group input-group-sm" style="max-width: 260px;">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa fa-search"></i></span>
                <input type="text" id="facultySearchInput" class="form-control border-start-0 bg-light" placeholder="Search instructor or email..." />
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="d-flex gap-1">
                    <button type="button" class="modal-filter-btn active" data-filter="all">All</button>
                    <button type="button" class="modal-filter-btn" data-filter="selected">Assigned</button>
                    <button type="button" class="modal-filter-btn" data-filter="unselected">Unassigned</button>
                </div>
                <div class="btn-group btn-group-sm ms-2">
                    <button type="button" class="btn btn-outline-primary" id="btnSelectAllFaculty" title="Select All Visible">
                        <i class="fa fa-check-double me-1"></i>All
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btnClearAllFaculty" title="Clear Selection">
                        <i class="fa fa-times me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="faculty-table-container shadow-sm">
            <table class="table table-hover align-middle mb-0" id="facultySelectTable">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width: 50px;" class="text-center">
                            <i class="fa fa-check text-muted"></i>
                        </th>
                        <th>Instructor / Faculty Profile</th>
                        <th class="text-end pe-4" style="width: 140px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!facultyList.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                <i class="fa fa-user-slash fa-2x mb-2 text-secondary opacity-50"></i>
                                <p class="mb-0">No eligible instructors found in system.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var f in facultyList)
                    {
                        var isChecked = f.Selected;
                        var rawText = f.Text ?? "";
                        var emailMatch = System.Text.RegularExpressions.Regex.Match(rawText, @"\((.*?)\)");
                        var email = emailMatch.Success ? emailMatch.Groups[1].Value : "";
                        var nameOnly = emailMatch.Success ? rawText.Replace($"({email})", "").Trim() : rawText;
                        var initials = nameOnly.Length >= 2 ? nameOnly.Substring(0, 2).ToUpper() : "FC";

                        <tr class="faculty-row @(isChecked ? "is-selected" : "")" data-selected="@(isChecked ? "true" : "false")">
                            <td class="text-center">
                                <input type="checkbox" name="FacultyIds" value="@f.Value" class="form-check-input faculty-checkbox" @(isChecked ? "checked" : "") style="width:18px;height:18px;cursor:pointer;" />
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="fmap-modal-avatar">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="fw-bold faculty-name" style="font-size: 0.92rem; color: #1e293b;">@nameOnly</div>
                                        @if (!string.IsNullOrEmpty(email))
                                        {
                                            <div class="small text-muted faculty-email" style="font-size: 0.78rem;">
                                                <i class="fa fa-envelope me-1 opacity-75"></i>@email
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge rounded-pill @(isChecked ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-light text-muted border") px-3 py-1 status-badge-@f.Value" style="font-size:0.75rem;">
                                    <i class="fa @(isChecked ? "fa-circle-check" : "fa-circle-minus") me-1"></i>
                                    @(isChecked ? "Assigned" : "Not Assigned")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="saveMappingAlert" class="mt-3"></div>

        <div class="sticky-bottom bg-white d-flex justify-content-between align-items-center mt-3 pt-3 pb-2 border-top" style="z-index: 1050; position: sticky; bottom: -1rem; margin-left: -0.5rem; margin-right: -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem;">
            <span class="text-muted small"><i class="fa fa-info-circle text-primary me-1"></i>Changes will update instructor course assignments immediately.</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary fw-bold px-4 shadow" id="btnSaveFacultyMapping" style="background: linear-gradient(135deg, #4338ca 0%, #3b82f6 100%); border:none; min-width: 150px;">
                    <i class="fa fa-floppy-disk me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    $(function () {
        function updateAssignedCount() {
            var count = $(".faculty-checkbox:checked").length;
            $("#currentAssignedCount").text(count);
        }

        function applyModalFilters() {
            var q = $("#facultySearchInput").val().toLowerCase();
            var filter = $(".modal-filter-btn.active").data("filter");

            $(".faculty-row").each(function () {
                var name = $(this).find(".faculty-name").text().toLowerCase();
                var email = $(this).find(".faculty-email").text().toLowerCase();
                var isChecked = $(this).find(".faculty-checkbox").is(":checked");

                var matchesQuery = name.indexOf(q) > -1 || email.indexOf(q) > -1;
                var matchesFilter = (filter === "all") ||
                                    (filter === "selected" && isChecked) ||
                                    (filter === "unselected" && !isChecked);

                $(this).toggle(matchesQuery && matchesFilter);
            });
        }

        // Row click triggers checkbox
        $("#facultySelectTable tbody").on("click", "tr.faculty-row", function (e) {
            if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL') {
                var cb = $(this).find(".faculty-checkbox");
                cb.prop("checked", !cb.prop("checked")).trigger("change");
            }
        });

        // Checkbox status badge update
        $(".faculty-checkbox").on("change", function () {
            var val = $(this).val();
            var isChecked = $(this).is(":checked");
            var row = $(this).closest(".faculty-row");
            var badge = $(".status-badge-" + val);

            row.attr("data-selected", isChecked ? "true" : "false");

            if (isChecked) {
                row.addClass("is-selected");
                badge.attr("class", "badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 status-badge-" + val)
                     .html('<i class="fa fa-circle-check me-1"></i> Assigned');
            } else {
                row.removeClass("is-selected");
                badge.attr("class", "badge rounded-pill bg-light text-muted border px-3 py-1 status-badge-" + val)
                     .html('<i class="fa fa-circle-minus me-1"></i> Not Assigned');
            }
            updateAssignedCount();
        });

        // Select All / Clear All
        $("#btnSelectAllFaculty").on("click", function () {
            $(".faculty-row:visible .faculty-checkbox").prop("checked", true).trigger("change");
        });

        $("#btnClearAllFaculty").on("click", function () {
            $(".faculty-row:visible .faculty-checkbox").prop("checked", false).trigger("change");
        });

        // Filter buttons (All / Selected / Unselected)
        $(".modal-filter-btn").on("click", function () {
            $(".modal-filter-btn").removeClass("active");
            $(this).addClass("active");
            applyModalFilters();
        });

        // Real-time search filter
        $("#facultySearchInput").on("keyup", function () {
            applyModalFilters();
        });

        // AJAX Form Submission
        $("#mappingForm").on("submit", function (e) {
            e.preventDefault();
            var btn = $("#btnSaveFacultyMapping");
            btn.prop("disabled", true).html('<i class="fa fa-spinner fa-spin me-1"></i> Saving...');
            $("#saveMappingAlert").empty();

            $.ajax({
                url: "/Admin/FacultyMapping/SaveMapping",
                method: "POST",
                data: $(this).serialize(),
                success: function (res) {
                    if (typeof res === 'string') {
                        try { res = JSON.parse(res); } catch (e) {}
                    }
                    var isSuccess = res && (res.success === true || res.Success === true || res.status === true || res.Status === true);
                    var msg = (res && (res.message || res.Message || res.msg || res.Msg)) || (isSuccess ? "Mappings updated successfully." : "Failed to save mapping.");

                    if (isSuccess) {
                        $("#saveMappingAlert").html('<div class="alert alert-success py-2 d-flex align-items-center gap-2"><i class="fa fa-check-circle"></i><span>' + msg + '</span></div>');
                        setTimeout(function () {
                            $("#mappingModal").modal("hide");
                            location.reload();
                        }, 800);
                    } else {
                        $("#saveMappingAlert").html('<div class="alert alert-danger py-2 d-flex align-items-center gap-2"><i class="fa fa-triangle-exclamation"></i><span>' + msg + '</span></div>');
                    }
                },
                error: function () {
                    $("#saveMappingAlert").html('<div class="alert alert-danger py-2">Server error occurred. Please try again.</div>');
                },
                complete: function () {
                    btn.prop("disabled", false).html('<i class="fa fa-floppy-disk me-1"></i> Save Changes');
                }
            });
        });
    });
</script>
