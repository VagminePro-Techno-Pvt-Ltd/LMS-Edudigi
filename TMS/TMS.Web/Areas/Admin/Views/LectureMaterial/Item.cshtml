@model TMS.ViewModels.Masters.LectureMaterialViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Content" : "Upload Content";
}

<link rel="stylesheet" href="~/css/content-library.css" />

<style>
    .upload-shell { padding: 24px 20px 40px; }
    .upload-card { max-width: 1180px; margin: 0 auto; }
    .upload-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    #courseAssignmentSection { margin-top: 18px; }
    .assignment-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .assignment-grid .assignment-full { grid-column: 1 / -1; }
    #courseSelect { min-height: 150px; }
    .cascade-status { min-height: 18px; margin-top: 5px; font-size: 12px; color: #64748b; }
    .form-select:disabled { background-color: #f8fafc; cursor: not-allowed; }
    @@media (max-width: 768px) {
        .upload-form-grid, .assignment-grid { grid-template-columns: 1fr; }
        .assignment-grid .assignment-full { grid-column: auto; }
        .upload-shell { padding: 14px 10px 28px; }
    }
</style>

<div class="upload-shell">
    <div class="upload-card">
        <!-- HEADER -->
        <div class="upload-header">
            <div>
                <h2 class="upload-title">
                    <i class="fa fa-cloud-upload-alt"></i>
                    @(Model.Id > 0 ? "Edit Content" : "Upload to Central Library")
                </h2>
                <p class="upload-subtitle">Content is stored in the Central Library and can be assigned to courses.</p>
            </div>
            <a href="@Url.Action("Index")" class="upload-back-btn">
                <i class="fa fa-arrow-left"></i> Back to Library
            </a>
        </div>

        <form asp-action="Item" method="post" enctype="multipart/form-data" id="uploadForm">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FilePath" id="hiddenFilePath" />
            <input type="hidden" asp-for="Source" id="hiddenSource" />
            <input type="hidden" asp-for="ExternalFileId" id="hiddenExternalFileId" />
            <input type="hidden" asp-for="OriginalFileName" id="hiddenOriginalFileName" />
            <input type="hidden" asp-for="MimeType" id="hiddenMimeType" />
            <input type="hidden" asp-for="FileSizeBytes" id="hiddenFileSizeBytes" />

            <!-- ═══════ STEP 1: SOURCE SELECTION ═══════ -->
            <div class="upload-section">
                <h3 class="upload-section-title">
                    <span class="upload-step-badge">1</span>
                    Choose Upload Source
                </h3>
                <div class="source-tabs">
                    <div class="source-tab active" data-source="Local">
                        <div class="source-tab-icon">📁</div>
                        <div class="source-tab-label">My Computer</div>
                        <div class="source-tab-desc">Upload from local files</div>
                    </div>
                    <div class="source-tab" data-source="GoogleDrive">
                        <div class="source-tab-icon">
                            <svg viewBox="0 0 87.3 78" width="28" height="28">
                                <path d="M6.6 66.85L30.3 25.9 54 66.85z" fill="#0066DA"/>
                                <path d="M30.3 25.9L54 66.85 77.7 25.9z" fill="#00AC47"/>
                                <path d="M54 66.85l23.7-40.95L54 0 30.3 25.9z" fill="#EA4335"/>
                                <path d="M6.6 66.85L30.3 25.9 6.6 25.9z" fill="#00832D"/>
                                <path d="M54 66.85H6.6L30.3 25.9z" fill="#2684FC"/>
                                <path d="M77.7 25.9L54 66.85h23.7z" fill="#FFBA00"/>
                            </svg>
                        </div>
                        <div class="source-tab-label">Google Drive</div>
                        <div class="source-tab-desc">Select from Drive</div>
                    </div>
                    <div class="source-tab" data-source="OneDrive">
                        <div class="source-tab-icon">
                            <svg viewBox="0 0 24 24" width="28" height="28">
                                <path d="M10.6 6C9.1 6 7.7 6.7 6.8 7.8 5 8.1 3.5 9.4 3 11.1 1.3 11.7 0 13.3 0 15.2 0 17.5 1.8 19.5 4.1 19.7H10V13h7v-1.5c0-3-2.5-5.5-5.5-5.5z" fill="#0364B8"/>
                                <path d="M10 19.7h8.9c2.8-.2 5.1-2.5 5.1-5.4 0-2.7-2-5-4.6-5.3-.5-1.9-2.1-3.4-4-3.8-.5-.1-1-.2-1.5-.2-2 0-3.8 1.1-4.8 2.7C8.6 8 8 8.4 7.5 9 6.2 9.4 5.2 10.5 4.8 11.8c-.1.3-.2.7-.2 1.1 0 .4.1.7.1 1.1.8-.6 1.8-1 2.8-1H10z" fill="#0078D4"/>
                                <path d="M17 13v6.7h1.9c.4 0 .7 0 1.1-.1 2.5-.4 4.3-2.5 4-5.1-.1-.6-.2-1.1-.5-1.6H17z" fill="#1490DF"/>
                                <path d="M10 13H7.5c-1 0-2 .4-2.7 1-.5.5-.9 1.1-1.1 1.8-.3.9-.2 1.9.2 2.8.6 1.2 1.9 2 3.3 2.1H10z" fill="#28A8EA"/>
                            </svg>
                        </div>
                        <div class="source-tab-label">OneDrive</div>
                        <div class="source-tab-desc">Select from OneDrive</div>
                    </div>
                </div>

                <!-- Cloud file info display (shown after selection) -->
                <div id="cloudFileInfo" class="cloud-file-info" style="display:none;">
                    <div class="cloud-file-badge">
                        <i class="fa fa-cloud-download-alt"></i>
                        <span id="cloudFileName">No file selected</span>
                        <button type="button" class="cloud-file-remove" id="removeCloudFile">✕</button>
                    </div>
                </div>
            </div>

            <!-- ═══════ STEP 2: CONTENT DETAILS ═══════ -->
            <div class="upload-section">
                <h3 class="upload-section-title">
                    <span class="upload-step-badge">2</span>
                    Content Details
                </h3>

                <div class="upload-form-grid">
                    <!-- Material Type -->
                    <div class="mb-3">
                        <label asp-for="MaterialType" class="form-label fw-bold">Material Type</label>
                        <select asp-for="MaterialType" class="form-select" id="MaterialType">
                            <option value="">-- Select Material Type --</option>
                            <option value="Video" selected="@(Model.MaterialType == "Video" ? "selected" : null)">🎥 Video</option>
                            <option value="Document" selected="@(Model.MaterialType == "Document" ? "selected" : null)">📄 Document</option>
                            <option value="VideoURL" selected="@(Model.MaterialType == "VideoURL" ? "selected" : null)">🔗 Video URL</option>
                        </select>
                        <span asp-validation-for="MaterialType" class="text-danger"></span>
                    </div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Enter content title..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <!-- Upload File (Local Source) -->
                <div class="mb-3" id="uploadSection">
                    <label class="form-label fw-bold">Upload File</label>
                    <div class="upload-dropzone" id="dropZone">
                        <div class="dropzone-icon">📤</div>
                        <p class="dropzone-text">Drag & drop your file here, or <span class="dropzone-browse">browse</span></p>
                        <p class="dropzone-hint">Supported: PDF, MP4, DOCX, PPTX, JPG, PNG, XLSX (Max 100MB)</p>
                        <input type="file" name="uploadFile" class="dropzone-input" id="fileInput" />
                    </div>
                    <div id="fileSelected" class="file-selected-info" style="display:none;">
                        <i class="fa fa-file"></i>
                        <span id="selectedFileName"></span>
                        <span id="selectedFileSize"></span>
                        <button type="button" class="cloud-file-remove" id="removeLocalFile">✕</button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.FilePath) && Model.Source == "Local" && Model.MaterialType != "VideoURL")
                    {
                        <p class="mt-2">
                            <i class="fa fa-check-circle text-success"></i>
                            Current File: <a href="@Model.FilePath" target="_blank">View</a>
                        </p>
                    }
                </div>

                <!-- Video URL -->
                <div class="mb-3" id="videoUrlSection" style="display:none;">
                    <label asp-for="ContentPath" class="form-label fw-bold">Video URL</label>
                    <input asp-for="ContentPath" class="form-control" placeholder="https://youtube.com/watch?v=..." />
                    <span asp-validation-for="ContentPath" class="text-danger"></span>
                </div>
            </div>

            <!-- ═══════ STEP 3: COURSE ASSIGNMENT ═══════ -->
            <div class="upload-section">
                <h3 class="upload-section-title">
                    <span class="upload-step-badge">3</span>
                    Course Assignment
                </h3>

                <div class="assign-toggle-wrap">
                    <label class="assign-toggle">
                        <input type="checkbox" asp-for="AssignToCourse" id="assignToggle" />
                        <span class="assign-toggle-slider"></span>
                    </label>
                    <div class="assign-toggle-label">
                        <span class="fw-bold">Assign to Course(s)</span>
                        <span class="text-muted" style="font-size:12px;">
                            If unchecked, content will be stored only in the Central Library for future use
                        </span>
                    </div>
                </div>

                <div id="courseAssignmentSection" style="@(Model.AssignToCourse ? "" : "display:none;")">
                    <div class="assignment-grid">
                    <!-- Courses -->
                    <div class="mb-3 assignment-full">
                        <label class="form-label fw-bold">Courses (Select multiple if needed)</label>
                        <select name="SelectedCourseIds" multiple class="form-select" size="5" id="courseSelect">
                            @if (ViewBag.CourseId != null)
                            {
                                var courses = (IEnumerable<TMS.ViewModels.Masters.CourseMasterViewModel>)ViewBag.CourseId;
                                foreach (var course in courses)
                                {
                                    <option value="@course.Id"
                                            selected="@(Model.SelectedCourseIds != null && Model.SelectedCourseIds.Contains(course.Id) ? "selected" : null)">
                                        @course.Name
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SelectedCourseIds" class="text-danger"></span>
                    </div>

                    <!-- Semester -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Semester</label>
                        <select asp-for="SemesterId" class="form-select" id="semesterSelect">
                            <option value="">-- Select Semester --</option>
                            @if (ViewBag.SemesterId != null)
                            {
                                var semesters = (IEnumerable<TMS.ViewModels.Masters.SemesterMasterViewModel>)ViewBag.SemesterId;
                                foreach (var sem in semesters)
                                {
                                    <option value="@sem.Id">@sem.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SemesterId" class="text-danger"></span>
                    </div>

                    <!-- Subject -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Subject</label>
                        <select asp-for="SubjectId" class="form-select" id="subjectSelect" disabled>
                            <option value="">-- Select Subject --</option>
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                        <div id="subjectStatus" class="cascade-status"></div>
                    </div>

                    <!-- Unit -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unit</label>
                        <select asp-for="UnitId" class="form-select" id="unitSelect" disabled>
                            <option value="">-- Select Unit (Optional) --</option>
                        </select>
                        <span asp-validation-for="UnitId" class="text-danger"></span>
                        <div id="unitStatus" class="cascade-status"></div>
                    </div>

                    <!-- Quadrant -->
                    <div class="mb-3">
                        <label asp-for="CourseQuadrantId" class="form-label fw-bold">Quadrant</label>
                        <select asp-for="CourseQuadrantId" class="form-select">
                            <option value="">-- Select Quadrant --</option>
                            @if (ViewBag.QuadrantId != null)
                            {
                                var quadrants = (IEnumerable<TMS.ViewModels.Masters.CourseQuadrantViewModel>)ViewBag.QuadrantId;
                                foreach (var q in quadrants)
                                {
                                    if (q.Id == Model.CourseQuadrantId)
                                    {
                                        <option value="@q.Id" selected>@q.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@q.Id">@q.Name</option>
                                    }
                                }
                            }
                        </select>
                        <span asp-validation-for="CourseQuadrantId" class="text-danger"></span>
                    </div>
                    </div>
                </div>
            </div>

            @if (Model.Id > 0)
            {
                <!-- Active Checkbox -->
                <div class="upload-section">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            }

            <!-- ACTIONS -->
            <div class="upload-actions">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                    <i class="fa fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg upload-save-btn">
                    <i class="fa fa-save"></i>
                    @(Model.Id > 0 ? "Update Content" : "Save to Library")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // ═══════ SOURCE TAB SELECTION ═══════
            $('.source-tab').on('click', function () {
                $('.source-tab').removeClass('active');
                $(this).addClass('active');
                var source = $(this).data('source');
                $('#hiddenSource').val(source);

                if (source === 'Local') {
                    $('#uploadSection').show();
                    $('#cloudFileInfo').hide();
                } else {
                    $('#uploadSection').hide();
                    // Trigger cloud picker
                    openCloudPicker(source);
                }
            });

            // ═══════ MATERIAL TYPE TOGGLE ═══════
            function toggleSections() {
                var type = $("#MaterialType").val();
                var source = $('#hiddenSource').val() || 'Local';

                if (type === "VideoURL") {
                    $('#hiddenSource').val('Local');
                    $('.source-tab').removeClass('active');
                    $('.source-tab[data-source="Local"]').addClass('active');
                    $("#uploadSection").hide();
                    $("#videoUrlSection").show();
                    $('.source-tabs').hide();
                    $('#cloudFileInfo').hide();
                } else if (type === "Video" || type === "Document") {
                    $("#videoUrlSection").hide();
                    $('.source-tabs').show();
                    if (source === 'Local') {
                        $("#uploadSection").show();
                    }
                } else {
                    $("#uploadSection").hide();
                    $("#videoUrlSection").hide();
                    $('.source-tabs').show();
                }
            }
            toggleSections();
            $("#MaterialType").change(toggleSections);

            // ═══════ ASSIGN TO COURSE TOGGLE ═══════
            $('#assignToggle').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#courseAssignmentSection').slideDown(300);
                } else {
                    $('#courseAssignmentSection').slideUp(300);
                }
            });

            // ═══════ DRAG & DROP + FILE INPUT ═══════
            var dropZone = document.getElementById('dropZone');
            var fileInput = document.getElementById('fileInput');

            if (dropZone) {
                dropZone.addEventListener('click', function () {
                    fileInput.click();
                });

                dropZone.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    dropZone.classList.add('dragover');
                });

                dropZone.addEventListener('dragleave', function () {
                    dropZone.classList.remove('dragover');
                });

                dropZone.addEventListener('drop', function (e) {
                    e.preventDefault();
                    dropZone.classList.remove('dragover');
                    if (e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        showSelectedFile(e.dataTransfer.files[0]);
                    }
                });

                fileInput.addEventListener('change', function () {
                    if (fileInput.files.length > 0) {
                        showSelectedFile(fileInput.files[0]);
                    }
                });
            }

            function showSelectedFile(file) {
                var sizeStr = file.size > 1048576
                    ? (file.size / 1048576).toFixed(1) + ' MB'
                    : (file.size / 1024).toFixed(0) + ' KB';
                $('#selectedFileName').text(file.name);
                $('#selectedFileSize').text('(' + sizeStr + ')');
                $('#fileSelected').show();
                $('#dropZone').hide();
            }

            $('#removeLocalFile').on('click', function () {
                fileInput.value = '';
                $('#fileSelected').hide();
                $('#dropZone').show();
            });

            // ═══════ CLOUD PICKER (Placeholder Integration) ═══════
            function openCloudPicker(source) {
                if (source === 'GoogleDrive') {
                    // Google Picker API: requires API key + Client ID setup
                    // For now, show an informational message
                    showCloudPickerPrompt('Google Drive', source);
                } else if (source === 'OneDrive') {
                    // OneDrive Picker: requires App ID setup
                    showCloudPickerPrompt('OneDrive', source);
                }
            }

            function showCloudPickerPrompt(name, source) {
                // Simulate cloud picker for now — in production, replace with actual API integration
                var fileName = prompt(name + ' integration requires API keys.\n\nFor demo, enter a file URL from ' + name + ':');
                if (fileName && fileName.trim()) {
                    $('#hiddenFilePath').val(fileName.trim());
                    $('#hiddenSource').val(source);
                    $('#hiddenExternalFileId').val('cloud_' + Date.now());
                    $('#hiddenOriginalFileName').val(fileName.split('/').pop() || 'cloud-file');

                    $('#cloudFileName').text(fileName.split('/').pop() || fileName);
                    $('#cloudFileInfo').show();
                }
            }

            $('#removeCloudFile').on('click', function () {
                $('#hiddenFilePath').val('');
                $('#hiddenExternalFileId').val('');
                $('#cloudFileInfo').hide();
                $('#hiddenSource').val('Local');
                $('.source-tab').removeClass('active');
                $('.source-tab[data-source="Local"]').addClass('active');
                $('#uploadSection').show();
            });

            // Set initial source tab based on model
            var currentSource = '@Model.Source';
            if (currentSource && currentSource !== 'Local') {
                $('.source-tab').removeClass('active');
                $(`.source-tab[data-source="${currentSource}"]`).addClass('active');
                $('#uploadSection').hide();
                if ('@Model.ExternalFileId') {
                    $('#cloudFileName').text('@Model.OriginalFileName' || 'Cloud File');
                    $('#cloudFileInfo').show();
                }
            }

            // ═══════ CASCADING DROPDOWNS ═══════
            const getSubjectsUrl = '@Url.Action("GetSubjects", "LectureMaterial", new { area = "Admin" })';
            const getUnitsUrl = '@Url.Action("GetUnits", "LectureMaterial", new { area = "Admin" })';
            const initialSubjectId = '@(Model.SubjectId?.ToString() ?? "")';
            const initialUnitId = '@(Model.UnitId?.ToString() ?? "")';

            function resetSubjects(message) {
                $('#subjectSelect')
                    .prop('disabled', true)
                    .empty()
                    .append('<option value="">-- Select Subject --</option>');
                $('#subjectStatus').text(message || '');
            }

            function resetUnits(message) {
                $('#unitSelect')
                    .prop('disabled', true)
                    .empty()
                    .append('<option value="">-- Select Unit (Optional) --</option>');
                $('#unitStatus').text(message || '');
            }

            function loadUnits(subjectId, selectedUnitId) {
                resetUnits(subjectId ? 'Loading units...' : '');
                if (!subjectId) return;

                $.ajax({
                    url: getUnitsUrl,
                    type: 'GET',
                    data: { subjectId: subjectId },
                    cache: false
                }).done(function (data) {
                    const $unit = $('#unitSelect');
                    $unit.empty().append('<option value="">-- Select Unit (Optional) --</option>');

                    if (Array.isArray(data)) {
                        data.forEach(function (item) {
                            $unit.append($('<option>', { value: item.id, text: item.name || '' }));
                        });
                    }

                    $unit.prop('disabled', false);
                    $('#unitStatus').text(data && data.length ? '' : 'No units found for this subject.');

                    if (selectedUnitId) $unit.val(selectedUnitId);
                }).fail(function () {
                    resetUnits('Unable to load units. Please try again.');
                });
            }

            function loadSubjects(semesterId, selectedSubjectId, selectedUnitId) {
                resetSubjects(semesterId ? 'Loading subjects...' : '');
                resetUnits('');
                if (!semesterId) return;

                $.ajax({
                    url: getSubjectsUrl,
                    type: 'GET',
                    data: { semesterId: semesterId },
                    cache: false
                }).done(function (data) {
                    const $subject = $('#subjectSelect');
                    $subject.empty().append('<option value="">-- Select Subject --</option>');

                    if (Array.isArray(data)) {
                        data.forEach(function (item) {
                            const text = (item.code ? item.code + ' - ' : '') + (item.name || '');
                            $subject.append($('<option>', { value: item.id, text: text }));
                        });
                    }

                    $subject.prop('disabled', false);
                    $('#subjectStatus').text(data && data.length ? '' : 'No subjects found for this semester.');

                    if (selectedSubjectId) {
                        $subject.val(selectedSubjectId);
                        if ($subject.val()) loadUnits(selectedSubjectId, selectedUnitId);
                    }
                }).fail(function () {
                    resetSubjects('Unable to load subjects. Please try again.');
                    resetUnits('');
                });
            }

            $('#semesterSelect').on('change', function () {
                loadSubjects($(this).val(), '', '');
            });

            $('#subjectSelect').on('change', function () {
                loadUnits($(this).val(), '');
            });

            if ($('#semesterSelect').val()) {
                loadSubjects($('#semesterSelect').val(), initialSubjectId, initialUnitId);
            } else {
                resetSubjects('');
                resetUnits('');
            }
        });
    </script>
}
