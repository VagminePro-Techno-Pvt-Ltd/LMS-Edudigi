@using TMS
@model List<TMS.ViewModels.Academics.GlobalLibraryItemViewModel>

@{
    var permissions = ViewContext.HttpContext.GetFormPermissions();
    var controller = Convert.ToString(ViewContext.RouteData.Values["controller"]);
}

<div class="gl-header d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="rounded-3 p-2 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center">
                <i class="fa fa-boxes-stacked fs-5"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark">Central Content Library</h4>
            </div>
        </div>
        <div class="cl-board-meta text-muted small">
            <i class="fa fa-layer-group text-primary me-1"></i> <strong>@Model.Count</strong> total items in repository • Upload once, assign anywhere across courses
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <select id="glSourceFilter" class="form-select form-select-sm" style="width: auto; border-radius: var(--cl-radius-sm);">
            <option value="All">All Sources</option>
            <option value="Local">📁 Local Storage</option>
            <option value="GoogleDrive">☁️ Google Drive</option>
            <option value="OneDrive">📘 OneDrive</option>
        </select>
        <select id="glTypeFilter" class="form-select form-select-sm" style="width: auto; border-radius: var(--cl-radius-sm);">
            <option value="All">All Types</option>
            <option value="Document">📄 Documents / PDFs</option>
            <option value="Video">🎥 Videos</option>
            <option value="VideoURL">🔗 Video URLs</option>
        </select>
        <a href="@Url.Action("Item", "LectureMaterial", new { area = "Admin" })" class="cl-upload-btn btn-sm">
            <i class="fa fa-cloud-arrow-up"></i> Upload New
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="p-5 text-center bg-white rounded-4 border my-3 shadow-sm">
        <div class="mb-3" style="font-size: 54px;">📚</div>
        <h5 class="fw-bold text-dark mb-1">Your Central Library is empty</h5>
        <p class="text-muted small mb-4 mx-auto" style="max-width: 460px;">
            Upload documents, videos, and PDFs once to your Central Library to easily assign them across any course and quadrant.
        </p>
        <a href="@Url.Action("Item", "LectureMaterial", new { area = "Admin" })" class="btn btn-primary px-4 py-2 fw-semibold" style="border-radius:10px;">
            <i class="fa fa-plus me-1"></i> Upload First Content
        </a>
    </div>
}
else
{
    <div class="gl-grid d-flex flex-column gap-2">
        @foreach (var item in Model)
        {
            var typeIcon = item.MaterialType switch
            {
                "Video" => "🎥",
                "VideoURL" => "🔗",
                _ => "📄"
            };

            var sourceIcon = item.Source switch
            {
                "GoogleDrive" => "☁️",
                "OneDrive" => "📘",
                _ => "📁"
            };

            var sourceLabel = item.Source switch
            {
                "GoogleDrive" => "Google Drive",
                "OneDrive" => "OneDrive",
                _ => "Local"
            };

            var fileSize = item.FileSizeBytes.HasValue
                ? (item.FileSizeBytes.Value > 1048576
                    ? $"{item.FileSizeBytes.Value / 1048576.0:F1} MB"
                    : $"{item.FileSizeBytes.Value / 1024.0:F0} KB")
                : "";

            <div class="gl-item d-flex align-items-center justify-content-between p-3 bg-white rounded-3 border shadow-sm" data-title="@item.Title?.ToLower()">
                <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0; padding-right: 12px;">
                    <div class="gl-item-icon rounded-3 p-2 bg-light d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 20px; flex-shrink: 0;">
                        @typeIcon
                    </div>
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="gl-item-title fw-bold text-dark text-truncate" title="@item.Title" style="font-size: 0.95rem;">
                            @item.Title
                        </div>
                        <div class="gl-item-meta d-flex gap-2 mt-1 flex-wrap align-items-center">
                            <span class="badge bg-light text-primary border" style="font-size: 10px;">
                                @sourceIcon @sourceLabel
                            </span>
                            <span class="badge bg-light text-secondary border" style="font-size: 10px;">
                                @item.MaterialType
                            </span>
                            @if (!string.IsNullOrEmpty(fileSize))
                            {
                                <span class="badge bg-light text-muted border" style="font-size: 10px;">@fileSize</span>
                            }
                            @if (!string.IsNullOrEmpty(item.AssignmentSummary))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 view-assignments-link" data-id="@item.Id" style="cursor:pointer; font-size: 10px;" title="Click to view course assignments">
                                    <i class="fa fa-link me-1"></i> @item.AssignmentSummary
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 flex-shrink-0">
                    <div class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-2 rounded-pill view-assignments-link" data-id="@item.Id" style="cursor:pointer; font-size: 12px;" title="Click to view assigned courses">
                        <i class="fa fa-book-bookmark me-1"></i>
                        @item.MappedCourseCount Assigned
                    </div>
                    <div class="d-flex gap-1">
                        @if (!string.IsNullOrEmpty(item.FilePath))
                        {
                            var isGoogleDrive = item.Source == "GoogleDrive";
                            var previewUrl = isGoogleDrive ? $"/Admin/LectureMaterial/PreviewFile?id={item.Id}" : item.FilePath;
                            var fileExt = !string.IsNullOrEmpty(item.OriginalFileName) && System.IO.Path.HasExtension(item.OriginalFileName)
                                ? System.IO.Path.GetExtension(item.OriginalFileName).TrimStart('.').ToLowerInvariant()
                                : (!string.IsNullOrEmpty(item.FilePath) && System.IO.Path.HasExtension(item.FilePath)
                                    ? System.IO.Path.GetExtension(item.FilePath).TrimStart('.').ToLowerInvariant()
                                    : "");
                            <a href="javascript:void(0);"
                               class="btn btn-sm btn-outline-secondary view-file-link"
                               data-material-id="@item.Id"
                               data-filepath="@previewUrl"
                               data-raw-filepath="@item.FilePath"
                               data-filename="@(item.OriginalFileName ?? item.Title)"
                               data-extension="@fileExt"
                               data-source="@item.Source"
                               data-material-type="@item.MaterialType"
                               data-title="@item.Title"
                               title="Preview file"
                               style="border-radius: var(--cl-radius-sm);">
                                <i class="fa fa-eye"></i>
                            </a>
                        }
                        <button class="btn btn-sm btn-outline-primary quick-assign-btn"
                                data-material-id="@item.Id"
                                title="Assign to Course"
                                style="border-radius: var(--cl-radius-sm);">
                            <i class="fa fa-link"></i> Assign
                        </button>
                        <a asp-area="Admin"
                           asp-action="Item"
                           asp-controller="@controller"
                           asp-route-iId="@item.EncryptedId"
                           class="btn btn-sm btn-outline-secondary"
                           title="Edit metadata"
                           style="border-radius: var(--cl-radius-sm);">
                            <i class="fa fa-pen"></i>
                        </a>
                        @if (item.MaterialType == "Video" || item.MaterialType == "VideoURL")
                        {
                            <a href="/Admin/VideoQuiz/Manage?materialId=@item.Id"
                               class="btn btn-sm btn-outline-purple"
                               title="Manage Video Quiz"
                               style="border-radius: var(--cl-radius-sm); color:#9333ea; border-color:#d8b4fe; background:#faf5ff;">
                                <i class="fa fa-film"></i>
                            </a>
                        }
                        <button class="btn btn-sm btn-outline-danger delete-material-btn"
                                data-material-id="@item.Id"
                                data-title="@item.Title"
                                title="Delete from Central Library"
                                style="border-radius: var(--cl-radius-sm);">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
