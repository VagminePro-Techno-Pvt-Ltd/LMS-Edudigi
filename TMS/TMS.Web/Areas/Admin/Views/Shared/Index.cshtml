@{
	var controller = Convert.ToString(ViewContext.RouteData.Values["controller"]);
	var permissions = ViewContext.HttpContext.GetFormPermissions();
}

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-glass: rgba(255, 255, 255, 0.95);
    }

    #divIndexContainer {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        background: var(--bg-glass);
        backdrop-filter: blur(8px);
    }

    .card-header-premium {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        background: transparent;
    }

    .btn-create-premium {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white !important;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        border: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
    }

    .btn-create-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(79, 70, 229, 0.3);
    }

    /* DataTable Customization */
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 6px 12px;
        outline: none;
    }

    table.dataTable {
        border-collapse: separate !important;
        border-spacing: 0 8px !important;
        margin-top: 15px !important;
    }

    table.dataTable thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: none !important;
        padding: 12px 15px !important;
    }

    table.dataTable tbody tr {
        background-color: white;
        transition: all 0.2s;
    }

    table.dataTable tbody tr:hover {
        background-color: #f1f5f9 !important;
        transform: scale(1.005);
    }

    table.dataTable tbody td {
        padding: 15px !important;
        border-top: 1px solid #f1f5f9 !important;
        border-bottom: 1px solid #f1f5f9 !important;
        vertical-align: middle;
        font-size: 14px;
        color: #1e293b;
    }

    table.dataTable tbody td:first-child { border-left: 1px solid #f1f5f9 !important; border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
    table.dataTable tbody td:last-child { border-right: 1px solid #f1f5f9 !important; border-top-right-radius: 10px; border-bottom-right-radius: 10px; }

    /* Modal Styling */
    .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }

    .modal-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 20px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }
</style>

@{
    var roleFilter = ViewData["RoleFilter"]?.ToString() ?? "";
    var buttonText = string.IsNullOrWhiteSpace(roleFilter) ? "Create New" 
                     : roleFilter == "Faculty" ? "Add Faculty"
                     : roleFilter == "Student" ? "Add Student"
                     : roleFilter == "Admin" ? "Add Admin"
                     : "Create New";
}

<input id="hdTitle" type="hidden" value="@ViewData["Title"]" />
<input id="hdRoleFilter" type="hidden" value="@roleFilter" />

<div class="card" id="divIndexContainer">
    <div class="card-header-premium">
        <h4 style="margin:0; font-weight:800; color:#1e293b;">@ViewData["Title"]</h4>
        @if (permissions.Add)
        {
            <a class="btn-create-premium aAddNewItem">
                <i class="fas fa-plus"></i> @buttonText
            </a>
        }
    </div>
    
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblItemList" class="table nowrap"
                   data-ei="@(permissions.EditViewIconClass)"
                   data-et="@(permissions.EditViewText)" 
                   data-st="@(permissions.ScheduleViewText)" 
                   data-si="@(permissions.ScheduleViewIconClass)"
                   data-rt="@(permissions.RejectViewText)"
                   data-ri="@(permissions.RejectViewIconClass)"  
                   data-ai="@(permissions.ApprovalViewIconClass)"
                   data-at="@(permissions.ApprovalViewText)"
                   data-ni="@(permissions.NominationViewIcon)"
                   data-nt="@(permissions.NominationViewText)"
                   data-nai="@(permissions.NominationApprovalViewIcon)"
                   data-nat="@(permissions.NominationApprovalViewText)"
                   data-nri="@(permissions.NominationRejectViewIcon)"
                   data-nrt="@(permissions.NominationRejectViewText)"
                   data-nnt="@(permissions.AdminNominationViewText)"
                   data-nni="@(permissions.AdminNominationViewIcon)"
                   data-tct="@(permissions.TrainingCancelText)"
                   data-tci="@(permissions.TrainingCancelIcon)">
            </table>
        </div>
    </div> 
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="myModalLabel">Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Content will be loaded via AJAX -->
            </div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Action("AdminGlobalMaster","LinkScript",new {area="",c=controller})" asp-append-version="true"></script> 
    <script src="@Url.Action("AdminSchedule","LinkScript",new {area="",c=controller})" asp-append-version="true"></script> 
    <script src="@Url.Action("AdminReject","LinkScript",new {area="",c=controller})" asp-append-version="true"></script> 
    <script src="@Url.Action("AdminNominationRequest","LinkScript",new {area="",c=controller})" asp-append-version="true"></script> 
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <partial name="~/Views/Shared/_IndexCommonScriptsPartial.cshtml" />
    <script src="~/js/masters/@(controller)-index.js" asp-append-version="true"></script> 
}

