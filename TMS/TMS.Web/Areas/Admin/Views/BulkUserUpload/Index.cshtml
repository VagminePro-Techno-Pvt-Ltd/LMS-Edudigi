@{
    ViewData["Title"] = "Bulk Upload Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .bulk-upload-container { max-width: 1100px; margin: 0 auto; }
    .upload-hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; padding: 40px; color: white; margin-bottom: 30px; position: relative; overflow: hidden; }
    .upload-hero::before { content: ''; position: absolute; top: -50%; right: -20%; width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%; }
    .upload-hero h2 { font-weight: 800; margin-bottom: 8px; }
    .upload-hero p { opacity: 0.85; font-size: 15px; }
    .upload-card { background: white; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04); overflow: hidden; transition: all 0.3s; }
    .upload-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
    .upload-card .card-header-custom { background: #f8fafc; padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .upload-card .card-header-custom h5 { margin: 0; font-weight: 700; color: #1e293b; }
    .upload-card .card-header-custom .header-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .upload-card .card-body { padding: 24px; }
    .template-table { border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; }
    .template-table thead th { background: #f1f5f9; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px; border: none; }
    .template-table tbody td { padding: 10px 16px; font-size: 13px; color: #334155; border-color: #f1f5f9; }
    .btn-gradient { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border: none; padding: 12px 28px; border-radius: 12px; font-weight: 700; transition: all 0.3s; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25); }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35); color: white; }
    .btn-download { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 22px; border-radius: 12px; font-weight: 600; transition: all 0.3s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); }
    .btn-download:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3); color: white; }
    .file-input-wrapper { border: 2px dashed #cbd5e1; border-radius: 16px; padding: 40px; text-align: center; background: #f8fafc; transition: all 0.3s; cursor: pointer; }
    .file-input-wrapper:hover { border-color: #6366f1; background: #f5f3ff; }
    .file-input-wrapper i { font-size: 42px; color: #94a3b8; margin-bottom: 12px; }
    .file-input-wrapper:hover i { color: #6366f1; }
    .info-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .role-badge { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .role-badge.admin { background: #fef2f2; color: #dc2626; }
    .role-badge.faculty { background: #eff6ff; color: #2563eb; }
    .role-badge.student { background: #f0fdf4; color: #16a34a; }
    .flow-steps { display: flex; gap: 8px; align-items: center; margin-top: 20px; }
    .flow-step { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; }
    .flow-step .step-num { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; }
    .flow-step.active .step-num { background: white; color: #6366f1; }
    .flow-step:not(.active) .step-num { background: rgba(255,255,255,0.2); color: rgba(255,255,255,0.8); }
    .flow-arrow { color: rgba(255,255,255,0.4); font-size: 12px; }
</style>

<div class="bulk-upload-container">

    @* ── Hero Banner ── *@
    <div class="upload-hero">
        <h2><i class="fas fa-users-cog me-2"></i>Bulk Upload Users</h2>
        <p>Create multiple Admin, Faculty, and Student accounts at once using CSV or Excel file upload.</p>
        <div class="d-flex gap-2 mt-2">
            <span class="info-chip" style="background:rgba(255,255,255,0.15); color:white;">
                <i class="fas fa-shield-halved"></i> Secure Password
            </span>
            <span class="info-chip" style="background:rgba(255,255,255,0.15); color:white;">
                <i class="fas fa-key"></i> Force Change on Login
            </span>
            <span class="info-chip" style="background:rgba(255,255,255,0.15); color:white;">
                <i class="fas fa-check-circle"></i> Duplicate Detection
            </span>
        </div>
        <div class="flow-steps">
            <div class="flow-step active"><span class="step-num">1</span> Upload</div>
            <i class="fas fa-chevron-right flow-arrow"></i>
            <div class="flow-step"><span class="step-num">2</span> Preview</div>
            <i class="fas fa-chevron-right flow-arrow"></i>
            <div class="flow-step"><span class="step-num">3</span> Confirm</div>
            <i class="fas fa-chevron-right flow-arrow"></i>
            <div class="flow-step"><span class="step-num">4</span> Result</div>
        </div>
    </div>

    <div class="row g-4">

        @* ── Left: Upload Form ── *@
        <div class="col-lg-8">
            <div class="upload-card">
                <div class="card-header-custom">
                    <div class="header-icon" style="background:#eff6ff; color:#3b82f6;">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <h5>Upload User Data</h5>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="BulkUserUpload" asp-action="Preview" method="post" enctype="multipart/form-data">

                        <div class="file-input-wrapper mb-4" onclick="document.getElementById('bulkFileInput').click();">
                            <i class="fas fa-file-excel d-block"></i>
                            <p class="mb-1 fw-bold text-dark">Drag & Drop or Click to Upload</p>
                            <p class="text-muted small mb-0">Supports .csv, .xlsx, .xls files</p>
                            <input type="file" id="bulkFileInput" name="bulkFile" class="d-none" accept=".csv, .xlsx, .xls" required
                                   onchange="document.getElementById('selectedFileName').textContent = this.files[0]?.name || ''" />
                            <span id="selectedFileName" class="d-block mt-2 fw-bold text-primary"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-light fw-bold">
                                <i class="fas fa-arrow-left"></i> Back to Users
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-area="Admin" asp-controller="BulkUserUpload" asp-action="DownloadTemplate" class="btn-download">
                                    <i class="fas fa-download"></i> Download Template
                                </a>
                                <button type="submit" class="btn-gradient">
                                    <i class="fas fa-eye"></i> Preview & Validate
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ── Right: Instructions Panel ── *@
        <div class="col-lg-4">
            <div class="upload-card mb-4">
                <div class="card-header-custom">
                    <div class="header-icon" style="background:#f0fdf4; color:#16a34a;">
                        <i class="fas fa-table"></i>
                    </div>
                    <h5>File Format</h5>
                </div>
                <div class="card-body">
                    <table class="table template-table mb-3">
                        <thead>
                            <tr><th>A</th><th>B</th><th>C</th><th>D</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Name</td><td>Email</td><td>Phone</td><td>Role</td></tr>
                            <tr class="text-muted">
                                <td>Rahul S.</td><td>rahul@@example</td><td>98765...</td>
                                <td><span class="role-badge student">Student</span></td>
                            </tr>
                            <tr class="text-muted">
                                <td>Priya V.</td><td>priya@@example</td><td>91234...</td>
                                <td><span class="role-badge faculty">Faculty</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="upload-card mb-4">
                <div class="card-header-custom">
                    <div class="header-icon" style="background:#fff7ed; color:#ea580c;">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <h5>Supported Roles</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2"><span class="role-badge admin">Admin</span><span class="text-muted small">Full system access</span></div>
                        <div class="d-flex align-items-center gap-2"><span class="role-badge faculty">Faculty</span><span class="text-muted small">Course management</span></div>
                        <div class="d-flex align-items-center gap-2"><span class="role-badge student">Student</span><span class="text-muted small">Learner access</span></div>
                    </div>
                </div>
            </div>

            <div class="upload-card">
                <div class="card-header-custom">
                    <div class="header-icon" style="background:#fef3c7; color:#d97706;">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h5>Important Notes</h5>
                </div>
                <div class="card-body">
                    <ul class="small text-muted mb-0" style="line-height: 1.8;">
                        <li>Default password: <code class="text-dark fw-bold">LMS@@2026</code></li>
                        <li>Users must change password on first login</li>
                        <li>Existing emails are <strong>skipped</strong> (default mode)</li>
                        <li>Role must match exactly: <code>Admin</code>, <code>Faculty</code>, or <code>Student</code></li>
                        <li>This does <strong>NOT</strong> enroll students into courses</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
